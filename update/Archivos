\n      \"me_no_conectado\": \"Mendeley non está conectado.\",\n      \"me_no_conectado_aviso\": \"Mendeley non está conectado. Usa Axustes > Mendeley (avanzado): conectar.\",\n      \"me_enviadas\": \"Enviadas a Mendeley: {0}. Pendentes: {1}.\",\n      \"me_reconectar\": \" Hai que volver conectar Mendeley desde o menú.\",\n      \"me_auto_on\": \"Envío automático a Mendeley activado (cada 6 horas).\",\n      \"me_auto_off\": \"Envío automático a Mendeley desactivado ({0}).\"\n  },\n  fr: {\n      \"m_configurar\": \"🎓 Configurer ma thèse (commencez ici)\",\n      \"m_actualizar\": \"📊 Actualiser le tableau de bord et le RADAR\",\n      \"m_buscar_base\": \"🔍 Rechercher dans toute la base\",\n      \"m_novedades\": \"🔎 Chercher les nouveautés maintenant\",\n      \"m_clasificar\": \"🤖 Classer les éléments en attente avec l'IA\",\n      \"m_gestor\": \"📚 Envoyer maintenant à mon gestionnaire de références\",\n      \"m_ris\": \"📤 Exporter un fichier RIS (EndNote et autres)\",\n      \"m_ris_enviar\": \"M'envoyer le fichier par e-mail\",\n      \"m_ris_marcar\": \"Marquer comme importé\",\n      \"m_mapa\": \"🗺 Carte des lacunes de la thèse\",\n      \"m_revisar\": \"🔄 Vérifier maintenant\",\n      \"m_autores\": \"Auteurs clés\",\n      \"m_fuentes\": \"Sources primaires\",\n      \"m_abiertas\": \"Sources ouvertes (facultatif)\",\n      \"m_congresos\": \"Dates limites de colloques\",\n      \"m_resumen\": \"Résumé hebdomadaire par e-mail\",\n      \"m_hist_continuar\": \"Radar historique : continuer\",\n      \"m_hist_estado\": \"Radar historique : voir l'état\",\n      \"m_ajustes\": \"⚙ Paramètres\",\n      \"m_activar_todo\": \"▶ Activer TOUTE l'automatisation\",\n      \"m_desactivar_todo\": \"⏹ Désactiver TOUTE l'automatisation\",\n      \"m_hist_activar\": \"Radar historique automatique : activer\",\n      \"m_hist_desactivar\": \"Radar historique automatique : désactiver\",\n      \"m_ab_activar\": \"Sources ouvertes (facultatif) : activer\",\n      \"m_ab_desactivar\": \"Sources ouvertes : désactiver\",\n      \"m_ab_probar\": \"Sources ouvertes : tester la connexion\",\n      \"m_zo_conectar\": \"Zotero : connecter (une seule fois)\",\n      \"m_zo_probar\": \"Zotero : tester la connexion\",\n      \"m_zo_desconectar\": \"Zotero : déconnecter\",\n      \"m_me_conectar\": \"Mendeley (avancé) : connecter\",\n      \"m_me_probar\": \"Mendeley : tester la connexion\",\n      \"m_me_desconectar\": \"Mendeley : déconnecter\",\n      \"m_repuntuar\": \"Renoter les éléments en attente avec le nouveau critère\",\n      \"m_diagnostico\": \"Diagnostic du système\",\n      \"m_idioma\": \"🌐 Idioma / Language\",\n      \"m_guia\": \"📖 Guide pas à pas\",\n      \"m_guia_inicio\": \"Premiers pas\",\n      \"m_guia_listo\": \"Après avoir configuré la thèse\",\n      \"m_guia_rapida\": \"❓ Guide rapide\",\n      \"a_buscando\": \"Recherche de nouveautés dans OpenAlex…\",\n      \"a_nuevos\": \"{0} nouvelle(s) publication(s).\",\n      \"a_nuevos_clasificar\": \" Utilisez « Classer les éléments en attente avec l'IA » pour les analyser.\",\n      \"a_limite_openalex\": \" La limite gratuite d'OpenAlex est atteinte : réessayez plus tard.\",\n      \"a_clasificando\": \"Classement par l'IA en cours (cela peut prendre quelques minutes)…\",\n      \"a_fuentes\": \"Vérification des pages de sources…\",\n      \"a_autores\": \"Surveillance des auteurs clés…\",\n      \"a_mapa\": \"Calcul de la carte des lacunes…\",\n      \"a_error_titulo\": \"L'action n'a pas pu être menée à bien\",\n      \"a_error_pie\": \"\\n\\nSi le problème persiste, consultez l'onglet LOG.\",\n      \"act_titulo\": \"Activer toute l'automatisation\",\n      \"act_texto\": \"Seront activés :\\n• Radar quotidien + classement par l'IA (chaque jour et chaque heure)\\n• Envoi vers le gestionnaire de références choisi (toutes les 6 heures)\\n• Résumé hebdomadaire par e-mail (lundi)\\n• Alerte des dates limites de colloques (lundi)\\n• Surveillance des sources primaires (dimanche)\\n• Surveillance des auteurs clés (dimanche)\\n\\nLe radar historique et les sources ouvertes (dépôts de thèses) s'activent séparément (Paramètres).\\n\\nContinuer ?\",\n      \"act_ok\": \"Automatisation activée\",\n      \"des_titulo\": \"Désactiver toute l'automatisation\",\n      \"des_texto\": \"Toutes les tâches automatiques seront arrêtées (y compris le radar historique). La modification de RADAR continuera de se synchroniser.\\n\\nContinuer ?\",\n      \"des_ok\": \"Automatisation désactivée\",\n      \"p_radar\": \"Radar quotidien et classement\",\n      \"p_gestor\": \"Envoi vers votre gestionnaire de références\",\n      \"p_resumen\": \"Résumé hebdomadaire\",\n      \"p_congresos\": \"Dates limites de colloques\",\n      \"p_fuentes\": \"Sources primaires\",\n      \"p_autores\": \"Auteurs clés\",\n      \"p_abiertas\": \"Sources ouvertes\",\n      \"p_historico\": \"Radar historique\",\n      \"guia_titulo\": \"Guide rapide · PIH Doctorado\",\n      \"guia_html\": \"<h3 style='margin: 0 0 8px; color: #24445C;'>Comment fonctionne votre PIH Doctorado</h3><p><b>0. Commencez</b> par « Configurar mi tesis » (Configurer ma thèse) : collez le résumé de votre thèse et vos clés gratuites, et le système se configure tout seul.</p><p><b>1. PANEL</b> est le résumé : chiffres et graphiques. À consulter seulement.</p><p><b>2. RADAR</b> est votre espace de travail, trié par pertinence (le plus important en haut). Les couleurs indiquent la pertinence, la confiance de l'IA et le statut.</p><ul style='margin-top: 0;'><li>Changez l'<b>ESTADO</b> (statut) avec la liste déroulante : <b>Pendiente</b> (en attente, non examiné), <b>Para leer</b> (à lire, cela vous intéresse), <b>Leído</b> (lu) ou <b>Descartado</b> (écarté).</li><li>Vous pouvez corriger la <b>RELEVANCIA</b> (pertinence, de 0 à 5) et la <b>TEMÁTICA</b> (thématique). Elles s'enregistrent toutes seules.</li></ul><p><b>3. Zotero ou Mendeley :</b> les publications marquées « Para leer » ou « Leído » sont envoyées automatiquement vers votre bibliothèque (collection « PIH Doctorado »). La première fois : Paramètres &gt; Zotero : connecter (Mendeley est plus technique).</p><p><b>4. Automatique :</b> <i>Paramètres &gt; Activer TOUTE l'automatisation</i> active tout d'un coup. Si une limite gratuite est atteinte, le système s'arrête et reprend seul plus tard. Tout est gratuit.</p><p><b>5. Autres onglets :</b> MAPA HUECOS (carte des lacunes : quelles parties de la thèse ont peu de bibliographie), AUTORES CLAVE (auteurs clés), FUENTES PRIMARIAS (sources primaires) et CONGRESOS (colloques) se remplissent et vous alertent par e-mail. PUBLICACIONES est la base de données et LOG l'historique (en cas de problème, la raison s'y trouve).</p>\",\n      \"tut_label_inicio\": \"GUIDE · PREMIERS PAS\",\n      \"tut_label_listo\": \"GUIDE · ÉTAPES SUIVANTES\",\n      \"tut_prev\": \"Précédent\",\n      \"tut_next\": \"Suivant\",\n      \"tut_start\": \"Commencer\",\n      \"tut_of\": \"sur\",\n      \"tut_menu_error\": \"Utilisez le menu du haut : PIH Doctorado > Configurer ma thèse.\",\n      \"tut_toast\": \"Ouvrez PIH Doctorado > Guide pas à pas pour voir les premiers pas.\",\n      \"tut_toast_titulo\": \"Bienvenue\",\n      \"tut_idioma\": \"Langue\",\n      \"tut_dialogo\": \"PIH Doctorado\",\n      \"tut_inicio\": [\n          {\n              \"titulo\": \"Bienvenue dans votre PIH Doctorado\",\n              \"texto\": \"C'est un système qui cherche chaque jour de nouvelles publications sur votre thèse, les note de 0 à 5 avec l'IA et les range dans cette feuille. Il fonctionne avec des comptes gratuits et vos données restent dans votre compte Google.\",\n              \"pista\": \"Ce guide dure environ 3 minutes. Vous pouvez le rouvrir depuis le menu.\"\n          },\n          {\n              \"titulo\": \"Comment ça marche\",\n              \"texto\": \"1. Vous décrivez votre thèse.\\n2. Le système cherche de la bibliographie dans OpenAlex, une base ouverte d'œuvres scientifiques.\\n3. L'IA lit chaque résumé et lui donne une note en fonction de votre thèse.\\n4. Vous décidez quoi lire et l'envoyez à votre gestionnaire de références.\",\n              \"pista\": \"Vous avez toujours le dernier mot : vous pouvez corriger n'importe quelle note.\"\n          },\n          {\n              \"titulo\": \"Ce qui sera créé dans votre feuille\",\n              \"texto\": \"Quand vous configurerez votre thèse, ces onglets apparaîtront :\\n\\nPERFIL (profil) : votre thèse et les recherches générées.\\nRADAR : la liste des publications, triée par pertinence. C'est ici que vous travaillez.\\nPANEL (tableau de bord) : résumé avec chiffres et graphiques.\\nPUBLICACIONES (publications) : la base de données complète.\\nLOG : l'historique ; en cas de problème, la raison s'y trouve.\\nEt vides, à remplir par vous : AUTORES CLAVE (auteurs clés), CONGRESOS (colloques) et FUENTES PRIMARIAS (sources primaires).\",\n              \"pista\": \"Inutile de toucher à quoi que ce soit avant de configurer.\"\n          },\n          {\n              \"titulo\": \"Ce dont vous avez besoin avant de commencer\",\n              \"texto\": \"Deux clés gratuites, sans carte bancaire :\\n• Gemini (l'IA) : aistudio.google.com > « Get API key ».\\n• OpenAlex (la bibliographie) : créez un compte sur openalex.org et copiez la clé depuis votre profil.\\n\\nEt le résumé de votre thèse : au moins 4 ou 5 phrases.\",\n              \"pista\": \"Procurez-vous-les maintenant dans un autre onglet du navigateur, puis revenez.\"\n          },\n          {\n              \"titulo\": \"Les autorisations Google\",\n              \"texto\": \"La première fois, Google vous demandera des autorisations et affichera « application non validée ». C'est normal pour les scripts personnels.\\n\\nCliquez sur « Paramètres avancés » puis sur « Accéder à… (non sécurisé) ». Le code est à vous et vous pouvez le lire dans Extensions > Apps Script.\",\n              \"pista\": \"Le système ne touche qu'à ce document.\"\n          },\n          {\n              \"titulo\": \"Première étape : configurer votre thèse\",\n              \"texto\": \"Cliquez sur le bouton ci-dessous, ou utilisez le menu du haut :\\n\\nPIH Doctorado  >  🎓 Configurer ma thèse\\n\\nCollez votre résumé, vos mots-clés et les deux clés. Le système générera votre profil et vous dira quoi faire ensuite.\",\n              \"pista\": \"Si le bouton ne répond pas, utilisez le menu. Si le menu n'apparaît pas, rechargez la page.\",\n              \"accion\": {\n                  \"etiqueta\": \"Ouvrir « Configurer ma thèse »\",\n                  \"funcion\": \"menuConfigurarTesisPIH\"\n              }\n          }\n      ],\n      \"tut_listo\": [\n          {\n              \"titulo\": \"Votre profil est prêt\",\n              \"texto\": \"Le système a créé l'onglet PERFIL avec les recherches, les termes et les blocs de votre thèse. Les cellules jaunes sont modifiables : une requête par ligne.\",\n              \"pista\": \"Vérifiez que les requêtes ont du sens pour votre sujet.\"\n          },\n          {\n              \"titulo\": \"À quoi sert chaque onglet\",\n              \"texto\": \"RADAR : votre espace de travail. Le plus pertinent en haut ; vous changez l'ESTADO (statut) et corrigez les notes.\\nPANEL : chiffres et graphiques de l'ensemble.\\nPUBLICACIONES : la base complète (inutile de la modifier).\\nMAPA HUECOS : quelles parties de votre thèse ont peu de bibliographie.\\nAUTORES CLAVE : auteurs que vous voulez suivre.\\nCONGRESOS : dates limites et état de vos propositions.\\nFUENTES PRIMARIAS : documents sur vos cas (rapports, réglementation).\\nBUSQUEDA : résultats de la recherche. LOG : l'historique.\",\n              \"pista\": \"Les couleurs de RADAR indiquent la pertinence, la confiance de l'IA et le statut.\"\n          },\n          {\n              \"titulo\": \"Étape 1 · Chercher les nouveautés\",\n              \"texto\": \"Menu PIH Doctorado > 🔎 Chercher les nouveautés maintenant.\\n\\nEn une ou deux minutes, de nouvelles publications apparaîtront dans l'onglet PUBLICACIONES.\",\n              \"pista\": \"Si rien n'apparaît, regardez l'onglet LOG : la raison s'y trouve.\"\n          },\n          {\n              \"titulo\": \"Étape 2 · Classement par l'IA\",\n              \"texto\": \"Menu PIH Doctorado > 🤖 Classer les éléments en attente avec l'IA.\\n\\nL'IA lit chaque résumé et lui attribue une pertinence de 0 à 5 avec une explication. Cela peut prendre quelques minutes.\",\n              \"pista\": \"Si Google indique « forte demande » (erreur 503), c'est temporaire : le système réessaie seul.\"\n          },\n          {\n              \"titulo\": \"Étape 3 · Votre espace de travail\",\n              \"texto\": \"Dans l'onglet RADAR, le plus pertinent est en haut. Les couleurs indiquent la pertinence (vert foncé = 5) et le statut.\\n\\nChangez l'ESTADO avec la liste déroulante : Pendiente (en attente), Para leer (à lire), Leído (lu) ou Descartado (écarté). Si vous n'êtes pas d'accord avec une note, corrigez-la.\",\n              \"pista\": \"Vos corrections sont enregistrées automatiquement.\"\n          },\n          {\n              \"titulo\": \"Étape 4 · Rechercher et explorer\",\n              \"texto\": \"🔍 Rechercher dans toute la base : trouve des mots dans les titres, les résumés et les abstracts.\\n\\n🗺 Carte des lacunes : vous indique quelles parties de votre thèse ont peu de bibliographie.\\n\\nAuteurs clés, Colloques et Sources primaires : onglets à remplir avec votre propre matériel.\",\n              \"pista\": \"Commencez par la recherche : c'est le plus utile le premier jour.\"\n          },\n          {\n              \"titulo\": \"Étape 5 · Votre gestionnaire de références\",\n              \"texto\": \"Ce que vous marquez « Para leer » (à lire) ou « Leído » (lu) peut partir tout seul vers votre bibliothèque.\\n\\nZotero : PIH Doctorado > Paramètres > Zotero : connecter (il vous faut une clé gratuite).\\nEndNote ou autres : 📤 Exporter un fichier RIS.\",\n              \"pista\": \"Mendeley est une option avancée.\"\n          },\n          {\n              \"titulo\": \"Étape 6 · Automatisation\",\n              \"texto\": \"Quand tout vous convient :\\n\\nPIH Doctorado > ⚙ Paramètres > ▶ Activer TOUTE l'automatisation.\\n\\nÀ partir de là, le système cherche, classe et vous envoie un résumé hebdomadaire par e-mail. Le radar historique (bibliographie antérieure) s'active séparément, dans Paramètres.\",\n              \"pista\": \"En cas de problème, l'onglet LOG l'explique. Le menu « Guide pas à pas » rouvre ceci.\"\n          }\n      ],\n      \"w_titulo\": \"Configurer ma thèse\",\n      \"w_idioma\": \"Langue de l'interface\",\n      \"w_intro\": \"Remplissez ce que vous savez. Plus le résumé est précis, mieux cela fonctionnera. Tout est enregistré uniquement dans votre document.\",\n      \"w_tema\": \"Titre ou sujet\",\n      \"w_disciplina\": \"Discipline\",\n      \"w_disciplina_ej\": \"(p. ex. sociologie, biologie marine…)\",\n      \"w_resumen\": \"Résumé de la thèse\",\n      \"w_resumen_ej\": \"(collez celui de votre projet)\",\n      \"w_claves\": \"Mots-clés\",\n      \"w_claves_ej\": \"(séparés par des virgules)\",\n      \"w_casos\": \"Cas précis que vous étudiez\",\n      \"w_opcional\": \"(facultatif)\",\n      \"w_casos_ph\": \"P. ex. : une espèce, une institution, une région, un programme, une entreprise…\",\n      \"w_casos_ayuda\": \"Si votre thèse compare ou analyse des objets précis, nommez-les ici (séparés par des virgules). Si elle est purement théorique, laissez vide.\",\n      \"w_idioma_local\": \"Langue locale de recherche\",\n      \"w_idioma_local_ej\": \"(en plus de l'anglais)\",\n      \"w_idioma_local_valor\": \"français\",\n      \"w_gestor\": \"Gestionnaire de références\",\n      \"w_gestor_ninguno\": \"Aucun\",\n      \"w_gemini\": \"Clé Gemini\",\n      \"w_gemini_ej\": \"(gratuite, sur aistudio.google.com)\",\n      \"w_openalex\": 
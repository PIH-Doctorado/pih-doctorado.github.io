     \"fp_asunto\": \"PIH Doctorado · {0} neue(s) Dokument(e) in den Primärquellen\",\n      \"fp_resultado\": \"{0} neue(s) Dokument(e) ({1} Seite(n) geprüft).\",\n      \"fp_errores\": \" Es gab Fehler: siehe LOG.\",\n      \"fp_on\": \"Quellenprüfung aktiviert: sonntags gegen 20:00 Uhr.\",\n      \"fp_off\": \"Quellenprüfung deaktiviert ({0}).\",\n      \"me_falta_cred\": \"MENDELEY_CLIENT_ID oder MENDELEY_CLIENT_SECRET fehlen in den Skripteigenschaften.\",\n      \"me_falta_oauth\": \"Die OAuth2-Bibliothek (OAuth2-Kennung) fehlt im Projekt.\",\n      \"me_ya\": \"Mendeley ist bereits verbunden.\",\n      \"me_html\": \"<p>1. Klicke auf den Link. Mendeley öffnet sich in einem anderen Tab.</p><p>2. Melde dich an und erteile die Berechtigung.</p><p>3. Wenn «Mendeley verbunden» erscheint, schließe diesen Tab und nutze <i>Einstellungen &gt; Mendeley: Verbindung testen</i>.</p>\",\n      \"me_enlace\": \"👉 Mit Mendeley verbinden\",\n      \"me_dialogo\": \"Mit Mendeley verbinden\",\n      \"me_desconectado\": \"Mendeley getrennt.\",\n      \"me_alert_no\": \"Du bist noch nicht verbunden. Nutze Einstellungen > Mendeley (fortgeschritten): verbinden.\",\n      \"me_ok\": \"✅ Verbindung zu deiner Mendeley-Bibliothek erfolgreich.\",\n      \"me_api_codigo\": \"Die API hat mit Code {0} geantwortet.\\n\\n{1}\",\n      \"me_no_conectado\": \"Mendeley ist nicht verbunden.\",\n      \"me_no_conectado_aviso\": \"Mendeley ist nicht verbunden. Nutze Einstellungen > Mendeley (fortgeschritten): verbinden.\",\n      \"me_enviadas\": \"An Mendeley gesendet: {0}. Offen: {1}.\",\n      \"me_reconectar\": \" Mendeley muss über das Menü erneut verbunden werden.\",\n      \"me_auto_on\": \"Automatischer Versand an Mendeley aktiviert (alle 6 Stunden).\",\n      \"me_auto_off\": \"Automatischer Versand an Mendeley deaktiviert ({0}).\"\n  }\n};\n"}, {"name": "InteligenciaDoctorado", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Módulo: Doctorado\n * Clasificador académico gratuito mediante Gemini · v3\n *\n * - Clasifica publicaciones pendientes en lotes de 5: UNA sola llamada a\n *   Gemini por lote (si algún elemento falla, se reintenta uno a uno).\n * - No procesa publicaciones ya clasificadas ni las marcadas \"Descartado\".\n * - Separa RELEVANCIA (0-5) de CONFIANZA_ANALISIS (Alta/Media/Baja).\n * - Si no hay abstract, la confianza es siempre Baja.\n * - Si has cambiado a mano la temática principal, NO se sobrescribe:\n *   la sugerencia de la IA pasa a TEMATICAS_SECUNDARIAS.\n * - Si se alcanza el límite gratuito (error 429), se detiene sin error y\n *   las pendientes se retoman en la siguiente ejecución.\n * - Un error temporal de Gemini (503) se reintenta con esperas de 5, 15 y\n *   30 s; si una publicación sigue fallando se salta y se continúa con la\n *   siguiente. Con 3 fallos temporales seguidos se pausa hasta la\n *   siguiente ejecución.\n * - Si una publicación falla por su contenido, se marca \"Error IA (n)\" en\n *   NIVEL_ANALISIS_IA y se reintenta hasta 3 veces. Para forzar otro\n *   intento, borra esa celda.\n * - Conserva los datos originales y registra la actividad en LOG.\n *\n * Funciones que puedes ejecutar a mano:\n *   - clasificarCincoPublicaciones()   -> un lote de 5\n *   - clasificarPendientesPIH()        -> varios lotes (hasta ~4 minutos)\n *\n * Coste: 0 €. Usa solo la API gratuita de Gemini (sin facturación).\n *\n * Depende de funciones de InterfazDoctorado.gs v4:\n * asegurarColumnaPIH_, obtenerIndiceCabecerasPIH_,\n * normalizarTextoPIH_, canonicoListaPIH_ y avisarPIH_.\n */\n\nconst PIH_GEMINI_MODEL = \"gemini-3.1-flash-lite\";\nconst PIH_LOTE_CLASIFICACION = 5;\nconst PIH_PAUSA_ENTRE_PETICIONES_MS = 500;\n\n// Tiempo máximo dedicado a clasificar en cada pasada. Google corta toda\n// ejecución a los 6 minutos y después hay que refrescar RADAR y el panel,\n// así que se deja un margen amplio.\nconst PIH_TIEMPO_MAXIMO_MS = 150000;\n\n// Hora límite de la pasada en curso (se calcula al empezar).\nlet PIH_FECHA_LIMITE = 0;\nconst PIH_MAX_INTENTOS = 3;\n\n// Consultas iniciales del perfil. Mientras TEMATICA_PRINCIPAL contenga una\n// de ellas (o esté vacía), se considera que no la has tocado.\nfunction tematicasInicialesPIH_() {\n  return listaPerfilPIH_(\"consultas_radar\", [])\n    .concat(listaPerfilPIH_(\"consultas_historico\", []));\n}\n\n\n// =====================================================\n// FUNCIONES PRINCIPALES\n// =====================================================\n\n/**\n * Analiza un lote de hasta cinco publicaciones pendientes.\n */\nfunction clasificarCincoPublicaciones() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    avisarPIH_(tPIH_(\"c_ocupado\"), 8);\n    return;\n  }\n\n  try {\n    ejecutarClasificacionPIH_(1);\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\n/**\n * Analiza varios lotes seguidos (hasta unos 4 minutos de trabajo).\n */\nfunction clasificarPendientesPIH() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    avisarPIH_(tPIH_(\"c_ocupado\"), 8);\n    return;\n  }\n\n  try {\n    ejecutarClasificacionPIH_(1000);\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\n/**\n * Ejecuta hasta \"maxLotes\" lotes, se detiene al llegar al límite\n * gratuito o al tiempo máximo, registra el resultado y actualiza\n * la interfaz. Devuelve un resumen.\n */\nfunction ejecutarClasificacionPIH_(maxLotes) {\n\n  const inicio = Date.now();\n\n  PIH_FECHA_LIMITE = inicio + PIH_TIEMPO_MAXIMO_MS;\n\n  const total = {\n    procesadas: 0,\n    errores: [],\n    restantes: 0,\n    motivoParada: \"\"\n  };\n\n  for (let lote = 0; lote < maxLotes; lote++) {\n\n    const r = clasificarLotePIH_(PIH_LOTE_CLASIFICACION);\n\n    total.procesadas += r.procesadas;\n    total.errores = total.errores.concat(r.errores);\n    total.restantes = r.restantes;\n    total.motivoParada = r.motivoParada;\n\n    if (r.motivoParada) break;\n    if (r.seleccionadas === 0) break;\n    if (r.procesadas === 0) break;\n    if (Date.now() - inicio > PIH_TIEMPO_MAXIMO_MS) break;\n  }\n\n  let resultado = \"COMPLETADO\";\n\n  if (total.motivoParada === \"cuota\") {\n    resultado = \"LIMITE_ALCANZADO\";\n  } else if (total.motivoParada === \"transitorio\") {\n    resultado = \"PAUSADO_ERROR_TEMPORAL\";\n  } else if (total.motivoParada === \"configuracion\") {\n    resultado = \"ERROR_CONFIGURACION\";\n  } else if (total.errores.length) {\n    resultado = \"PARCIAL\";\n  }\n\n  let detalles = total.errores.join(\" | \") || \"Sin errores\";\n\n  if (total.motivoParada === \"cuota\") {\n    detalles +=\n      \" | Límite gratuito alcanzado: las pendientes se retomarán \" +\n      \"en la siguiente ejecución.\";\n  } else if (total.motivoParada === \"transitorio\") {\n    detalles +=\n      \" | Error temporal de Gemini: se reintentará en la siguiente ejecución.\";\n  }\n\n  // Solo se registra si ha ocurrido algo (así LOG no se llena de avisos\n  // cuando no hay nada pendiente).\n  const hayActividad =\n    total.procesadas > 0 ||\n    total.errores.length > 0 ||\n    total.motivoParada !== \"\";\n\n  if (hayActividad) {\n    registrarLogPIH_(\n      \"CLASIFICADOR_IA\",\n      resultado,\n      total.procesadas,\n      detalles\n    );\n  }\n\n  // Refrescar RADAR y el panel solo si queda tiempo de sobra (Google corta\n  // todo a los 6 minutos). Si no, se hace con «Actualizar panel y RADAR».\n  const refrescado =\n    total.procesadas > 0 &&\n    typeof crearInterfazDoctorado === \"function\" &&\n    Date.now() - inicio < 200000;\n\n  if (refrescado) {\n    crearInterfazDoctorado();\n  }\n\n  let mensaje;\n\n  if (!hayActividad) {\n    mensaje = tPIH_(\"ig_vacio\");\n  } else {\n    mensaje = tPIH_(\"ig_resultado\", total.procesadas, total.restantes);\n\n    if (total.procesadas > 0 && !refrescado) {\n      mensaje += tPIH_(\"ig_actualizar\");\n    }\n\n    if (total.motivoParada === \"cuota\") {\n      mensaje += tPIH_(\"ig_cuota\");\n    } else if (total.motivoParada === \"transitorio\") {\n      mensaje += tPIH_(\"ig_transitorio\");\n    } else if (total.motivoParada === \"configuracion\") {\n      mensaje += tPIH_(\"ig_config\");\n    } else if (total.errores.length) {\n      mensaje += tPIH_(\"ig_errores\");\n    }\n  }\n\n  avisarPIH_(mensaje, 10);\n\n  console.log(mensaje);\n\n  return total;\n}\n\n\n/**\n * Clasifica un lote. Devuelve:\n * { seleccionadas, procesadas, errores, motivoParada, restantes }\n * motivoParada: \"\" | \"cuota\" | \"transitorio\" | \"configuracion\"\n */\nfunction clasificarLotePIH_(tamano) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja) {\n    throw new Error(tPIH_(\"c_no_hoja_pub\"));\n  }\n\n  const vacio = {\n    seleccionadas: 0,\n    procesadas: 0,\n    errores: [],\n    motivoParada: \"\",\n    restantes: 0\n  };\n\n  if (hoja.getLastRow() < 2) {\n    return vacio;\n  }\n\n  const apiKey = PropertiesService\n    .getScriptProperties()\n    .getProperty(\"GEMINI_API_KEY\");\n\n  if (!apiKey) {\n    throw new Error(tPIH_(\"ig_sin_gemini\"));\n  }\n\n  if (\n    typeof asegurarColumnaPIH_ !== \"function\" ||\n    typeof obtenerIndiceCabecerasPIH_ !== \"function\" ||\n    typeof normalizarTextoPIH_ !== \"function\" ||\n    typeof canonicoListaPIH_ !== \"function\"\n  ) {\n    throw new Error(\n      \"Falta InterfazDoctorado.gs v4 en el proyecto.\"\n    );\n  }\n\n  // Asegurar la columna de confianza (se añade al final si no existe).\n  const cabeceras = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0]\n    .map(String);\n\n  asegurarColumnaPIH_(hoja, cabeceras, \"CONFIANZA_ANALISIS\");\n\n  SpreadsheetApp.flush();\n\n  const datos = hoja.getDataRange().getValues();\n  const col = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  const necesarias = [\n    \"TITULO\",\n    \"AUTORES\",\n    \"ANO\",\n    \"ABSTRACT_ORIGINAL\",\n    \"RESUMEN_IA\",\n    \"TEMATICA_PRINCIPAL\",\n    \"TEMATICAS_SECUNDARIAS\",\n    \"RELEVANCIA_0_5\",\n    \"JUSTIFICACION_RELEVANCIA\",\n    \"VINCULO_TESIS\",\n    \"NIVEL_ANALISIS_IA\",\n    \"CONFIANZA_ANALISIS\"\n  ];\n\n  necesarias.forEach(nombre => {\n    if (col[nombre] === undefined) {\n      throw new Error(\"Falta la columna: \" + nombre);\n    }\n  });\n\n  const tematicasIniciales = tematicasInicialesPIH_()\n    .map(normalizarTextoPIH_);\n\n  // Buscar publicaciones pendientes.\n  const pendientes = [];\n  let totalPendientes = 0;\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n\n    const titulo = fila[col.TITULO];\n    const resumen = fila[col.RESUMEN_IA];\n    const relevancia = String(fila[col.RELEVANCIA_0_5]).trim();\n\n    const estado = col.ESTADO_LECTURA === undefined\n      ? \"\"\n      : normalizarTextoPIH_(fila[col.ESTADO_LECTURA]);\n\n    if (!titulo || resumen || relevancia !== \"\") continue;\n\n    // No gastar cuota en publicaciones que ya has descartado.\n    if (estado === \"descartado\") continue;\n\n    // Saltar las que ya han fallado demasiadas veces por su contenido.\n    const coincidencia = String(fila[col.NIVEL_ANALISIS_IA] || \"\")\n      .match(/^Error IA \\((\\d+)\\)/);\n\n    const intentos = coincidencia ? Number(coincidencia[1]) : 0;\n\n    if (intentos >= PIH_MAX_INTENTOS) continue;\n\n    totalPendientes++;\n\n    if (pendientes.length >= tamano) continue;\n\n    const temaActual = String(fila[col.TEMATICA_PRINCIPAL] || \"\").trim();\n\n    const temaEditado =\n      temaActual !== \"\" &&\n      tematicasIniciales.indexOf(normalizarTextoPIH_(temaActual)) === -1;\n\n    pendientes.push({\n      numeroFila: i + 1,\n      titulo: titulo,\n      autores: fila[col.AUTORES],\n      ano: fila[col.ANO],\n      abstract: String(fila[col.ABSTRACT_ORIGINAL] || \"\").trim(),\n      tipo: col.TIPO_DOCUMENTO === undefined\n        ? \"\" : fila[col.TIPO_DOCUMENTO],\n      revista: col.REVISTA_EDITORIAL === undefined\n        ? \"\" : fila[col.REVISTA_EDITORIAL],\n      fecha: col.FECHA_PUBLICACION === undefined\n        ? \"\" : fila[col.FECHA_PUBLICACION],\n      idioma: col.IDIOMA === undefined\n        ? \"\" : fila[col.IDIOMA],\n      temaEditado: temaEditado ? temaActual : \"\",\n      intentos: intentos\n    });\n  }\n\n  if (pendientes.length === 0) {\n    return vacio;\n  }\n\n  let procesadas = 0;\n  let motivoParada = \"\";\n  let transitoriosSeguidos = 0;\n  const errores = [];\n\n  // Una sola llamada a Gemini para todo el lote. Si falla por el servicio\n  // (cuota, 503...), se detiene la pasada. Si falla por el contenido, o\n  // faltan elementos en la respuesta, se reintentan una a una.\n  let resultadosLote = null;\n\n  if (!PIH_FECHA_LIMITE || Date.now() < PIH_FECHA_LIMITE) {\n    try {\n      resultadosLote = analizarLoteGemini_(pendientes, apiKey);\n    } catch (e) {\n\n      const tipoLote = tipoErrorPIH_(e);\n\n      if (tipoLote !== \"contenido\") {\n        return {\n          seleccionadas: pendientes.length,\n          procesadas: 0,\n          errores: [\"Lote: \" + e.message],\n          motivoParada: tipoLote,\n          restantes: totalPendientes\n        };\n      }\n\n      errores.push(\"Lote (se reintenta una a una): \" + e.message);\n    }\n  }\n\n  for (let k = 0; k < pendientes.length; k++) {\n\n    const publicacion = pendientes[k];\n\n    // Si se acaba el tiempo de esta pasada, se detiene aquí mismo.\n    if (PIH_FECHA_LIMITE && Date.now() > PIH_FECHA_LIMITE) break;\n\n    try {\n\n      let analisis;\n\n      if (resultadosLote && resultadosLote[k] && resultadosLote[k].ok) {\n        analisis = resultadosLote[k].analisis;\n      } else {\n        // Plan B: esta publicación sola.\n        analisis = analizarPublicacionGemini_(publicacion, apiKey);\n        Utilities.sleep(PIH_PAUSA_ENTRE_PETICIONES_MS);\n      }\n\n      guardarAnalisisPIH_(hoja, col, publicacion, analisis);\n\n      SpreadsheetApp.flush();\n\n      procesadas++;\n      transitoriosSeguidos = 0;\n\n    } catch (e) {\n\n      errores.push(publicacion.titulo + \": \" + e.message);\n\n      const tipo = tipoErrorPIH_(e);\n\n      if (tipo === \"contenido\") {\n        // Falla por esta publicación: se marca y se sigue con la siguiente.\n        hoja.getRange(\n          publicacion.numeroFila,\n          col.NIVEL_ANALISIS_IA + 1\n        ).setValue(\"Error IA (\" + (publicacion.intentos + 1) + \")\");\n\n        continue;\n      }\n\n      // Error temporal: se salta esta publicación (sin marcarla como\n      // fallida) y se sigue con la siguiente. Si fallan 3 seguidas, Gemini\n      // está saturado y se detiene el lote.\n      if (tipo === \"transitorio\") {\n        transitoriosSeguidos++;\n\n        if (transitoriosSeguidos < 3) continue;\n      }\n\n      // Cuota, error de configuración o Gemini saturado: se detiene el lote.\n      motivoParada = tipo;\n      break;\n    }\n  }\n\n  return {\n    seleccionadas: pendientes.length,\n    procesadas: procesadas,\n    errores: errores,\n    motivoParada: motivoParada,\n    restantes: Math.max(totalPendientes - procesadas, 0)\n  };\n}\n\n\n// =====================================================\n// RECALIBRAR PUNTUACIONES (tras cambiar el criterio de la IA)\n// =====================================================\n\n/**\n * Borra el análisis de IA de las publicaciones que aún no has trabajado\n * (ESTADO vacío o \"Pendiente\") para que el clasificador las vuelva a\n * puntuar con el criterio actual. NO toca las que estén Para leer,\n * Leído o Descartado. Usa cuota gratuita de Gemini y se\n * reanuda sola si se agota.\n *\n * Aviso: si habías cambiado a mano la RELEVANCIA de alguna publicación\n * que sigue en \"Pendiente\", esa puntuación también se recalculará.\n * Cámbiale el ESTADO (p. ej. a \"Para leer\") para protegerla.\n */\nfunction recalibrarPuntuacionesPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n\n  const respuesta = ui.alert(\n    tPIH_(\"ig_recal_titulo\"),\n    tPIH_(\"ig_recal_texto\"),\n    ui.ButtonSet.YES_NO\n  );\n\n  if (respuesta !== ui.Button.YES) return;\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    avisarPIH_(tPIH_(\"c_ocupado\"), 8);\n    return;\n  }\n\n  try {\n\n    const hoja = SpreadsheetApp.getActiveSpreadsheet()\n      .getSheetByName(\"PUBLICACIONES\");\n\n    if (!hoja || hoja.getLastRow() < 2) {\n      avisarPIH_(tPIH_(\"ig_recal_nada\"), 6);\n      return;\n    }\n\n    const datos = hoja.getDataRange().getValues();\n    const col = obtenerIndiceCabecerasPIH_(datos[0]);\n\n    const columnas = [\n      \"RESUMEN_IA\", \"RELEVANCIA_0_5\", \"JUSTIFICACION_RELEVANCIA\",\n      \"VINCULO_TESIS\", \"NIVEL_ANALISIS_IA\", \"CONFIANZA_ANALISIS\"\n    ];\n\n    columnas.concat([\"TITULO\"]).forEach(nombre => {\n      if (col[nombre] === undefined) {\n        throw new Error(\"Falta la columna: \" + nombre);\n      }\n    });\n\n    const filas = [];\n\n    for (let i = 1; i < datos.length; i++) {\n\n      const fila = datos[i];\n\n      if (!fila[col.TITULO]) continue;\n      if (String(fila[col.RELEVANCIA_0_5]).trim() === \"\") continue;\n\n      const estado = col.ESTADO_LECTURA === undefined\n        ? \"\"\n        : normalizarTextoPIH_(fila[col.ESTADO_LECTURA]);\n\n      if (estado !== \"\" && estado !== \"pendiente\") continue;\n\n      filas.push(i);\n    }\n\n    if (!filas.length) {\n      avisarPIH_(tPIH_(\"ig_recal_sin_pend\"), 6);\n      return;\n    }\n\n    columnas.forEach(nombre => {\n\n      const c = col[nombre];\n      const rango = hoja.getRange(2, c + 1, datos.length - 1, 1);\n      const valores = rango.getValues();\n\n      filas.forEach(i => { valores[i - 1][0] = \"\"; });\n\n      rango.setValues(valores);\n    });\n\n    SpreadsheetApp.flush();\n\n    registrarLogPIH_(\n      \"RECALIBRAR_PUNTUACIONES\", \"PREPARADO\", filas.length,\n      \"Análisis borrado para volver a puntuar con el criterio nuevo.\"\n    );\n\n    avisarPIH_(tPIH_(\"ig_recal_listas\", filas.length), 12);\n\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\n// =====================================================\n// GUARDAR RESULTADOS Y GESTIÓN DE ERRORES\n// =====================================================\n\n/**\n * Guarda el análisis en PUBLICACIONES sin tocar ESTADO ni MENDELEY.\n */\nfunction guardarAnalisisPIH_(hoja, col, publicacion, analisis) {\n\n  const fila = publicacion.numeroFila;\n\n  const escribir = (nombre, valor) => {\n    hoja.getRange(fila, col[nombre] + 1).setValue(valor);\n  };\n\n  const secundarias = analisis.tematicas_secundarias.slice();\n\n  if (publicacion.temaEditado) {\n    // La temática la has cambiado tú: se respeta.\n    secundarias.unshift(\n      \"Sugerida por IA: \" + analisis.tematica_principal\n    );\n  } else {\n    escribir(\"TEMATICA_PRINCIPAL\", analisis.tematica_principal);\n  }\n\n  escribir(\"RESUMEN_IA\", analisis.resumen);\n  escribir(\"TEMATICAS_SECUNDARIAS\", secundarias.join(\"; \"));\n  escribir(\"RELEVANCIA_0_5\", analisis.relevancia);\n  escribir(\"JUSTIFICACION_RELEVANCIA\", analisis.justificacion);\n  escribir(\"VINCULO_TESIS\", analisis.vinculo_tesis);\n  escribir(\"CONFIANZA_ANALISIS\", analisis.confianza);\n\n  escribir(\n    \"NIVEL_ANALISIS_IA\",\n    publicacion.abstract\n      ? \"IA · Metadatos y abstract\"\n      : \"IA · Solo metadatos\"\n  );\n}\n\n\n/**\n * Clasifica un error:\n *  - \"cuota\": se ha agotado el límite gratuito.\n *  - \"configuracion\": clave o petición no válidas.\n *  - \"transitorio\": fallo temporal del servicio o de la red.\n *  - \"contenido\": problema con esta publicación concreta.\n */\nfunction tipoErrorPIH_(e) {\n\n  const mensaje = String(e && e.message ? e.message : e);\n\n  const http = mensaje.match(/Gemini HTTP (\\d{3})/);\n\n  if (http) {\n    const codigo = Number(http[1]);\n\n    if (codigo === 429) return \"cuota\";\n    if ([400, 401, 403, 404].indexOf(codigo) !== -1) return \"configuracion\";\n    if (codigo >= 500) return \"transitorio\";\n\n    return \"contenido\";\n  }\n\n  if (mensaje.includes(\"RESOURCE_EXHAUSTED\")) return \"cuota\";\n\n  if (/Exception|timed out|timeout|DNS|unavailable/i.test(mensaje)) {\n    return \"transitorio\";\n  }\n\n  return \"contenido\";\n}\n\n\n/**\n * Ajusta la confianza para no sobreinterpretar.\n */\nfunction normalizarConfianzaPIH_(valor, abstract) {\n\n  if (!abstract) return \"Baja\";\n\n  const confianza =\n    canonicoListaPIH_(valor, [\"Alta\", \"Media\", \"Baja\"]) || \"Baja\";\n\n  // Un abstract muy corto no permite una confianza alta.\n  if (abstract.length < 400 && confianza === \"Alta\") {\n    return \"Media\";\n  }\n\n  return confianza;\n}\n\n\n// =====================================================\n// ANÁLISIS CON GEMINI\n// =====================================================\n\n/**\n * Texto fijo del prompt: contexto de la tesis y criterios de puntuación.\n */\nfunction contextoTesisPIH_() {\n\n  const disciplina = textoPerfilPIH_(\"disciplina\", \"la disciplina de la tesis\");\n  const contexto = textoPerfilPIH_(\"contexto_tesis\", \"\");\n  const rasgos = listaPerfilPIH_(\"rasgos_casos\", []);\n  const idioma = textoPerfilPIH_(\"idioma_local\", \"español\");\n\n  if (!contexto) {\n    throw new Error(tPIH_(\"c_falta_tesis\"));\n  }\n\n  let texto = `\nActúa como investigador académico especializado en ${disciplina}.\n\nCONTEXTO DE LA TESIS (propuesta de doctorado real del investigador):\n\n${contexto}\n`;\n\n  if (rasgos.length) {\n    texto += `\nRASGOS DE LOS CASOS O INSTITUCIONES (úsalos para detectar relevancia\naunque el texto no los nombre):\n\n${rasgos.map(r => \"- \" + r).join(\"\\n\")}\n`;\n  }\n\n  texto += `\nLa bibliografía de partida puede estar en inglés y en ${idioma}: el idioma\nNO penaliza la relevancia.\n`;\n\n  return texto;\n}\n\n\nfunction instruccionesPIH_() {\n  return `\nINSTRUCCIONES:\n\n1. Evalúa la relación real con la investigación doctoral.\n2. No exijas que se nombren los casos concretos de la tesis: también son\n   relevantes los marcos teóricos, los modelos comparativos, las\n   metodologías y los estudios de otros casos que ayuden a analizar la\n   pregunta central.\n3. No confundas coincidencia de palabras con relevancia científica.\n4. Valora la aportación teórica, metodológica y empírica, y en la\n   justificación indica cuál predomina (teórica, metodológica,\n   empírica, mixta o no determinable).\n5. Asigna una puntuación ENTERA de 0 a 5 con esta escala:\n   5 = trata directamente la pregunta central de la tesis, o aporta un\n       marco teórico o metodológico central para ella;\n   4 = muy relacionada con uno de los ejes de la tesis, pero sin abordar\n       directamente la pregunta central, o es un caso próximo muy útil\n       por comparación;\n   3 = utilidad parcial o indirecta (contexto, otros sectores, ideas\n       transferibles);\n   1-2 = relación débil o solo coincidencia de temas;\n   0 = ausencia de relación significativa.\n   Usa 5 solo cuando el texto lo justifique de forma clara; no infles la\n   puntuación por prudencia ni la rebajes por ser un libro, un informe o\n   estar en español o catalán.\n6. No inventes resultados, métodos ni conclusiones que no aparezcan\n   en los datos proporcionados.\n7. Si no hay abstract o es insuficiente, dilo claramente en la\n   justificación, sé prudente con la puntuación y marca la confianza\n   como \"Baja\".\n8. La confianza (Alta, Media o Baja) indica cuánta información real\n   hay para valorar la publicación; no es lo mismo que la relevancia.\n9. Distingue entre información explícita e inferencias.\n10. Explica la posible utilidad para la tesis (y, si hay varios casos, para compararlos).\n11. Escribe en ${nombreIdiomaIAPIH_()}.\n`;\n}\n\n\n// Datos de una publicación tal y como se los enseñamos a Gemini.\nfunction bloquePublicacionPIH_(p, maxAbstract) {\n  return [\n    \"Título: \" + p.titulo,\n    \"Autores: \" + (p.autores || \"No disponibles\"),\n    \"Año: \" + (p.ano || \"No disponible\"),\n    \"Fecha de publicación: \" + (p.fecha || \"No disponible\"),\n    \"Revista o editorial: \" + (p.revista || \"No disponible\"),\n    \"Tipo de documento: \" + (p.tipo || \"No disponible\"),\n    \"Idioma: \" + (p.idioma || \"No disponible\"),\n    \"Abstract: \" + (p.abstract || \"No disponible\").substring(0, maxAbstract)\n  ].join(\"\\n\");\n}\n\n\nconst PIH_ESQUEMA_ANALISIS =\n  '\"relevancia\": 0,\\n' +\n  '  \"tematica_principal\": \"Una temática\",\\n' +\n  '  \"tematicas_secundarias\": [\"Tema 1\", \"Tema 2\"],\\n' +\n  '  \"resumen\": \"Resumen académico de máximo 90 palabras. La PRIMERA frase ' +\n  'debe ser la idea principal (qué sostiene, demuestra o propone el texto), ' +\n  'breve y autónoma.\",\\n' +\n  '  \"justificacion\": \"Justificación de la puntuación.\",\\n' +\n  '  \"vinculo_tesis\": \"Relación con la investigación doctoral.\",\\n' +\n  '  \"confianza\": \"Alta, Media o Baja\"';\n\n\n/**\n * Analiza UNA publicación con Gemini (se usa como plan B del lote).\n */\nfunction analizarPublicacionGemini_(p, apiKey) {\n\n  const prompt =\n    contextoTesisPIH_() +\n    \"\\nPUBLICACIÓN:\\n\\n\" +\n    bloquePublicacionPIH_(p, 7000) +\n    \"\\n\\n\" +\n    instruccionesPIH_() +\n    \"\\nDevuelve exclusivamente JSON válido:\\n\\n{\\n  \" +\n    PIH_ESQUEMA_ANALISIS +\n    \"\\n}\\n\";\n\n  const resultado = llamarGeminiPIH_(prompt, apiKey, 2000);\n\n  return validarAnalisisPIH_(resultado, p);\n}\n\n\n/**\n * Analiza VARIAS publicaciones en una sola llamada a Gemini (mucho más\n * rápido que una llamada por publicación). Devuelve una lista del mismo\n * tamaño que \"lista\": cada elemento es { ok: true, analisis } o\n * { ok: false, error }. Los fallos de servicio (cuota, 503...) se lanzan\n * como error; los problemas de contenido se marcan por publicación para\n * que se reintenten una a una.\n */\nfunction analizarLoteGemini_(lista, apiKey) {\n\n  const bloques = lista.map((p, i) =>\n    \"PUBLICACIÓN \" + (i + 1) + \":\\n\" + bloquePublicacionPIH_(p, 3000)\n  ).join(\"\\n\\n\");\n\n  const prompt =\n    contextoTesisPIH_() +\n    \"\\nSe te dan \" + lista.length + \" publicaciones. Evalúa cada una de \" +\n    \"forma INDEPENDIENTE, sin compararlas entre sí.\\n\\n\" +\n    bloques +\n    \"\\n\\n\" +\n    instruccionesPIH_() +\n    \"\\nDevuelve exclusivamente un JSON válido: una lista con \" +\n    lista.length + \" objetos, uno por publicación y en el mismo orden. \" +\n    \"Cada objeto lleva además el campo \\\"n\\\" con el número de la \" +\n    \"publicación (1, 2, 3...):\\n\\n[\\n  {\\n  \\\"n\\\": 1,\\n  \" +\n    PIH_ESQUEMA_ANALISIS +\n    \"\\n  }\\n]\\n\";\n\n  const resultado = llamarGeminiPIH_(prompt, apiKey, 8000);\n\n  const elementos = Array.isArray(resultado)\n    ? resultado\n    : (resultado && Array.isArray(resultado.resultados)\n        ? resultado.resultados : []);\n\n  return lista.map((p, i) => {\n\n    const elemento = elementos.find(x => x && Number(x.n) === i + 1) ||\n      (elementos.length === lista.length ? elementos[i] : null);\n\n    if (!elemento) {\n      return { ok: false, error: \"Falta en la respuesta del lote.\" };\n    }\n\n    try {\n      return { ok: true, analisis: validarAnalisisPIH_(elemento, p) };\n    } catch (e) {\n      return { ok: false, error: e.message };\n    }\n  });\n}\n\n\n/**\n * Llamada a Gemini con reintentos ante errores temporales (500/503).\n * Devuelve el JSON ya interpretado.\n */\nfunction llamarGeminiPIH_(prompt, apiKey, maxTokens) {\n\n  const url =\n    \"https://generativelanguage.googleapis.com/v1beta/models/\" +\n    PIH_GEMINI_MODEL +\n    \":generateContent\";\n\n  const cuerpo = JSON.stringify({\n\n    contents: [{\n      parts: [{\n        text: prompt\n      }]\n    }],\n\n    generationConfig: {\n      temperature: 0.2,\n      maxOutputTokens: maxTokens,\n      responseMimeType: \"application/json\"\n    }\n\n  });\n\n  let respuesta;\n\n  // Hasta 4 intentos ante errores temporales del servidor (500/503),\n  // esperando cada vez más: 5, 15 y 30 segundos.\n  const esperas = [5000, 15000, 30000];\n\n  for (let intento = 1; intento <= 4; intento++) {\n\n    respuesta = UrlFetchApp.fetch(url, {\n      method: \"post\",\n      contentType: \"application/json\",\n      headers: {\n        \"x-goog-api-key\": apiKey\n      },\n      payload: cuerpo,\n      muteHttpExceptions: true\n    });\n\n    const codigoIntento = respuesta.getResponseCode();\n\n    if (codigoIntento !== 500 && codigoIntento !== 503) break;\n\n    if (intento > esperas.length) break;\n\n    // Si ya casi se ha agotado el tiempo de la pasada, no se espera más:\n    // se deja el error temporal y se reintentará en la siguiente ejecución.\n    if (\n      PIH_FECHA_LIMITE &&\n      Date.now() + esperas[intento - 1] > PIH_FECHA_LIMITE + 30000\n    ) break;\n\n    Utilities.sleep(esperas[intento - 1]);\n  }\n\n  const codigo = respuesta.getResponseCode();\n  const contenido = respuesta.getContentText();\n\n  if (codigo !== 200) {\n    throw new Error(\n      \"Gemini HTTP \" + codigo + \": \" +\n      contenido.substring(0, 600)\n    );\n  }\n\n  const respuestaJSON = JSON.parse(contenido);\n\n  if (\n    !respuestaJSON.candidates ||\n    !respuestaJSON.candidates[0] ||\n    !respuestaJSON.candidates[0].content ||\n    !respuestaJSON.candidates[0].content.parts\n  ) {\n    throw new Error(\n      \"Gemini no ha devuelto una respuesta válida.\"\n    );\n  }\n\n  const texto = respuestaJSON.candidates[0]\n    .content.parts\n    .map(parte => parte.text || \"\")\n    .join(\"\")\n    .replace(/```json|```/g, \"\")\n    .trim();\n\n  try {\n    return JSON.parse(texto);\n  } catch (error) {\n    throw new Error(\"Gemini ha devuelto un JSON no válido.\");\n  }\n}\n\n\n/**\n * Comprueba y normaliza el análisis de UNA publicación.\n */\nfunction validarAnalisisPIH_(resultado, p) {\n\n  const puntuacion = Number(resultado.relevancia);\n\n  if (\n    !Number.isInteger(puntuacion) ||\n    puntuacion < 0 ||\n    puntuacion > 5\n  ) {\n    throw new Error(\n      \"La puntuación de relevancia no es válida.\"\n    );\n  }\n\n  return {\n\n    relevancia: puntuacion,\n\n    tematica_principal:\n      resultado.tematica_principal || \"Sin clasificar\",\n\n    tematicas_secundarias:\n      Array.isArray(resultado.tematicas_secundarias)\n        ? resultado.tematicas_secundarias\n        : [],\n\n    resumen: resultado.resumen || \"\",\n\n    justificacion: resultado.justificacion || \"\",\n\n    vinculo_tesis: resultado.vinculo_tesis || \"\",\n\n    confianza: normalizarConfianzaPIH_(\n      resultado.confianza,\n      p.abstract\n    )\n\n  };\n}\n"}, {"name": "InterfazDoctorado", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * INTERFAZ DOCTORADO v5\n *\n * - PUBLICACIONES es la base de datos principal (fuente de verdad).\n * - RADAR es una vista simplificada y parcialmente editable,\n *   ordenada por relevancia (de mayor a menor).\n * - Las ediciones de RADAR se sincronizan con PUBLICACIONES al instante.\n * - Los desplegables, filtros y formatos de RADAR se conservan al actualizar.\n * - Cada publicación se identifica por la columna ID de PUBLICACIONES.\n *   Si la columna oculta de RADAR no tiene el ID, la sincronización\n *   localiza la publicación por su título y repara el ID por sí sola.\n *\n * Novedades de la v5 (visual):\n *   - RADAR con colores: relevancia, confianza, estado, Mendeley y origen.\n *   - Las publicaciones descartadas se ven tachadas y en gris.\n *   - Las de relevancia 4-5 pendientes de leer se destacan en negrita.\n *   - PANEL con dos gráficos (relevancia y estado de lectura).\n *   - Pestañas con color y sin cuadrícula.\n *\n * Novedades de la v4:\n *   - Columnas nuevas en RADAR: CONFIANZA y ORIGEN.\n *   - PANEL con más indicadores (pendientes de clasificar, origen).\n *   - Los indicadores se calculan sobre toda la base PUBLICACIONES.\n *\n * Coste: 0 €. Solo usa Google Sheets y Apps Script (sin APIs externas).\n *\n * Funciones que puedes ejecutar a mano:\n *   - crearInterfazDoctorado()          -> crea/actualiza PANEL y RADAR\n *   - actualizarInterfazDoctorado()     -> igual que la anterior\n *   - configurarSincronizacionRadar()   -> crea el activador \"Al editarse\"\n *   - diagnosticarRadarDoctorado()      -> comprueba que todo está en orden\n */\n\n// =====================================================\n// CONFIGURACIÓN\n// =====================================================\n\nconst PIH_RADAR_CONFIG = {\n  hojaDatos: \"PUBLICACIONES\",\n  hojaRadar: \"RADAR\",\n  hojaPanel: \"PANEL\",\n\n  columnas: [\n    \"PUBLICACIÓN\",\n    \"AUTORES\",\n    \"AÑO\",\n    \"REVISTA\",\n    \"TEMÁTICA\",\n    \"RELEVANCIA\",\n    \"CONFIANZA\",\n    \"RESUMEN\",\n    \"ESTADO\",\n    \"EN MI GESTOR\",\n    \"ORIGEN\",\n    \"ENLACE\",\n    \"ID_INTERNO\"\n  ],\n\n  // Posición (empezando en 1) de cada columna de RADAR.\n  col: {\n    PUBLICACION: 1,\n    AUTORES: 2,\n    ANO: 3,\n    REVISTA: 4,\n    TEMATICA: 5,\n    RELEVANCIA: 6,\n    CONFIANZA: 7,\n    RESUMEN: 8,\n    ESTADO: 9,\n    MENDELEY: 10,\n    ORIGEN: 11,\n    ENLACE: 12,\n    ID: 13\n  },\n\n  numeroColumnasVisibles: 12,\n  columnaIdRadar: 13,\n  columnaTituloRadar: 1,\n\n  // Columnas de RADAR que se pueden editar -> columna de PUBLICACIONES.\n  sincronizacion: {\n    5: \"TEMATICA_PRINCIPAL\",\n    6: \"RELEVANCIA_0_5\",\n    8: \"RESUMEN_IA\",\n    9: \"ESTADO_LECTURA\",\n    10: \"INCORPORADO_MENDELEY\"\n  },\n\n  // Valores de los desplegables.\n  estados: [\"Pendiente\", \"Para leer\", \"Leído\", \"Descartado\"],\n  mendeley: [\"Sí\", \"No\"],\n  relevanciaMin: 0,\n  relevanciaMax: 5,\n\n  // RADAR muestra las publicaciones con relevancia igual o superior a este\n  // valor (las que aún no tienen puntuación se muestran siempre).\n  // 0 = mostrar todas. 3 = oculta las de relevancia 0, 1 y 2 (siguen\n  // guardadas en PUBLICACIONES). Se puede subir a 4 cuando crezca el\n  // histórico.\n  relevanciaMinimaRadar: 3,\n\n  // Valores de la columna ORIGEN en PUBLICACIONES.\n  origenDiario: \"Novedad diaria\",\n  origenHistorico: \"Histórico\"\n};\n\n\n// =====================================================\n// UTILIDADES\n// =====================================================\n\nfunction normalizarCabeceraPIH_(texto) {\n  return String(texto || \"\")\n    .trim()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .replace(/\\s+/g, \"_\")\n    .toUpperCase();\n}\n\n\n// Valor de un registro para una cabecera de la hoja. Tolera «AÑO» (con Ñ)\n// frente a la clave interna «ANO», y mayúsculas/tildes en general.\nfunction valorRegistroPIH_(registro, cabecera) {\n  if (registro[cabecera] !== undefined) return registro[cabecera];\n  const n = normalizarCabeceraPIH_(cabecera);\n  return registro[n] !== undefined ? registro[n] : \"\";\n}\n\n\n// Rellena AÑO en las filas de PUBLICACIONES que lo tengan vacío, sacándolo\n// de FECHA_PUBLICACION (por un fallo anterior, las filas «Histórico» y de\n// «Fuente abierta» se guardaron sin año). Devuelve cuántas ha reparado.\nfunction repararAniosPIH_(hoja) {\n\n  if (!hoja || hoja.getLastRow() < 2) return 0;\n\n  const cab = hoja.getRange(1, 1, 1, hoja.getLastColumn()).getValues()[0]\n    .map(normalizarCabeceraPIH_);\n\n  const cAno = cab.indexOf(\"ANO\");\n  const cFecha = cab.indexOf(\"FECHA_PUBLICACION\");\n  if (cAno < 0 || cFecha < 0) return 0;\n\n  const n = hoja.getLastRow() - 1;\n  const rango = hoja.getRange(2, Math.min(cAno, cFecha) + 1, n,\n    Math.abs(cFecha - cAno) + 1);\n  const v = rango.getValues();\n  const iAno = cAno - Math.min(cAno, cFecha);\n  const iFecha = cFecha - Math.min(cAno, cFecha);\n\n  let reparadas = 0;\n\n  v.forEach(fila => {\n    if (String(fila[iAno]).trim() !== \"\") return;\n    const f = fila[iFecha];\n    let anio = \"\";\n    if (f instanceof Date) anio = f.getFullYear();\n    else {\n      const m = String(f).match(/(19|20)\\d{2}/);\n      if (m) anio = Number(m[0]);\n    }\n    if (anio) { fila[iAno] = anio; reparadas++; }\n  });\n\n  if (reparadas) rango.setValues(v);\n  return reparadas;\n}\n\n\n// Ejecútala a mano si quieres reparar los años ahora.\nfunction repararAniosPublicacionesPIH() {\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(PIH_RADAR_CONFIG.hojaDatos);\n  const n = repararAniosPIH_(hoja);\n  try {\n    SpreadsheetApp.getActiveSpreadsheet()\n      .toast(n + \" año(s) reparado(s).\", \"PIH\", 6);\n  } catch (e) {}\n}\n\n\nfunction normalizarTextoPIH_(texto) {\n  return String(texto === null || texto === undefined ? \"\" : texto)\n    .trim()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .toLowerCase();\n}\n\n\nfunction obtenerIndiceCabecerasPIH_(cabeceras) {\n  const indice = {};\n\n  cabeceras.forEach((cabecera, posicion) => {\n    indice[normalizarCabeceraPIH_(cabecera)] = posicion;\n  });\n\n  return indice;\n}\n\n\nfunction obtenerValorPIH_(fila, indice, nombre) {\n  const posicion = indice[normalizarCabeceraPIH_(nombre)];\n\n  return posicion === undefined ? \"\" : fila[posicion];\n}\n\n\n// Devuelve el valor de la lista que coincide sin importar\n// mayúsculas ni tildes (\"para leer\" -> \"Para leer\").\nfunction canonicoListaPIH_(valor, lista) {\n  const clave = normalizarTextoPIH_(valor);\n\n  for (let i = 0; i < lista.length; i++) {\n    if (normalizarTextoPIH_(lista[i]) === clave) {\n      return lista[i];\n    }\n  }\n\n  return null;\n}\n\n\n// Aviso en pantalla que no falla cuando el script corre sin interfaz\n// (por ejemplo, desde un activador automático).\nfunction avisarPIH_(mensaje, segundos) {\n  try {\n    SpreadsheetApp.getActiveSpreadsheet()\n      .toast(mensaje, \"PIH Doctorado\", segundos || 6);\n  } catch (e) {\n    console.log(mensaje);\n  }\n}\n\n\n// Asegura que existe una columna con ese nombre en PUBLICACIONES.\n// Si no existe, la añade al final y devuelve su posición (base 0).\nfunction asegurarColumnaPIH_(hoja, cabeceras, nombre) {\n  const indice = obtenerIndiceCabecerasPIH_(cabeceras);\n  const clave = normalizarCabeceraPIH_(nombre);\n\n  if (indice[clave] !== undefined) {\n    return indice[clave];\n  }\n\n  const posicion = cabeceras.length;\n\n  if (posicion + 1 > hoja.getMaxColumns()) {\n    hoja.insertColumnsAfter(hoja.getMaxColumns(), 1);\n  }\n\n  hoja.getRange(1, posicion + 1).setValue(nombre);\n\n  cabeceras.push(nombre);\n\n  return posicion;\n}\n\n\n// Asegura la columna ID y rellena solo los IDs que faltan.\nfunction asegurarColumnaIdPIH_(hoja, cabeceras) {\n  const posicionId = asegurarColumnaPIH_(hoja, cabeceras, \"ID\");\n\n  const ultimaFila = hoja.getLastRow();\n\n  if (ultimaFila < 2) {\n    return posicionId;\n  }\n\n  const numFilas = ultimaFila - 1;\n\n  const rango = hoja.getRange(2, posicionId + 1, numFilas, 1);\n  const ids = rango.getValues();\n\n  const posicionTitulo =\n    obtenerIndiceCabecerasPIH_(cabeceras).TITULO;\n\n  const titulos = posicionTitulo === undefined\n    ? null\n    : hoja.getRange(2, posicionTitulo + 1, numFilas, 1).getValues();\n\n  let cambios = false;\n\n  ids.forEach((fila, i) => {\n    const tieneContenido = !titulos || String(titulos[i][0]).trim() !== \"\";\n\n    if (!fila[0] && tieneContenido) {\n      fila[0] = Utilities.getUuid();\n      cambios = true;\n    }\n  });\n\n  if (cambios) {\n    rango.setValues(ids);\n  }\n\n  return posicionId;\n}\n\n\n// Al crear la columna ORIGEN, las publicaciones que ya existían\n// proceden del radar diario.\nfunction rellenarOrigenInicialPIH_(hoja, cabeceras, posicionOrigen) {\n\n  const ultimaFila = hoja.getLastRow();\n\n  if (ultimaFila < 2) return;\n\n  const posicionTitulo =\n    obtenerIndiceCabecerasPIH_(cabeceras).TITULO;\n\n  if (posicionTitulo === undefined) return;\n\n  const numFilas = ultimaFila - 1;\n\n  const titulos = hoja\n    .getRange(2, posicionTitulo + 1, numFilas, 1)\n    .getValues();\n\n  const origenes = titulos.map(fila => [\n    String(fila[0]).trim() !== \"\"\n      ? PIH_RADAR_CONFIG.origenDiario\n      : \"\"\n  ]);\n\n  hoja.getRange(2, posicionOrigen + 1, numFilas, 1)\n    .setValues(origenes);\n}\n\n\n// =====================================================\n// CREACIÓN Y ACTUALIZACIÓN DE LA INTERFAZ\n// =====================================================\n\nfunction crearInterfazDoctorado() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const cfg = PIH_RADAR_CONFIG;\n  const c = cfg.col;\n\n  const datos = ss.getSheetByName(cfg.hojaDatos);\n\n  if (!datos) {\n    throw new Error(tPIH_(\"ui_no_hoja\"));\n  }\n\n  if (datos.getLastRow() < 1 || datos.getLastColumn() < 1) {\n    throw new Error(\"PUBLICACIONES no contiene cabeceras.\");\n  }\n\n  const panel =\n    ss.getSheetByName(cfg.hojaPanel) ||\n    ss.insertSheet(cfg.hojaPanel);\n\n  const radar =\n    ss.getSheetByName(cfg.hojaRadar) ||\n    ss.insertSheet(cfg.hojaRadar);\n\n  // ---------------------------------------------------\n  // PUBLICACIONES: columnas necesarias e IDs\n  // ---------------------------------------------------\n\n  const cabeceras = datos\n    .getRange(1, 1, 1, datos.getLastColumn())\n    .getValues()[0]\n    .map(String);\n\n  asegurarColumnaIdPIH_(datos, cabeceras);\n  asegurarColumnaPIH_(datos, cabeceras, \"INCORPORADO_MENDELEY\");\n  asegurarColumnaPIH_(datos, cabeceras, \"CONFIANZA_ANALISIS\");\n\n  const origenExistia =\n    obtenerIndiceCabecerasPIH_(cabeceras).ORIGEN !== undefined;\n\n  const posicionOrigen =\n    asegurarColumnaPIH_(datos, cabeceras, \"ORIGEN\");\n\n  if (!origenExistia) {\n    rellenarOrigenInicialPIH_(datos, cabeceras, posicionOrigen);\n  }\n\n  try { repararAniosPIH_(datos); } catch (e) {\n    console.log(\"Reparar años: \" + e.message);\n  }\n\n  SpreadsheetApp.flush();\n\n  const valores = datos.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(valores[0]);\n  const posicionId = indice.ID;\n  const registros = valores.slice(1);\n\n  // Cada publicación necesita un ID único.\n  const idsVistos = {};\n\n  registros.forEach(fila => {\n    const id = String(fila[posicionId] || \"\");\n\n    if (!id) return;\n\n    if (idsVistos[id]) {\n      throw new Error(\n        \"Hay IDs repetidos en PUBLICACIONES (\" + id + \"). \" +\n        \"Cada publicación necesita un ID único.\"\n      );\n    }\n\n    idsVistos[id] = true;\n  });\n\n  // ---------------------------------------------------\n  // RADAR: filas a mostrar\n  // ---------------------------------------------------\n\n  const filasRadar = [];\n\n  registros.forEach(fila => {\n\n    const titulo = obtenerValorPIH_(fila, indice, \"TITULO\");\n\n    if (!titulo) return;\n\n    const relevancia = obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\");\n\n    if (\n      cfg.relevanciaMinimaRadar > 0 &&\n      String(relevancia).trim() !== \"\" &&\n      Number(relevancia) < cfg.relevanciaMinimaRadar\n    ) {\n      return;\n    }\n\n    filasRadar.push([\n      titulo,\n      obtenerValorPIH_(fila, indice, \"AUTORES\"),\n      obtenerValorPIH_(fila, indice, \"ANO\"),\n      obtenerValorPIH_(fila, indice, \"REVISTA_EDITORIAL\"),\n      obtenerValorPIH_(fila, indice, \"TEMATICA_PRINCIPAL\"),\n      relevancia,\n      obtenerValorPIH_(fila, indice, \"CONFIANZA_ANALISIS\"),\n      obtenerValorPIH_(fila, indice, \"RESUMEN_IA\"),\n      obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\"),\n      obtenerValorPIH_(fila, indice, \"INCORPORADO_MENDELEY\"),\n      obtenerValorPIH_(fila, indice, \"ORIGEN\"),\n      obtenerValorPIH_(fila, indice, \"URL\"),\n      String(fila[posicionId] || \"\")\n    ]);\n  });\n\n  // Orden: relevancia de mayor a menor (las no puntuadas, al final),\n  // después año más reciente y, por último, título.\n  const valorOrden = valor => {\n    if (String(valor).trim() === \"\") return -1;\n    const numero = Number(valor);\n    return isNaN(numero) ? -1 : numero;\n  };\n\n  filasRadar.sort((a, b) => {\n    const dif =\n      valorOrden(b[c.RELEVANCIA - 1]) - valorOrden(a[c.RELEVANCIA - 1]);\n\n    if (dif !== 0) return dif;\n\n    const anios =\n      (Number(b[c.ANO - 1]) || 0) - (Number(a[c.ANO - 1]) || 0);\n\n    if (anios !== 0) return anios;\n\n    return String(a[0]).localeCompare(String(b[0]));\n  });\n\n  // ---------------------------------------------------\n  // RADAR: tamaño de la hoja\n  // ---------------------------------------------------\n\n  const numColumnas = cfg.columnas.length;\n\n  // La cabecera de la columna del gestor sigue lo elegido en PERFIL\n  // («EN MENDELEY», «EN ZOTERO» o, sin gestor, «EN MI GESTOR»).\n  const columnasRadar = cfg.columnas.slice();\n  columnasRadar[c.MENDELEY - 1] = cabeceraGestorPIH_();\n\n  if (radar.getMaxColumns() < numColumnas) {\n    radar.insertColumnsAfter(\n      radar.getMaxColumns(),\n      numColumnas - radar.getMaxColumns()\n    );\n  }\n\n  if (radar.getMaxRows() < filasRadar.length + 2) {\n    radar.insertRowsAfter(\n      radar.getMaxRows(),\n      filasRadar.length + 2 - radar.getMaxRows()\n    );\n  }\n\n  // ---------------------------------------------------\n  // RADAR: guardar los criterios del filtro actual\n  // (solo si el diseño de columnas no ha cambiado)\n  // ---------------------------------------------------\n\n  const cabeceraAnterior = radar\n    .getRange(1, 1, 1, numColumnas)\n    .getValues()[0]\n    .map(String);\n\n  const mismoDiseno =\n    cabeceraAnterior.join(\"|\") === columnasRadar.join(\"|\");\n\n  const criteriosFiltro = {};\n  const filtroAnterior = radar.getFilter();\n\n  if (filtroAnterior) {\n    if (mismoDiseno) {\n      for (let k = 1; k <= cfg.numeroColumnasVisibles; k++) {\n        const criterio = filtroAnterior.getColumnFilterCriteria(k);\n\n        if (criterio) {\n          criteriosFiltro[k] = criterio;\n        }\n      }\n    }\n\n    filtroAnterior.remove();\n  }\n\n  // ---------------------------------------------------\n  // RADAR: escribir contenido (sin borrar formatos:\n  // solo se limpia el contenido)\n  // ---------------------------------------------------\n\n  // Mostrar todas las columnas y quitar validaciones antiguas, por si\n  // el diseño de columnas ha cambiado desde la versión anterior.\n  radar.showColumns(1, radar.getMaxColumns());\n\n  radar\n    .getRange(\n      2, 1,\n      Math.max(radar.getMaxRows() - 1, 1),\n      radar.getMaxColumns()\n    )\n    .clearDataValidations();\n\n  const ultimaFilaRadar = Math.max(\n    radar.getLastRow(),\n    filasRadar.length + 1,\n    2\n  );\n\n  radar.getRange(1, 1, 1, numColumnas)\n    .setValues([columnasRadar]);\n\n  radar.getRange(2, 1, ultimaFilaRadar - 1, numColumnas)\n    .clearContent();\n\n  if (filasRadar.length > 0) {\n\n    radar.getRange(2, 1, filasRadar.length, numColumnas)\n      .setValues(filasRadar);\n\n    // RESUMEN: la primera frase (la idea principal) en negrita.\n    const negrita = SpreadsheetApp.newTextStyle().setBold(true).build();\n\n    const resumenesRicos = filasRadar.map(f => {\n      const texto = String(f[c.RESUMEN - 1] || \"\");\n      const constructor = SpreadsheetApp.newRichTextValue().setText(texto);\n      const primera = texto.match(/^.+?[.!?](?=\\s|$)/);\n\n      if (primera && primera[0].length < texto.length) {\n        constructor.setTextStyle(0, primera[0].length, negrita);\n      }\n\n      return [constructor.build()];\n    });\n\n    radar.getRange(2, c.RESUMEN, filasRadar.length, 1)\n      .setRichTextValues(resumenesRicos);\n\n    radar.getRange(2, 1, filasRadar.length, cfg.numeroColumnasVisibles)\n      .setVerticalAlignment(\"top\")\n      .setWrap(true);\n\n    radar.setRowHeights(2, filasRadar.length, 48);\n  }\n\n  radar.setFrozenRows(1);\n  radar.setRowHeight(1, 38);\n\n  radar.getRange(1, 1, 1, numColumnas)\n    .setBackground(\"#24445C\")\n    .setFontColor(\"#FFFFFF\")\n    .setFontWeight(\"bold\")\n    .setWrap(false);\n\n  radar.setColumnWidth(c.PUBLICACION, 340);\n  radar.setColumnWidth(c.AUTORES, 190);\n  radar.setColumnWidth(c.ANO, 65);\n  radar.setColumnWidth(c.REVISTA, 180);\n  radar.setColumnWidth(c.TEMATICA, 190);\n  radar.setColumnWidth(c.RELEVANCIA, 85);\n  radar.setColumnWidth(c.CONFIANZA, 90);\n  radar.setColumnWidth(c.RESUMEN, 350);\n  radar.setColumnWidth(c.ESTADO, 120);\n  radar.setColumnWidth(c.MENDELEY, 100);\n  radar.setColumnWidth(c.ORIGEN, 130);\n  radar.setColumnWidth(c.ENLACE, 240);\n\n  // Cabeceras siempre en una sola línea (ensancha lo que haga falta).\n  try { ajustarCabecerasUnaLineaPIH(); } catch (e) {\n    console.log(\"Cabeceras: \" + e.message);\n  }\n\n  // La última columna contiene el identificador interno.\n  radar.hideColumns(cfg.columnaIdRadar);\n\n  // ---------------------------------------------------\n  // RADAR: desplegables, filtro y protecciones\n  // ---------------------------------------------------\n\n  aplicarValidacionesRadarPIH_(radar);\n  aplicarFormatoVisualRadarPIH_(radar);\n\n  const filtroNuevo = radar\n    .getRange(\n      1, 1,\n      Math.max(2, filasRadar.length + 1),\n      cfg.numeroColumnasVisibles\n    )\n    .createFilter();\n\n  Object.keys(criteriosFiltro).forEach(columna => {\n    filtroNuevo.setColumnFilterCriteria(\n      Number(columna),\n      criteriosFiltro[columna]\n    );\n  });\n\n  aplicarProteccionesPIH_(radar, datos);\n\n  // ---------------------------------------------------\n  // PANEL\n  // ---------------------------------------------------\n\n  construirPanelDoctorado_(panel);\n\n  try {\n    aplicarPanelIdiomaPIH_(panel);\n  } catch (e) {\n    console.log(\"Panel idioma: \" + e.message);\n  }\n\n  actualizarIndicadoresPanelDoctorado_(\n    panel,\n    calcularIndicadoresPIH_(valores),\n    filasRadar.length\n  );\n\n  SpreadsheetApp.flush();\n\n  avisarPIH_(tPIH_(\"ui_actualizado\", filasRadar.length), 5);\n\n  console.log(\"Interfaz doctoral actualizada correctamente.\");\n}\n\n\n// =====================================================\n// DESPLEGABLES Y VALIDACIONES DE RADAR\n// =====================================================\n\nfunction aplicarValidacionesRadarPIH_(radar) {\n\n  const cfg = PIH_RADAR_CONFIG;\n  const c = cfg.col;\n\n  const filas = Math.max(radar.getMaxRows() - 1, 1);\n\n  const reglaEstado = SpreadsheetApp.newDataValidation()\n    .requireValueInList(cfg.estados, true)\n    .setAllowInvalid(false)\n    .setHelpText(\"Elige un estado de la lista.\")\n    .build();\n\n  const reglaMendeley = SpreadsheetApp.newDataValidation()\n    .requireValueInList(cfg.mendeley, true)\n    .setAllowInvalid(false)\n    .setHelpText(\"Elige Sí o No.\")\n    .build();\n\n  const opcionesRelevancia = [];\n\n  for (let n = cfg.relevanciaMin; n <= cfg.relevanciaMax; n++) {\n    opcionesRelevancia.push(String(n));\n  }\n\n  const reglaRelevancia = SpreadsheetApp.newDataValidation()\n    .requireValueInList(opcionesRelevancia, true)\n    .setAllowInvalid(false)\n    .setHelpText(\n      \"Elige un número entero entre \" +\n      cfg.relevanciaMin + \" y \" + cfg.relevanciaMax + \".\"\n    )\n    .build();\n\n  radar.getRange(2, c.RELEVANCIA, filas, 1).setDataValidation(reglaRelevancia);\n  radar.getRange(2, c.ESTADO, filas, 1).setDataValidation(reglaEstado);\n  radar.getRange(2, c.MENDELEY, filas, 1).setDataValidation(reglaMendeley);\n}\n\n\n// =====================================================\n// FORMATO VISUAL DE RADAR (colores y destacados)\n// =====================================================\n\nfunction aplicarFormatoVisualRadarPIH_(radar) {\n\n  const cfg = PIH_RADAR_CONFIG;\n  const c = cfg.col;\n\n  const filas = Math.max(radar.getMaxRows() - 1, 1);\n\n  const letra = columna => String.fromCharCode(64 + columna);\n  const rango = columna => radar.getRange(2, columna, filas, 1);\n\n  radar.setTabColor(\"#24445C\");\n  radar.setHiddenGridlines(true);\n\n  // Columnas cortas, centradas.\n  [c.ANO, c.RELEVANCIA, c.CONFIANZA, c.ESTADO, c.MENDELEY, c.ORIGEN]\n    .forEach(columna => {\n      rango(columna).setHorizontalAlignment(\"center\");\n    });\n\n  rango(c.RELEVANCIA).setFontWeight(\"bold\").setFontSize(12);\n\n  const reglas = [];\n\n  const porTexto = (columna, texto, fondo, colorLetra, negrita) => {\n    let regla = SpreadsheetApp.newConditionalFormatRule()\n      .whenTextEqualTo(texto)\n      .setBackground(fondo)\n      .setFontColor(colorLetra || \"#202124\");\n\n    if (negrita) regla = regla.setBold(true);\n\n    return regla.setRanges([rango(columna)]).build();\n  };\n\n  // RELEVANCIA: de verde intenso (5) a gris (0).\n  const coloresRelevancia = [\n    { n: 5, fondo: \"#1E7B4F\", letra: \"#FFFFFF\" },\n    { n: 4, fondo: \"#7CC49A\", letra: \"#202124\" },\n    { n: 3, fondo: \"#FFE59A\", letra: \"#202124\" },\n    { n: 2, fondo: \"#F8CBAD\", letra: \"#202124\" },\n    { n: 1, fondo: \"#E4E6E8\", letra: \"#202124\" },\n    { n: 0, fondo: \"#CDD0D3\", letra: \"#5F6368\" }\n  ];\n\n  coloresRelevancia.forEach(item => {\n    reglas.push(\n      SpreadsheetApp.newConditionalFormatRule()\n        .whenFormulaSatisfied(\n          \"=AND(ISNUMBER($\" + letra(c.RELEVANCIA) + \"2),$\" +\n          letra(c.RELEVANCIA) + \"2=\" + item.n + \")\"\n        )\n        .setBackground(item.fondo)\n        .setFontColor(item.letra)\n        .setRanges([rango(c.RELEVANCIA)])\n        .build()\n    );\n  });\n\n  // CONFIANZA\n  reglas.push(porTexto(c.CONFIANZA, \"Alta\", \"#D9EAD3\", \"#1E5631\"));\n  reglas.push(porTexto(c.CONFIANZA, \"Media\", \"#FFF2CC\", \"#7F6000\"));\n  reglas.push(porTexto(c.CONFIANZA, \"Baja\", \"#F8D7DA\", \"#842029\"));\n\n  // ESTADO\n  reglas.push(porTexto(c.ESTADO, \"Pendiente\", \"#ECEFF1\", \"#37474F\"));\n  reglas.push(porTexto(c.ESTADO, \"Para leer\", \"#CFE2F3\", \"#0B3D6B\"));\n  reglas.push(porTexto(c.ESTADO, \"Leído\", \"#D9EAD3\", \"#1E5631\"));\n  reglas.push(porTexto(c.ESTADO, \"Descartado\", \"#E0E0E0\", \"#80868B\"));\n\n  // MENDELEY\n  reglas.push(porTexto(c.MENDELEY, \"Sí\", \"#D9EAD3\", \"#1E5631\", true));\n  reglas.push(\n    SpreadsheetApp.newConditionalFormatRule()\n      .whenTextEqualTo(\"No\")\n      .setFontColor(\"#80868B\")\n      .setRanges([rango(c.MENDELEY)])\n      .build()\n  );\n\n  // ORIGEN\n  reglas.push(porTexto(c.ORIGEN, cfg.origenHistorico, \"#EADCF8\", \"#4A235A\"));\n  reglas.push(porTexto(c.ORIGEN, cfg.origenDiario, \"#DDEBF7\", \"#1F4E79\"));\n  reglas.push(porTexto(c.ORIGEN, \"Fuente abierta\", \"#D5F0EC\", \"#0B5345\"));\n\n  // Publicaciones descartadas: título y resumen tachados y en gris.\n  const filaDescartada =\n    \"=$\" + letra(c.ESTADO) + \"2=\\\"Descartado\\\"\";\n\n  reglas.push(\n    SpreadsheetApp.newConditionalFormatRule()\n      .whenFormulaSatisfied(filaDescartada)\n      .setFontColor(\"#9AA0A6\")\n      .setStrikethrough(true)\n      .setRanges([rango(c.PUBLICACION)])\n      .build()\n  );\n\n  reglas.push(\n    SpreadsheetApp.newConditionalFormatRule()\n      .whenFormulaSatisfied(filaDescartada)\n      .setFontColor(\"#9AA0A6\")\n      .setRanges([\n        radar.getRange(2, c.AUTORES, filas, 4),\n        rango(c.RESUMEN)\n      ])\n      .build()\n  );\n\n  // Por leer con prioridad: relevancia 4-5 y estado Pendiente -> título en negrita.\n  reglas.push(\n    SpreadsheetApp.newConditionalFormatRule()\n      .whenFormulaSatisfied(\n        \"=AND(ISNUMBER($\" + letra(c.RELEVANCIA) + \"2),$\" +\n        letra(c.RELEVANCIA) + \"2>=4,$\" + letra(c.ESTADO) +\n        \"2=\\\"Pendiente\\\")\"\n      )\n      .setBold(true)\n      .setRanges([rango(c.PUBLICACION)])\n      .build()\n  );\n\n  radar.setConditionalFormatRules(reglas);\n}\n\n\n// =====================================================\n// PROTECCIONES (solo aviso: nunca te bloquean)\n// =====================================================\n\nfunction aplicarProteccionesPIH_(radar, datos) {\n\n  const c = PIH_RADAR_CONFIG.col;\n  const prefijo = \"PIH_\";\n\n  // Quitar solo las protecciones creadas por este script.\n  [radar, datos].forEach(hoja => {\n    const protecciones = hoja\n      .getProtections(SpreadsheetApp.ProtectionType.RANGE)\n      .concat(\n        hoja.getProtections(SpreadsheetApp.ProtectionType.SHEET)\n      );\n\n    protecciones.forEach(proteccion => {\n      if (String(proteccion.getDescription()).indexOf(prefijo) === 0) {\n        proteccion.remove();\n      }\n    });\n  });\n\n  const filasRadar = radar.getMaxRows();\n\n  // RADAR: PUBLICACIÓN, AUTORES, AÑO y REVISTA.\n  radar.getRange(1, c.PUBLICACION, filasRadar, 4)\n    .protect()\n    .setDescription(\"PIH_RADAR_SOLO_LECTURA_1\")\n    .setWarningOnly(true);\n\n  // RADAR: CONFIANZA (la calcula la IA).\n  radar.getRange(1, c.CONFIANZA, filasRadar, 1)\n    .protect()\n    .setDescription(\"PIH_RADAR_SOLO_LECTURA_2\")\n    .setWarningOnly(true);\n\n  // RADAR: ORIGEN, ENLACE e ID interno.\n  radar.getRange(1, c.ORIGEN, filasRadar, 3)\n    .protect()\n    .setDescription(\"PIH_RADAR_SOLO_LECTURA_3\")\n    .setWarningOnly(true);\n\n  // PUBLICACIONES: se edita desde RADAR; aquí solo se avisa.\n  datos.protect()\n    .setDescription(\"PIH_PUBLICACIONES_BASE\")\n    .setWarningOnly(true);\n}\n\n\n// =====================================================\n// PANEL DE INDICADORES\n// =====================================================\n\n// Calcula los indicadores sobre TODA la base PUBLICACIONES\n// (la primera fila debe ser la de cabeceras).\nfunction calcularIndicadoresPIH_(valores) {\n\n  const indice = obtenerIndiceCabecerasPIH_(valores[0]);\n\n  const registros = valores.slice(1).filter(fila =>\n    String(obtenerValorPIH_(fila, indice, \"TITULO\")).trim() !== \"\"\n  );\n\n  const resultado = {\n    total: registros.length,\n    pendientes: 0,\n    altaRelevancia: 0,\n    incorporadas: 0,\n    sinClasificar: 0,\n    diarias: 0,\n    historicas: 0,\n    porRelevancia: [0, 0, 0, 0, 0, 0],\n    porEstado: {}\n  };\n\n  PIH_RADAR_CONFIG.estados.forEach(nombre => {\n    resultado.porEstado[nombre] = 0;\n  });\n\n  registros.forEach(fila => {\n\n    const estado = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    );\n\n    if (estado === \"\" || estado === \"pendiente\") {\n      resultado.pendientes++;\n    }\n\n    const estadoCanonico =\n      canonicoListaPIH_(estado, PIH_RADAR_CONFIG.estados) || \"Pendiente\";\n\n    resultado.porEstado[estadoCanonico]++;\n\n    const relevancia = String(\n      obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\")\n    ).trim();\n\n    if (relevancia === \"\") {\n      resultado.sinClasificar++;\n    } else {\n      const nivel = Math.round(Number(relevancia));\n\n      if (nivel >= 0 && nivel <= 5) {\n        resultado.porRelevancia[nivel]++;\n      }\n\n      if (Number(relevancia) >= 4) {\n        resultado.altaRelevancia++;\n      }\n    }\n\n    const mendeley = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"INCORPORADO_MENDELEY\")\n    );\n\n    if ([\"si\", \"true\", \"yes\"].includes(mendeley)) {\n      resultado.incorporadas++;\n    }\n\n    const origen = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"ORIGEN\")\n    );\n\n    if (origen === normalizarTextoPIH_(PIH_RADAR_CONFIG.origenHistorico)) {\n      resultado.historicas++;\n    } else {\n      resultado.diarias++;\n    }\n  });\n\n  return resultado;\n}\n\n\n// Diseño fijo del panel (solo se aplica al crear/actualizar la interfaz).\nfunction construirPanelDoctorado_(panel) {\n\n  // El panel lo genera este script por completo.\n  panel.getCharts().forEach(grafico => panel.removeChart(grafico));\n  panel.getRange(\"A1:M30\").breakApart().clear();\n\n  panel.setTabColor(\"#1B7F4B\");\n  panel.setHiddenGridlines(true);\n\n  panel.setColumnWidth(1, 250);\n  panel.setColumnWidth(2, 220);\n  panel.setColumnWidth(3, 180);\n  panel.setColumnWidth(4, 180);\n  panel.setColumnWidth(5, 30);\n\n  for (let columna = 6; columna <= 10; columna++) {\n    panel.setColumnWidth(columna, 100);\n  }\n\n  panel.setColumnWidth(11, 30);\n  panel.setColumnWidth(12, 130);\n  panel.setColumnWidth(13, 110);\n\n  panel.getRange(\"A1:J1\")\n    .merge()\n    .setValue(\"PERSONAL INTELLIGENCE HUB\")\n    .setBackground(\"#24445C\")\n    .setFontColor(\"#FFFFFF\")\n    .setFontSize(17)\n    .setFontWeight(\"bold\");\n\n  panel.getRange(\"A2:J2\")\n    .merge()\n    .setValue(\"DOCTORADO · Centro de seguimiento académico\")\n    .setFontColor(\"#557080\")\n    .setFontSize(11);\n\n  panel.getRange(\"A4:B4\").setValues([\n    [\"INDICADOR\", \"VALOR\"]\n  ]);\n\n  panel.getRange(\"A4:B4\")\n    .setBackground(\"#DCE7ED\")\n    .setFontWeight(\"bold\");\n\n  panel.getRange(\"A5:A9\").setValues([\n    [\"Publicaciones detectadas\"],\n    [\"Pendientes de revisión\"],\n    [\"Alta relevancia (4–5)\"],\n    [\"Enviadas a mi gestor\"],\n    [\"Pendientes de clasificar (IA)\"]\n  ]);\n\n  panel.getRange(\"B5:B9\")\n    .setFontWeight(\"bold\")\n    .setFontSize(14);\n\n  panel.getRange(\"A11:B11\")\n    .merge()\n    .setValue(\"ESTADO DEL SISTEMA\")\n    .setBackground(\"#DCE7ED\")\n    .setFontWeight(\"bold\");\n\n  panel.getRange(\"A12:A15\").setValues([\n    [\"Última actualización\"],\n    [\"Publicaciones en RADAR\"],\n    [\"Clasificación IA\"],\n    [\"Origen (diarias · históricas)\"]\n  ]);\n\n  panel.getRange(\"B12\").setNumberFormat(\"dd/mm/yyyy hh:mm\");\n\n  // La antigua lista de «próximos desarrollos» ya no existe: se limpia.\n  panel.getRange(\"A17:J22\")\n    .breakApart()\n    .clearContent()\n    .clearFormat();\n\n  panel.getRange(\"A1:J22\")\n    .setVerticalAlignment(\"middle\")\n    .setWrap(true);\n\n  panel.setRowHeight(1, 42);\n  panel.setRowHeight(2, 28);\n  panel.setFrozenRows(2);\n\n  // ---- Datos de apoyo para los gráficos (columnas L:M) ----\n\n  panel.getRange(\"L3\").setValue(\"DATOS DE LOS GRÁFICOS (no tocar)\");\n\n  panel.getRange(\"L4:M4\").setValues([[\"Relevancia\", \"Publicaciones\"]]);\n\n  panel.getRange(\"L5:L11\").setValues([\n    [\"Rel. 0\"], [\"Rel. 1\"], [\"Rel. 2\"],\n    [\"Rel. 3\"], [\"Rel. 4\"], [\"Rel. 5\"],\n    [\"Sin puntuar\"]\n  ]);\n\n  panel.getRange(\"L13:M13\").setValues([[\"Estado\", \"Publicaciones\"]]);\n\n  panel.getRange(\"L14:M18\").clearContent();\n\n  panel.getRange(\"L14:L17\").setValues(\n    PIH_RADAR_CONFIG.estados.map(estado => [estado])\n  );\n\n  panel.getRange(\"M5:M11\").setValue(0);\n  panel.getRange(\"M14:M17\").setValue(0);\n\n  panel.getRange(\"L3:M18\")\n    .setFontColor(\"#9AA0A6\")\n    .setFontSize(9);\n\n  // ---- Gráficos ----\n\n  const graficoRelevancia = panel.newChart()\n    .setChartType(Charts.ChartType.COLUMN)\n    .addRange(panel.getRange(\"L4:M11\"))\n    .setNumHeaders(1)\n    .setPosition(4, 3, 0, 0)\n    .setOption(\"title\", \"Publicaciones por relevancia\")\n    .setOption(\"legend\", { position: \"none\" })\n    .setOption(\"colors\", [\"#24445C\"])\n    .setOption(\"width\", 360)\n    .setOption(\"height\", 250)\n    .build();\n\n  panel.insertChart(graficoRelevancia);\n\n  const graficoEstados = panel.newChart()\n    .setChartType(Charts.ChartType.PIE)\n    .addRange(panel.getRange(\"L13:M17\"))\n    .setNumHeaders(1)\n    .setPosition(4, 6, 0, 0)\n    .setOption(\"title\", \"Estado de lectura\")\n    .setOption(\"pieHole\", 0.45)\n    .setOption(\n      \"colors\",\n      [\"#C9CED3\", \"#F4C542\", \"#5B9BD5\", \"#4CAF7A\", \"#E57373\"]\n    )\n    .setOption(\"width\", 400)\n    .setOption(\"height\", 250)\n    .build();\n\n  panel.insertChart(graficoEstados);\n}\n\n\n// Solo los valores de los indicadores (rápido, se usa en cada edición).\nfunction actualizarIndicadoresPanelDoctorado_(panel, indicadores, enRadar) {\n\n  panel.getRange(\"B5:B9\").setValues([\n    [indicadores.total],\n    [indicadores.pendientes],\n    [indicadores.altaRelevancia],\n    [indicadores.incorporadas],\n    [indicadores.sinClasificar]\n  ]);\n\n  let estadoIA = \"Pendiente de clasificación\";\n\n  if (indicadores.total > indicadores.sinClasificar) {\n    estadoIA = indicadores.sinClasificar > 0\n      ? \"En curso (\" + indicadores.sinClasificar + \" pendientes)\"\n      : \"Todas clasificadas\";\n  }\n\n  panel.getRange(\"B12:B15\").setValues([\n    [new Date()],\n    [enRadar],\n    [estadoIA],\n    [indicadores.diarias + \" · \" + indicadores.historicas]\n  ]);\n\n  panel.getRange(\"B12\").setNumberFormat(\"dd/mm/yyyy hh:mm\");\n\n  // Datos de los gráficos.\n  const datosRelevancia = indicadores.porRelevancia.map(n => [n]);\n  datosRelevancia.push([indicadores.sinClasificar]);\n\n  panel.getRange(\"M5:M11\").setValues(datosRelevancia);\n\n  panel.getRange(\"M14:M17\").setValues(\n    PIH_RADAR_CONFIG.estados.map(estado => [\n      indicadores.porEstado[estado] || 0\n    ])\n  );\n}\n\n\n// =====================================================\n// SINCRONIZACIÓN RADAR → PUBLICACIONES\n// =====================================================\n\n// Esta función la ejecuta el activador \"Al editarse\".\nfunction sincronizarEdicionRadar(e) {\n\n  if (!e || !e.range) return;\n\n  const cfg = PIH_RADAR_CONFIG;\n  const rango = e.range;\n  const radar = rango.getSheet();\n\n  if (radar.getName() !== cfg.hojaRadar) return;\n\n  const primeraFila = rango.getRow();\n  const ultimaFila = primeraFila + rango.getNumRows() - 1;\n  const primeraColumna = rango.getColumn();\n  const ultimaColumna = primeraColumna + rango.getNumColumns() - 1;\n\n  // Ignorar la cabecera.\n  if (ultimaFila < 2) return;\n\n  // Ignorar ediciones que no tocan ninguna columna editable.\n  const tocaColumnaEditable = Object.keys(cfg.sincronizacion)\n    .map(Number)\n    .some(columna => columna >= primeraColumna && columna <= ultimaColumna);\n\n  if (!tocaColumnaEditable) return;\n\n  const bloqueo = LockService.getDocumentLock();\n  bloqueo.waitLock(20000);\n\n  try {\n    sincronizarRangoRadarPIH_(e, radar);\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\nfunction sincronizarRangoRadarPIH_(e, radar) {\n\n  const cfg = PIH_RADAR_CONFIG;\n  const ss = e.source || SpreadsheetApp.getActiveSpreadsheet();\n\n  const datos = ss.getSheetByName(cfg.hojaDatos);\n\n  if (!datos) {\n    throw new Error(tPIH_(\"ui_no_hoja\"));\n  }\n\n  const rango = e.range;\n\n  const filaInicio = Math.max(rango.getRow(), 2);\n  const filaFin = Math.min(\n    rango.getRow() + rango.getNumRows() - 1,\n    radar.getLastRow()\n  );\n\n  if (filaFin < filaInicio) return;\n\n  const primeraColumna = rango.getColumn();\n  const ultimaColumna = primeraColumna + rango.getNumColumns() - 1;\n\n  // ---- Leer PUBLICACIONES una sola vez ----\n\n  const valoresDatos = datos.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(valoresDatos[0]);\n\n  const posicionId = indice.ID;\n  const posicionTitulo = indice.TITULO;\n\n  if (posicionId === undefined || posicionTitulo === undefined) {\n    throw new Error(\n      \"Faltan las columnas ID o TITULO en PUBLICACIONES.\"\n    );\n  }\n\n  const destinos = {};\n\n  Object.keys(cfg.sincronizacion).forEach(columna => {\n    const nombre = cfg.sincronizacion[columna];\n    const posicion = indice[normalizarCabeceraPIH_(nombre)];\n\n    if (posicion === undefined) {\n      throw new Error(\n        \"Falta la columna \" + nombre + \" en PUBLICACIONES. \" +\n        \"Ejecuta crearInterfazDoctorado() para que se cree.\"\n      );\n    }\n\n    destinos[Number(columna)] = posicion;\n  });\n\n  const filaPorId = {};\n  const filasPorTitulo = {};\n\n  for (let i = 1; i < valoresDatos.length; i++) {\n    const id = String(valoresDatos[i][posicionId] || \"\");\n\n    if (id) {\n      filaPorId[id] = i;\n    }\n\n    const titulo = normalizarTextoPIH_(valoresDatos[i][posicionTitulo]);\n\n    if (titulo) {\n      if (!filasPorTitulo[titulo]) filasPorTitulo[titulo] = [];\n      filasPorTitulo[titulo].push(i);\n    }\n  }\n\n  // ---- Leer las filas editadas de RADAR ----\n\n  const filasEditadas = radar\n    .getRange(\n      filaInicio, 1,\n      filaFin - filaInicio + 1,\n      cfg.columnaIdRadar\n    )\n    .getValues();\n\n  let sinIdentificar = 0;\n  let valoresRechazados = 0;\n  let cambiosGuardados = 0;\n\n  filasEditadas.forEach((filaRadar, desplazamiento) => {\n\n    const numeroFilaRadar = filaInicio + desplazamiento;\n\n    // 1) Localizar la publicación: primero por ID, luego por título.\n    const idRadar = String(filaRadar[cfg.columnaIdRadar - 1] || \"\");\n\n    let filaDatos = idRadar !== \"\" && filaPorId[idRadar] !== undefined\n      ? filaPorId[idRadar]\n      : -1;\n\n    if (filaDatos === -1) {\n      const coincidencias = filasPorTitulo[\n        normalizarTextoPIH_(filaRadar[cfg.columnaTituloRadar - 1])\n      ] || [];\n\n      if (coincidencias.length === 1) {\n        filaDatos = coincidencias[0];\n\n        // Reparar el ID interno de esta fila de RADAR.\n        const idDatos = String(valoresDatos[filaDatos][posicionId] || \"\");\n\n        if (idDatos) {\n          radar.getRange(numeroFilaRadar, cfg.columnaIdRadar)\n            .setValue(idDatos);\n        }\n      }\n    }\n\n    if (filaDatos === -1) {\n      sinIdentificar++;\n      return;\n    }\n\n    // 2) Sincronizar cada columna editada.\n    Object.keys(destinos).forEach(columnaTexto => {\n\n      const columna = Number(columnaTexto);\n\n      if (columna < primeraColumna || columna > ultimaColumna) return;\n\n      const posicion = destinos[columna];\n      const valorRadar = filaRadar[columna - 1];\n      const valorActual = valoresDatos[filaDatos][posicion];\n\n      const resultado = validarValorRadarPIH_(columna, valorRadar);\n\n      // Valor no válido: se devuelve el valor anterior a RADAR.\n      if (!resultado.ok) {\n        radar.getRange(numeroFilaRadar, columna).setValue(valorActual);\n        valoresRechazados++;\n        return;\n      }\n\n      // Si se ha normalizado (p. ej. \"si\" -> \"Sí\"), se refleja en RADAR.\n      if (String(resultado.valor) !== String(valorRadar)) {\n        radar.getRange(numeroFilaRadar, columna).setValue(resultado.valor);\n      }\n\n      if (String(resultado.valor) !== String(valorActual)) {\n        datos.getRange(filaDatos + 1, posicion + 1)\n          .setValue(resultado.valor);\n\n        valoresDatos[filaDatos][posicion] = resultado.valor;\n        cambiosGuardados++;\n      }\n    });\n  });\n\n  // ---- Actualizar indicadores del panel ----\n\n  const panel = ss.getSheetByName(cfg.hojaPanel);\n\n  if (panel) {\n    actualizarIndicadoresPanelDoctorado_(\n      panel,\n      calcularIndicadoresPIH_(valoresDatos),\n      Math.max(radar.getLastRow() - 1, 0)\n    );\n  }\n\n  SpreadsheetApp.flush();\n\n  // ---- Avisos ----\n\n  if (valoresRechazados > 0) {\n    ss.toast(\n      tPIH_(\"ui_valor_invalido\", valoresRechazados),\n      \"PIH Doctorado\",\n      6\n    );\n  }\n\n  if (sinIdentificar > 0) {\n    ss.toast(\n      tPIH_(\"ui_sin_identificar\", sinIdentificar),\n      \"PIH Doctorado\",\n      8\n    );\n\n    console.error(\n      \"Filas de RADAR sin identificar: \" + sinIdentificar\n    );\n  }\n\n  console.log(\"Sincronización RADAR: \" + cambiosGuardados + \" cambio(s).\");\n}\n\n\n// Comprueba un valor editado en RADAR y lo devuelve normalizado.\nfunction validarValorRadarPIH_(columnaRadar, valor) {\n\n  const cfg = PIH_RADAR_CONFIG;\n  const c = cfg.col;\n\n  if (String(valor === null || valor === undefined ? \"\" : valor).trim() === \"\") {\n    return { ok: true, valor: \"\" };\n  }\n\n  // RELEVANCIA (solo enteros)\n  if (columnaRadar === c.RELEVANCIA) {\n    const numero = Number(valor);\n\n    if (\n      typeof valor === \"boolean\" ||\n      !Number.isInteger(numero) ||\n      numero < cfg.relevanciaMin ||\n      numero > cfg.relevanciaMax\n    ) {\n      return { ok: false };\n    }\n\n    return { ok: true, valor: numero };\n  }\n\n  // ESTADO\n  if (columnaRadar === c.ESTADO) {\n    const estado = canonicoListaPIH_(valor, cfg.estados);\n\n    return estado ? { ok: true, valor: estado } : { ok: false };\n  }\n\n  // MENDELEY\n  if (columnaRadar === c.MENDELEY) {\n    const respuesta = canonicoListaPIH_(valor, cfg.mendeley);\n\n    return respuesta ? { ok: true, valor: respuesta } : { ok: false };\n  }\n\n  return { ok: true, valor: valor };\n}\n\n\n// =====================================================\n// ACTIVAR SINCRONIZACIÓN AUTOMÁTICA\n// =====================================================\n\nfunction configurarSincronizacionRadar() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n\n  // Evitar crear activadores duplicados.\n  ScriptApp.getProjectTriggers().forEach(activador => {\n    if (activador.getHandlerFunction() === \"sincronizarEdicionRadar\") {\n      ScriptApp.deleteTrigger(activador);\n    }\n  });\n\n  ScriptApp.newTrigger(\"sincronizarEdicionRadar\")\n    .forSpreadsheet(ss)\n    .onEdit()\n    .create();\n\n  ss.toast(\n    tPIH_(\"ui_sync_on\"),\n    \"PIH Doctorado\",\n    5\n  );\n\n  console.log(\"Sincronización automática configurada.\");\n}\n\n\n// =====================================================\n// ACTUALIZACIÓN DE LAS VISTAS\n// =====================================================\n\nfunction actualizarInterfazDoctorado() {\n  crearInterfazDoctorado();\n}\n\n\n// =====================================================\n// DIAGNÓSTICO\n// =====================================================\n\nfunction diagnosticarRadarDoctorado() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const cfg = PIH_RADAR_CONFIG;\n\n  const lineas = [];\n\n  const datos = ss.getSheetByName(cfg.hojaDatos);\n  const radar = ss.getSheetByName(cfg.hojaRadar);\n\n  if (!datos) {\n    lineas.push(\"✘ No existe la hoja PUBLICACIONES.\");\n  } else {\n    const cabeceras = datos\n      .getRange(1, 1, 1, datos.getLastColumn())\n      .getValues()[0];\n\n    const indice = obtenerIndiceCabecerasPIH_(cabeceras);\n\n    [\n      \"ID\",\n      \"TITULO\",\n      \"TEMATICA_PRINCIPAL\",\n      \"RELEVANCIA_0_5\",\n      \"RESUMEN_IA\",\n      \"ESTADO_LECTURA\",\n      \"INCORPORADO_MENDELEY\",\n      \"CONFIANZA_ANALISIS\",\n      \"ORIGEN\"\n    ].forEach(nombre => {\n      lineas.push(\n        (indice[nombre] !== undefined ? \"✔ \" : \"✘ FALTA \") +\n        nombre + \" en PUBLICACIONES\"\n      );\n    });\n  }\n\n  if (!radar) {\n    lineas.push(\"✘ No existe la hoja RADAR.\");\n  } else {\n    lineas.push(\n      \"Cabecera de la columna del ID en RADAR: «\" +\n      radar.getRange(1, cfg.columnaIdRadar).getValue() + \"»\"\n    );\n\n    const filas = Math.max(radar.getLastRow() - 1, 0);\n\n    const conId = filas === 0\n      ? 0\n      : radar\n          .getRange(2, cfg.columnaIdRadar, filas, 1)\n          .getValues()\n          .filter(f => String(f[0]).trim() !== \"\").length;\n\n    lineas.push(\"Filas de RADAR con ID interno: \" + conId + \" de \" + filas);\n\n    lineas.push(\n      \"Desplegable en ESTADO: \" +\n      (radar.getRange(2, cfg.col.ESTADO).getDataValidation() ? \"sí\" : \"NO\")\n    );\n  }\n\n  const activadores = ScriptApp.getProjectTriggers().filter(a =>\n    a.getHandlerFunction() === \"sincronizarEdicionRadar\"\n  ).length;\n\n  lineas.push(\"Activadores de sincronización: \" + activadores);\n\n  const ui = SpreadsheetApp.getUi();\n\n  ui.alert(\n    \"Diagnóstico PIH Doctorado\",\n    lineas.join(\"\\n\"),\n    ui.ButtonSet.OK\n  );\n}\n\n\n// =====================================================\n// CABECERAS EN UNA SOLA LÍNEA\n// =====================================================\n\n/**\n * En todas las pestañas con una fila de cabeceras (fila 1): quita el\n * salto de línea y ensancha la columna lo justo para que cada cabecera\n * quepa entera («CONFIANZA», no «CONFIAN / ZA»). Nunca estrecha columnas.\n * Se ejecuta sola al abrir la hoja; también puedes lanzarla a mano.\n */\nfunction ajustarCabecerasUnaLineaPIH() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const saltar = [\"PANEL\", \"👋 START\"];\n\n  ss.getSheets().forEach(hoja => {\n\n    try {\n      if (saltar.indexOf(hoja.getName()) !== -1) return;\n\n      const columnas = hoja.getLastColumn();\n      if (columnas < 3 || hoja.getLastRow() < 1) return;\n\n      const fila = hoja.getRange(1, 1, 1, columnas);\n\n      // Si la fila 1 es un título combinado, no se toca.\n      if (fila.getMergedRanges().length) return;\n\n      const textos = fila.getValues()[0];\n      if (textos.filter(t => String(t).trim() !== \"\").length < 3) return;\n\n      fila.setWrap(false);\n\n      const tamanos = fila.getFontSizes()[0];\n      const anchos = [];\n\n      textos.forEach((t, i) => {\n        const largo = String(t).length;\n        if (!largo) return;\n        // ~0,75 px por punto de fuente y letra (negrita, mayúsculas) + margen\n        // y hueco para el icono de filtro/orden.\n        const necesario = Math.ceil(largo * (tamanos[i] || 10) * 0.85) + 34;\n        if (hoja.getColumnWidth(i + 1) < necesario) {\n          hoja.setColumnWidth(i + 1, necesario);\n        }\n      });\n    } catch (e) {\n      console.log(\"Cabeceras \" + hoja.getName() + \": \" + e.message);\n    }\n  });\n}\n\n\n/**\n * Texto de la cabecera de RADAR para la columna del gestor de referencias.\n */\nfunction cabeceraGestorPIH_() {\n  let gestor = \"ninguno\";\n  try { gestor = gestorElegidoPIH_(); } catch (e) {}\n  if (gestor === \"mendeley\") return \"EN MENDELEY\";\n  if (gestor === \"zotero\") return \"EN ZOTERO\";\n  return \"EN MI GESTOR\";\n}\n"}, {"name": "MapaHuecos", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Mapa de huecos de la tesis · v1\n *\n * Crea (o rehace) la pestaña MAPA_HUECOS: para cada eje de tu propuesta de\n * doctorado cuenta cuántas referencias ya puntuadas tienes, cuántas son de\n * relevancia 4-5, cuántas estás leyendo o has leído, y te señala cuáles\n * están cubiertas, flojas o vacías, con una búsqueda sugerida para los\n * huecos.\n *\n * Cómo funciona (coste 0 €, sin IA):\n *   - Lee PUBLICACIONES y solo cuenta las que ya tienen relevancia.\n *   - Asigna cada publicación a uno o varios ejes buscando palabras clave\n *     (español e inglés) en título, abstract, resumen y temáticas.\n *   - Es una aproximación por palabras clave, no una lectura: sirve para\n *     ver dónde hay poco material, no para medir la calidad.\n *\n * Función que puedes ejecutar a mano (o desde el menú):\n *   - construirMapaHuecosPIH()\n *\n * Puedes ajustar los umbrales y las palabras clave en las constantes de\n * abajo.\n */\n\n// Una referencia \"cuenta\" si tiene relevancia igual o superior a esto.\nconst PIH_MAPA_RELEVANCIA_MINIMA = 3;\n\n// Semáforo según nº de referencias relevantes por eje.\nconst PIH_MAPA_UMBRAL_CUBIERTO = 8;   // 8 o más  -> Cubierto\nconst PIH_MAPA_UMBRAL_FLOJO = 3;      // de 3 a 7 -> Flojo; menos de 3 -> Hueco\n\nconst PIH_MAPA_HOJA = \"MAPA HUECOS\";\n\n// Los ejes salen de tu perfil (pestaña PERFIL, fila «bloques_mapa»).\nfunction ejesMapaPIH_() {\n\n  const bloques = bloquesMapaPerfilPIH_([]);\n\n  if (bloques.length === 0) {\n    throw new Error(tPIH_(\"c_falta_tesis\"));\n  }\n\n  return bloques.map(b => ({\n    nombre: b.nombre,\n    objetivo: \"\",\n    claves: b.claves.map(c => normalizarTextoPIH_(c)),\n    busqueda: b.busqueda\n  }));\n}\n\n\n// =====================================================\n// FUNCIÓN PRINCIPAL\n// =====================================================\n\nfunction construirMapaHuecosPIH() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const pub = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!pub || pub.getLastRow() < 2) {\n    avisarPIH_(tPIH_(\"mh_sin_pub\"), 6);\n    return;\n  }\n\n  const datos = pub.getDataRange().getValues();\n  const col = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  if (col.TITULO === undefined || col.RELEVANCIA_0_5 === undefined) {\n    throw new Error(\"Faltan las columnas TITULO o RELEVANCIA_0_5.\");\n  }\n\n  const leer = (fila, nombre) =>\n    col[nombre] === undefined ? \"\" : fila[col[nombre]];\n\n  const publicaciones = [];\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n\n    if (!fila[col.TITULO]) continue;\n\n    publicaciones.push({\n      titulo: String(fila[col.TITULO]),\n      relevancia: String(fila[col.RELEVANCIA_0_5]).trim(),\n      ano: leer(fila, \"ANO\"),\n      estado: leer(fila, \"ESTADO_LECTURA\"),\n      texto: [\n        leer(fila, \"TITULO\"),\n        leer(fila, \"ABSTRACT_ORIGINAL\"),\n        leer(fila, \"RESUMEN_IA\"),\n        leer(fila, \"TEMATICA_PRINCIPAL\"),\n        leer(fila, \"TEMATICAS_SECUNDARIAS\")\n      ].join(\" \")\n    });\n  }\n\n  const resultado = calcularMapaHuecosPIH_(publicaciones, ejesMapaPIH_());\n\n  escribirMapaHuecosPIH_(ss, resultado);\n\n  registrarLogPIH_(\n    \"MAPA_HUECOS\", \"COMPLETADO\", resultado.puntuadas,\n    \"Huecos: \" + resultado.ejes.filter(e => e.semaforo === \"Hueco\").length\n  );\n\n  avisarPIH_(tPIH_(\"mh_actualizado\", resultado.puntuadas, resultado.pendientes), 8);\n}\n\n\n// =====================================================\n// CÁLCULO (sin acceso a la hoja)\n// =====================================================\n\nfunction normalizarParaMapaPIH_(texto) {\n  return String(texto || \"\")\n    .normalize(\"NFD\")\n    .replace(/[̀-ͯ]/g, \"\")\n    .toLowerCase();\n}\n\n\n/**\n * Recibe una lista de {titulo, relevancia, ano, estado, texto} y los ejes.\n * Devuelve { ejes: [...], puntuadas, pendientes }.\n */\nfunction calcularMapaHuecosPIH_(publicaciones, ejes) {\n\n  const salida = ejes.map(eje => ({\n    nombre: eje.nombre,\n    objetivo: eje.objetivo,\n    busqueda: eje.busqueda,\n    claves: eje.claves.map(normalizarParaMapaPIH_),\n    detectadas: 0,\n    relevantes: 0,\n    clave: 0,\n    lecturas: 0,\n    mejores: [],\n    semaforo: \"\"\n  }));\n\n  let puntuadas = 0;\n  let pendientes = 0;\n\n  publicaciones.forEach(p => {\n\n    if (p.relevancia === \"\") {\n      pendientes++;\n      return;\n    }\n\n    const nota = Number(p.relevancia);\n\n    if (isNaN(nota)) return;\n\n    puntuadas++;\n\n    const texto = normalizarParaMapaPIH_(p.texto);\n    const estado = normalizarParaMapaPIH_(p.estado);\n\n    salida.forEach(eje => {\n\n      if (!eje.claves.some(k => texto.indexOf(k) !== -1)) return;\n\n      eje.detectadas++;\n\n      if (nota < PIH_MAPA_RELEVANCIA_MINIMA) return;\n\n      eje.relevantes++;\n\n      if (nota >= 4) eje.clave++;\n\n      if (estado === \"para leer\" || estado === \"leido\") eje.lecturas++;\n\n      eje.mejores.push({\n        titulo: p.titulo,\n        nota: nota,\n        ano: Number(p.ano) || 0\n      });\n    });\n  });\n\n  salida.forEach(eje => {\n\n    eje.mejores.sort((a, b) => b.nota - a.nota || b.ano - a.ano);\n    eje.mejores = eje.mejores.slice(0, 3);\n\n    if (eje.relevantes >= PIH_MAPA_UMBRAL_CUBIERTO) eje.semaforo = \"Cubierto\";\n    else if (eje.relevantes >= PIH_MAPA_UMBRAL_FLOJO) eje.semaforo = \"Flojo\";\n    else eje.semaforo = \"Hueco\";\n  });\n\n  return { ejes: salida, puntuadas: puntuadas, pendientes: pendientes };\n}\n\n\n// =====================================================\n// ESCRIBIR LA HOJA\n// =====================================================\n\nfunction escribirMapaHuecosPIH_(ss, resultado) {\n\n  let hoja = ss.getSheetByName(PIH_MAPA_HOJA);\n\n  if (!hoja) {\n    hoja = ss.insertSheet(PIH_MAPA_HOJA);\n  }\n\n  hoja.getCharts().forEach(g => hoja.removeChart(g));\n  hoja.clear();\n  hoja.setHiddenGridlines(true);\n\n  const columnas = [\n    \"EJE DE LA TESIS\", \"REFERENCIAS RELEVANTES (3-5)\", \"DE RELEVANCIA 4-5\",\n    \"PARA LEER O LEÍDAS\", \"ESTADO\", \"MEJORES REFERENCIAS\",\n    \"BÚSQUEDA SUGERIDA\", \"DÓNDE ENCAJA\"\n  ];\n\n  hoja.getRange(1, 1).setValue(\"Mapa de huecos de la tesis\")\n    .setFontSize(16).setFontWeight(\"bold\");\n\n  hoja.getRange(2, 1).setValue(\n    \"Cuenta solo publicaciones ya puntuadas (\" + resultado.puntuadas +\n    \"; \" + resultado.pendientes + \" siguen sin puntuar). Una publicación \" +\n    \"puede contar en varios ejes. Es una aproximación por palabras clave: \" +\n    \"indica dónde hay poco material, no su calidad. Cubierto: \" +\n    PIH_MAPA_UMBRAL_CUBIERTO + \" o más · Flojo: \" + PIH_MAPA_UMBRAL_FLOJO +\n    \" a \" + (PIH_MAPA_UMBRAL_CUBIERTO - 1) + \" · Hueco: menos de \" +\n    PIH_MAPA_UMBRAL_FLOJO + \".\"\n  ).setFontColor(\"#666666\").setFontStyle(\"italic\");\n\n  hoja.getRange(2, 1, 1, columnas.length).merge().setWrap(true);\n  hoja.setRowHeight(2, 48);\n\n  hoja.getRange(4, 1, 1, columnas.length).setValues([columnas])\n    .setFontWeight(\"bold\").setBackground(\"#1f3864\").setFontColor(\"#ffffff\")\n    .setWrap(true).setVerticalAlignment(\"middle\");\n\n  try {\n    ponerNotasCabecerasPIH_(hoja);\n  } catch (e) {\n    console.log(\"Notas mapa: \" + e.message);\n  }\n\n  const filas = resultado.ejes.map(e => [\n    e.nombre,\n    e.relevantes,\n    e.clave,\n    e.lecturas,\n    e.semaforo,\n    e.mejores.length\n      ? e.mejores.map(m =>\n          \"[\" + m.nota + \"] \" + m.titulo.substring(0, 90) +\n          (m.titulo.length > 90 ? \"…\" : \"\")\n        ).join(\"\\n\")\n      : \"—\",\n    e.busqueda,\n    e.objetivo\n  ]);\n\n  const rango = hoja.getRange(5, 1, filas.length, columnas.length);\n\n  rango.setValues(filas).setVerticalAlignment(\"top\").setWrap(true);\n\n  filas.forEach((f, i) => {\n\n    const celda = hoja.getRange(5 + i, 5);\n\n    if (f[4] === \"Cubierto\") celda.setBackground(\"#d9ead3\");\n    else if (f[4] === \"Flojo\") celda.setBackground(\"#fff2cc\");\n    else celda.setBackground(\"#f4cccc\");\n\n    celda.setFontWeight(\"bold\").setHorizontalAlignment(\"center\");\n  });\n\n  hoja.getRange(5, 2, filas.length, 3).setHorizontalAlignment(\"center\");\n\n  hoja.setColumnWidth(1, 260);\n  hoja.setColumnWidth(2, 120);\n  hoja.setColumnWidth(3, 100);\n  hoja.setColumnWidth(4, 110);\n  hoja.setColumnWidth(5, 95);\n  hoja.setColumnWidth(6, 520);\n  hoja.setColumnWidth(7, 300);\n  hoja.setColumnWidth(8, 160);\n\n  hoja.setFrozenRows(4);\n\n  const grafico = hoja.newChart()\n    .setChartType(Charts.ChartType.BAR)\n    .addRange(hoja.getRange(4, 1, filas.length + 1, 2))\n    .setPosition(5 + filas.length + 2, 1, 0, 0)\n    .setOption(\"title\", \"Referencias relevantes por eje de la tesis\")\n    .setOption(\"legend\", { position: \"none\" })\n    .setOption(\"width\", 760)\n    .setOption(\"height\", 420)\n    .build();\n\n  hoja.insertChart(grafico);\n\n  ss.setActiveSheet(hoja);\n}\n"}, {"name": "Mendeley", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Exportación en archivo RIS enviado por correo (EndNote, Mendeley y otros)\n *\n * Flujo:\n *  1. En RADAR, cambia el ESTADO de las publicaciones que te interesan a\n *     \"Para leer\" o \"Leído\".\n *  2. Ejecuta exportarAMendeley(). Recibirás en tu correo un archivo .ris.\n *  3. Importa el archivo en tu gestor: EndNote (File > Import > File,\n *     formato «Reference Manager (RIS)»), Mendeley (+ Add new > Import\n *     library > RIS), Citavi, RefWorks y la mayoría de gestores lo admiten.\n *  4. Ejecuta confirmarImportacionMendeley(): marca «EN MI GESTOR» = Sí en\n *     las publicaciones exportadas.\n *\n * Funciones que puedes ejecutar a mano:\n *   - exportarAMendeley()               -> exporta solo lo no exportado antes\n *   - reexportarAMendeley()             -> exporta todo lo que aún no es \"Sí\"\n *   - confirmarImportacionMendeley()    -> marca lo exportado como incorporado\n *\n * Coste: 0 €. Usa el correo de tu cuenta (límite de 100 envíos diarios).\n * La primera vez, Google te pedirá permiso para enviar correo.\n *\n * Depende de InterfazDoctorado.gs v4.\n */\n\nconst PIH_ESTADOS_EXPORTABLES = [\"para leer\", \"leido\"];\n\n\n// =====================================================\n// FUNCIONES PRINCIPALES\n// =====================================================\n\nfunction exportarAMendeley() {\n  exportarReferenciasPIH_(false);\n}\n\n\nfunction reexportarAMendeley() {\n  exportarReferenciasPIH_(true);\n}\n\n\n/**\n * Marca MENDELEY = Sí en las publicaciones ya exportadas.\n * Úsala solo cuando hayas importado el archivo en Mendeley.\n */\nfunction confirmarImportacionMendeley() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja) {\n    throw new Error(tPIH_(\"c_no_hoja_pub\"));\n  }\n\n  const cabeceras = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0]\n    .map(String);\n\n  const posicionMendeley =\n    asegurarColumnaPIH_(hoja, cabeceras, \"INCORPORADO_MENDELEY\");\n\n  const posicionExportado =\n    asegurarColumnaPIH_(hoja, cabeceras, \"EXPORTADO_MENDELEY\");\n\n  const ultimaFila = hoja.getLastRow();\n\n  if (ultimaFila < 2) {\n    avisarPIH_(tPIH_(\"ris_sin_pub\"), 6);\n    return;\n  }\n\n  const numFilas = ultimaFila - 1;\n\n  const rangoMendeley = hoja.getRange(2, posicionMendeley + 1, numFilas, 1);\n  const mendeley = rangoMendeley.getValues();\n\n  const exportado = hoja\n    .getRange(2, posicionExportado + 1, numFilas, 1)\n    .getValues();\n\n  let marcadas = 0;\n\n  mendeley.forEach((fila, i) => {\n    const yaIncorporada =\n      [\"si\", \"true\", \"yes\"].includes(normalizarTextoPIH_(fila[0]));\n\n    if (!yaIncorporada && String(exportado[i][0]).trim() !== \"\") {\n      fila[0] = \"Sí\";\n      marcadas++;\n    }\n  });\n\n  if (marcadas === 0) {\n    avisarPIH_(tPIH_(\"ris_sin_confirmar\"), 8);\n    return;\n  }\n\n  rangoMendeley.setValues(mendeley);\n\n  SpreadsheetApp.flush();\n\n  registrarLogPIH_(\n    \"MENDELEY_CONFIRMACION\",\n    \"COMPLETADO\",\n    marcadas,\n    \"Marcadas como incorporadas a tu gestor.\"\n  );\n\n  // Refrescar RADAR y PANEL.\n  crearInterfazDoctorado();\n\n  avisarPIH_(tPIH_(\"ris_marcadas\", marcadas), 8);\n}\n\n\n// =====================================================\n// EXPORTACIÓN\n// =====================================================\n\nfunction exportarReferenciasPIH_(incluirYaExportadas) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja) {\n    throw new Error(tPIH_(\"c_no_hoja_pub\"));\n  }\n\n  if (hoja.getLastRow() < 2) {\n    avisarPIH_(tPIH_(\"ris_nada_exportar\"), 6);\n    return;\n  }\n\n  const cabeceras = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0]\n    .map(String);\n\n  const posicionExportado =\n    asegurarColumnaPIH_(hoja, cabeceras, \"EXPORTADO_MENDELEY\");\n\n  asegurarColumnaPIH_(hoja, cabeceras, \"INCORPORADO_MENDELEY\");\n\n  SpreadsheetApp.flush();\n\n  const datos = hoja.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  const seleccion = [];\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n\n    const titulo = String(obtenerValorPIH_(fila, indice, \"TITULO\")).trim();\n\n    if (titulo === \"\") continue;\n\n    const estado = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    );\n\n    if (PIH_ESTADOS_EXPORTABLES.indexOf(estado) === -1) continue;\n\n    const incorporada = [\"si\", \"true\", \"yes\"].includes(\n      normalizarTextoPIH_(\n        obtenerValorPIH_(fila, indice, \"INCORPORADO_MENDELEY\")\n      )\n    );\n\n    if (incorporada) continue;\n\n    const yaExportada =\n      String(fila[indice.EXPORTADO_MENDELEY] || \"\").trim() !== \"\";\n\n    if (yaExportada && !incluirYaExportadas) continue;\n\n    seleccion.push({\n      numeroFila: i + 1,\n      titulo: titulo,\n      autores: obtenerValorPIH_(fila, indice, \"AUTORES\"),\n      ano: obtenerValorPIH_(fila, indice, \"ANO\"),\n      revista: obtenerValorPIH_(fila, indice, \"REVISTA_EDITORIAL\"),\n      tipo: obtenerValorPIH_(fila, indice, \"TIPO_DOCUMENTO\"),\n      idioma: obtenerValorPIH_(fila, indice, \"IDIOMA\"),\n      doi: obtenerValorPIH_(fila, indice, \"DOI\"),\n      url: obtenerValorPIH_(fila, indice, \"URL\"),\n      abstract: obtenerValorPIH_(fila, indice, \"ABSTRACT_ORIGINAL\"),\n      tematica: obtenerValorPIH_(fila, indice, \"TEMATICA_PRINCIPAL\"),\n      relevancia: obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\"),\n      estado: obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\"),\n      origen: obtenerValorPIH_(fila, indice, \"ORIGEN\")\n    });\n  }\n\n  if (seleccion.length === 0) {\n    avisarPIH_(tPIH_(\"ris_nada_estado\"), 12);\n    return;\n  }\n\n  if (MailApp.getRemainingDailyQuota() < 1) {\n    throw new Error(tPIH_(\"ris_cuota\"));\n  }\n\n  const ris = seleccion\n    .map(construirRegistroRISPIH_)\n    .join(\"\\r\\n\");\n\n  const zona = Session.getScriptTimeZone();\n  const ahora = new Date();\n\n  const nombreArchivo =\n    \"PIH_Referencias_\" +\n    Utilities.formatDate(ahora, zona, \"yyyy-MM-dd_HHmm\") +\n    \".ris\";\n\n  const adjunto = Utilities.newBlob(\n    ris,\n    \"application/x-research-info-systems\",\n    nombreArchivo\n  );\n\n  const destinatario = Session.getEffectiveUser().getEmail();\n\n  MailApp.sendEmail({\n    to: destinatario,\n    subject:\n      \"PIH · Exportación de referencias (\" + seleccion.length +\n      \" referencias)\",\n    body:\n      \"Adjunto el archivo \" + nombreArchivo + \" con \" + seleccion.length +\n      \" referencias.\\n\\n\" +\n      \"Para importarlo en tu gestor de referencias:\\n\" +\n      \"1. Descarga el archivo adjunto.\\n\" +\n      \"2. EndNote: File > Import > File, formato «Reference Manager (RIS)».\\n\" +\n      \"   Mendeley: + Add new > Import library > RIS (*.ris).\\n\" +\n      \"   Otros gestores: busca «Importar» y elige el formato RIS.\\n\" +\n      \"3. Revisa los datos importados (especialmente los autores).\\n\" +\n      \"4. Vuelve a la hoja y pulsa en el menú PIH Doctorado > \" +\n      \"Exportar archivo RIS > Marcar como importado.\\n\",\n    attachments: [adjunto],\n    name: \"PIH Doctorado\"\n  });\n\n  // Anotar la fecha de exportación.\n  seleccion.forEach(item => {\n    hoja.getRange(item.numeroFila, posicionExportado + 1).setValue(ahora);\n  });\n\n  hoja.getRange(2, posicionExportado + 1, hoja.getLastRow() - 1, 1)\n    .setNumberFormat(\"dd/mm/yyyy hh:mm\");\n\n  SpreadsheetApp.flush();\n\n  registrarLogPIH_(\n    \"EXPORTACION_RIS\",\n    \"COMPLETADO\",\n    seleccion.length,\n    \"Archivo \" + nombreArchivo + \" enviado a \" + destinatario\n  );\n\n  avisarPIH_(tPIH_(\"ris_enviado\", seleccion.length), 12);\n}\n\n\n// =====================================================\n// FORMATO RIS\n// =====================================================\n\nfunction construirRegistroRISPIH_(r) {\n\n  const tipo = tipoRISPIH_(r.tipo);\n  const lineas = [];\n\n  lineas.push(\"TY  - \" + tipo);\n  lineas.push(\"TI  - \" + limpiarRISPIH_(r.titulo));\n\n  String(r.autores || \"\")\n    .split(\";\")\n    .map(autor => autor.trim())\n    .filter(Boolean)\n    .forEach(autor => {\n      lineas.push(\"AU  - \" + nombreRISPIH_(autor));\n    });\n\n  if (r.ano) {\n    lineas.push(\"PY  - \" + limpiarRISPIH_(r.ano));\n  }\n\n  if (r.revista) {\n    lineas.push(\n      (tipo === \"JOUR\" ? \"JO  - \" : \"T2  - \") + limpiarRISPIH_(r.revista)\n    );\n  }\n\n  if (r.doi) {\n    lineas.push(\"DO  - \" + limpiarRISPIH_(r.doi));\n  }\n\n  if (r.url) {\n    lineas.push(\"UR  - \" + limpiarRISPIH_(r.url));\n  }\n\n  if (r.abstract) {\n    lineas.push(\"AB  - \" + limpiarRISPIH_(r.abstract));\n  }\n\n  if (r.idioma) {\n    lineas.push(\"LA  - \" + limpiarRISPIH_(r.idioma));\n  }\n\n  if (r.tematica) {\n    lineas.push(\"KW  - \" + limpiarRISPIH_(r.tematica));\n  }\n\n  const nota = [\n    \"PIH\",\n    r.relevancia !== \"\" ? \"relevancia \" + r.relevancia : \"\",\n    r.estado ? \"estado \" + r.estado : \"\",\n    r.origen ? r.origen : \"\"\n  ].filter(Boolean).join(\" · \");\n\n  lineas.push(\"N1  - \" + limpiarRISPIH_(nota));\n  lineas.push(\"ER  - \");\n  lineas.push(\"\");\n\n  return lineas.join(\"\\r\\n\");\n}\n\n\nfunction tipoRISPIH_(tipoDocumento) {\n\n  const tipo = normalizarTextoPIH_(tipoDocumento);\n\n  const equivalencias = {\n    \"article\": \"JOUR\",\n    \"review\": \"JOUR\",\n    \"book\": \"BOOK\",\n    \"book-chapter\": \"CHAP\",\n    \"dissertation\": \"THES\",\n    \"report\": \"RPRT\",\n    \"preprint\": \"UNPB\",\n    \"proceedings-article\": \"CONF\"\n  };\n\n  return equivalencias[tipo] || \"GEN\";\n}\n\n\n// Convierte \"Nombre Apellido\" en \"Apellido, Nombre\" (el último término\n// se toma como apellido). Con apellidos compuestos puede requerir\n// una corrección manual en Mendeley.\nfunction nombreRISPIH_(nombre) {\n\n  const texto = limpiarRISPIH_(nombre);\n\n  if (texto.indexOf(\",\") !== -1) return texto;\n\n  const partes = texto.split(\" \");\n\n  if (partes.length < 2) return texto;\n\n  const apellido = partes[partes.length - 1];\n  const nombrePila = partes.slice(0, -1).join(\" \");\n\n  return apellido + \", \" + nombrePila;\n}\n\n\nfunction limpiarRISPIH_(valor) {\n  return String(valor === null || valor === undefined ? \"\" : valor)\n    .replace(/[\\r\\n]+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n"}, {"name": "MendeleyAPI", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Mendeley automático mediante su API (OAuth 2.0)\n *\n * Qué hace: las publicaciones con ESTADO \"Para leer\" o\n * \"Leído\" se crean solas en tu biblioteca de Mendeley, dentro de una\n * carpeta llamada \"PIH Doctorado\", y en RADAR pasan a MENDELEY = Sí.\n *\n * Requisitos (ya hechos):\n *   - Aplicación registrada en dev.mendeley.com.\n *   - Propiedades MENDELEY_CLIENT_ID y MENDELEY_CLIENT_SECRET en las\n *     propiedades de la secuencia de comandos.\n *   - Biblioteca OAuth2 añadida con el identificador \"OAuth2\".\n *\n * Primera vez (una sola):\n *   1. Menú PIH Doctorado > Mendeley > Conectar con Mendeley.\n *   2. Menú PIH Doctorado > Mendeley > Probar la conexión.\n *   3. Menú PIH Doctorado > Enviar a Mendeley (automático).\n *   4. Si todo va bien: Mendeley > Activar envío automático.\n *\n * Si la API falla, el sistema anterior (archivo RIS por correo) sigue\n * disponible en el menú.\n *\n * Coste: 0 €. Usa la API gratuita de Mendeley. Si hay límite de uso (429)\n * se detiene y continúa en la siguiente ejecución.\n *\n * Depende de InterfazDoctorado.gs v5, Mendeley.gs (PIH_ESTADOS_EXPORTABLES)\n * y RadarAcademico.gs (registrarLogPIH_).\n */\n\nconst PIH_MENDELEY_API = \"https://api.mendeley.com\";\nconst PIH_MENDELEY_CARPETA = \"PIH Doctorado\";\nconst PIH_MENDELEY_LOTE = 25;\nconst PIH_MENDELEY_MAX_INTENTOS = 3;\nconst PIH_MENDELEY_TIEMPO_MAXIMO_MS = 240000;\n\nconst PIH_MIME_DOCUMENTO = \"application/vnd.mendeley-document.1+json\";\nconst PIH_MIME_CARPETA = \"application/vnd.mendeley-folder.1+json\";\n\n\n// =====================================================\n// CONEXIÓN (OAuth 2.0)\n// =====================================================\n\nfunction obtenerServicioMendeleyPIH_() {\n\n  const propiedades = PropertiesService.getScriptProperties();\n\n  const clientId = propiedades.getProperty(\"MENDELEY_CLIENT_ID\");\n  const clientSecret = propiedades.getProperty(\"MENDELEY_CLIENT_SECRET\");\n\n  if (!clientId || !clientSecret) {\n    throw new Error(tPIH_(\"me_falta_cred\"));\n  }\n\n  if (typeof OAuth2 === \"undefined\") {\n    throw new Error(tPIH_(\"me_falta_oauth\"));\n  }\n\n  return OAuth2.createService(\"mendeley\")\n    .setAuthorizationBaseUrl(PIH_MENDELEY_API + \"/oauth/authorize\")\n    .setTokenUrl(PIH_MENDELEY_API + \"/oauth/token\")\n    .setClientId(clientId.trim())\n    .setClientSecret(clientSecret.trim())\n    .setTokenHeaders({\n      Authorization:\n        \"Basic \" + Utilities.base64Encode(\n          clientId.trim() + \":\" + clientSecret.trim()\n        )\n    })\n    .setCallbackFunction(\"mendeleyCallbackPIH\")\n    .setPropertyStore(PropertiesService.getUserProperties())\n    .setCache(CacheService.getUserCache())\n    .setLock(LockService.getUserLock())\n    .setScope(\"all\");\n}\n\n\n// La ejecuta Google cuando vuelves de Mendeley tras dar el permiso.\nfunction mendeleyCallbackPIH(request) {\n\n  const servicio = obtenerServicioMendeleyPIH_();\n  const autorizado = servicio.handleCallback(request);\n\n  return HtmlService.createHtmlOutput(\n    autorizado\n      ? \"<p style='font-family:Arial'>✅ Mendeley conectado. \" +\n        \"Ya puedes cerrar esta pestaña y volver a la hoja.</p>\"\n      : \"<p style='font-family:Arial'>❌ Permiso denegado. \" +\n        \"Cierra esta pestaña e inténtalo de nuevo desde el menú.</p>\"\n  );\n}\n\n\n// Muestra el enlace para dar permiso a Mendeley (solo la primera vez).\nfunction conectarMendeleyPIH() {\n\n  const servicio = obtenerServicioMendeleyPIH_();\n\n  if (servicio.hasAccess()) {\n    avisarPIH_(tPIH_(\"me_ya\"), 6);\n    return;\n  }\n\n  const enlace = servicio.getAuthorizationUrl();\n\n  const html =\n    \"<div style='font-family:Arial;font-size:13px;line-height:1.5'>\" +\n    tPIH_(\"me_html\") +\n    \"<p><a href='\" + enlace + \"' target='_blank' \" +\n    \"style='font-size:15px'>\" + tPIH_(\"me_enlace\") + \"</a></p></div>\";\n\n  SpreadsheetApp.getUi().showModalDialog(\n    HtmlService.createHtmlOutput(envolverPIH_(html)).setWidth(420).setHeight(240),\n    tPIH_(\"me_dialogo\")\n  );\n}\n\n\n// Desconecta Mendeley (por si quieres volver a autorizar desde cero).\nfunction desconectarMendeleyPIH() {\n  obtenerServicioMendeleyPIH_().reset();\n  avisarPIH_(tPIH_(\"me_desconectado\"), 6);\n}\n\n\n// Comprueba que la conexión funciona.\nfunction probarConexionMendeleyPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n\n  try {\n    const servicio = obtenerServicioMendeleyPIH_();\n\n    if (!servicio.hasAccess()) {\n      ui.alert(\n        \"Mendeley\",\n        tPIH_(\"me_alert_no\"),\n        ui.ButtonSet.OK\n      );\n      return;\n    }\n\n    const respuesta = peticionMendeleyPIH_(\n      \"get\", \"/documents?limit=1\", null, null\n    );\n\n    const codigo = respuesta.getResponseCode();\n\n    ui.alert(\n      \"Mendeley\",\n      codigo === 200\n        ? tPIH_(\"me_ok\")\n        : tPIH_(\"me_api_codigo\", codigo, respuesta.getContentText().substring(0, 300)),\n      ui.ButtonSet.OK\n    );\n\n  } catch (e) {\n    ui.alert(\"Mendeley\", String(e.message || e), ui.ButtonSet.OK);\n  }\n}\n\n\n// =====================================================\n// PETICIONES A LA API\n// =====================================================\n\nfunction peticionMendeleyPIH_(metodo, ruta, tipoContenido, cuerpo) {\n\n  const servicio = obtenerServicioMendeleyPIH_();\n\n  if (!servicio.hasAccess()) {\n    throw new Error(tPIH_(\"me_no_conectado\"));\n  }\n\n  const opciones = {\n    method: metodo,\n    headers: {\n      Authorization: \"Bearer \" + servicio.getAccessToken(),\n      Accept: tipoContenido || PIH_MIME_DOCUMENTO\n    },\n    muteHttpExceptions: true\n  };\n\n  if (cuerpo !== null && cuerpo !== undefined) {\n    opciones.contentType = tipoContenido;\n    opciones.payload = JSON.stringify(cuerpo);\n  }\n\n  return UrlFetchApp.fetch(PIH_MENDELEY_API + ruta, opciones);\n}\n\n\nfunction errorMendeleyPIH_(accion, respuesta) {\n  return new Error(\n    \"Mendeley HTTP \" + respuesta.getResponseCode() + \" (\" + accion + \"): \" +\n    respuesta.getContentText().substring(0, 400)\n  );\n}\n\n\n// Clasifica un error: \"autorizacion\", \"cuota\", \"transitorio\" o \"contenido\".\nfunction tipoErrorMendeleyPIH_(e) {\n\n  const mensaje = String(e && e.message ? e.message : e);\n\n  if (/no está conectado|Faltan MENDELEY|Falta la biblioteca/i.test(mensaje)) {\n    return \"autorizacion\";\n  }\n\n  const http = mensaje.match(/Mendeley HTTP (\\d{3})/);\n\n  if (http) {\n    const codigo = Number(http[1]);\n\n    if (codigo === 401 || codigo === 403) return \"autorizacion\";\n    if (codigo === 429) return \"cuota\";\n    if (codigo >= 500) return \"transitorio\";\n\n    return \"contenido\";\n  }\n\n  if (/Exception|timed out|timeout|DNS|unavailable/i.test(mensaje)) {\n    return \"transitorio\";\n  }\n\n  return \"contenido\";\n}\n\n\n// =====================================================\n// CARPETA \"PIH Doctorado\"\n// =====================================================\n\nfunction obtenerCarpetaMendeleyPIH_() {\n\n  const propiedades = PropertiesService.getUserProperties();\n  const guardada = propiedades.getProperty(\"MENDELEY_CARPETA_ID\");\n\n  if (guardada) return guardada;\n\n  const respuesta = peticionMendeleyPIH_(\n    \"post\", \"/folders\", PIH_MIME_CARPETA, { name: PIH_MENDELEY_CARPETA }\n  );\n\n  const codigo = respuesta.getResponseCode();\n\n  if (codigo !== 201 && codigo !== 200) {\n    throw errorMendeleyPIH_(\"crear carpeta\", respuesta);\n  }\n\n  const id = JSON.parse(respuesta.getContentText()).id;\n\n  propiedades.setProperty(\"MENDELEY_CARPETA_ID\", id);\n\n  return id;\n}\n\n\n// =====================================================\n// CONVERSIÓN DE UNA PUBLICACIÓN\n// =====================================================\n\nfunction tipoMendeleyPIH_(tipoDocumento) {\n\n  const tipo = normalizarTextoPIH_(tipoDocumento);\n\n  const equivalencias = {\n    \"article\": \"journal\",\n    \"review\": \"journal\",\n    \"book\": \"book\",\n    \"book-chapter\": \"book_section\",\n    \"dissertation\": \"thesis\",\n    \"report\": \"report\",\n    \"preprint\": \"working_paper\",\n    \"proceedings-article\": \"conference_proceedings\"\n  };\n\n  return equivalencias[tipo] || \"generic\";\n}\n\n\n// \"Nombre Apellido\" -> { first_name, last_name } (el último término se\n// toma como apellido; con apellidos compuestos puede requerir corrección).\nfunction autorMendeleyPIH_(texto) {\n\n  const limpio = String(texto || \"\").replace(/\\s+/g, \" \").trim();\n\n  if (limpio.indexOf(\",\") !== -1) {\n    const partes = limpio.split(\",\");\n\n    return {\n      first_name: partes.slice(1).join(\",\").trim(),\n      last_name: partes[0].trim()\n    };\n  }\n\n  const palabras = limpio.split(\" \");\n\n  if (palabras.length < 2) {\n    return { first_name: \"\", last_name: limpio };\n  }\n\n  return {\n    first_name: palabras.slice(0, -1).join(\" \"),\n    last_name: palabras[palabras.length - 1]\n  };\n}\n\n\nfunction construirDocumentoMendeleyPIH_(r) {\n\n  const documento = {\n    title: String(r.titulo).trim(),\n    type: tipoMendeleyPIH_(r.tipo)\n  };\n\n  const autores = String(r.autores || \"\")\n    .split(\";\")\n    .map(a => a.trim())\n    .filter(Boolean)\n    .map(autorMendeleyPIH_)\n    .filter(a => a.last_name !== \"\");\n\n  if (autores.length) documento.authors = autores;\n\n  const anio = parseInt(r.ano, 10);\n\n  if (!isNaN(anio)) documento.year = anio;\n\n  if (r.revista) documento.source = String(r.revista).trim();\n\n  if (r.doi) documento.identifiers = { doi: String(r.doi).trim() };\n\n  if (r.abstract) documento.abstract = String(r.abstract).trim();\n\n  if (r.url) documento.websites = [String(r.url).trim()];\n\n  if (r.tematica) documento.keywords = [String(r.tematica).trim()];\n\n  const nota = [\n    \"PIH\",\n    r.relevancia !== \"\" ? \"relevancia \" + r.relevancia : \"\",\n    r.estado ? \"estado \" + r.estado : \"\"\n  ].filter(Boolean).join(\" · \");\n\n  documento.notes = nota;\n\n  return documento;\n}\n\n\n// =====================================================\n// ENVÍO A MENDELEY\n// =====================================================\n\n/**\n * Crea en Mendeley las publicaciones pendientes de enviar.\n * Devuelve { enviadas, errores, motivoParada, restantes }.\n */\nfunction sincronizarConMendeleyPIH() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    avisarPIH_(tPIH_(\"c_ocupado\"), 8);\n    return null;\n  }\n\n  try {\n    return ejecutarEnvioMendeleyPIH_();\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\nfunction ejecutarEnvioMendeleyPIH_() {\n\n  const inicio = Date.now();\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja) {\n    throw new Error(tPIH_(\"c_no_hoja_pub\"));\n  }\n\n  const resultado = {\n    enviadas: 0,\n    errores: [],\n    motivoParada: \"\",\n    restantes: 0\n  };\n\n  // Comprobar la conexión antes de nada.\n  let servicio;\n\n  try {\n    servicio = obtenerServicioMendeleyPIH_();\n  } catch (e) {\n    avisarPIH_(String(e.message || e), 12);\n    registrarLogPIH_(\"MENDELEY_API\", \"ERROR_CONFIGURACION\", 0, String(e.message));\n    resultado.motivoParada = \"autorizacion\";\n    return resultado;\n  }\n\n  if (!servicio.hasAccess()) {\n    avisarPIH_(tPIH_(\"me_no_conectado_aviso\"), 12);\n    registrarLogPIH_(\n      \"MENDELEY_API\", \"SIN_CONEXION\", 0,\n      \"Mendeley no está conectado: autoriza desde el menú.\"\n    );\n    resultado.motivoParada = \"autorizacion\";\n    return resultado;\n  }\n\n  if (hoja.getLastRow() < 2) return resultado;\n\n  const cabeceras = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0]\n    .map(String);\n\n  asegurarColumnaPIH_(hoja, cabeceras, \"INCORPORADO_MENDELEY\");\n  asegurarColumnaPIH_(hoja, cabeceras, \"MENDELEY_ID_DOCUMENTO\");\n\n  SpreadsheetApp.flush();\n\n  const datos = hoja.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  const columnaIncorporado = indice.INCORPORADO_MENDELEY;\n  const columnaIdDocumento = indice.MENDELEY_ID_DOCUMENTO;\n\n  // Seleccionar publicaciones por enviar.\n  const pendientes = [];\n  let totalPendientes = 0;\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n\n    const titulo = String(obtenerValorPIH_(fila, indice, \"TITULO\")).trim();\n\n    if (titulo === \"\") continue;\n\n    const estado = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    );\n\n    if (PIH_ESTADOS_EXPORTABLES.indexOf(estado) === -1) continue;\n\n    const incorporada = [\"si\", \"true\", \"yes\"].includes(\n      normalizarTextoPIH_(fila[columnaIncorporado])\n    );\n\n    if (incorporada) continue;\n\n    const marca = String(fila[columnaIdDocumento] || \"\").trim();\n\n    // Ya creada en Mendeley (el ID es el de Mendeley).\n    if (marca !== \"\" && !/^Error \\(/.test(marca)) continue;\n\n    const coincidencia = marca.match(/^Error \\((\\d+)\\)/);\n    const intentos = coincidencia ? Number(coincidencia[1]) : 0;\n\n    if (intentos >= PIH_MENDELEY_MAX_INTENTOS) continue;\n\n    totalPendientes++;\n\n    if (pendientes.length >= PIH_MENDELEY_LOTE) continue;\n\n    pendientes.push({\n      numeroFila: i + 1,\n      intentos: intentos,\n      titulo: titulo,\n      autores: obtenerValorPIH_(fila, indice, \"AUTORES\"),\n      ano: obtenerValorPIH_(fila, indice, \"ANO\"),\n      revista: obtenerValorPIH_(fila, indice, \"REVISTA_EDITORIAL\"),\n      tipo: obtenerValorPIH_(fila, indice, \"TIPO_DOCUMENTO\"),\n      doi: obtenerValorPIH_(fila, indice, \"DOI\"),\n      url: obtenerValorPIH_(fila, indice, \"URL\"),\n      abstract: obtenerValorPIH_(fila, indice, \"ABSTRACT_ORIGINAL\"),\n      tematica: obtenerValorPIH_(fila, indice, \"TEMATICA_PRINCIPAL\"),\n      relevancia: obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\"),\n      estado: obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    });\n  }\n\n  if (pendientes.length === 0) {\n    avisarPIH_(tPIH_(\"zo_nada\"), 10);\n    return resultado;\n  }\n\n  let carpetaId = \"\";\n\n  try {\n    carpetaId = obtenerCarpetaMendeleyPIH_();\n  } catch (e) {\n    const tipo = tipoErrorMendeleyPIH_(e);\n\n    if (tipo !== \"contenido\") {\n      resultado.motivoParada = tipo;\n      resultado.errores.push(\"Carpeta: \" + e.message);\n      return cerrarEnvioMendeleyPIH_(resultado, totalPendientes);\n    }\n\n    // Sin carpeta: se envían igualmente a la biblioteca.\n    resultado.errores.push(\"Carpeta no creada: \" + e.message);\n  }\n\n  for (const publicacion of pendientes) {\n\n    if (Date.now() - inicio > PIH_MENDELEY_TIEMPO_MAXIMO_MS) break;\n\n    try {\n\n      const respuesta = peticionMendeleyPIH_(\n        \"post\", \"/documents\", PIH_MIME_DOCUMENTO,\n        construirDocumentoMendeleyPIH_(publicacion)\n      );\n\n      const codigo = respuesta.getResponseCode();\n\n      if (codigo !== 201 && codigo !== 200) {\n        throw errorMendeleyPIH_(\"crear documento\", respuesta);\n      }\n\n      const idDocumento = JSON.parse(respuesta.getContentText()).id;\n\n      // Marcar como enviada de inmediato, para no duplicar.\n      hoja.getRange(publicacion.numeroFila, columnaIdDocumento + 1)\n        .setValue(idDocumento);\n\n      hoja.getRange(publicacion.numeroFila, columnaIncorporado + 1)\n        .setValue(\"Sí\");\n\n      SpreadsheetApp.flush();\n\n      resultado.enviadas++;\n\n      // Añadir a la carpeta (si falla, el documento ya está en Mendeley).\n      if (carpetaId) {\n        try {\n          const enCarpeta = peticionMendeleyPIH_(\n            \"post\", \"/folders/\" + carpetaId + \"/documents\",\n            PIH_MIME_DOCUMENTO, { id: idDocumento }\n          );\n\n          const codigoCarpeta = enCarpeta.getResponseCode();\n\n          if (codigoCarpeta === 404) {\n            // La carpeta ya no existe: se vuelve a crear la próxima vez.\n            PropertiesService.getUserProperties()\n              .deleteProperty(\"MENDELEY_CARPETA_ID\");\n            carpetaId = \"\";\n          }\n        } catch (errorCarpeta) {\n          resultado.errores.push(\n            \"Carpeta (\" + publicacion.titulo + \"): \" + errorCarpeta.message\n          );\n        }\n      }\n\n      Utilities.sleep(400);\n\n    } catch (e) {\n\n      resultado.errores.push(publicacion.titulo + \": \" + e.message);\n\n      const tipo = tipoErrorMendeleyPIH_(e);\n\n      if (tipo === \"contenido\") {\n        hoja.getRange(publicacion.numeroFila, columnaIdDocumento + 1)\n          .setValue(\"Error (\" + (publicacion.intentos + 1) + \")\");\n        continue;\n      }\n\n      resultado.motivoParada = tipo;\n      break;\n    }\n  }\n\n  return cerrarEnvioMendeleyPIH_(resultado, totalPendientes);\n}\n\n\nfunction cerrarEnvioMendeleyPIH_(resultado, totalPendientes) {\n\n  resultado.restantes = Math.max(totalPendientes - resultado.enviadas, 0);\n\n  let estado = \"COMPLETADO\";\n\n  if (resultado.motivoParada === \"autorizacion\") {\n    estado = \"ERROR_AUTORIZACION\";\n  } else if (resultado.motivoParada === \"cuota\") {\n    estado = \"LIMITE_ALCANZADO\";\n  } else if (resultado.motivoParada === \"transitorio\") {\n    estado = \"PAUSADO_ERROR_TEMPORAL\";\n  } else if (resultado.errores.length) {\n    estado = \"PARCIAL\";\n  }\n\n  registrarLogPIH_(\n    \"MENDELEY_API\",\n    estado,\n    resultado.enviadas,\n    resultado.errores.join(\" | \") || \"Sin errores\"\n  );\n\n  if (resultado.enviadas > 0 && typeof crearInterfazDoctorado === \"function\") {\n    crearInterfazDoctorado();\n  }\n\n  let mensaje = tPIH_(\"me_enviadas\", resultado.enviadas, resultado.restantes);\n\n  if (resultado.motivoParada === \"autorizacion\") {\n    mensaje += tPIH_(\"me_reconectar\");\n  } else if (resultado.motivoParada === \"cuota\") {\n    mensaje += tPIH_(\"zo_limite\");\n  } else if (resultado.motivoParada === \"transitorio\") {\n    mensaje += tPIH_(\"zo_temporal\");\n  } else if (resultado.errores.length) {\n    mensaje += tPIH_(\"zo_errores\");\n  }\n\n  avisarPIH_(mensaje, 12);\n\n  return resultado;\n}\n\n\n// =====================================================\n// AUTOMATIZACIÓN\n// =====================================================\n\n// Envío automático cada 6 horas.\nfunction activarEnvioAutomaticoMendeleyPIH() {\n\n  desactivarEnvioAutomaticoMendeleyPIH_();\n\n  ScriptApp.newTrigger(\"sincronizarConMendeleyPIH\")\n    .timeBased()\n    .everyHours(6)\n    .create();\n\n  avisarPIH_(tPIH_(\"me_auto_on\"), 8);\n}\n\n\nfunction desactivarEnvioAutomaticoMendeleyPIH() {\n\n  const eliminados = desactivarEnvioAutomaticoMendeleyPIH_();\n\n  avisarPIH_(tPIH_(\"me_auto_off\", eliminados), 6);\n}\n\n\nfunction desactivarEnvioAutomaticoMendeleyPIH_() {\n\n  let eliminados = 0;\n\n  ScriptApp.getProjectTriggers().forEach(activador => {\n    if (activador.getHandlerFunction() === \"sincronizarConMendeleyPIH\") {\n      ScriptApp.deleteTrigger(activador);\n      eliminados++;\n    }\n  });\n\n  return eliminados;\n}\n"}, {"name": "Menu", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Menú «PIH Doctorado» y guía rápida\n *\n * Añade un menú en la barra superior de Google Sheets para no tener que\n * abrir Apps Script ni buscar funciones por su nombre.\n *\n * El menú se crea al abrir el documento. La primera vez, o tras pegar este\n * archivo, recarga la página de Sheets (o ejecuta onOpen() una vez).\n *\n * Coste: 0 €.\n * Depende de Idiomas.gs (textos), InterfazDoctorado.gs v5, RadarAcademico.gs v2,\n * InteligenciaDoctorado.gs v3, Mendeley.gs y Zotero.gs.\n */\n\n// =====================================================\n// MENÚ\n// =====================================================\n\nfunction onOpen() {\n\n  construirMenuPIH_();\n\n  // Guía paso a paso (solo la primera vez de cada fase).\n  try {\n    tutorialAutomaticoPIH_();\n  } catch (e) {\n    console.log(\"Tutorial: \" + e.message);\n  }\n\n  // Cabeceras siempre en una sola línea (sin partir palabras).\n  try {\n    ajustarCabecerasUnaLineaPIH();\n  } catch (e) {\n    console.log(\"Cabeceras: \" + e.message);\n  }\n\n  // Aviso de versión nueva (si la comprobación diaria encontró una).\n  try {\n    avisarActualizacionPIH_();\n  } catch (e) {\n    console.log(\"Aviso de actualización: \" + e.message);\n  }\n\n  // Deja CONGRESOS ordenada (lo que llevas entre manos, arriba).\n  try {\n    ordenarCongresosPIH();\n  } catch (e) {\n    console.log(\"Orden de CONGRESOS: \" + e.message);\n  }\n}\n\n\n// Construye el menú en el idioma activo (también se llama al cambiar de idioma).\nfunction construirMenuPIH_() {\n\n  const ui = SpreadsheetApp.getUi();\n  const t = tPIH_;\n\n  ui.createMenu(\"PIH Doctorado\")\n    .addItem(t(\"m_configurar\"), \"menuConfigurarTesisPIH\")\n    .addSeparator()\n    .addItem(t(\"m_actualizar\"), \"menuActualizarVista\")\n    .addItem(t(\"m_buscar_base\"), \"menuBuscarEnBasePIH\")\n    .addItem(t(\"m_novedades\"), \"menuBuscarNovedades\")\n    .addItem(t(\"m_clasificar\"), \"menuClasificar\")\n    .addItem(t(\"m_gestor\"), \"enviarAGestorPIH\")\n    .addSubMenu(\n      ui.createMenu(t(\"m_ris\"))\n        .addItem(t(\"m_ris_enviar\"), \"exportarAMendeley\")\n        .addItem(t(\"m_ris_marcar\"), \"confirmarImportacionMendeley\")\n    )\n    .addItem(t(\"m_mapa\"), \"menuMapaHuecos\")\n    .addSeparator()\n    .addSubMenu(\n      ui.createMenu(t(\"m_revisar\"))\n        .addItem(t(\"m_autores\"), \"menuVigilarAutores\")\n        .addItem(t(\"m_fuentes\"), \"menuVigilarFuentes\")\n        .addItem(t(\"m_abiertas\"), \"cosecharFuentesAbiertasPIH\")\n        .addItem(t(\"m_congresos\"), \"recordarPlazosCongresosPIH\")\n        .addItem(t(\"m_resumen\"), \"enviarResumenSemanalPIH\")\n        .addSeparator()\n        .addItem(t(\"m_hist_continuar\"), \"continuarHistoricoPIH\")\n        .addItem(t(\"m_hist_estado\"), \"estadoHistoricoPIH\")\n    )\n    .addSubMenu(\n      ui.createMenu(t(\"m_ajustes\"))\n        .addItem(t(\"m_activar_todo\"), \"menuActivarTodoPIH\")\n        .addItem(t(\"m_desactivar_todo\"), \"menuDesactivarTodoPIH\")\n        .addSeparator()\n        .addItem(t(\"m_hist_activar\"), \"activarHistoricoAutomaticoPIH\")\n        .addItem(t(\"m_hist_desactivar\"), \"desactivarHistoricoAutomaticoPIH\")\n        .addSeparator()\n        .addItem(t(\"m_ab_activar\"), \"activarFuentesAbiertasPIH\")\n        .addItem(t(\"m_ab_desactivar\"), \"desactivarFuentesAbiertasPIH\")\n        .addItem(t(\"m_ab_probar\"), \"probarFuentesAbiertasPIH\")\n        .addSeparator()\n        .addItem(t(\"m_zo_conectar\"), \"conectarZoteroPIH\")\n        .addItem(t(\"m_zo_probar\"), \"probarConexionZoteroPIH\")\n        .addItem(t(\"m_zo_desconectar\"), \"desconectarZoteroPIH\")\n        .addSeparator()\n        .addItem(t(\"m_me_conectar\"), \"conectarMendeleyPIH\")\n        .addItem(t(\"m_me_probar\"), \"probarConexionMendeleyPIH\")\n        .addItem(t(\"m_me_desconectar\"), \"desconectarMendeleyPIH\")\n        .addSeparator()\n        .addItem(t(\"m_repuntuar\"), \"recalibrarPuntuacionesPIH\")\n        .addItem(t(\"m_diagnostico\"), \"diagnosticarRadarDoctorado\")\n    )\n    .addSeparator()\n    .addItem(t(\"m_idioma\"), \"menuElegirIdiomaPIH\")\n    .addSubMenu(\n      ui.createMenu(t(\"m_guia\"))\n        .addItem(t(\"m_guia_inicio\"), \"menuTutorialInicioPIH\")\n        .addItem(t(\"m_guia_listo\"), \"menuTutorialListoPIH\")\n    )\n    .addItem(t(\"m_guia_rapida\"), \"mostrarGuiaRapidaPIH\")\n    .addItem(tActPIH_(\"m_act\"), \"menuActualizacionPIH\")\n    .addItem(gPIH_(\"gl_menu\"), \"menuGuiaHojasPIH\")\n    .addToUi();\n}\n\n\n// =====================================================\n// ACCIONES DEL MENÚ\n// =====================================================\n\nfunction menuActualizarVista() {\n  ejecutarDesdeMenuPIH_(() => {\n    crearInterfazDoctorado();\n  });\n}\n\n\nfunction menuBuscarNovedades() {\n  ejecutarDesdeMenuPIH_(() => {\n    avisarPIH_(tPIH_(\"a_buscando\"), 5);\n\n    const resultado = ejecutarRadarDiario();\n\n    if (resultado.nuevos > 0) {\n      crearInterfazDoctorado();\n    }\n\n    let mensaje = tPIH_(\"a_nuevos\", resultado.nuevos);\n\n    if (resultado.nuevos > 0) {\n      mensaje += tPIH_(\"a_nuevos_clasificar\");\n    }\n\n    if (resultado.limiteAlcanzado) {\n      mensaje += tPIH_(\"a_limite_openalex\");\n    }\n\n    avisarPIH_(mensaje, 12);\n  });\n}\n\n\nfunction menuClasificar() {\n  ejecutarDesdeMenuPIH_(() => {\n    avisarPIH_(tPIH_(\"a_clasificando\"), 8);\n    clasificarPendientesPIH();\n  });\n}\n\n\nfunction menuVigilarFuentes() {\n  ejecutarDesdeMenuPIH_(() => {\n    avisarPIH_(tPIH_(\"a_fuentes\"), 5);\n    vigilarFuentesPrimariasPIH();\n  });\n}\n\n\nfunction menuVigilarAutores() {\n  ejecutarDesdeMenuPIH_(() => {\n    avisarPIH_(tPIH_(\"a_autores\"), 5);\n\n    const resultado = vigilarAutoresClavePIH();\n\n    if (resultado && resultado.nuevos > 0) {\n      crearInterfazDoctorado();\n    }\n  });\n}\n\n\nfunction menuMapaHuecos() {\n  ejecutarDesdeMenuPIH_(() => {\n    avisarPIH_(tPIH_(\"a_mapa\"), 5);\n    construirMapaHuecosPIH();\n  });\n}\n\n\n// Ejecuta una acción y, si falla, muestra un mensaje claro en lugar de\n// un error técnico.\nfunction ejecutarDesdeMenuPIH_(accion) {\n  try {\n    accion();\n  } catch (e) {\n    const ui = SpreadsheetApp.getUi();\n\n    ui.alert(\n      tPIH_(\"a_error_titulo\"),\n      String(e && e.message ? e.message : e) + tPIH_(\"a_error_pie\"),\n      ui.ButtonSet.OK\n    );\n  }\n}\n\n\n// =====================================================\n// ACTIVAR / DESACTIVAR TODA LA AUTOMATIZACIÓN\n// =====================================================\n\nfunction menuActivarTodoPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n\n  const respuesta = ui.alert(\n    tPIH_(\"act_titulo\"),\n    tPIH_(\"act_texto\"),\n    ui.ButtonSet.YES_NO\n  );\n\n  if (respuesta !== ui.Button.YES) return;\n\n  const pasos = [\n    [tPIH_(\"p_radar\"), configurarAutomatizacionDiaria],\n    [tPIH_(\"p_gestor\"), activarEnvioAutomaticoGestorPIH],\n    [tPIH_(\"p_resumen\"), activarResumenSemanalPIH],\n    [tPIH_(\"p_congresos\"), activarRecordatorioCongresosPIH],\n    [tPIH_(\"p_fuentes\"), activarVigilanciaFuentesPIH],\n    [tPIH_(\"p_autores\"), activarVigilanciaAutoresPIH]\n  ];\n\n  ejecutarPasosPIH_(pasos, tPIH_(\"act_ok\"));\n}\n\n\nfunction menuDesactivarTodoPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n\n  const respuesta = ui.alert(\n    tPIH_(\"des_titulo\"),\n    tPIH_(\"des_texto\"),\n    ui.ButtonSet.YES_NO\n  );\n\n  if (respuesta !== ui.Button.YES) return;\n\n  const pasos = [\n    [tPIH_(\"p_radar\"), desactivarAutomatizacionPIH],\n    [tPIH_(\"p_gestor\"), desactivarEnvioAutomaticoGestorPIH],\n    [tPIH_(\"p_resumen\"), desactivarResumenSemanalPIH],\n    [tPIH_(\"p_congresos\"), desactivarRecordatorioCongresosPIH],\n    [tPIH_(\"p_fuentes\"), desactivarVigilanciaFuentesPIH],\n    [tPIH_(\"p_autores\"), desactivarVigilanciaAutoresPIH],\n    [tPIH_(\"p_abiertas\"), desactivarFuentesAbiertasPIH],\n    [tPIH_(\"p_historico\"), desactivarHistoricoAutomaticoPIH]\n  ];\n\n  ejecutarPasosPIH_(pasos, tPIH_(\"des_ok\"));\n}\n\n\n// Ejecuta cada paso por separado: si uno falla, los demás siguen.\nfunction ejecutarPasosPIH_(pasos, titulo) {\n\n  const ui = SpreadsheetApp.getUi();\n\n  const resultados = pasos.map(paso => {\n    try {\n      paso[1]();\n      return \"✔ \" + paso[0];\n    } catch (e) {\n      return \"✖ \" + paso[0] + \": \" + String(e && e.message ? e.message : e);\n    }\n  });\n\n  ui.alert(titulo, resultados.join(\"\\n\"), ui.ButtonSet.OK);\n}\n\n\n// =====================================================\n// GUÍA RÁPIDA\n// =====================================================\n\nfunction mostrarGuiaRapidaPIH() {\n\n  const html =\n    '<div style=\"font-family: Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #202124;\">' +\n    tPIH_(\"guia_html\") +\n    '</div>';\n\n  SpreadsheetApp.getUi().showModalDialog(\n    HtmlService.createHtmlOutput(envolverPIH_(html)).setWidth(520).setHeight(560),\n    tPIH_(\"guia_titulo\")\n  );\n}\n\n\n// Menú: crea la guía de pestañas y columnas y la muestra.\nfunction menuGuiaHojasPIH() {\n  crearGuiaHojasPIH(false);\n  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(PIH_AYUDA_HOJA);\n  if (hoja) hoja.activate();\n}\n"}, {"name": "Perfil", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB · PLANTILLA PARA DOCTORANDOS\n * Perfil.gs · Asistente «Configurar mi tesis»\n *\n * Qué hace:\n *   1. Abre un formulario donde la persona escribe el resumen de su tesis,\n *      sus palabras clave, sus casos o instituciones de estudio y su idioma.\n *   2. Guarda sus claves gratuitas (Gemini y OpenAlex) en las «Propiedades\n *      del script» (nunca en la hoja, así no viajan si copia el documento).\n *   3. Pide a Gemini que genere el perfil: consultas de búsqueda, términos\n *      de filtro, contexto para la IA y bloques del mapa de huecos.\n *   4. Escribe todo en la pestaña PERFIL, donde se puede revisar y corregir.\n *\n * El resto de archivos leen de PERFIL con obtenerPerfilPIH().\n *\n * Coste: 0 €. Usa solo la API gratuita de Gemini.\n *\n * @OnlyCurrentDoc  (limita el permiso a ESTE documento, no a todas tus hojas)\n * Depende de InteligenciaDoctorado.gs (llamarGeminiPIH_, PIH_GEMINI_MODEL)\n * y de Idiomas.gs (textos en el idioma elegido).\n */\n\nconst PIH_PERFIL_HOJA = \"PERFIL\";\n\n// Campos que rellena la persona en el formulario.\nconst PIH_PERFIL_CAMPOS_USUARIO = [\n  [\"titulo\", \"Título o tema de la tesis\"],\n  [\"disciplina\", \"Disciplina\"],\n  [\"resumen\", \"Resumen de la tesis\"],\n  [\"palabras_clave\", \"Palabras clave\"],\n  [\"casos\", \"Casos concretos que estudias (opcional)\"],\n  [\"idioma_local\", \"Idioma local de búsqueda\"],\n  [\"gestor_referencias\", \"Gestor de referencias\"]\n];\n\n// Campos que genera la IA (la persona puede editarlos en la hoja).\nconst PIH_PERFIL_CAMPOS_IA = [\n  [\"contexto_tesis\", \"Contexto que se da a la IA al clasificar\"],\n  [\"rasgos_casos\", \"Rasgos de cada caso o institución (uno por línea)\"],\n  [\"consultas_radar\", \"Consultas del radar diario (una por línea)\"],\n  [\"consultas_historico\", \"Consultas del radar histórico (una por línea)\"],\n  [\"terminos_filtro\", \"Términos para filtrar fuentes abiertas (uno por línea)\"],\n  [\"bloques_mapa\", \"Bloques del mapa de huecos (nombre | claves | búsqueda)\"]\n];\n\n\n// =====================================================\n// FORMULARIO\n// =====================================================\n\nfunction menuConfigurarTesisPIH() {\n\n  const t = tPIH_;\n\n  const opcionesIdioma = idiomasDisponiblesPIH_().map(p =>\n    '<option value=\"' + p[0] + '\"' + (p[0] === idiomaPIH_() ? \" selected\" : \"\") + \">\" +\n    p[1] + \"</option>\"\n  ).join(\"\");\n\n  const html = `\n<div style=\"font-family: Arial, sans-serif; font-size: 13px; color: #202124;\">\n\n  <label><b>${t(\"w_idioma\")}</b> / Language</label><br>\n  <select id=\"ui_idioma\" onchange=\"cambiarIdioma(this.value)\" style=\"margin-bottom:10px;\">${opcionesIdioma}</select>\n\n  <p style=\"margin: 0 0 10px;\">${t(\"w_intro\")}</p>\n\n  <label><b>${t(\"w_tema\")}</b></label><br>\n  <input id=\"titulo\" style=\"width:100%; margin-bottom:8px;\"><br>\n\n  <label><b>${t(\"w_disciplina\")}</b> ${t(\"w_disciplina_ej\")}</label><br>\n  <input id=\"disciplina\" style=\"width:100%; margin-bottom:8px;\"><br>\n\n  <label><b>${t(\"w_resumen\")}</b> ${t(\"w_resumen_ej\")}</label><br>\n  <textarea id=\"resumen\" rows=\"6\" style=\"width:100%; margin-bottom:8px;\"></textarea><br>\n\n  <label><b>${t(\"w_claves\")}</b> ${t(\"w_claves_ej\")}</label><br>\n  <input id=\"palabras_clave\" style=\"width:100%; margin-bottom:8px;\"><br>\n\n  <label><b>${t(\"w_casos\")}</b> ${t(\"w_opcional\")}</label><br>\n  <input id=\"casos\" placeholder=\"${t(\"w_casos_ph\")}\" style=\"width:100%;\"><br>\n  <small style=\"color:#5f6368;\">${t(\"w_casos_ayuda\")}</small><br><div style=\"margin-bottom:8px;\"></div>\n\n  <label><b>${t(\"w_idioma_local\")}</b> ${t(\"w_idioma_local_ej\")}</label><br>\n  <input id=\"idioma_local\" value=\"${t(\"w_idioma_local_valor\")}\" style=\"width:100%; margin-bottom:8px;\"><br>\n\n  <label><b>${t(\"w_gestor\")}</b></label><br>\n  <select id=\"gestor_referencias\" style=\"margin-bottom:8px;\">\n    <option value=\"Zotero\">Zotero</option>\n    <option value=\"Mendeley\">Mendeley</option>\n    <option value=\"Ninguno\">${t(\"w_gestor_ninguno\")}</option>\n  </select><br>\n\n  <label><b>${t(\"w_gemini\")}</b> ${t(\"w_gemini_ej\")}</label><br>\n  <input id=\"clave_gemini\" type=\"password\" style=\"width:100%; margin-bottom:8px;\"><br>\n\n  <label><b>${t(\"w_openalex\")}</b> ${t(\"w_openalex_ej\")}</label><br>\n  <input id=\"clave_openalex\" type=\"password\" style=\"width:100%; margin-bottom:12px;\"><br>\n\n  <button id=\"boton\" onclick=\"enviar()\"\n    style=\"background:#24445C; color:white; border:0; padding:8px 16px;\">\n    ${t(\"w_guardar\")}</button>\n\n  <p id=\"estado\" style=\"margin-top:10px; color:#5f6368;\"></p>\n\n  <button id=\"siguiente\" onclick=\"google.script.run.menuTutorialListoPIH()\"\n    style=\"display:none; background:#1B7F6B; color:white; border:0; padding:8px 16px;\">\n    ${t(\"w_siguientes\")}</button>\n\n</div>\n\n<script>\n  var TEXTO_GENERANDO = ${JSON.stringify(t(\"w_generando\")).replace(/</g, \"\\\\u003c\")};\n\n  function cambiarIdioma(codigo) {\n    google.script.run\n      .withSuccessHandler(function () {\n        google.script.run.menuConfigurarTesisPIH();\n      })\n      .cambiarIdiomaPIH(codigo);\n  }\n\n  function enviar() {\n    var ids = [\"titulo\",\"disciplina\",\"resumen\",\"palabras_clave\",\"casos\",\n               \"idioma_local\",\"gestor_referencias\",\"clave_gemini\",\"clave_openalex\"];\n    var datos = {};\n    ids.forEach(function (id) {\n      datos[id] = document.getElementById(id).value;\n    });\n\n    document.getElementById(\"boton\").disabled = true;\n    document.getElementById(\"estado\").innerText = TEXTO_GENERANDO;\n\n    google.script.run\n      .withSuccessHandler(function (mensaje) {\n        document.getElementById(\"estado\").innerText = mensaje;\n        document.getElementById(\"siguiente\").style.display = \"inline-block\";\n      })\n      .withFailureHandler(function (error) {\n        document.getElementById(\"estado\").innerText = String(error.message).replace(/^(Error: )+/, \"Error: \");\n        document.getElementById(\"boton\").disabled = false;\n      })\n      .guardarFormularioPerfilPIH(datos);\n  }\n</script>`;\n\n  SpreadsheetApp.getUi().showModalDialog(\n    HtmlService.createHtmlOutput(envolverPIH_(html)).setWidth(560).setHeight(720),\n    t(\"w_titulo\")\n  );\n}\n\n\n/**\n * Recibe el formulario, guarda las claves, genera el perfil y lo escribe.\n */\nfunction guardarFormularioPerfilPIH(datos) {\n\n  const resumen = String(datos.resumen || \"\").trim();\n  const claves = String(datos.palabras_clave || \"\").trim();\n\n  if (resumen.length < 200 && claves.length < 10) {\n    throw new Error(tPIH_(\"w_error_corto\"));\n  }\n\n  const props = PropertiesService.getScriptProperties();\n\n  // Las claves solo se guardan si la persona las escribe (si ya estaban,\n  // se conservan).\n  const gemini = String(datos.clave_gemini || \"\").trim();\n  const openalex = String(datos.clave_openalex || \"\").trim();\n\n  if (gemini) props.setProperty(\"GEMINI_API_KEY\", gemini);\n  if (openalex) props.setProperty(\"OPENALEX_API_KEY\", openalex);\n\n  const apiKey = props.getProperty(\"GEMINI_API_KEY\");\n\n  if (!apiKey) {\n    throw new Error(tPIH_(\"w_error_gemini\"));\n  }\n\n  const perfilIA = generarPerfilIAPIH_(datos, apiKey);\n\n  escribirPerfilPIH_(datos, perfilIA);\n\n  // Crea las pestañas básicas (vacías) si todavía no existen.\n  prepararPlantillaPIH_();\n\n  return tPIH_(\"w_listo\");\n}\n\n\n// =====================================================\n// GENERACIÓN CON GEMINI\n// =====================================================\n\nfunction generarPerfilIAPIH_(datos, apiKey) {\n\n  const prompt = `\nEres un bibliotecario académico experto. Una persona prepara una tesis doctoral\ny necesitas configurar un sistema automático de vigilancia bibliográfica.\n\nDATOS DE LA TESIS\nTítulo o tema: ${datos.titulo || \"(no indicado)\"}\nDisciplina: ${datos.disciplina || \"(no indicada)\"}\nResumen: ${datos.resumen || \"(no indicado)\"}\nPalabras clave: ${datos.palabras_clave || \"(no indicadas)\"}\nCasos, instituciones o ámbito: ${datos.casos || \"(no indicados)\"}\nIdioma local además del inglés: ${datos.idioma_local || \"español\"}\n\nDevuelve SOLO un JSON con estas claves:\n\n{\n  \"contexto_tesis\": \"4-6 frases en ${nombreIdiomaIAPIH_()} que describen la tesis, su pregunta, enfoque y casos, para que otra IA pueda juzgar si un artículo es relevante.\",\n  \"rasgos_casos\": [\"una línea por caso o institución: nombre y 2-4 rasgos que lo definen (tipo de institución, titularidad, tensión principal)\"],\n  \"consultas_radar\": [\"entre 18 y 22 consultas cortas (3-7 palabras) para OpenAlex, la mayoría en inglés y 4-5 en el idioma local; cubren el tema central, cada caso y los enfoques teóricos\"],\n  \"consultas_historico\": [\"entre 22 y 28 consultas, las anteriores más 4-6 variantes más amplias\"],\n  \"terminos_filtro\": [\"entre 12 y 20 términos en minúsculas, sin acentos obligatorios, en inglés y en el idioma local, para filtrar títulos de repositorios de tesis\"],\n  \"bloques_mapa\": [\n    {\"nombre\": \"bloque temático de la tesis\", \"claves\": [\"5-8 palabras clave en minúsculas, en inglés y en el idioma local\"], \"busqueda\": \"consulta en inglés para buscar bibliografía de este bloque\"}\n  ]\n}\n\nReglas:\n- \"bloques_mapa\": entre 7 y 10 bloques que cubran todos los capítulos probables de la tesis (marco teórico, métodos, cada caso, etc.).\n- No inventes autores ni obras.\n- Usa vocabulario real de la disciplina.\n`;\n\n  const resultado = llamarGeminiPIH_(prompt, apiKey, 8000);\n\n  const listas = [\"rasgos_casos\", \"consultas_radar\", \"consultas_historico\",\n                  \"terminos_filtro\", \"bloques_mapa\"];\n\n  listas.forEach(clave => {\n    if (!Array.isArray(resultado[clave]) || resultado[clave].length === 0) {\n      throw new Error(tPIH_(\"w_error_ia\", clave));\n    }\n  });\n\n  if (!resultado.contexto_tesis) {\n    throw new Error(tPIH_(\"w_error_contexto\"));\n  }\n\n  return resultado;\n}\n\n\n// =====================================================\n// ESCRITURA Y LECTURA DE LA PESTAÑA PERFIL\n// =====================================================\n\nfunction escribirPerfilPIH_(datos, perfilIA) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n\n  let hoja = ss.getSheetByName(PIH_PERFIL_HOJA);\n  if (!hoja) hoja = ss.insertSheet(PIH_PERFIL_HOJA);\n\n  hoja.clear();\n  PIH_PERFIL_CACHE = null;\n\n  const filas = [tPIH_(\"pf_cabecera\")];\n\n  PIH_PERFIL_CAMPOS_USUARIO.forEach(par => {\n    filas.push([par[0], tPIH_(\"pf_\" + par[0]), String(datos[par[0]] || \"\")]);\n  });\n\n  const comoLineas = valor =>\n    Array.isArray(valor) ? valor.map(String).join(\"\\n\") : String(valor || \"\");\n\n  const bloques = (perfilIA.bloques_mapa || []).map(b =>\n    String(b.nombre || \"\") + \" | \" +\n    (Array.isArray(b.claves) ? b.claves.join(\", \") : String(b.claves || \"\")) +\n    \" | \" + String(b.busqueda || \"\")\n  );\n\n  const valoresIA = {\n    contexto_tesis: perfilIA.contexto_tesis,\n    rasgos_casos: comoLineas(perfilIA.rasgos_casos),\n    consultas_radar: comoLineas(perfilIA.consultas_radar),\n    consultas_historico: comoLineas(perfilIA.consultas_historico),\n    terminos_filtro: comoLineas(perfilIA.terminos_filtro),\n    bloques_mapa: bloques.join(\"\\n\")\n  };\n\n  PIH_PERFIL_CAMPOS_IA.forEach(par => {\n    filas.push([par[0], tPIH_(\"pf_\" + par[0]), valoresIA[par[0]]]);\n  });\n\n  hoja.getRange(1, 1, filas.length, 3).setValues(filas);\n\n  hoja.getRange(1, 1, 1, 3)\n    .setFontWeight(\"bold\")\n    .setBackground(\"#24445C\")\n    .setFontColor(\"#FFFFFF\");\n\n  hoja.setColumnWidth(1, 170);\n  hoja.setColumnWidth(2, 260);\n  hoja.setColumnWidth(3, 620);\n\n  hoja.getRange(2, 1, filas.length - 1, 3)\n    .setVerticalAlignment(\"top\")\n    .setWrap(true);\n\n  hoja.getRange(2, 3, filas.length - 1, 1).setBackground(\"#FFFDE7\");\n\n  hoja.setFrozenRows(1);\n\n  hoja.getRange(filas.length + 2, 1).setValue(tPIH_(\"pf_nota\"));\n}\n\n\n/**\n * Devuelve el perfil como objeto. Las listas vienen ya separadas en\n * arrays. Si PERFIL no existe o una clave está vacía, devuelve \"porDefecto\".\n */\nlet PIH_PERFIL_CACHE = null;\n\nfunction obtenerPerfilPIH() {\n\n  if (PIH_PERFIL_CACHE) return PIH_PERFIL_CACHE;\n\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(PIH_PERFIL_HOJA);\n\n  const perfil = {};\n\n  if (!hoja || hoja.getLastRow() < 2) return perfil;\n\n  PIH_PERFIL_CACHE = perfil;\n\n  const datos = hoja.getRange(2, 1, hoja.getLastRow() - 1, 3).getValues();\n\n  datos.forEach(fila => {\n    const clave = String(fila[0] || \"\").trim();\n    if (clave) perfil[clave] = String(fila[2] || \"\").trim();\n  });\n\n  return perfil;\n}\n\n\n/**\n * Devuelve una lista (una línea = un elemento) del perfil, o la lista\n * por defecto si el perfil aún no está configurado.\n */\nfunction listaPerfilPIH_(clave, porDefecto) {\n\n  const perfil = obtenerPerfilPIH();\n  const texto = perfil[clave];\n\n  if (!texto) return porDefecto || [];\n\n  return texto\n    .split(\"\\n\")\n    .map(linea => linea.trim())\n    .filter(Boolean);\n}\n\n\n/**\n * Devuelve un texto del perfil o el valor por defecto.\n */\nfunction textoPerfilPIH_(clave, porDefecto) {\n  const perfil = obtenerPerfilPIH();\n  return perfil[clave] || porDefecto || \"\";\n}\n\n\n/**\n * Devuelve los bloques del mapa de huecos como objetos\n * {nombre, claves[], busqueda}, o la lista por defecto.\n */\nfunction bloquesMapaPerfilPIH_(porDefecto) {\n\n  const lineas = listaPerfilPIH_(\"bloques_mapa\", null);\n\n  if (!lineas || lineas.length === 0) return porDefecto || [];\n\n  const bloques = lineas\n    .map(linea => linea.split(\"|\").map(parte => parte.trim()))\n    .filter(partes => partes.length >= 3 && partes[0])\n    .map(partes => ({\n      nombre: partes[0],\n      claves: partes[1].split(\",\").map(c => c.trim().toLowerCase()).filter(Boolean),\n      busqueda: partes[2]\n    }));\n\n  return bloques.length ? bloques : (porDefecto || []);\n}\n"}, {"name": "RadarAcademico", "type": "SERVER_JS", "source": "/**\n * PIH — RADAR ACADÉMICO v2\n * Fuente: OpenAlex (clave gratuita).\n *\n * Busca publicaciones recientes, reconstruye abstracts,\n * evita duplicados y registra los resultados en PUBLICACIONES.\n *\n * Funciones que puedes ejecutar a mano:\n *   - ejecutarRadarAcademico()            -> búsqueda con la ventana de CONFIG\n *                                            (VENTANA_DIAS, 90 días por defecto)\n *   - ejecutarRadarDiario()               -> búsqueda de los últimos días\n *                                            (VENTANA_DIARIA_DIAS, 7 por defecto)\n *   - procesoDiarioPIH()                  -> radar diario + clasificación IA\n *   - continuarClasificacionPIH()         -> solo clasificación IA de pendientes\n *   - configurarAutomatizacionDiaria()    -> activa la ejecución automática\n *   - desactivarAutomatizacionPIH()       -> la desactiva\n *\n * Coste: 0 €. Si OpenAlex o Gemini alcanzan su límite gratuito, el proceso\n * se detiene sin error y se reanuda solo en la siguiente ejecución.\n *\n * Depende de InterfazDoctorado.gs v4 (PIH_RADAR_CONFIG y utilidades).\n */\n\n// =====================================================\n// BÚSQUEDA EN OPENALEX\n// =====================================================\n\nfunction ejecutarRadarAcademico() {\n  return buscarNovedadesPIH_({\n    proceso: \"RADAR_ACADEMICO\",\n    claveVentana: \"VENTANA_DIAS\",\n    ventanaPorDefecto: 90\n  });\n}\n\n\nfunction ejecutarRadarDiario() {\n  return buscarNovedadesPIH_({\n    proceso: \"RADAR_DIARIO\",\n    claveVentana: \"VENTANA_DIARIA_DIAS\",\n    ventanaPorDefecto: 7\n  });\n}\n\n\n/**\n * Núcleo de la búsqueda. Devuelve { nuevos, limiteAlcanzado, errores }.\n */\nfunction buscarNovedadesPIH_(opciones) {\n  const inicio = new Date();\n  let nuevos = 0;\n  let limiteAlcanzado = false;\n  const errores = [];\n\n  try {\n    const ss = SpreadsheetApp.getActiveSpreadsheet();\n    const config = obtenerConfiguracionPIH_();\n    const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n    if (!hoja) throw new Error(tPIH_(\"c_no_hoja_pub\"));\n\n    const apiKey = PropertiesService\n      .getScriptProperties()\n      .getProperty(\"OPENALEX_API_KEY\");\n\n    if (!apiKey) {\n      throw new Error(tPIH_(\"c_falta_openalex\"));\n    }\n\n    // Añadir campos nuevos sin modificar los existentes.\n    asegurarColumnasPIH_(hoja, [\n      \"INCORPORADO_MENDELEY\",\n      \"NIVEL_ANALISIS_IA\",\n      \"CONFIANZA_ANALISIS\",\n      \"ORIGEN\"\n    ]);\n\n    const encabezados = hoja\n      .getRange(1, 1, 1, hoja.getLastColumn())\n      .getValues()[0];\n\n    const existentes = obtenerIdentificadoresExistentes_(hoja, encabezados);\n\n    const ventanaDias = Number(\n      config[opciones.claveVentana] || opciones.ventanaPorDefecto\n    );\n\n    const fechaDesde = new Date();\n    fechaDesde.setDate(fechaDesde.getDate() - ventanaDias);\n\n    const desde = Utilities.formatDate(\n      fechaDesde,\n      Session.getScriptTimeZone(),\n      \"yyyy-MM-dd\"\n    );\n\n    const limite = Number(config.MAX_RESULTADOS || 50);\n\n    // Consultas de tu perfil (pestaña PERFIL).\n    const consultas = listaPerfilPIH_(\"consultas_radar\", []);\n\n    if (consultas.length === 0) {\n      throw new Error(tPIH_(\"c_falta_tesis\"));\n    }\n\n\n    const resultados = [];\n\n    for (const consulta of consultas) {\n      if (resultados.length >= limite) break;\n\n      try {\n        const url =\n          \"https://api.openalex.org/works\" +\n          \"?search=\" + encodeURIComponent(consulta) +\n          \"&filter=from_publication_date:\" + desde +\n          \"&per_page=25\" +\n          \"&sort=publication_date:desc\" +\n          \"&select=id,doi,title,authorships,publication_year,\" +\n          \"publication_date,primary_location,type,language,\" +\n          \"abstract_inverted_index,cited_by_count,open_access\" +\n          \"&api_key=\" + encodeURIComponent(apiKey);\n\n        const respuesta = UrlFetchApp.fetch(url, {\n          muteHttpExceptions: true\n        });\n\n        const codigo = respuesta.getResponseCode();\n\n        // Límite gratuito de OpenAlex: parar sin error.\n        if (codigo === 429) {\n          limiteAlcanzado = true;\n          throw new Error(\"OpenAlex HTTP 429 (límite gratuito alcanzado)\");\n        }\n\n        if (codigo !== 200) {\n          throw new Error(\"OpenAlex HTTP \" + codigo);\n        }\n\n        const datos = JSON.parse(respuesta.getContentText());\n\n        for (const obra of (datos.results || [])) {\n          const id = obra.id || \"\";\n          const doi = normalizarDOI_(obra.doi);\n\n          if (!id) continue;\n          if (existentes.ids.has(id)) continue;\n          if (doi && existentes.dois.has(doi)) continue;\n\n          resultados.push({\n            obra: obra,\n            consulta: consulta\n          });\n\n          existentes.ids.add(id);\n          if (doi) existentes.dois.add(doi);\n\n          if (resultados.length >= limite) break;\n        }\n\n      } catch (e) {\n        errores.push(consulta + \": \" + e.message);\n      }\n\n      if (limiteAlcanzado) break;\n    }\n\n    const filas = resultados.map(item =>\n      convertirPublicacionPIH_(\n        item.obra,\n        item.consulta,\n        inicio,\n        PIH_RADAR_CONFIG.origenDiario\n      )\n    );\n\n    if (filas.length) {\n      const matriz = filas.map(registro =>\n        encabezados.map(h =>\n          valorRegistroPIH_(registro, h)\n        )\n      );\n\n      asegurarFilasHojaPIH_(hoja, hoja.getLastRow() + matriz.length);\n\n      hoja.getRange(\n        hoja.getLastRow() + 1,\n        1,\n        matriz.length,\n        encabezados.length\n      ).setValues(matriz);\n\n      nuevos = filas.length;\n    }\n\n    let resultado = \"COMPLETADO\";\n\n    if (limiteAlcanzado) {\n      resultado = \"LIMITE_ALCANZADO\";\n    } else if (errores.length) {\n      resultado = \"PARCIAL\";\n    }\n\n    registrarLogPIH_(\n      opciones.proceso,\n      resultado,\n      nuevos,\n      errores.join(\" | \") || \"Sin errores\"\n    );\n\n  } catch (e) {\n    errores.push(e.message);\n    registrarLogPIH_(\n      opciones.proceso,\n      \"ERROR\",\n      nuevos,\n      errores.join(\" | \")\n    );\n    throw e;\n  }\n\n  return {\n    nuevos: nuevos,\n    limiteAlcanzado: limiteAlcanzado,\n    errores: errores\n  };\n}\n\n\n/**\n * Convierte una obra de OpenAlex en un registro PIH.\n */\nfunction convertirPublicacionPIH_(obra, consulta, fecha, origen) {\n  const autores = (obra.authorships || [])\n    .map(a => a.author ? a.author.display_name : \"\")\n    .filter(Boolean)\n    .join(\"; \");\n\n  const revista = obra.primary_location &&\n    obra.primary_location.source\n      ? obra.primary_location.source.display_name\n      : \"\";\n\n  const doi = normalizarDOI_(obra.doi);\n  const abstract = reconstruirAbstractPIH_(\n    obra.abstract_inverted_index\n  );\n\n  return {\n    ID: obra.id || \"\",\n    DOI: doi,\n    TITULO: obra.title || \"\",\n    AUTORES: autores,\n    ANO: obra.publication_year || \"\",\n    FECHA_PUBLICACION: obra.publication_date || \"\",\n    REVISTA_EDITORIAL: revista,\n    TIPO_DOCUMENTO: obra.type || \"\",\n    IDIOMA: obra.language || \"\",\n    FUENTE: \"OpenAlex\",\n    URL: doi ? \"https://doi.org/\" + doi : obra.id || \"\",\n    ABSTRACT_ORIGINAL: abstract,\n    RESUMEN_IA: \"\",\n    TEMATICA_PRINCIPAL: consulta,\n    TEMATICAS_SECUNDARIAS: \"\",\n    RELEVANCIA_0_5: \"\",\n    JUSTIFICACION_RELEVANCIA: \"\",\n    VINCULO_TESIS: \"\",\n    ESTADO_LECTURA: \"Pendiente\",\n    FECHA_DETECCION: fecha,\n    FECHA_REVISION: \"\",\n    INCORPORADO_MENDELEY: \"No\",\n    NIVEL_ANALISIS_IA: abstract ? \"Abstract disponible\" : \"Solo metadatos\",\n    CONFIANZA_ANALISIS: \"\",\n    ORIGEN: origen || \"\"\n  };\n}\n\n\n/**\n * Reconstruye el abstract a partir del índice invertido de OpenAlex.\n */\nfunction reconstruirAbstractPIH_(indice) {\n  if (!indice) return \"\";\n\n  const palabras = [];\n\n  Object.keys(indice).forEach(palabra => {\n    indice[palabra].forEach(posicion => {\n      palabras[posicion] = palabra;\n    });\n  });\n\n  return palabras.filter(Boolean).join(\" \");\n}\n\n\n/**\n * Recupera la configuración de la pestaña CONFIG.\n */\nfunction obtenerConfiguracionPIH_() {\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(\"CONFIG\");\n\n  if (!hoja) throw new Error(\"No existe la pestaña CONFIG.\");\n\n  const datos = hoja.getDataRange().getValues();\n  const config = {};\n\n  for (let i = 1; i < datos.length; i++) {\n    const clave = datos[i][0];\n    if (clave) config[clave] = datos[i][1];\n  }\n\n  return config;\n}\n\n\n/**\n * Añade columnas sin sobrescribir ninguna existente.\n */\n/**\n * Google Sheets NO amplía una pestaña al escribir con setValues: si faltan\n * filas, falla. Esta función añade filas (con margen) hasta poder escribir\n * \"ultimaFilaNecesaria\".\n */\nfunction asegurarFilasHojaPIH_(hoja, ultimaFilaNecesaria) {\n\n  const maximo = hoja.getMaxRows();\n\n  if (ultimaFilaNecesaria > maximo) {\n    hoja.insertRowsAfter(maximo, ultimaFilaNecesaria - maximo + 500);\n  }\n}\n\n\nfunction asegurarColumnasPIH_(hoja, columnas) {\n  const actuales = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0];\n\n  columnas.forEach(nombre => {\n    if (!actuales.includes(nombre)) {\n      hoja.getRange(1, hoja.getLastColumn() + 1)\n        .setValue(nombre)\n        .setFontWeight(\"bold\")\n        .setWrap(true);\n      actuales.push(nombre);\n    }\n  });\n}\n\n\n/**\n * Obtiene los identificadores existentes para evitar duplicados.\n */\nfunction obtenerIdentificadoresExistentes_(hoja, encabezados) {\n  const colID = encabezados.indexOf(\"ID\");\n  const colDOI = encabezados.indexOf(\"DOI\");\n\n  const ids = new Set();\n  const dois = new Set();\n\n  if (hoja.getLastRow() < 2) return { ids, dois };\n\n  const datos = hoja.getRange(\n    2, 1, hoja.getLastRow() - 1, hoja.getLastColumn()\n  ).getValues();\n\n  datos.forEach(fila => {\n    if (colID >= 0 && fila[colID]) {\n      ids.add(String(fila[colID]));\n    }\n\n    if (colDOI >= 0 && fila[colDOI]) {\n      dois.add(normalizarDOI_(fila[colDOI]));\n    }\n  });\n\n  return { ids, dois };\n}\n\n\n/**\n * Normaliza los DOI.\n */\nfunction normalizarDOI_(valor) {\n  return String(valor || \"\")\n    .trim()\n    .replace(/^https?:\\/\\/(dx\\.)?doi\\.org\\//i, \"\")\n    .toLowerCase();\n}\n\n\n/**\n * Registra ejecuciones y errores en LOG.\n */\nfunction registrarLogPIH_(proceso, resultado, nuevos, detalles) {\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(\"LOG\");\n\n  if (!hoja) return;\n\n  hoja.appendRow([\n    new Date(),\n    proceso,\n    resultado,\n    nuevos,\n    \"\",\n    detalles\n  ]);\n}\n\n\n// =====================================================\n// PROCESOS AUTOMÁTICOS\n// =====================================================\n\n/**\n * Proceso diario: busca novedades y clasifica todo lo que pueda\n * dentro del tiempo y de los límites gratuitos.\n */\nfunction procesoDiarioPIH() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    console.log(\"Ya hay otro proceso PIH en marcha. Se omite esta ejecución.\");\n    return;\n  }\n\n  try {\n    // Una vez al día: ¿hay una versión nueva de PIH?\n    try { comprobarActualizacionPIH_(); } catch (e) {}\n\n    let nuevos = 0;\n\n    try {\n      const busqueda = ejecutarRadarDiario();\n      nuevos = busqueda.nuevos;\n    } catch (e) {\n      // El error ya queda registrado en LOG; se continúa con la clasificación.\n      console.error(\"Radar diario: \" + e.message);\n    }\n\n    const clasificacion = ejecutarClasificacionPIH_(1000);\n\n    // Si hay publicaciones nuevas pero no se ha clasificado nada,\n    // se actualiza igualmente la interfaz.\n    if (nuevos > 0 && clasificacion.procesadas === 0) {\n      crearInterfazDoctorado();\n    }\n\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\n/**\n * Solo clasificación de pendientes (reanuda el trabajo cuando se\n * restablece el límite gratuito).\n */\nfunction continuarClasificacionPIH() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    console.log(\"Ya hay otro proceso PIH en marcha. Se omite esta ejecución.\");\n    return;\n  }\n\n  try {\n    ejecutarClasificacionPIH_(1000);\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\n/**\n * Activa la ejecución automática:\n *  - cada día, entre las 7:00 y las 8:00: radar diario + clasificación;\n *  - cada 6 horas: continuar la clasificación de pendientes.\n */\nfunction configurarAutomatizacionDiaria() {\n\n  eliminarActivadoresAutomaticosPIH_();\n\n  ScriptApp.newTrigger(\"procesoDiarioPIH\")\n    .timeBased()\n    .everyDays(1)\n    .atHour(7)\n    .create();\n\n  // Cada hora: si no hay nada pendiente no hace nada, y si Gemini\n  // está saturado reintenta pronto sin gastar nada.\n  ScriptApp.newTrigger(\"continuarClasificacionPIH\")\n    .timeBased()\n    .everyHours(1)\n    .create();\n\n  avisarPIH_(tPIH_(\"ra_auto_on\"), 8);\n\n  console.log(\"Automatización diaria configurada.\");\n}\n\n\n/**\n * Desactiva la ejecución automática (no toca la sincronización de RADAR).\n */\nfunction desactivarAutomatizacionPIH() {\n\n  const eliminados = eliminarActivadoresAutomaticosPIH_();\n\n  avisarPIH_(tPIH_(\"ra_auto_off\", tPIH_(\"c_activadores\", eliminados)), 6);\n}\n\n\nfunction eliminarActivadoresAutomaticosPIH_() {\n\n  const funciones = [\"procesoDiarioPIH\", \"continuarClasificacionPIH\"];\n\n  let eliminados = 0;\n\n  ScriptApp.getProjectTriggers().forEach(activador => {\n    if (funciones.indexOf(activador.getHandlerFunction()) !== -1) {\n      ScriptApp.deleteTrigger(activador);\n      eliminados++;\n    }\n  });\n\n  return eliminados;\n}\n"}, {"name": "RadarHistorico", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Radar histórico: las publicaciones más relevantes ya publicadas\n *\n * Cómo funciona (todo gratuito, por tandas):\n *  1. BÚSQUEDA: recoge candidatos de OpenAlex (varias consultas, varias\n *     páginas, solo con abstract) y los guarda en la pestaña oculta\n *     COLA_HISTORICO con una puntuación previa gratuita (citas, año y\n *     posición en la búsqueda). No gasta IA.\n *  2. OLAS: pasa a PUBLICACIONES las 50 mejores candidatas de la cola\n *     (ORIGEN = \"Histórico\"). El clasificador de IA las analiza como al\n *     resto.\n *  3. SATURACIÓN: cuando una ola está clasificada, cuenta cuántas son de\n *     relevancia 4-5. Si 2 olas seguidas aportan menos de 5, el sistema\n *     se detiene y te avisa por correo. Puedes cambiar esos números.\n *  4. BOLA DE NIEVE (opcional): si la cola se agota, busca obras que citan\n *     a tus publicaciones de relevancia 4-5 y las añade a la cola.\n *\n * Funciones que puedes ejecutar a mano (o desde el menú):\n *   - iniciarHistoricoPIH()          -> empieza (o reinicia) el proceso\n *   - continuarHistoricoPIH()        -> avanza un paso ahora\n *   - estadoHistoricoPIH()           -> muestra en qué punto está\n *   - pausarHistoricoPIH() / reanudarHistoricoPIH()\n *   - activarHistoricoAutomaticoPIH() / desactivarHistoricoAutomaticoPIH()\n *\n * Coste: 0 €. OpenAlex da 1 $ gratuito al día (una búsqueda cuesta\n * 0,001 $). Si se agota (429) se detiene y sigue al día siguiente.\n *\n * Depende de InterfazDoctorado.gs v5, RadarAcademico.gs v2 y\n * InteligenciaDoctorado.gs v3.\n */\n\nconst PIH_HIST_HOJA_COLA = \"COLA_HISTORICO\";\nconst PIH_HIST_PROPIEDAD = \"PIH_HIST_ESTADO\";\n\nconst PIH_HIST_PAGINAS_POR_CONSULTA = 3;     // 3 x 100 = 300 candidatas por consulta\nconst PIH_HIST_OLA_TAMANO = 50;\nconst PIH_HIST_UMBRAL_APORTE = 5;            // relevancia 4-5 mínimas por ola\nconst PIH_HIST_OLAS_SEGUIDAS = 2;            // olas flojas seguidas para parar\nconst PIH_HIST_SEMILLAS_POR_PASO = 5;\nconst PIH_HIST_TIEMPO_MAXIMO_MS = 240000;\nconst PIH_HIST_DESDE = \"2000-01-01\";\n\n// Consultas del histórico: salen de tu perfil (pestaña PERFIL).\nlet PIH_HIST_CONSULTAS_MEMORIA = null;\n\nfunction consultasHistoricoPIH_() {\n  if (!PIH_HIST_CONSULTAS_MEMORIA) {\n    PIH_HIST_CONSULTAS_MEMORIA = listaPerfilPIH_(\"consultas_historico\", []);\n  }\n  return PIH_HIST_CONSULTAS_MEMORIA;\n}\n\n// Sin consultas «antiguas» en la plantilla: se empieza desde cero.\nconst PIH_HIST_CONSULTAS_ANTIGUAS = 0;\n\nconst PIH_HIST_COLUMNAS_COLA = [\n  \"ID\", \"DOI\", \"TITULO\", \"AUTORES\", \"ANO\", \"FECHA_PUBLICACION\",\n  \"REVISTA_EDITORIAL\", \"TIPO_DOCUMENTO\", \"IDIOMA\", \"URL\",\n  \"ABSTRACT_ORIGINAL\", \"PUNTUACION_PREVIA\"\n];\n\n\n// =====================================================\n// ESTADO\n// =====================================================\n\nfunction leerEstadoHistoricoPIH_() {\n\n  const texto = PropertiesService.getScriptProperties()\n    .getProperty(PIH_HIST_PROPIEDAD);\n\n  if (!texto) return null;\n\n  try {\n    return JSON.parse(texto);\n  } catch (e) {\n    return null;\n  }\n}\n\n\nfunction guardarEstadoHistoricoPIH_(estado) {\n  PropertiesService.getScriptProperties()\n    .setProperty(PIH_HIST_PROPIEDAD, JSON.stringify(estado));\n}\n\n\nfunction estadoInicialHistoricoPIH_() {\n  return {\n    fase: \"busqueda\",        // busqueda | olas | saturado\n    pausado: false,\n    consultaIdx: 0,\n    pagina: 1,\n    olaIds: [],\n    olasEnviadas: 0,\n    olasFlojasSeguidas: 0,\n    historialOlas: [],       // [{ ola, aportes, total }]\n    semillasUsadas: [],\n    bolaNieveNoDisponible: false,\n    iniciado: new Date().toISOString()\n  };\n}\n\n\n// =====================================================\n// FUNCIONES PRINCIPALES\n// =====================================================\n\nfunction iniciarHistoricoPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n\n  if (leerEstadoHistoricoPIH_()) {\n    const respuesta = ui.alert(\n      tPIH_(\"hi_reiniciar_titulo\"),\n      tPIH_(\"hi_reiniciar\"),\n      ui.ButtonSet.YES_NO\n    );\n\n    if (respuesta !== ui.Button.YES) return;\n  }\n\n  const hoja = asegurarHojaColaPIH_();\n\n  if (hoja.getLastRow() > 1) {\n    hoja.getRange(2, 1, hoja.getLastRow() - 1, hoja.getLastColumn())\n      .clearContent();\n  }\n\n  guardarEstadoHistoricoPIH_(estadoInicialHistoricoPIH_());\n\n  registrarLogPIH_(\n    \"HISTORICO\", \"INICIADO\", 0,\n    \"Búsqueda histórica iniciada. Fase: búsqueda de candidatas.\"\n  );\n\n  avisarPIH_(tPIH_(\"hi_iniciado\"), 8);\n\n  continuarHistoricoPIH();\n}\n\n\n/**\n * Ejecuta SOLO las consultas nuevas (las añadidas tras revisar la propuesta\n * de doctorado) sin borrar nada de lo ya recogido. Úsala una vez.\n */\nfunction ampliarBusquedaHistoricoPIH() {\n\n  const estado = leerEstadoHistoricoPIH_();\n\n  if (!estado) {\n    avisarPIH_(tPIH_(\"hi_no_iniciado\"), 8);\n    return;\n  }\n\n  if (estado.consultaIdx >= consultasHistoricoPIH_().length) {\n    estado.consultaIdx = Math.min(\n      PIH_HIST_CONSULTAS_ANTIGUAS,\n      consultasHistoricoPIH_().length\n    );\n  }\n\n  estado.fase = \"busqueda\";\n  estado.pagina = 1;\n  estado.olasFlojasSeguidas = 0;\n  estado.pausado = false;\n\n  guardarEstadoHistoricoPIH_(estado);\n\n  registrarLogPIH_(\n    \"HISTORICO\", \"AMPLIADO\", 0,\n    \"Búsqueda ampliada con las consultas nuevas (desde la nº \" +\n    (estado.consultaIdx + 1) + \").\"\n  );\n\n  continuarHistoricoPIH();\n}\n\n\nfunction continuarHistoricoPIH() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    avisarPIH_(tPIH_(\"c_ocupado\"), 8);\n    return;\n  }\n\n  try {\n    ejecutarPasoHistoricoPIH_();\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\nfunction ejecutarPasoHistoricoPIH_() {\n\n  const inicio = Date.now();\n\n  let estado = leerEstadoHistoricoPIH_();\n\n  if (!estado) {\n    avisarPIH_(tPIH_(\"hi_no_iniciado\"), 8);\n    return;\n  }\n\n  if (estado.pausado) {\n    avisarPIH_(tPIH_(\"hi_pausa\"), 6);\n    return;\n  }\n\n  if (estado.fase === \"saturado\") {\n    avisarPIH_(tPIH_(\"hi_saturado\"), 8);\n    return;\n  }\n\n  let mensaje = \"\";\n\n  try {\n\n    if (estado.fase === \"busqueda\") {\n      mensaje = pasoBusquedaHistoricoPIH_(estado, inicio);\n    } else if (estado.fase === \"olas\") {\n      mensaje = pasoOlasHistoricoPIH_(estado);\n    }\n\n  } catch (e) {\n\n    const texto = String(e && e.message ? e.message : e);\n\n    registrarLogPIH_(\"HISTORICO\", \"ERROR\", 0, texto);\n\n    mensaje = tPIH_(\"hi_error\", texto);\n  }\n\n  guardarEstadoHistoricoPIH_(estado);\n\n  if (mensaje) avisarPIH_(mensaje, 12);\n}\n\n\n// =====================================================\n// FASE 1: BÚSQUEDA DE CANDIDATAS\n// =====================================================\n\nfunction pasoBusquedaHistoricoPIH_(estado, inicio) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n  const cola = asegurarHojaColaPIH_();\n\n  if (!hoja) throw new Error(tPIH_(\"c_no_hoja_pub\"));\n\n  const apiKey = PropertiesService.getScriptProperties()\n    .getProperty(\"OPENALEX_API_KEY\");\n\n  if (!apiKey) {\n    throw new Error(tPIH_(\"c_falta_openalex\"));\n  }\n\n  const cabeceras = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0];\n\n  const existentes = obtenerIdentificadoresExistentes_(hoja, cabeceras);\n\n  // Añadir también lo que ya está en la cola.\n  leerIdentificadoresColaPIH_(cola, existentes);\n\n  let anadidas = 0;\n  let peticiones = 0;\n  let limite = false;\n  const errores = [];\n\n  while (estado.consultaIdx < consultasHistoricoPIH_().length) {\n\n    if (Date.now() - inicio > PIH_HIST_TIEMPO_MAXIMO_MS) break;\n\n    const consulta = consultasHistoricoPIH_()[estado.consultaIdx];\n\n    const url =\n      \"https://api.openalex.org/works\" +\n      \"?search=\" + encodeURIComponent(consulta) +\n      \"&filter=has_abstract:true,from_publication_date:\" + PIH_HIST_DESDE +\n      \"&per_page=100&page=\" + estado.pagina +\n      \"&select=id,doi,title,authorships,publication_year,\" +\n      \"publication_date,primary_location,type,language,\" +\n      \"abstract_inverted_index,cited_by_count\" +\n      \"&api_key=\" + encodeURIComponent(apiKey);\n\n    const respuesta = UrlFetchApp.fetch(url, { muteHttpExceptions: true });\n\n    peticiones++;\n\n    const codigo = respuesta.getResponseCode();\n\n    if (codigo === 429) {\n      limite = true;\n      break;\n    }\n\n    if (codigo !== 200) {\n      errores.push(consulta + \" (pág. \" + estado.pagina + \"): HTTP \" + codigo);\n      // Se salta esta página para no quedarse atascado.\n    } else {\n\n      const datos = JSON.parse(respuesta.getContentText());\n      const resultados = datos.results || [];\n      const filas = [];\n\n      resultados.forEach((obra, posicion) => {\n\n        const id = obra.id || \"\";\n        const doi = normalizarDOI_(obra.doi);\n\n        if (!id || !obra.title) return;\n        if (existentes.ids.has(id)) return;\n        if (doi && existentes.dois.has(doi)) return;\n\n        existentes.ids.add(id);\n        if (doi) existentes.dois.add(doi);\n\n        const rango = (estado.pagina - 1) * 100 + posicion;\n\n        filas.push(filaColaPIH_(obra, rango));\n      });\n\n      if (filas.length) {\n        cola.getRange(cola.getLastRow() + 1, 1, filas.length, filas[0].length)\n          .setValues(filas);\n        anadidas += filas.length;\n      }\n\n      // Si la página viene incompleta, no hay más resultados.\n      if (resultados.length < 100) {\n        estado.pagina = PIH_HIST_PAGINAS_POR_CONSULTA;\n      }\n    }\n\n    // Siguiente página o siguiente consulta.\n    if (estado.pagina >= PIH_HIST_PAGINAS_POR_CONSULTA) {\n      estado.consultaIdx++;\n      estado.pagina = 1;\n    } else {\n      estado.pagina++;\n    }\n\n    Utilities.sleep(250);\n  }\n\n  let resultado = \"COMPLETADO\";\n\n  if (limite) resultado = \"LIMITE_ALCANZADO\";\n  else if (errores.length) resultado = \"PARCIAL\";\n\n  const terminada = estado.consultaIdx >= consultasHistoricoPIH_().length;\n\n  if (terminada) estado.fase = \"olas\";\n\n  registrarLogPIH_(\n    \"HISTORICO_BUSQUEDA\",\n    resultado,\n    anadidas,\n    (errores.join(\" | \") || \"Sin errores\") +\n    \" | Peticiones: \" + peticiones +\n    (limite ? \" | Límite gratuito de OpenAlex alcanzado: continuará mañana.\" : \"\")\n  );\n\n  let mensaje = tPIH_(\n    \"hi_busq\", anadidas,\n    Math.min(estado.consultaIdx + 1, consultasHistoricoPIH_().length),\n    consultasHistoricoPIH_().length\n  );\n\n  if (limite) {\n    mensaje += tPIH_(\"hi_limite\");\n  } else if (terminada) {\n    mensaje += tPIH_(\"hi_terminada\");\n  }\n\n  return mensaje;\n}\n\n\n// Puntuación previa gratuita: citas, antigüedad y posición en la búsqueda.\nfunction puntuacionPreviaPIH_(obra, rango) {\n\n  const citas = Number(obra.cited_by_count) || 0;\n  const anio = Number(obra.publication_year) || 0;\n  const anioActual = new Date().getFullYear();\n\n  const porCitas = Math.log10(1 + citas);                    // 0 a ~4\n  const porRecencia = anio >= anioActual - 5 ? 0.5 : 0;      // algo de peso a lo reciente\n  const porPosicion = Math.max(0, 1.5 - rango / 200);        // lo mejor posicionado\n\n  return Math.round((porCitas + porRecencia + porPosicion) * 1000) / 1000;\n}\n\n\nfunction filaColaPIH_(obra, rango) {\n\n  const autores = (obra.authorships || [])\n    .map(a => a.author ? a.author.display_name : \"\")\n    .filter(Boolean)\n    .join(\"; \");\n\n  const revista = obra.primary_location && obra.primary_location.source\n    ? obra.primary_location.source.display_name\n    : \"\";\n\n  const doi = normalizarDOI_(obra.doi);\n\n  return [\n    obra.id || \"\",\n    doi,\n    obra.title || \"\",\n    autores,\n    obra.publication_year || \"\",\n    obra.publication_date || \"\",\n    revista,\n    obra.type || \"\",\n    obra.language || \"\",\n    doi ? \"https://doi.org/\" + doi : (obra.id || \"\"),\n    reconstruirAbstractPIH_(obra.abstract_inverted_index),\n    puntuacionPreviaPIH_(obra, rango)\n  ];\n}\n\n\n// =====================================================\n// FASE 2: OLAS DE ANÁLISIS\n// =====================================================\n\nfunction pasoOlasHistoricoPIH_(estado) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja) throw new Error(tPIH_(\"c_no_hoja_pub\"));\n\n  // 1) Si hay una ola en curso, ver si ya está clasificada.\n  if (estado.olaIds && estado.olaIds.length > 0) {\n\n    const evaluacion = evaluarOlaHistoricoPIH_(hoja, estado.olaIds);\n\n    if (!evaluacion.completa) {\n      return tPIH_(\n        \"hi_ola_clasif\", estado.olasEnviadas, evaluacion.hechas,\n        estado.olaIds.length\n      );\n    }\n\n    estado.historialOlas.push({\n      ola: estado.olasEnviadas,\n      aportes: evaluacion.aportes,\n      total: estado.olaIds.length\n    });\n\n    estado.olasFlojasSeguidas =\n      evaluacion.aportes < PIH_HIST_UMBRAL_APORTE\n        ? estado.olasFlojasSeguidas + 1\n        : 0;\n\n    estado.olaIds = [];\n\n    registrarLogPIH_(\n      \"HISTORICO_OLA\",\n      \"COMPLETADA\",\n      evaluacion.aportes,\n      \"Ola \" + estado.olasEnviadas + \": \" + evaluacion.aportes +\n      \" publicaciones de relevancia 4-5. Olas flojas seguidas: \" +\n      estado.olasFlojasSeguidas + \".\"\n    );\n\n    if (estado.olasFlojasSeguidas >= PIH_HIST_OLAS_SEGUIDAS) {\n      return cerrarPorSaturacionPIH_(estado, tPIH_(\"hi_m_sat\"));\n    }\n  }\n\n  // 2) Preparar la siguiente ola.\n  const cola = asegurarHojaColaPIH_();\n\n  if (cola.getLastRow() < 2) {\n\n    const nuevas = ampliarColaConCitasPIH_(estado);\n\n    if (nuevas === 0) {\n      return cerrarPorSaturacionPIH_(estado, tPIH_(\"hi_m_cola\"));\n    }\n  }\n\n  const enviadas = moverOlaAPublicacionesPIH_(estado);\n\n  if (enviadas === 0) {\n    return cerrarPorSaturacionPIH_(estado, tPIH_(\"hi_m_cola\"));\n  }\n\n  crearInterfazDoctorado();\n\n  return tPIH_(\"hi_ola_enviada\", estado.olasEnviadas, enviadas);\n}\n\n\n// ¿Todas las publicaciones de la ola están ya analizadas (o descartadas)?\nfunction evaluarOlaHistoricoPIH_(hoja, ids) {\n\n  const datos = hoja.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  const conjunto = new Set(ids);\n\n  let hechas = 0;\n  let aportes = 0;\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n    const id = String(obtenerValorPIH_(fila, indice, \"ID\"));\n\n    if (!conjunto.has(id)) continue;\n\n    const relevancia = String(\n      obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\")\n    ).trim();\n\n    const nivel = String(obtenerValorPIH_(fila, indice, \"NIVEL_ANALISIS_IA\"));\n    const errorFinal = /^Error IA \\((\\d+)\\)/.exec(nivel);\n\n    const descartada = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    ) === \"descartado\";\n\n    if (relevancia !== \"\") {\n      hechas++;\n      if (Number(relevancia) >= 4) aportes++;\n    } else if ((errorFinal && Number(errorFinal[1]) >= 3) || descartada) {\n      hechas++;\n    }\n  }\n\n  return {\n    completa: hechas >= ids.length,\n    hechas: hechas,\n    aportes: aportes\n  };\n}\n\n\n// Pasa las mejores candidatas de la cola a PUBLICACIONES.\nfunction moverOlaAPublicacionesPIH_(estado) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n  const cola = asegurarHojaColaPIH_();\n\n  asegurarColumnasPIH_(hoja, [\n    \"INCORPORADO_MENDELEY\", \"NIVEL_ANALISIS_IA\",\n    \"CONFIANZA_ANALISIS\", \"ORIGEN\"\n  ]);\n\n  const ultimaFila = cola.getLastRow();\n\n  if (ultimaFila < 2) return 0;\n\n  const valores = cola\n    .getRange(2, 1, ultimaFila - 1, PIH_HIST_COLUMNAS_COLA.length)\n    .getValues()\n    .filter(fila => String(fila[2]).trim() !== \"\");\n\n  const posPuntuacion = PIH_HIST_COLUMNAS_COLA.indexOf(\"PUNTUACION_PREVIA\");\n\n  valores.sort((a, b) => Number(b[posPuntuacion]) - Number(a[posPuntuacion]));\n\n  const elegidas = valores.slice(0, PIH_HIST_OLA_TAMANO);\n  const restantes = valores.slice(PIH_HIST_OLA_TAMANO);\n\n  const encabezados = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0];\n\n  const ahora = new Date();\n\n  const matriz = elegidas.map(fila => {\n\n    const campo = nombre => fila[PIH_HIST_COLUMNAS_COLA.indexOf(nombre)];\n\n    const registro = {\n      ID: campo(\"ID\"),\n      DOI: campo(\"DOI\"),\n      TITULO: campo(\"TITULO\"),\n      AUTORES: campo(\"AUTORES\"),\n      ANO: campo(\"ANO\"),\n      FECHA_PUBLICACION: campo(\"FECHA_PUBLICACION\"),\n      REVISTA_EDITORIAL: campo(\"REVISTA_EDITORIAL\"),\n      TIPO_DOCUMENTO: campo(\"TIPO_DOCUMENTO\"),\n      IDIOMA: campo(\"IDIOMA\"),\n      FUENTE: \"OpenAlex\",\n      URL: campo(\"URL\"),\n      ABSTRACT_ORIGINAL: campo(\"ABSTRACT_ORIGINAL\"),\n      RESUMEN_IA: \"\",\n      // Vacía a propósito: el clasificador pondrá la temática de la IA.\n      TEMATICA_PRINCIPAL: \"\",\n      TEMATICAS_SECUNDARIAS: \"\",\n      RELEVANCIA_0_5: \"\",\n      JUSTIFICACION_RELEVANCIA: \"\",\n      VINCULO_TESIS: \"\",\n      ESTADO_LECTURA: \"Pendiente\",\n      FECHA_DETECCION: ahora,\n      FECHA_REVISION: \"\",\n      INCORPORADO_MENDELEY: \"No\",\n      NIVEL_ANALISIS_IA: \"Abstract disponible\",\n      CONFIANZA_ANALISIS: \"\",\n      ORIGEN: PIH_RADAR_CONFIG.origenHistorico\n    };\n\n    return encabezados.map(h =>\n      valorRegistroPIH_(registro, h)\n    );\n  });\n\n  if (matriz.length) {\n    asegurarFilasHojaPIH_(hoja, hoja.getLastRow() + matriz.length);\n\n    hoja.getRange(hoja.getLastRow() + 1, 1, matriz.length, encabezados.length)\n      .setValues(matriz);\n  }\n\n  // Reescribir la cola sin las elegidas.\n  cola.getRange(2, 1, ultimaFila - 1, PIH_HIST_COLUMNAS_COLA.length)\n    .clearContent();\n\n  if (restantes.length) {\n    cola.getRange(2, 1, restantes.length, PIH_HIST_COLUMNAS_COLA.length)\n      .setValues(restantes);\n  }\n\n  estado.olasEnviadas++;\n  estado.olaIds = elegidas.map(fila => String(fila[0]));\n\n  SpreadsheetApp.flush();\n\n  registrarLogPIH_(\n    \"HISTORICO_OLA\", \"ENVIADA\", elegidas.length,\n    \"Ola \" + estado.olasEnviadas + \" enviada a PUBLICACIONES. \" +\n    \"Quedan \" + restantes.length + \" candidatas en la cola.\"\n  );\n\n  return elegidas.length;\n}\n\n\n// =====================================================\n// BOLA DE NIEVE (opcional): obras que citan a las mejores\n// =====================================================\n\nfunction ampliarColaConCitasPIH_(estado) {\n\n  if (estado.bolaNieveNoDisponible) return 0;\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n  const cola = asegurarHojaColaPIH_();\n\n  const apiKey = PropertiesService.getScriptProperties()\n    .getProperty(\"OPENALEX_API_KEY\");\n\n  if (!apiKey) return 0;\n\n  const datos = hoja.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  const usadas = new Set(estado.semillasUsadas || []);\n  const semillas = [];\n\n  for (let i = 1; i < datos.length && semillas.length < PIH_HIST_SEMILLAS_POR_PASO; i++) {\n\n    const fila = datos[i];\n    const id = String(obtenerValorPIH_(fila, indice, \"ID\"));\n    const relevancia = String(\n      obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\")\n    ).trim();\n\n    if (\n      id.indexOf(\"https://openalex.org/\") === 0 &&\n      relevancia !== \"\" && Number(relevancia) >= 4 &&\n      !usadas.has(id)\n    ) {\n      semillas.push(id);\n    }\n  }\n\n  if (semillas.length === 0) return 0;\n\n  const cabeceras = datos[0];\n  const existentes = obtenerIdentificadoresExistentes_(hoja, cabeceras);\n  leerIdentificadoresColaPIH_(cola, existentes);\n\n  let anadidas = 0;\n\n  for (const semilla of semillas) {\n\n    const corto = semilla.replace(\"https://openalex.org/\", \"\");\n\n    const url =\n      \"https://api.openalex.org/works\" +\n      \"?filter=cites:\" + encodeURIComponent(corto) + \",has_abstract:true\" +\n      \"&sort=cited_by_count:desc&per_page=25\" +\n      \"&select=id,doi,title,authorships,publication_year,\" +\n      \"publication_date,primary_location,type,language,\" +\n      \"abstract_inverted_index,cited_by_count\" +\n      \"&api_key=\" + encodeURIComponent(apiKey);\n\n    const respuesta = UrlFetchApp.fetch(url, { muteHttpExceptions: true });\n    const codigo = respuesta.getResponseCode();\n\n    if (codigo === 429) break;\n\n    if (codigo === 400 || codigo === 422) {\n      // El filtro de citas no está disponible: se desactiva esta función.\n      estado.bolaNieveNoDisponible = true;\n\n      registrarLogPIH_(\n        \"HISTORICO_BOLA_NIEVE\", \"NO_DISPONIBLE\", 0,\n        \"OpenAlex rechazó el filtro cites (HTTP \" + codigo + \"). \" +\n        \"Se desactiva la bola de nieve.\"\n      );\n\n      break;\n    }\n\n    estado.semillasUsadas = (estado.semillasUsadas || []).concat([semilla]);\n\n    if (codigo !== 200) continue;\n\n    const resultados = JSON.parse(respuesta.getContentText()).results || [];\n    const filas = [];\n\n    resultados.forEach((obra, posicion) => {\n\n      const id = obra.id || \"\";\n      const doi = normalizarDOI_(obra.doi);\n\n      if (!id || !obra.title) return;\n      if (existentes.ids.has(id)) return;\n      if (doi && existentes.dois.has(doi)) return;\n\n      existentes.ids.add(id);\n      if (doi) existentes.dois.add(doi);\n\n      filas.push(filaColaPIH_(obra, posicion * 4));\n    });\n\n    if (filas.length) {\n      cola.getRange(cola.getLastRow() + 1, 1, filas.length, filas[0].length)\n        .setValues(filas);\n      anadidas += filas.length;\n    }\n\n    Utilities.sleep(250);\n  }\n\n  registrarLogPIH_(\n    \"HISTORICO_BOLA_NIEVE\", \"COMPLETADO\", anadidas,\n    \"Semillas usadas: \" + semillas.length\n  );\n\n  return anadidas;\n}\n\n\n// =====================================================\n// CIERRE POR SATURACIÓN\n// =====================================================\n\nfunction cerrarPorSaturacionPIH_(estado, motivo) {\n\n  estado.fase = \"saturado\";\n\n  const resumen = estado.historialOlas\n    .map(o => tPIH_(\"hi_ola_resumen\", o.ola, o.aportes, o.total))\n    .join(\"\\n\");\n\n  registrarLogPIH_(\n    \"HISTORICO\", \"SATURADO\", estado.olasEnviadas,\n    \"Motivo: \" + motivo + \". \" + resumen.replace(/\\n/g, \" | \")\n  );\n\n  try {\n    MailApp.sendEmail({\n      to: Session.getEffectiveUser().getEmail(),\n      subject: tPIH_(\"hi_mail_asunto\", motivo),\n      body: tPIH_(\"hi_mail_cuerpo\", motivo, estado.olasEnviadas, resumen),\n      name: \"PIH Doctorado\"\n    });\n  } catch (e) {\n    console.log(\"No se pudo enviar el correo: \" + e.message);\n  }\n\n  return tPIH_(\"hi_terminado\", motivo);\n}\n\n\n// =====================================================\n// ESTADO, PAUSA Y AUTOMATIZACIÓN\n// =====================================================\n\nfunction estadoHistoricoPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n  const estado = leerEstadoHistoricoPIH_();\n\n  if (!estado) {\n    ui.alert(tPIH_(\"hi_reiniciar_titulo\"), tPIH_(\"hi_alert_no\"), ui.ButtonSet.OK);\n    return;\n  }\n\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(PIH_HIST_HOJA_COLA);\n\n  const enCola = hoja && hoja.getLastRow() > 1 ? hoja.getLastRow() - 1 : 0;\n\n  const fases = {\n    busqueda: tPIH_(\"hi_f_busqueda\"),\n    olas: tPIH_(\"hi_f_olas\"),\n    saturado: tPIH_(\"hi_f_saturado\")\n  };\n\n  const lineas = [\n    tPIH_(\"hi_l_fase\", fases[estado.fase] || estado.fase),\n    estado.pausado ? tPIH_(\"hi_l_pausa\") : tPIH_(\"hi_l_activo\"),\n    tPIH_(\"hi_l_cola\", enCola),\n    tPIH_(\"hi_l_olas\", estado.olasEnviadas),\n    tPIH_(\"hi_l_flojas\", estado.olasFlojasSeguidas, PIH_HIST_OLAS_SEGUIDAS)\n  ];\n\n  if (estado.fase === \"busqueda\") {\n    lineas.push(tPIH_(\n      \"hi_l_consulta\",\n      Math.min(estado.consultaIdx + 1, consultasHistoricoPIH_().length),\n      consultasHistoricoPIH_().length\n    ));\n  }\n\n  (estado.historialOlas || []).forEach(o => {\n    lineas.push(tPIH_(\"hi_l_ola\", o.ola, o.aportes));\n  });\n\n  if (estado.bolaNieveNoDisponible) {\n    lineas.push(tPIH_(\"hi_l_bola\"));\n  }\n\n  ui.alert(\"Radar histórico\", lineas.join(\"\\n\"), ui.ButtonSet.OK);\n}\n\n\nfunction pausarHistoricoPIH() {\n  const estado = leerEstadoHistoricoPIH_();\n  if (!estado) { avisarPIH_(tPIH_(\"hi_no_ini_corto\"), 6); return; }\n  estado.pausado = true;\n  guardarEstadoHistoricoPIH_(estado);\n  avisarPIH_(tPIH_(\"hi_en_pausa\"), 6);\n}\n\n\nfunction reanudarHistoricoPIH() {\n  const estado = leerEstadoHistoricoPIH_();\n  if (!estado) { avisarPIH_(tPIH_(\"hi_no_ini_corto\"), 6); return; }\n  estado.pausado = false;\n  guardarEstadoHistoricoPIH_(estado);\n  avisarPIH_(tPIH_(\"hi_reanudado\"), 6);\n}\n\n\n// Continuar el radar histórico cada 6 horas.\nfunction activarHistoricoAutomaticoPIH() {\n\n  desactivarHistoricoAutomaticoPIH_();\n\n  ScriptApp.newTrigger(\"continuarHistoricoPIH\")\n    .timeBased()\n    .everyHours(6)\n    .create();\n\n  avisarPIH_(tPIH_(\"hi_auto_on\"), 8);\n}\n\n\nfunction desactivarHistoricoAutomaticoPIH() {\n  const eliminados = desactivarHistoricoAutomaticoPIH_();\n  avisarPIH_(tPIH_(\"hi_auto_off\", eliminados), 6);\n}\n\n\nfunction desactivarHistoricoAutomaticoPIH_() {\n\n  let eliminados = 0;\n\n  ScriptApp.getProjectTriggers().forEach(activador => {\n    if (activador.getHandlerFunction() === \"continuarHistoricoPIH\") {\n      ScriptApp.deleteTrigger(activador);\n      eliminados++;\n    }\n  });\n\n  return eliminados;\n}\n\n\n// =====================================================\n// UTILIDADES DE LA COLA\n// =====================================================\n\nfunction asegurarHojaColaPIH_() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n\n  let hoja = ss.getSheetByName(PIH_HIST_HOJA_COLA);\n\n  if (!hoja) {\n    hoja = ss.insertSheet(PIH_HIST_HOJA_COLA);\n\n    hoja.getRange(1, 1, 1, PIH_HIST_COLUMNAS_COLA.length)\n      .setValues([PIH_HIST_COLUMNAS_COLA])\n      .setFontWeight(\"bold\");\n\n    hoja.setFrozenRows(1);\n    hoja.setTabColor(\"#9AA0A6\");\n    hoja.hideSheet();\n  }\n\n  return hoja;\n}\n\n\nfunction leerIdentificadoresColaPIH_(cola, existentes) {\n\n  if (cola.getLastRow() < 2) return;\n\n  cola.getRange(2, 1, cola.getLastRow() - 1, 2)\n    .getValues()\n    .forEach(fila => {\n      if (fila[0]) existentes.ids.add(String(fila[0]));\n      if (fila[1]) existentes.dois.add(normalizarDOI_(fila[1]));\n    });\n}\n"}, {"name": "ResumenSemanal", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB\n * Resumen semanal por correo · v1\n *\n * Cada lunes a primera hora (si lo activas) te envía un correo con:\n *   - Las publicaciones de relevancia 4-5 detectadas en los últimos 7 días\n *     que aún tienes en estado «Pendiente».\n *   - Un pequeño balance: publicaciones nuevas, puntuadas, sin puntuar,\n *     candidatas de relevancia 4-5 pendientes de revisar y estado del\n *     radar histórico.\n *\n * Si no hay nada nuevo que merezca la pena, no envía correo (solo lo\n * anota en LOG).\n *\n * Funciones que puedes ejecutar a mano (o desde el menú):\n *   - enviarResumenSemanalPIH()        -> lo envía ahora (para probarlo)\n *   - activarResumenSemanalPIH()       -> lunes a las 8:00\n *   - desactivarResumenSemanalPIH()\n *\n * Coste: 0 €. Usa el correo normal de Google (límite gratuito diario).\n */\n\nconst PIH_RESUMEN_RELEVANCIA_MINIMA = 4;\nconst PIH_RESUMEN_DIAS = 7;\nconst PIH_RESUMEN_MAXIMO = 15;\n\n\n// =====================================================\n// ENVÍO\n// =====================================================\n\nfunction enviarResumenSemanalPIH() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n  const hoja = ss.getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja || hoja.getLastRow() < 2) {\n    avisarPIH_(tPIH_(\"rs_sin_pub\"), 6);\n    return;\n  }\n\n  const datos = hoja.getDataRange().getValues();\n  const col = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  if (col.TITULO === undefined || col.RELEVANCIA_0_5 === undefined) {\n    throw new Error(\"Faltan las columnas TITULO o RELEVANCIA_0_5.\");\n  }\n\n  const leer = (fila, nombre) =>\n    col[nombre] === undefined ? \"\" : fila[col[nombre]];\n\n  const publicaciones = [];\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n\n    if (!fila[col.TITULO]) continue;\n\n    publicaciones.push({\n      titulo: String(fila[col.TITULO]),\n      autores: String(leer(fila, \"AUTORES\")),\n      ano: leer(fila, \"ANO\"),\n      revista: String(leer(fila, \"REVISTA_EDITORIAL\")),\n      relevancia: String(fila[col.RELEVANCIA_0_5]).trim(),\n      tematica: String(leer(fila, \"TEMATICA_PRINCIPAL\")),\n      resumen: String(leer(fila, \"RESUMEN_IA\")),\n      estado: String(leer(fila, \"ESTADO_LECTURA\")),\n      deteccion: leer(fila, \"FECHA_DETECCION\"),\n      origen: String(leer(fila, \"ORIGEN\")),\n      url: String(leer(fila, \"URL\"))\n    });\n  }\n\n  const resumen = seleccionarResumenSemanalPIH_(\n    publicaciones,\n    new Date(),\n    PIH_RESUMEN_DIAS\n  );\n\n  if (resumen.destacadas.length === 0) {\n\n    registrarLogPIH_(\n      \"RESUMEN_SEMANAL\", \"SIN_NOVEDADES\", 0,\n      \"Sin publicaciones de relevancia 4-5 nuevas esta semana. \" +\n      \"No se envía correo.\"\n    );\n\n    avisarPIH_(tPIH_(\"rs_sin_novedades\"), 8);\n\n    return;\n  }\n\n  if (MailApp.getRemainingDailyQuota() < 1) {\n    registrarLogPIH_(\n      \"RESUMEN_SEMANAL\", \"LIMITE_CORREO\", 0,\n      \"Se ha agotado el límite diario de correos. Se reintentará.\"\n    );\n    return;\n  }\n\n  let estadoHistorico = \"\";\n\n  if (typeof leerEstadoHistoricoPIH_ === \"function\") {\n\n    const e = leerEstadoHistoricoPIH_();\n\n    if (e) {\n      estadoHistorico = tPIH_(\n        \"rs_historico\", e.fase,\n        e.pausado ? tPIH_(\"rs_en_pausa\") : \"\",\n        e.olasEnviadas || 0\n      );\n    }\n  }\n\n  const url = ss.getUrl();\n  const asunto = tPIH_(\"rs_asunto\", resumen.destacadas.length);\n\n  MailApp.sendEmail({\n    to: Session.getEffectiveUser().getEmail(),\n    subject: asunto,\n    body: construirTextoResumenPIH_(resumen, estadoHistorico, url),\n    htmlBody: construirHtmlResumenPIH_(resumen, estadoHistorico, url)\n  });\n\n  registrarLogPIH_(\n    \"RESUMEN_SEMANAL\", \"ENVIADO\", resumen.destacadas.length,\n    \"Correo enviado con \" + resumen.destacadas.length + \" destacadas.\"\n  );\n\n  avisarPIH_(tPIH_(\"rs_enviado\"), 8);\n}\n\n\n// =====================================================\n// SELECCIÓN (sin acceso a la hoja)\n// =====================================================\n\n/**\n * Interpreta una fecha que puede ser un Date o un texto dd/mm/aaaa\n * (con o sin hora). Devuelve un Date o null.\n */\nfunction parsearFechaPIH_(valor) {\n\n  if (valor instanceof Date && !isNaN(valor.getTime())) return valor;\n\n  const texto = String(valor || \"\").trim();\n\n  const m = texto.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);\n\n  if (m) {\n    return new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]));\n  }\n\n  const iso = texto.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n\n  if (iso) {\n    return new Date(Number(iso[1]), Number(iso[2]) - 1, Number(iso[3]));\n  }\n\n  return null;\n}\n\n\n/**\n * Devuelve { destacadas, nuevas, puntuadas, sinPuntuar, pendientesAltas }.\n */\nfunction seleccionarResumenSemanalPIH_(publicaciones, hoy, dias) {\n\n  const limite = new Date(hoy.getTime() - dias * 24 * 60 * 60 * 1000);\n\n  const resultado = {\n    destacadas: [],\n    nuevas: 0,\n    puntuadas: 0,\n    sinPuntuar: 0,\n    pendientesAltas: 0\n  };\n\n  publicaciones.forEach(p => {\n\n    const nota = p.relevancia === \"\" ? null : Number(p.relevancia);\n\n    const puntuada = nota !== null && !isNaN(nota);\n\n    if (puntuada) resultado.puntuadas++;\n    else resultado.sinPuntuar++;\n\n    const estado = String(p.estado || \"\").trim().toLowerCase();\n    const pendiente = estado === \"\" || estado === \"pendiente\";\n\n    if (puntuada && nota >= PIH_RESUMEN_RELEVANCIA_MINIMA && pendiente) {\n      resultado.pendientesAltas++;\n    }\n\n    const detectada = parsearFechaPIH_(p.deteccion);\n\n    if (!detectada || detectada < limite) return;\n\n    resultado.nuevas++;\n\n    if (puntuada && nota >= PIH_RESUMEN_RELEVANCIA_MINIMA && pendiente) {\n      resultado.destacadas.push({\n        titulo: p.titulo,\n        autores: p.autores,\n        ano: p.ano,\n        revista: p.revista,\n        nota: nota,\n        tematica: p.tematica,\n        resumen: p.resumen,\n        origen: p.origen,\n        url: p.url\n      });\n    }\n  });\n\n  resultado.destacadas.sort((a, b) => b.nota - a.nota);\n  resultado.destacadas = resultado.destacadas.slice(0, PIH_RESUMEN_MAXIMO);\n\n  return resultado;\n}\n\n\n// =====================================================\n// CONTENIDO DEL CORREO\n// =====================================================\n\nfunction escaparHtmlPIH_(texto) {\n  return String(texto || \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\");\n}\n\n\nfunction construirTextoResumenPIH_(resumen, estadoHistorico, urlHoja) {\n\n  const lineas = [\n    tPIH_(\"rs_t_titulo\"),\n    \"\",\n    tPIH_(\"rs_t_sub\"),\n    \"\"\n  ];\n\n  resumen.destacadas.forEach((d, i) => {\n    lineas.push((i + 1) + \". [\" + d.nota + \"] \" + d.titulo);\n    if (d.autores) lineas.push(\"   \" + d.autores + (d.ano ? \" (\" + d.ano + \")\" : \"\"));\n    if (d.tematica) lineas.push(\"   \" + tPIH_(\"rs_tematica\") + \": \" + d.tematica);\n    if (d.url) lineas.push(\"   \" + d.url);\n    lineas.push(\"\");\n  });\n\n  lineas.push(tPIH_(\"rs_balance\") + \":\");\n  lineas.push(\"- \" + tPIH_(\"rs_nuevas\", resumen.nuevas));\n  lineas.push(\"- \" + tPIH_(\"rs_puntuadas\", resumen.puntuadas));\n  lineas.push(\"- \" + tPIH_(\"rs_sinpunt\", resumen.sinPuntuar));\n  lineas.push(\"- \" + tPIH_(\"rs_pend\", resumen.pendientesAltas));\n  if (estadoHistorico) lineas.push(\"- \" + estadoHistorico);\n  lineas.push(\"\");\n  lineas.push(tPIH_(\"rs_abre\", urlHoja));\n\n  return lineas.join(\"\\n\");\n}\n\n\nfunction construirHtmlResumenPIH_(resumen, estadoHistorico, urlHoja) {\n\n  const tarjetas = resumen.destacadas.map(d => {\n\n    const enlace = d.url\n      ? '<a href=\"' + escaparHtmlPIH_(d.url) + '\">' +\n        escaparHtmlPIH_(d.titulo) + \"</a>\"\n      : escaparHtmlPIH_(d.titulo);\n\n    return (\n      '<div style=\"margin:0 0 14px 0;padding:10px 12px;' +\n      'border-left:4px solid #1f3864;background:#f5f7fa;\">' +\n      '<div style=\"font-weight:bold;\">[' + d.nota + \"] \" + enlace + \"</div>\" +\n      '<div style=\"color:#555;font-size:13px;\">' +\n      escaparHtmlPIH_(d.autores) +\n      (d.ano ? \" (\" + escaparHtmlPIH_(d.ano) + \")\" : \"\") +\n      (d.revista ? \" · \" + escaparHtmlPIH_(d.revista) : \"\") +\n      \"</div>\" +\n      (d.tematica\n        ? '<div style=\"font-size:13px;\"><b>' + tPIH_(\"rs_tematica\") + ':</b> ' +\n          escaparHtmlPIH_(d.tematica) + \"</div>\"\n        : \"\") +\n      (d.resumen\n        ? '<div style=\"font-size:13px;margin-top:4px;\">' +\n          escaparHtmlPIH_(d.resumen) + \"</div>\"\n        : \"\") +\n      \"</div>\"\n    );\n  }).join(\"\");\n\n  return (\n    '<div style=\"font-family:Arial,sans-serif;max-width:680px;\">' +\n    \"<h2>\" + tPIH_(\"rs_h_titulo\") + \"</h2>\" +\n    \"<p>\" + tPIH_(\"rs_h_sub\") + \"</p>\" +\n    tarjetas +\n    \"<h3>\" + tPIH_(\"rs_balance\") + \"</h3><ul>\" +\n    \"<li>\" + tPIH_(\"rs_nuevas\", resumen.nuevas) + \"</li>\" +\n    \"<li>\" + tPIH_(\"rs_puntuadas\", resumen.puntuadas) + \"</li>\" +\n    \"<li>\" + tPIH_(\"rs_sinpunt\", resumen.sinPuntuar) + \"</li>\" +\n    \"<li>\" + tPIH_(\"rs_pend\", resumen.pendientesAltas) + \"</li>\" +\n    (estadoHistorico ? \"<li>\" + escaparHtmlPIH_(estadoHistorico) + \"</li>\" : \"\") +\n    \"</ul>\" +\n    '<p><a href=\"' + escaparHtmlPIH_(urlHoja) + '\">' + tPIH_(\"rs_h_abrir\") + '</a></p>' +\n    \"</div>\"\n  );\n}\n\n\n// =====================================================\n// ACTIVAR / DESACTIVAR\n// =====================================================\n\nfunction activarResumenSemanalPIH() {\n\n  eliminarActivadoresResumenPIH_();\n\n  ScriptApp.newTrigger(\"enviarResumenSemanalPIH\")\n    .timeBased()\n    .onWeekDay(ScriptApp.WeekDay.MONDAY)\n    .atHour(8)\n    .create();\n\n  avisarPIH_(tPIH_(\"rs_on\"), 8);\n}\n\n\nfunction desactivarResumenSemanalPIH() {\n\n  const eliminados = eliminarActivadoresResumenPIH_();\n\n  avisarPIH_(tPIH_(\"rs_off\", tPIH_(\"c_activadores\", eliminados)), 6);\n}\n\n\nfunction eliminarActivadoresResumenPIH_() {\n\n  let eliminados = 0;\n\n  ScriptApp.getProjectTriggers().forEach(activador => {\n    if (activador.getHandlerFunction() === \"enviarResumenSemanalPIH\") {\n      ScriptApp.deleteTrigger(activador);\n      eliminados++;\n    }\n  });\n\n  return eliminados;\n}\n"}, {"name": "Setup", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB · PLANTILLA PARA DOCTORANDOS\n * Setup.gs · Crea las pestañas básicas (vacías)\n *\n * Se ejecuta solo, al terminar «Configurar mi tesis». Es seguro repetirlo:\n * no borra nada de lo que ya exista.\n *\n * Crea: PUBLICACIONES, CONFIG, LOG, y después PANEL, RADAR, AUTORES CLAVE,\n * CONGRESOS y FUENTES PRIMARIAS (todas vacías).\n */\n\nconst PIH_PUBLICACIONES_CABECERAS = [\n  \"ID\", \"DOI\", \"TITULO\", \"AUTORES\", \"AÑO\", \"FECHA_PUBLICACION\",\n  \"REVISTA_EDITORIAL\", \"TIPO_DOCUMENTO\", \"IDIOMA\", \"FUENTE\", \"URL\",\n  \"ABSTRACT_ORIGINAL\", \"RESUMEN_IA\", \"TEMATICA_PRINCIPAL\",\n  \"TEMATICAS_SECUNDARIAS\", \"RELEVANCIA_0_5\", \"JUSTIFICACION_RELEVANCIA\",\n  \"VINCULO_TESIS\", \"ESTADO_LECTURA\", \"FECHA_DETECCION\", \"FECHA_REVISION\",\n  \"INCORPORADO_MENDELEY\", \"NIVEL_ANALISIS_IA\", \"CONFIANZA_ANALISIS\",\n  \"ORIGEN\", \"EXPORTADO_MENDELEY\", \"MENDELEY_ID_DOCUMENTO\"\n];\n\nconst PIH_CONFIG_INICIAL = [\n  [\"FRECUENCIA\", \"Semanal\", \"Periodicidad de búsqueda\"],\n  [\"VENTANA_DIAS\", \"90\", \"Periodo inicial de búsqueda\"],\n  [\"MAX_RESULTADOS\", \"50\", \"Máximo por consulta\"],\n  [\"MODO_IA\", \"Metadatos y abstracts; texto completo solo cuando esté disponible y autorizado\", \"Alcance del análisis\"]\n];\n\nconst PIH_LOG_CABECERAS = [\n  \"FECHA\", \"PROCESO\", \"RESULTADO\", \"REGISTROS_NUEVOS\", \"ERRORES\", \"DETALLES\"\n];\n\n\nfunction prepararPlantillaPIH_() {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n\n  // PUBLICACIONES\n  let pub = ss.getSheetByName(\"PUBLICACIONES\");\n  if (!pub) pub = ss.insertSheet(\"PUBLICACIONES\");\n\n  if (pub.getLastRow() < 1) {\n    pub.getRange(1, 1, 1, PIH_PUBLICACIONES_CABECERAS.length)\n      .setValues([PIH_PUBLICACIONES_CABECERAS])\n      .setFontWeight(\"bold\")\n      .setBackground(\"#24445C\")\n      .setFontColor(\"#FFFFFF\");\n    pub.setFrozenRows(1);\n  }\n\n  // CONFIG\n  let cfg = ss.getSheetByName(\"CONFIG\");\n  if (!cfg) cfg = ss.insertSheet(\"CONFIG\");\n\n  if (cfg.getLastRow() < 1) {\n    cfg.getRange(1, 1, 1, 3)\n      .setValues([[\"PARAMETRO\", \"VALOR\", \"DESCRIPCION\"]])\n      .setFontWeight(\"bold\");\n    cfg.getRange(2, 1, PIH_CONFIG_INICIAL.length, 3)\n      .setValues(PIH_CONFIG_INICIAL);\n    cfg.setColumnWidth(1, 160);\n    cfg.setColumnWidth(2, 360);\n    cfg.setColumnWidth(3, 260);\n  }\n\n  // LOG\n  let log = ss.getSheetByName(\"LOG\");\n  if (!log) log = ss.insertSheet(\"LOG\");\n\n  if (log.getLastRow() < 1) {\n    log.getRange(1, 1, 1, PIH_LOG_CABECERAS.length)\n      .setValues([PIH_LOG_CABECERAS])\n      .setFontWeight(\"bold\");\n  }\n\n  // Resto de pestañas (cada una comprueba si ya existe).\n  const pasos = [\n    crearInterfazDoctorado,\n    configurarSincronizacionRadar,\n    prepararAutoresClavePIH,\n    prepararCongresosPIH,\n    prepararFuentesPrimariasPIH\n  ];\n\n  const avisos = [];\n\n  pasos.forEach(paso => {\n    try {\n      paso();\n    } catch (e) {\n      avisos.push(String(e && e.message ? e.message : e));\n    }\n  });\n\n  // Quita la hoja en blanco que trae un documento nuevo.\n  const sobrante = ss.getSheetByName(\"Hoja 1\") || ss.getSheetByName(\"Sheet1\");\n  if (sobrante && ss.getSheets().length > 1 && sobrante.getLastRow() === 0) {\n    ss.deleteSheet(sobrante);\n  }\n\n  if (avisos.length) console.log(\"Avisos de preparación: \" + avisos.join(\" | \"));\n}\n"}, {"name": "Tutorial", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB · PLANTILLA PARA DOCTORANDOS\n * Tutorial.gs · Guía paso a paso al abrir la hoja\n *\n * Qué hace: al abrir la hoja muestra una ventana por pasos:\n *   - Antes de configurar la tesis: qué es esto, qué necesitas y qué pulsar.\n *   - Justo después de generar el perfil: qué hacer a continuación.\n * Cada ventana sale solo una vez. Se puede volver a abrir desde el menú\n * PIH Doctorado > Guía paso a paso.\n *\n * Coste: 0 €. No usa IA ni servicios externos.\n *\n * Se llama desde onOpen() en Menu.gs.\n */\n\n// Los textos se piden a Idiomas.gs (tPIH_).\nconst PIH_TUTORIAL_PROPIEDAD = \"PIH_TUTORIAL_VISTO\";\n\n// Los textos de los pasos están en Idiomas.gs (tut_inicio y tut_listo).\n\n\n// =====================================================\n// APERTURA AUTOMÁTICA\n// =====================================================\n\n/**\n * Se llama desde onOpen(). Muestra el tutorial que toque, una sola vez.\n */\nfunction tutorialAutomaticoPIH_() {\n\n  // La marca de «ya visto» va en las propiedades del USUARIO, no del\n  // documento: así una copia nueva del documento no hereda la marca de\n  // quien preparó la plantilla.\n  let visto = \"\";\n\n  try {\n    visto = PropertiesService.getUserProperties()\n      .getProperty(PIH_TUTORIAL_PROPIEDAD) || \"\";\n  } catch (e) {\n    visto = \"\";\n  }\n\n  const perfilListo = perfilConfiguradoPIH_();\n\n  if (perfilListo) ocultarHojaBienvenidaPIH_();\n\n  let modo = \"\";\n\n  if (!perfilListo && visto === \"\") modo = \"inicio\";\n  else if (perfilListo && visto !== \"listo\") modo = \"listo\";\n\n  if (!modo) return;\n\n  try {\n    PropertiesService.getUserProperties()\n      .setProperty(PIH_TUTORIAL_PROPIEDAD, modo);\n  } catch (e) {\n    // Sin propiedades se mostrará de nuevo la próxima vez: es preferible.\n  }\n\n  try {\n    mostrarTutorialPIH_(modo);\n  } catch (e) {\n    console.log(\"Tutorial (ventana): \" + e.message);\n\n    // Google no deja abrir ventanas en la primera apertura de una copia\n    // (todavía sin permisos). Se muestra la guía dentro de una pestaña.\n    try {\n      // Con la tesis ya configurada la guía no hace falta: solo un aviso.\n      if (modo !== \"inicio\") throw new Error(\"sin pestaña\");\n      crearHojaBienvenidaPIH_(modo);\n    } catch (e2) {\n      console.log(\"Tutorial (pestaña): \" + e2.message);\n      SpreadsheetApp.getActiveSpreadsheet().toast(\n        tPIH_(\"tut_toast\"),\n        tPIH_(\"tut_toast_titulo\"), 15\n      );\n    }\n  }\n}\n\n\n// =====================================================\n// PESTAÑA DE BIENVENIDA (cuando no se puede abrir la ventana)\n// =====================================================\n\nconst PIH_BIENVENIDA_HOJA = \"👋 START\";\n\nfunction crearHojaBienvenidaPIH_(modo) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n\n  const pasos = tPIH_(modo === \"listo\" ? \"tut_listo\" : \"tut_inicio\");\n\n  let hoja = ss.getSheetByName(PIH_BIENVENIDA_HOJA);\n  if (!hoja) hoja = ss.insertSheet(PIH_BIENVENIDA_HOJA, 0);\n\n  hoja.clear();\n  hoja.showSheet();\n  hoja.setHiddenGridlines(true);\n  hoja.setRightToLeft(PIH_IDIOMAS_RTL.indexOf(idiomaPIH_()) > -1);\n\n  hoja.setColumnWidth(1, 30);\n  hoja.setColumnWidth(2, 760);\n\n  const filas = [];\n  const estilo = [];   // t = banda, h = título, p = texto, a = pista, m = menú\n\n  filas.push([\"\", \"PERSONAL INTELLIGENCE HUB\"]); estilo.push(\"t\");\n  filas.push([\"\", tPIH_(modo === \"listo\" ? \"tut_label_listo\" : \"tut_label_inicio\")]); estilo.push(\"e\");\n  filas.push([\"\", \"\"]); estilo.push(\"p\");\n  filas.push([\"\", \"👉  \" + tPIH_(\"tut_toast\")]); estilo.push(\"m\");\n  filas.push([\"\", \"\"]); estilo.push(\"p\");\n\n  pasos.forEach((p, i) => {\n    filas.push([\"\", (i + 1) + \" · \" + p.titulo]); estilo.push(\"h\");\n    filas.push([\"\", p.texto]); estilo.push(\"p\");\n    if (p.pista) { filas.push([\"\", \"💡 \" + p.pista]); estilo.push(\"a\"); }\n    filas.push([\"\", \"\"]); estilo.push(\"p\");\n  });\n\n  hoja.getRange(1, 1, filas.length, 2).setValues(filas)\n    .setFontFamily(\"Arial\")\n    .setWrap(true)\n    .setVerticalAlignment(\"top\");\n\n  estilo.forEach((tipo, i) => {\n    const celda = hoja.getRange(i + 1, 2);\n    if (tipo === \"t\") {\n      hoja.getRange(i + 1, 1, 1, 2).setBackground(\"#24445C\");\n      celda.setFontColor(\"#FFFFFF\").setFontSize(20).setFontWeight(\"bold\");\n      hoja.setRowHeight(i + 1, 56);\n      celda.setVerticalAlignment(\"middle\");\n    } else if (tipo === \"e\") {\n      celda.setFontColor(\"#5F7384\").setFontSize(11);\n    } else if (tipo === \"m\") {\n      celda.setBackground(\"#E8F0F6\").setFontColor(\"#24445C\")\n        .setFontSize(15).setFontWeight(\"bold\");\n      hoja.setRowHeight(i + 1, 54);\n      celda.setVerticalAlignment(\"middle\");\n    } else if (tipo === \"h\") {\n      celda.setFontColor(\"#24445C\").setFontSize(14).setFontWeight(\"bold\");\n    } else if (tipo === \"a\") {\n      celda.setFontColor(\"#5F7384\").setFontStyle(\"italic\");\n    } else {\n      celda.setFontSize(12).setFontColor(\"#2C3E4C\");\n    }\n  });\n\n  ss.setActiveSheet(hoja);\n  hoja.setActiveSelection(\"B1\");\n\n  ss.toast(tPIH_(\"tut_toast\"), tPIH_(\"tut_toast_titulo\"), 10);\n}\n\n\n// Oculta la pestaña de bienvenida cuando ya no hace falta.\nfunction ocultarHojaBienvenidaPIH_() {\n  try {\n    const hoja = SpreadsheetApp.getActiveSpreadsheet()\n      .getSheetByName(PIH_BIENVENIDA_HOJA);\n    if (hoja && SpreadsheetApp.getActiveSpreadsheet().getSheets().length > 1) {\n      hoja.hideSheet();\n    }\n  } catch (e) {\n    console.log(\"Ocultar bienvenida: \" + e.message);\n  }\n}\n\n\nfunction perfilConfiguradoPIH_() {\n\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(\"PERFIL\");\n\n  if (!hoja || hoja.getLastRow() < 2) return false;\n\n  const claves = hoja.getRange(2, 1, hoja.getLastRow() - 1, 3).getValues();\n\n  return claves.some(f =>\n    f[0] === \"consultas_radar\" && String(f[2] || \"\").trim() !== \"\"\n  );\n}\n\n\n// Desde el menú.\nfunction menuTutorialInicioPIH() { mostrarTutorialPIH_(\"inicio\"); }\nfunction menuTutorialListoPIH() {\n  try {\n    PropertiesService.getUserProperties()\n      .setProperty(PIH_TUTORIAL_PROPIEDAD, \"listo\");\n  } catch (e) {}\n  mostrarTutorialPIH_(\"listo\");\n}\n\n\n// =====================================================\n// VENTANA\n// =====================================================\n\nfunction mostrarTutorialPIH_(modo) {\n\n  const pasos = tPIH_(modo === \"listo\" ? \"tut_listo\" : \"tut_inicio\");\n\n  const etiqueta = tPIH_(modo === \"listo\" ? \"tut_label_listo\" : \"tut_label_inicio\");\n\n  const json = JSON.stringify(pasos).replace(/</g, \"\\\\u003c\");\n\n  const textos = JSON.stringify({\n    prev: tPIH_(\"tut_prev\"),\n    next: tPIH_(\"tut_next\"),\n    start: tPIH_(\"tut_start\"),\n    of: tPIH_(\"tut_of\"),\n    menuError: tPIH_(\"tut_menu_error\")\n  }).replace(/</g, \"\\\\u003c\");\n\n  const opcionesIdioma = idiomasDisponiblesPIH_().map(p =>\n    '<option value=\"' + p[0] + '\"' + (p[0] === idiomaPIH_() ? \" selected\" : \"\") + \">\" +\n    p[1] + \"</option>\"\n  ).join(\"\");\n\n  const html = `\n<style>\n  body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: #FFFFFF; color: #1B2A36; }\n  .marco { padding: 24px 28px 20px; min-height: 410px; display: flex; flex-direction: column; box-sizing: border-box; }\n  .etiqueta { font-size: 11px; letter-spacing: .1em; color: #5F7384; margin: 0 0 8px; }\n  .barra { height: 3px; background: #E3E9EE; border-radius: 2px; margin-bottom: 22px; }\n  .barra div { height: 3px; background: #24445C; border-radius: 2px; transition: width .25s; }\n  h1 { font-size: 21px; margin: 0 0 14px; font-weight: 600; color: #24445C; }\n  .cuerpo { white-space: pre-line; font-size: 14px; line-height: 1.6; color: #2C3E4C; flex: 1; }\n  .pista { margin-top: 16px; padding: 10px 12px; background: #F2F6F9; border-left: 3px solid #24445C; font-size: 12.5px; color: #4D5C6A; }\n  .pie { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; }\n  .contador { font-size: 12px; color: #7B8B98; }\n  button { font: inherit; font-size: 13px; padding: 8px 16px; border-radius: 4px; border: 1px solid #C5D0D9; background: #FFFFFF; color: #24445C; cursor: pointer; }\n  button.principal { background: #24445C; color: #FFFFFF; border-color: #24445C; font-weight: 600; }\n  button:disabled { opacity: .4; cursor: default; }\n  button:focus-visible { outline: 2px solid #24445C; outline-offset: 2px; }\n  .botones { display: flex; gap: 8px; }\n  .cabecera { display: flex; justify-content: space-between; align-items: center; margin: 0 0 8px; }\n  .cabecera .etiqueta { margin: 0; }\n  .cabecera select { font: inherit; font-size: 12px; padding: 3px 6px; border: 1px solid #C5D0D9; border-radius: 4px; color: #24445C; background: #FFFFFF; }\n</style>\n\n<div class=\"marco\">\n  <div class=\"cabecera\">\n    <p class=\"etiqueta\">${etiqueta}</p>\n    <select id=\"idioma\" aria-label=\"${tPIH_(\"tut_idioma\")}\" onchange=\"cambiarIdioma(this.value)\">${opcionesIdioma}</select>\n  </div>\n  <div class=\"barra\"><div id=\"progreso\"></div></div>\n  <h1 id=\"titulo\"></h1>\n  <div class=\"cuerpo\" id=\"texto\"></div>\n  <div class=\"pista\" id=\"pista\"></div>\n  <div id=\"accion\" style=\"margin-top:12px; display:none;\">\n    <button class=\"principal\" id=\"botonAccion\" onclick=\"ejecutarAccion()\"></button>\n    <span id=\"errorAccion\" style=\"font-size:12px; color:#8A3B2E; margin-left:8px;\"></span>\n  </div>\n  <div class=\"pie\">\n    <span class=\"contador\" id=\"contador\"></span>\n    <span class=\"botones\">\n      <button id=\"atras\" onclick=\"mover(-1)\"></button>\n      <button id=\"adelante\" class=\"principal\" onclick=\"mover(1)\"></button>\n    </span>\n  </div>\n</div>\n\n<script>\n  var PASOS = ${json};\n  var TXT = ${textos};\n  var MODO = \"${modo}\";\n  var actual = 0;\n\n  function pintar() {\n    var p = PASOS[actual];\n    document.getElementById(\"titulo\").innerText = p.titulo;\n    document.getElementById(\"texto\").innerText = p.texto;\n    document.getElementById(\"pista\").innerText = p.pista;\n    document.getElementById(\"contador\").innerText = (actual + 1) + \" \" + TXT.of + \" \" + PASOS.length;\n    var accion = document.getElementById(\"accion\");\n    if (p.accion) {\n      accion.style.display = \"block\";\n      document.getElementById(\"botonAccion\").innerText = p.accion.etiqueta;\n      document.getElementById(\"errorAccion\").innerText = \"\";\n    } else {\n      accion.style.display = \"none\";\n    }\n    document.getElementById(\"progreso\").style.width = ((actual + 1) / PASOS.length * 100) + \"%\";\n    document.getElementById(\"atras\").disabled = actual === 0;\n    document.getElementById(\"atras\").innerText = TXT.prev;\n    document.getElementById(\"adelante\").innerText =\n      actual === PASOS.length - 1 ? TXT.start : TXT.next;\n  }\n\n  function mover(d) {\n    var nuevo = actual + d;\n    if (nuevo >= PASOS.length) { google.script.host.close(); return; }\n    if (nuevo < 0) return;\n    actual = nuevo;\n    pintar();\n  }\n\n  function ejecutarAccion() {\n    var p = PASOS[actual];\n    if (!p.accion || p.accion.funcion !== \"menuConfigurarTesisPIH\") return;\n    google.script.run\n      .withFailureHandler(function () {\n        document.getElementById(\"errorAccion\").innerText = TXT.menuError;\n      })\n      .menuConfigurarTesisPIH();\n  }\n\n  function cambiarIdioma(codigo) {\n    google.script.run\n      .withSuccessHandler(function () {\n        google.script.run.reabrirTutorialPIH(MODO);\n      })\n      .cambiarIdiomaPIH(codigo);\n  }\n\n  document.addEventListener(\"keydown\", function (e) {\n    if (e.key === \"ArrowRight\") mover(1);\n    if (e.key === \"ArrowLeft\") mover(-1);\n  });\n\n  pintar();\n</script>`;\n\n  SpreadsheetApp.getUi().showModalDialog(\n    HtmlService.createHtmlOutput(envolverPIH_(html)).setWidth(620).setHeight(500),\n    tPIH_(\"tut_dialogo\")\n  );\n}\n\n\n// La llama la ventana al cambiar de idioma: la vuelve a abrir traducida.\nfunction reabrirTutorialPIH(modo) {\n  mostrarTutorialPIH_(modo === \"listo\" ? \"listo\" : \"inicio\");\n}\n"}, {"name": "Zotero", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB · PLANTILLA PARA DOCTORANDOS\n * Zotero.gs · Envío automático a Zotero mediante su API\n *\n * Qué hace: las publicaciones con ESTADO «Para leer» o «Leído» se crean\n * solas en tu biblioteca de Zotero, dentro de una colección llamada\n * «PIH Doctorado», y en RADAR pasan a «Sí» en la columna EN MI GESTOR.\n *\n * Qué necesitas (gratis, 2 minutos):\n *   1. Cuenta gratuita en zotero.org.\n *   2. Una clave de API con permiso de escritura:\n *      zotero.org/settings/keys > «Create new private key» >\n *      marca «Allow library access» y «Allow write access» > Save.\n *   3. Menú PIH Doctorado > Ajustes > Zotero: conectar, y pega la clave.\n *      (No hace falta tu número de usuario: se obtiene solo.)\n *\n * Usa las mismas columnas que Mendeley (INCORPORADO_MENDELEY y\n * MENDELEY_ID_DOCUMENTO), que por historia llevan ese nombre: aquí guardan\n * si la publicación ya está en tu gestor y su identificador.\n *\n * Coste: 0 €. Si hay límite de uso (429) se detiene y continúa luego.\n *\n * Depende de InterfazDoctorado.gs (obtenerValorPIH_, asegurarColumnaPIH_,\n * obtenerIndiceCabecerasPIH_, normalizarTextoPIH_, avisarPIH_),\n * Mendeley.gs (PIH_ESTADOS_EXPORTABLES) y RadarAcademico.gs\n * (registrarLogPIH_).\n */\n\nconst PIH_ZOTERO_API = \"https://api.zotero.org\";\nconst PIH_ZOTERO_COLECCION = \"PIH Doctorado\";\nconst PIH_ZOTERO_LOTE = 25;\nconst PIH_ZOTERO_MAX_INTENTOS = 3;\nconst PIH_ZOTERO_TIEMPO_MAXIMO_MS = 240000;\n\n\n// =====================================================\n// CONEXIÓN\n// =====================================================\n\nfunction conectarZoteroPIH() {\n\n  const html = `\n<div style=\"font-family: Arial, sans-serif; font-size: 13px; color: #202124;\">\n  <p style=\"margin: 0 0 10px;\">${tPIH_(\"zo_intro\")}</p>\n\n  <input id=\"clave\" type=\"password\" style=\"width:100%; margin-bottom:12px;\">\n\n  <button id=\"boton\" onclick=\"enviar()\"\n    style=\"background:#24445C; color:white; border:0; padding:8px 16px;\">\n    ${tPIH_(\"zo_conectar\")}</button>\n\n  <p id=\"estado\" style=\"margin-top:10px; color:#5f6368;\"></p>\n</div>\n<script>\n  function enviar() {\n    document.getElementById(\"boton\").disabled = true;\n    document.getElementById(\"estado\").innerText = ${JSON.stringify(tPIH_(\"zo_comprobando\")).replace(/</g, \"\\\\u003c\")};\n    google.script.run\n      .withSuccessHandler(function (m) {\n        document.getElementById(\"estado\").innerText = m;\n      })\n      .withFailureHandler(function (e) {\n        document.getElementById(\"estado\").innerText =\n          String(e.message).replace(/^(Error: )+/, \"Error: \");\n        document.getElementById(\"boton\").disabled = false;\n      })\n      .guardarClaveZoteroPIH(document.getElementById(\"clave\").value);\n  }\n</script>`;\n\n  SpreadsheetApp.getUi().showModalDialog(\n    HtmlService.createHtmlOutput(envolverPIH_(html)).setWidth(460).setHeight(280),\n    tPIH_(\"zo_dialogo\")\n  );\n}\n\n\nfunction guardarClaveZoteroPIH(clave) {\n\n  const limpia = String(clave || \"\").trim();\n\n  if (!limpia) throw new Error(tPIH_(\"zo_err_pegar\"));\n\n  const respuesta = UrlFetchApp.fetch(PIH_ZOTERO_API + \"/keys/current\", {\n    method: \"get\",\n    headers: {\n      \"Zotero-API-Key\": limpia,\n      \"Zotero-API-Version\": \"3\"\n    },\n    muteHttpExceptions: true\n  });\n\n  if (respuesta.getResponseCode() !== 200) {\n    throw new Error(tPIH_(\"zo_err_clave\", respuesta.getResponseCode()));\n  }\n\n  const info = JSON.parse(respuesta.getContentText());\n\n  const acceso = info.access && info.access.user ? info.access.user : {};\n\n  if (!acceso.library) {\nthrow new Error(tPIH_(\"zo_err_acceso\"));\n  }\n\n  if (!acceso.write) {\nthrow new Error(tPIH_(\"zo_err_escritura\"));\n  }\n\n  const props = PropertiesService.getScriptProperties();\n\n  props.setProperty(\"ZOTERO_API_KEY\", limpia);\n  props.setProperty(\"ZOTERO_USER_ID\", String(info.userID));\n  props.deleteProperty(\"ZOTERO_COLECCION_ID\");\n\n  return tPIH_(\"zo_conectado\");\n}\n\n\nfunction desconectarZoteroPIH() {\n\n  const props = PropertiesService.getScriptProperties();\n\n  [\"ZOTERO_API_KEY\", \"ZOTERO_USER_ID\", \"ZOTERO_COLECCION_ID\"]\n    .forEach(clave => props.deleteProperty(clave));\n\n  avisarPIH_(tPIH_(\"zo_desconectado\"), 8);\n}\n\n\nfunction probarConexionZoteroPIH() {\n\n  const ui = SpreadsheetApp.getUi();\n\n  try {\n    const credenciales = credencialesZoteroPIH_();\n\n    const respuesta = peticionZoteroPIH_(\n      \"get\", \"/users/\" + credenciales.usuario + \"/collections?limit=1\", null\n    );\n\n    if (respuesta.getResponseCode() !== 200) {\n      throw errorZoteroPIH_(\"probar conexión\", respuesta);\n    }\n\n    ui.alert(\"Zotero\", tPIH_(\"zo_funciona\"), ui.ButtonSet.OK);\n\n  } catch (e) {\n    ui.alert(\"Zotero\", String(e && e.message ? e.message : e), ui.ButtonSet.OK);\n  }\n}\n\n\nfunction credencialesZoteroPIH_() {\n\n  const props = PropertiesService.getScriptProperties();\n\n  const clave = props.getProperty(\"ZOTERO_API_KEY\");\n  const usuario = props.getProperty(\"ZOTERO_USER_ID\");\n\n  if (!clave || !usuario) {\n    const error = new Error(\n      tPIH_(\"zo_no_conectado\")\n    );\n    error.tipo = \"autorizacion\";\n    throw error;\n  }\n\n  return { clave: clave, usuario: usuario };\n}\n\n\nfunction peticionZoteroPIH_(metodo, ruta, cuerpo, tokenEscritura) {\n\n  const credenciales = credencialesZoteroPIH_();\n\n  const cabeceras = {\n    \"Zotero-API-Key\": credenciales.clave,\n    \"Zotero-API-Version\": \"3\"\n  };\n\n  if (tokenEscritura) cabeceras[\"Zotero-Write-Token\"] = tokenEscritura;\n\n  const opciones = {\n    method: metodo,\n    headers: cabeceras,\n    muteHttpExceptions: true\n  };\n\n  if (cuerpo !== null && cuerpo !== undefined) {\n    opciones.contentType = \"application/json\";\n    opciones.payload = JSON.stringify(cuerpo);\n  }\n\n  return UrlFetchApp.fetch(PIH_ZOTERO_API + ruta, opciones);\n}\n\n\nfunction errorZoteroPIH_(accion, respuesta) {\n\n  const codigo = respuesta.getResponseCode();\n\n  const error = new Error(\n    \"Zotero (\" + accion + \") HTTP \" + codigo + \": \" +\n    respuesta.getContentText().substring(0, 300)\n  );\n\n  if (codigo === 401 || codigo === 403) error.tipo = \"autorizacion\";\n  else if (codigo === 429) error.tipo = \"cuota\";\n  else if (codigo >= 500) error.tipo = \"transitorio\";\n  else error.tipo = \"contenido\";\n\n  return error;\n}\n\n\nfunction tipoErrorZoteroPIH_(e) {\n  return e && e.tipo ? e.tipo : \"transitorio\";\n}\n\n\n// =====================================================\n// COLECCIÓN\n// =====================================================\n\nfunction obtenerColeccionZoteroPIH_() {\n\n  const props = PropertiesService.getScriptProperties();\n\n  const guardada = props.getProperty(\"ZOTERO_COLECCION_ID\");\n  if (guardada) return guardada;\n\n  const usuario = credencialesZoteroPIH_().usuario;\n\n  const lista = peticionZoteroPIH_(\n    \"get\", \"/users/\" + usuario + \"/collections?limit=100\", null\n  );\n\n  if (lista.getResponseCode() !== 200) {\n    throw errorZoteroPIH_(\"listar colecciones\", lista);\n  }\n\n  const existente = JSON.parse(lista.getContentText())\n    .filter(c => c.data && c.data.name === PIH_ZOTERO_COLECCION)[0];\n\n  if (existente) {\n    props.setProperty(\"ZOTERO_COLECCION_ID\", existente.key);\n    return existente.key;\n  }\n\n  const creada = peticionZoteroPIH_(\n    \"post\", \"/users/\" + usuario + \"/collections\",\n    [{ name: PIH_ZOTERO_COLECCION }]\n  );\n\n  if (creada.getResponseCode() !== 200) {\n    throw errorZoteroPIH_(\"crear colección\", creada);\n  }\n\n  const clave = (JSON.parse(creada.getContentText()).success || {})[\"0\"];\n\n  if (!clave) {\n    throw new Error(tPIH_(\"zo_err_coleccion\"));\n  }\n\n  props.setProperty(\"ZOTERO_COLECCION_ID\", clave);\n  return clave;\n}\n\n\n// =====================================================\n// CONSTRUCCIÓN DE REFERENCIAS\n// =====================================================\n\nfunction tipoZoteroPIH_(tipoDocumento) {\n\n  const tipo = normalizarTextoPIH_(tipoDocumento);\n\n  const equivalencias = {\n    \"article\": \"journalArticle\",\n    \"review\": \"journalArticle\",\n    \"book\": \"book\",\n    \"book-chapter\": \"bookSection\",\n    \"dissertation\": \"thesis\",\n    \"report\": \"report\",\n    \"preprint\": \"preprint\",\n    \"proceedings-article\": \"conferencePaper\"\n  };\n\n  return equivalencias[tipo] || \"document\";\n}\n\n\nfunction autorZoteroPIH_(texto) {\n\n  const limpio = String(texto || \"\").replace(/\\s+/g, \" \").trim();\n\n  if (limpio.indexOf(\",\") !== -1) {\n    const partes = limpio.split(\",\");\n    return {\n      creatorType: \"author\",\n      firstName: partes.slice(1).join(\",\").trim(),\n      lastName: partes[0].trim()\n    };\n  }\n\n  const palabras = limpio.split(\" \");\n\n  if (palabras.length < 2) {\n    return { creatorType: \"author\", firstName: \"\", lastName: limpio };\n  }\n\n  return {\n    creatorType: \"author\",\n    firstName: palabras.slice(0, -1).join(\" \"),\n    lastName: palabras[palabras.length - 1]\n  };\n}\n\n\nfunction construirItemZoteroPIH_(r, coleccion) {\n\n  const tipo = tipoZoteroPIH_(r.tipo);\n\n  const item = {\n    itemType: tipo,\n    title: String(r.titulo).trim(),\n    creators: String(r.autores || \"\")\n      .split(\";\")\n      .map(a => a.trim())\n      .filter(Boolean)\n      .map(autorZoteroPIH_)\n      .filter(a => a.lastName !== \"\"),\n    tags: [{ tag: \"PIH\" }]\n  };\n\n  const anio = parseInt(r.ano, 10);\n  if (!isNaN(anio)) item.date = String(anio);\n\n  if (r.abstract) item.abstractNote = String(r.abstract).trim();\n  if (r.url) item.url = String(r.url).trim();\n  if (r.tematica) item.tags.push({ tag: String(r.tematica).trim() });\n\n  // Solo los artículos tienen campos propios de revista y DOI. Para el\n  // resto de tipos se guardan en «Extra» y así Zotero nunca los rechaza.\n  const extra = [];\n\n  if (tipo === \"journalArticle\") {\n    if (r.revista) item.publicationTitle = String(r.revista).trim();\n    if (r.doi) item.DOI = String(r.doi).trim();\n  } else {\n    if (r.revista) extra.push(\"Publicado en: \" + String(r.revista).trim());\n    if (r.doi) extra.push(\"DOI: \" + String(r.doi).trim());\n  }\n\n  extra.push(\n    [\n      \"PIH\",\n      r.relevancia !== \"\" ? \"relevancia \" + r.relevancia : \"\",\n      r.estado ? \"estado \" + r.estado : \"\"\n    ].filter(Boolean).join(\" · \")\n  );\n\n  item.extra = extra.join(\"\\n\");\n\n  if (coleccion) item.collections = [coleccion];\n\n  return item;\n}\n\n\n// =====================================================\n// ENVÍO A ZOTERO\n// =====================================================\n\nfunction sincronizarConZoteroPIH() {\n\n  const bloqueo = LockService.getScriptLock();\n\n  if (!bloqueo.tryLock(5000)) {\n    avisarPIH_(tPIH_(\"zo_ocupado\"), 8);\n    return { enviadas: 0, errores: [], motivoParada: \"ocupado\", restantes: 0 };\n  }\n\n  try {\n    return ejecutarEnvioZoteroPIH_();\n  } finally {\n    bloqueo.releaseLock();\n  }\n}\n\n\nfunction ejecutarEnvioZoteroPIH_() {\n\n  const inicio = Date.now();\n\n  const hoja = SpreadsheetApp.getActiveSpreadsheet()\n    .getSheetByName(\"PUBLICACIONES\");\n\n  if (!hoja) throw new Error(tPIH_(\"zo_no_hoja\"));\n\n  const resultado = { enviadas: 0, errores: [], motivoParada: \"\", restantes: 0 };\n\n  try {\n    credencialesZoteroPIH_();\n  } catch (e) {\n    avisarPIH_(String(e.message || e), 12);\n    registrarLogPIH_(\"ZOTERO_API\", \"SIN_CONEXION\", 0, String(e.message));\n    resultado.motivoParada = \"autorizacion\";\n    return resultado;\n  }\n\n  if (hoja.getLastRow() < 2) return resultado;\n\n  const cabeceras = hoja\n    .getRange(1, 1, 1, hoja.getLastColumn())\n    .getValues()[0]\n    .map(String);\n\n  asegurarColumnaPIH_(hoja, cabeceras, \"INCORPORADO_MENDELEY\");\n  asegurarColumnaPIH_(hoja, cabeceras, \"MENDELEY_ID_DOCUMENTO\");\n\n  SpreadsheetApp.flush();\n\n  const datos = hoja.getDataRange().getValues();\n  const indice = obtenerIndiceCabecerasPIH_(datos[0]);\n\n  const colIncorporado = indice.INCORPORADO_MENDELEY;\n  const colId = indice.MENDELEY_ID_DOCUMENTO;\n\n  const pendientes = [];\n  let totalPendientes = 0;\n\n  for (let i = 1; i < datos.length; i++) {\n\n    const fila = datos[i];\n\n    const titulo = String(obtenerValorPIH_(fila, indice, \"TITULO\")).trim();\n    if (titulo === \"\") continue;\n\n    const estado = normalizarTextoPIH_(\n      obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    );\n\n    if (PIH_ESTADOS_EXPORTABLES.indexOf(estado) === -1) continue;\n\n    const incorporada = [\"si\", \"true\", \"yes\"].includes(\n      normalizarTextoPIH_(fila[colIncorporado])\n    );\n\n    if (incorporada) continue;\n\n    const marca = String(fila[colId] || \"\").trim();\n\n    if (marca !== \"\" && !/^Error \\(/.test(marca)) continue;\n\n    const coincidencia = marca.match(/^Error \\((\\d+)\\)/);\n    const intentos = coincidencia ? Number(coincidencia[1]) : 0;\n\n    if (intentos >= PIH_ZOTERO_MAX_INTENTOS) continue;\n\n    totalPendientes++;\n\n    if (pendientes.length >= PIH_ZOTERO_LOTE) continue;\n\n    pendientes.push({\n      numeroFila: i + 1,\n      intentos: intentos,\n      titulo: titulo,\n      autores: obtenerValorPIH_(fila, indice, \"AUTORES\"),\n      ano: obtenerValorPIH_(fila, indice, \"ANO\"),\n      revista: obtenerValorPIH_(fila, indice, \"REVISTA_EDITORIAL\"),\n      tipo: obtenerValorPIH_(fila, indice, \"TIPO_DOCUMENTO\"),\n      doi: obtenerValorPIH_(fila, indice, \"DOI\"),\n      url: obtenerValorPIH_(fila, indice, \"URL\"),\n      abstract: obtenerValorPIH_(fila, indice, \"ABSTRACT_ORIGINAL\"),\n      tematica: obtenerValorPIH_(fila, indice, \"TEMATICA_PRINCIPAL\"),\n      relevancia: obtenerValorPIH_(fila, indice, \"RELEVANCIA_0_5\"),\n      estado: obtenerValorPIH_(fila, indice, \"ESTADO_LECTURA\")\n    });\n  }\n\n  if (pendientes.length === 0) {\n    avisarPIH_(tPIH_(\"zo_nada\"), 10);\n    return resultado;\n  }\n\n  let coleccion = \"\";\n\n  try {\n    coleccion = obtenerColeccionZoteroPIH_();\n  } catch (e) {\n    const tipo = tipoErrorZoteroPIH_(e);\n\n    if (tipo !== \"contenido\") {\n      resultado.motivoParada = tipo;\n      resultado.errores.push(\"Colección: \" + e.message);\n      return cerrarEnvioZoteroPIH_(resultado, totalPendientes);\n    }\n\n    resultado.errores.push(\"Colección no creada: \" + e.message);\n  }\n\n  if (Date.now() - inicio > PIH_ZOTERO_TIEMPO_MAXIMO_MS) {\n    return cerrarEnvioZoteroPIH_(resultado, totalPendientes);\n  }\n\n  try {\n\n    const usuario = credencialesZoteroPIH_().usuario;\n\n    const respuesta = peticionZoteroPIH_(\n      \"post\",\n      \"/users/\" + usuario + \"/items\",\n      pendientes.map(p => construirItemZoteroPIH_(p, coleccion)),\n      Utilities.getUuid().replace(/-/g, \"\")\n    );\n\n    if (respuesta.getResponseCode() !== 200) {\n      throw errorZoteroPIH_(\"crear referencias\", respuesta);\n    }\n\n    const cuerpo = JSON.parse(respuesta.getContentText());\n    const correctas = cuerpo.success || {};\n    const falladas = cuerpo.failed || {};\n\n    pendientes.forEach((p, posicion) => {\n\n      const clave = correctas[String(posicion)];\n\n      if (clave) {\n        hoja.getRange(p.numeroFila, colId + 1).setValue(clave);\n        hoja.getRange(p.numeroFila, colIncorporado + 1).setValue(\"Sí\");\n        resultado.enviadas++;\n        return;\n      }\n\n      const fallo = falladas[String(posicion)];\n\n      hoja.getRange(p.numeroFila, colId + 1)\n        .setValue(\"Error (\" + (p.intentos + 1) + \")\");\n\n      resultado.errores.push(\n        p.titulo + \": \" + (fallo ? fallo.message : \"sin respuesta\")\n      );\n    });\n\n    SpreadsheetApp.flush();\n\n  } catch (e) {\n    resultado.errores.push(e.message);\n    resultado.motivoParada = tipoErrorZoteroPIH_(e);\n\n    // Un error de contenido en todo el lote no se reintenta eternamente.\n    if (resultado.motivoParada === \"contenido\") {\n      pendientes.forEach(p => {\n        hoja.getRange(p.numeroFila, colId + 1)\n          .setValue(\"Error (\" + (p.intentos + 1) + \")\");\n      });\n      resultado.motivoParada = \"\";\n    }\n  }\n\n  return cerrarEnvioZoteroPIH_(resultado, totalPendientes);\n}\n\n\nfunction cerrarEnvioZoteroPIH_(resultado, totalPendientes) {\n\n  resultado.restantes = Math.max(totalPendientes - resultado.enviadas, 0);\n\n  let estado = \"COMPLETADO\";\n\n  if (resultado.motivoParada === \"autorizacion\") estado = \"ERROR_AUTORIZACION\";\n  else if (resultado.motivoParada === \"cuota\") estado = \"LIMITE_ALCANZADO\";\n  else if (resultado.motivoParada === \"transitorio\") estado = \"PAUSADO_ERROR_TEMPORAL\";\n  else if (resultado.errores.length) estado = \"PARCIAL\";\n\n  registrarLogPIH_(\n    \"ZOTERO_API\",\n    estado,\n    resultado.enviadas,\n    resultado.errores.join(\" | \") || \"Sin errores\"\n  );\n\n  if (resultado.enviadas > 0 && typeof crearInterfazDoctorado === \"function\") {\n    crearInterfazDoctorado();\n  }\n\n  let mensaje = tPIH_(\"zo_enviadas\", resultado.enviadas, resultado.restantes);\n\n  if (resultado.motivoParada === \"autorizacion\") {\n    mensaje += tPIH_(\"zo_reconectar\");\n  } else if (resultado.motivoParada === \"cuota\") {\n    mensaje += tPIH_(\"zo_limite\");\n  } else if (resultado.motivoParada === \"transitorio\") {\n    mensaje += tPIH_(\"zo_temporal\");\n  } else if (resultado.errores.length) {\n    mensaje += tPIH_(\"zo_errores\");\n  }\n\n  avisarPIH_(mensaje, 12);\n\n  return resultado;\n}\n\n\n// =====================================================\n// AUTOMATIZACIÓN Y SELECTOR DE GESTOR\n// =====================================================\n\nfunction activarEnvioAutomaticoZoteroPIH() {\n\n  desactivarEnvioAutomaticoZoteroPIH_();\n\n  ScriptApp.newTrigger(\"sincronizarConZoteroPIH\")\n    .timeBased()\n    .everyHours(6)\n    .create();\n\n  avisarPIH_(tPIH_(\"zo_auto_on\"), 8);\n}\n\n\nfunction desactivarEnvioAutomaticoZoteroPIH() {\n\n  const eliminados = desactivarEnvioAutomaticoZoteroPIH_();\n\n  avisarPIH_(tPIH_(\"zo_auto_off\", eliminados), 6);\n}\n\n\nfunction desactivarEnvioAutomaticoZoteroPIH_() {\n\n  let eliminados = 0;\n\n  ScriptApp.getProjectTriggers().forEach(activador => {\n    if (activador.getHandlerFunction() === \"sincronizarConZoteroPIH\") {\n      ScriptApp.deleteTrigger(activador);\n      eliminados++;\n    }\n  });\n\n  return eliminados;\n}\n\n\n// Gestor elegido en PERFIL: \"mendeley\", \"zotero\" o \"ninguno\".\nfunction gestorElegidoPIH_() {\n\n  const valor = normalizarTextoPIH_(\n    textoPerfilPIH_(\"gestor_referencias\", \"Ninguno\")\n  );\n\n  if (valor.indexOf(\"zotero\") !== -1) return \"zotero\";\n  if (valor.indexOf(\"mendeley\") !== -1) return \"mendeley\";\n  return \"ninguno\";\n}\n\n\n// «Enviar a mi gestor ahora» del menú.\nfunction enviarAGestorPIH() {\n\n  const gestor = gestorElegidoPIH_();\n\n  if (gestor === \"zotero\") return sincronizarConZoteroPIH();\n  if (gestor === \"mendeley\") return sincronizarConMendeleyPIH();\n\n  avisarPIH_(tPIH_(\"zo_sin_gestor\"), 10);\n}\n\n\n// Activa el envío automático del gestor elegido y desactiva el otro.\nfunction activarEnvioAutomaticoGestorPIH() {\n\n  const gestor = gestorElegidoPIH_();\n\n  desactivarEnvioAutomaticoZoteroPIH_();\n  desactivarEnvioAutomaticoMendeleyPIH_();\n\n  if (gestor === \"zotero\") {\n    activarEnvioAutomaticoZoteroPIH();\n  } else if (gestor === \"mendeley\") {\n    activarEnvioAutomaticoMendeleyPIH();\n  }\n}\n\n\nfunction desactivarEnvioAutomaticoGestorPIH() {\n  desactivarEnvioAutomaticoZoteroPIH_();\n  desactivarEnvioAutomaticoMendeleyPIH_();\n}\n"}]}

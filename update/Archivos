nferencji.\",\n  \"co_mail_cab\": \"Terminy konferencji w ciągu najbliższych {0} dni:\",\n  \"co_en_dia\": \"za {0} dzień\",\n  \"co_en_dias\": \"za {0} dni\",\n  \"co_asunto\": \"PIH Doctorado · terminów konferencji w ciągu najbliższych {1} dni: {0}\",\n  \"co_enviado\": \"Przypomnienie o terminach zostało wysłane na Twój e-mail.\",\n  \"co_on\": \"Przypomnienie o konferencjach włączone: w każdy poniedziałek około 8:00.\",\n  \"co_off\": \"Przypomnienie o konferencjach wyłączone ({0}).\",\n  \"fp_catalogo\": \"Dodano źródeł: {0}. Sprawdź linki oznaczone «Localizado en buscador» (znalezione wyszukiwarką) i uzupełnij te «Por localizar» (do znalezienia).\",\n  \"fp_primero\": \"Najpierw użyj «Preparar catálogo» (przygotuj katalog).\",\n  \"fp_mail_cab\": \"Nowe dokumenty w Twoich źródłach pierwotnych:\",\n  \"fp_asunto\": \"PIH Doctorado · nowych dokumentów w źródłach pierwotnych: {0}\",\n  \"fp_resultado\": \"Nowych dokumentów: {0} (sprawdzonych stron: {1}).\",\n  \"fp_errores\": \" Wystąpiły błędy: zobacz LOG.\",\n  \"fp_on\": \"Sprawdzanie źródeł włączone: w każdą niedzielę około 20:00.\",\n  \"fp_off\": \"Sprawdzanie źródeł wyłączone ({0}).\",\n  \"me_falta_cred\": \"We właściwościach skryptu brakuje MENDELEY_CLIENT_ID lub MENDELEY_CLIENT_SECRET.\",\n  \"me_falta_oauth\": \"W projekcie brakuje biblioteki OAuth2 (identyfikator OAuth2).\",\n  \"me_ya\": \"Mendeley jest już połączone.\",\n  \"me_html\": \"<p>1. Kliknij link. Mendeley otworzy się w innej karcie.</p><p>2. Zaloguj się i zatwierdź uprawnienia.</p><p>3. Gdy zobaczysz «Mendeley połączone», zamknij tę kartę i użyj <i>Ustawienia &gt; Mendeley: przetestuj połączenie</i>.</p>\",\n  \"me_enlace\": \"👉 Połącz z Mendeley\",\n  \"me_dialogo\": \"Połącz z Mendeley\",\n  \"me_desconectado\": \"Mendeley rozłączone.\",\n  \"me_alert_no\": \"Nie jesteś jeszcze połączony(-a). Użyj Ustawienia > Mendeley (zaawansowane): połącz.\",\n  \"me_ok\": \"✅ Połączenie z Twoją biblioteką Mendeley działa prawidłowo.\",\n  \"me_api_codigo\": \"API odpowiedziało kodem {0}.\\n\\n{1}\",\n  \"me_no_conectado\": \"Mendeley nie jest połączone.\",\n  \"me_no_conectado_aviso\": \"Mendeley nie jest połączone. Użyj Ustawienia > Mendeley (zaawansowane): połącz.\",\n  \"me_enviadas\": \"Wysłano do Mendeley: {0}. Oczekuje: {1}.\",\n  \"me_reconectar\": \" Trzeba ponownie połączyć Mendeley z menu.\",\n  \"me_auto_on\": \"Automatyczne wysyłanie do Mendeley włączone (co 6 godzin).\",\n  \"me_auto_off\": \"Automatyczne wysyłanie do Mendeley wyłączone ({0}).\"\n};\n}\n"}, {"name": "Idioma_ru", "type": "SERVER_JS", "source": "// PIH Doctorado · textos del idioma \"ru\". Pega este archivo como Idioma_ru.gs.\nfunction textosPIH_ru() {\n  return {\n  \"m_configurar\": \"🎓 Настроить мою диссертацию (начните здесь)\",\n  \"m_actualizar\": \"📊 Обновить панель и RADAR\",\n  \"m_buscar_base\": \"🔍 Искать по всей базе\",\n  \"m_novedades\": \"🔎 Искать новинки сейчас\",\n  \"m_clasificar\": \"🤖 Классифицировать ожидающие с помощью ИИ\",\n  \"m_gestor\": \"📚 Отправить сейчас в мой менеджер библиографии\",\n  \"m_ris\": \"📤 Экспортировать файл RIS (EndNote и другие)\",\n  \"m_ris_enviar\": \"Отправить мне файл по почте\",\n  \"m_ris_marcar\": \"Отметить как импортированные\",\n  \"m_mapa\": \"🗺 Карта пробелов диссертации\",\n  \"m_revisar\": \"🔄 Проверить сейчас\",\n  \"m_autores\": \"Ключевые авторы\",\n  \"m_fuentes\": \"Первичные источники\",\n  \"m_abiertas\": \"Открытые источники (по желанию)\",\n  \"m_congresos\": \"Сроки конференций\",\n  \"m_resumen\": \"Еженедельная сводка по почте\",\n  \"m_hist_continuar\": \"Исторический радар: продолжить\",\n  \"m_hist_estado\": \"Исторический радар: показать состояние\",\n  \"m_ajustes\": \"⚙ Настройки\",\n  \"m_activar_todo\": \"▶ Включить ВСЮ автоматизацию\",\n  \"m_desactivar_todo\": \"⏹ Выключить ВСЮ автоматизацию\",\n  \"m_hist_activar\": \"Автоматический исторический радар: включить\",\n  \"m_hist_desactivar\": \"Автоматический исторический радар: выключить\",\n  \"m_ab_activar\": \"Открытые источники (по желанию): включить\",\n  \"m_ab_desactivar\": \"Открытые источники: выключить\",\n  \"m_ab_probar\": \"Открытые источники: проверить соединение\",\n  \"m_zo_conectar\": \"Zotero: подключить (только в первый раз)\",\n  \"m_zo_probar\": \"Zotero: проверить соединение\",\n  \"m_zo_desconectar\": \"Zotero: отключить\",\n  \"m_me_conectar\": \"Mendeley (для опытных): подключить\",\n  \"m_me_probar\": \"Mendeley: проверить соединение\",\n  \"m_me_desconectar\": \"Mendeley: отключить\",\n  \"m_repuntuar\": \"Переоценить ожидающие по новому критерию\",\n  \"m_diagnostico\": \"Диагностика системы\",\n  \"m_idioma\": \"🌐 Idioma / Language\",\n  \"m_guia\": \"📖 Пошаговое руководство\",\n  \"m_guia_inicio\": \"Первые шаги\",\n  \"m_guia_listo\": \"После настройки диссертации\",\n  \"m_guia_rapida\": \"❓ Краткое руководство\",\n  \"a_buscando\": \"Ищу новинки в OpenAlex…\",\n  \"a_nuevos\": \"Новых публикаций: {0}.\",\n  \"a_nuevos_clasificar\": \" Чтобы проанализировать их, используйте «Классифицировать ожидающие с помощью ИИ».\",\n  \"a_limite_openalex\": \" Достигнут бесплатный лимит OpenAlex: попробуйте позже.\",\n  \"a_clasificando\": \"Классифицирую с помощью ИИ (это может занять несколько минут)…\",\n  \"a_fuentes\": \"Проверяю страницы источников…\",\n  \"a_autores\": \"Проверяю ключевых авторов…\",\n  \"a_mapa\": \"Рассчитываю карту пробелов…\",\n  \"a_error_titulo\": \"Не удалось завершить действие\",\n  \"a_error_pie\": \"\\n\\nЕсли проблема повторяется, посмотрите вкладку LOG.\",\n  \"act_titulo\": \"Включить всю автоматизацию\",\n  \"act_texto\": \"Будет включено:\\n• Ежедневный радар + классификация с помощью ИИ (каждый день и каждый час)\\n• Отправка в выбранный менеджер библиографии (каждые 6 часов)\\n• Еженедельная сводка по почте (по понедельникам)\\n• Напоминание о сроках конференций (по понедельникам)\\n• Проверка первичных источников (по воскресеньям)\\n• Проверка ключевых авторов (по воскресеньям)\\n\\nИсторический радар и открытые источники (архивы диссертаций) включаются отдельно (Настройки).\\n\\nПродолжить?\",\n  \"act_ok\": \"Автоматизация включена\",\n  \"des_titulo\": \"Выключить всю автоматизацию\",\n  \"des_texto\": \"Все автоматические задачи будут остановлены (включая исторический радар). Изменения в RADAR по-прежнему будут синхронизироваться.\\n\\nПродолжить?\",\n  \"des_ok\": \"Автоматизация выключена\",\n  \"p_radar\": \"Ежедневный радар и классификация\",\n  \"p_gestor\": \"Отправка в ваш менеджер библиографии\",\n  \"p_resumen\": \"Еженедельная сводка\",\n  \"p_congresos\": \"Сроки конференций\",\n  \"p_fuentes\": \"Первичные источники\",\n  \"p_autores\": \"Ключевые авторы\",\n  \"p_abiertas\": \"Открытые источники\",\n  \"p_historico\": \"Исторический радар\",\n  \"guia_titulo\": \"Краткое руководство · PIH Doctorado\",\n  \"guia_html\": \"<h3 style='margin: 0 0 8px; color: #24445C;'>Как работает ваш PIH Doctorado</h3><p><b>0. Начните</b> с «Configurar mi tesis» (Настроить мою диссертацию): вставьте аннотацию диссертации и свои бесплатные ключи, и система настроится сама.</p><p><b>1. PANEL</b> — это сводка: цифры и графики. Вы только смотрите на неё.</p><p><b>2. RADAR</b> — ваш рабочий план, упорядоченный по релевантности (самое важное вверху). Цвета показывают релевантность, надёжность ИИ и статус.</p><ul style='margin-top: 0;'><li>Меняйте <b>ESTADO</b> (статус) в выпадающем списке: <b>Pendiente</b> (ожидает, не просмотрено), <b>Para leer</b> (к прочтению, интересно), <b>Leído</b> (прочитано) или <b>Descartado</b> (отклонено).</li><li>Можно исправить <b>RELEVANCIA</b> (релевантность, от 0 до 5) и <b>TEMÁTICA</b> (тема). Они сохраняются сами.</li></ul><p><b>3. Zotero или Mendeley:</b> публикации со статусом «Para leer» или «Leído» сами отправляются в вашу библиотеку (коллекция «PIH Doctorado»). В первый раз: Настройки &gt; Zotero: подключить (Mendeley технически сложнее).</p><p><b>4. Автоматически:</b> в <i>Настройки &gt; Включить ВСЮ автоматизацию</i> всё включается сразу. Если достигнут бесплатный лимит, система останавливается и позже продолжает сама. Всё бесплатно.</p><p><b>5. Остальные вкладки:</b> MAPA HUECOS (карта пробелов: в каких частях диссертации мало литературы), AUTORES CLAVE (ключевые авторы), FUENTES PRIMARIAS (первичные источники) и CONGRESOS (конференции) вы заполняете, а система предупреждает по почте. PUBLICACIONES — база данных, а LOG — история (если что-то не сработало, причина там).</p>\",\n  \"tut_label_inicio\": \"РУКОВОДСТВО · ПЕРВЫЕ ШАГИ\",\n  \"tut_label_listo\": \"РУКОВОДСТВО · СЛЕДУЮЩИЕ ШАГИ\",\n  \"tut_prev\": \"Назад\",\n  \"tut_next\": \"Далее\",\n  \"tut_start\": \"Начать\",\n  \"tut_of\": \"из\",\n  \"tut_menu_error\": \"Используйте верхнее меню: PIH Doctorado > Настроить мою диссертацию.\",\n  \"tut_toast\": \"Откройте PIH Doctorado > Пошаговое руководство, чтобы увидеть первые шаги.\",\n  \"tut_toast_titulo\": \"Добро пожаловать\",\n  \"tut_idioma\": \"Язык\",\n  \"tut_dialogo\": \"PIH Doctorado\",\n  \"tut_inicio\": [\n    {\n      \"titulo\": \"Добро пожаловать в ваш PIH Doctorado\",\n      \"texto\": \"Это система, которая каждый день ищет новые публикации для вашей диссертации, оценивает их с помощью ИИ по шкале от 0 до 5 и оставляет упорядоченными в этой таблице. Она работает на бесплатных аккаунтах, а ваши данные остаются в вашем аккаунте Google.\",\n      \"pista\": \"Это руководство займёт около 3 минут. Вы можете открыть его снова из меню.\"\n    },\n    {\n      \"titulo\": \"Как это работает\",\n      \"texto\": \"1. Вы описываете свою диссертацию.\\n2. Система ищет литературу в OpenAlex, открытой базе научных работ.\\n3. ИИ читает каждую аннотацию и оценивает её относительно вашей диссертации.\\n4. Вы решаете, что читать, и отправляете это в свой менеджер библиографии.\",\n      \"pista\": \"Последнее слово всегда за вами: любую оценку можно исправить.\"\n    },\n    {\n      \"titulo\": \"Что появится в вашей таблице\",\n      \"texto\": \"При настройке диссертации появятся вкладки:\\n\\nPERFIL (профиль): ваша диссертация и созданные поисковые запросы.\\nRADAR: список публикаций по релевантности. Здесь вы работаете.\\nPANEL (панель): сводка с цифрами и графиками.\\nPUBLICACIONES (публикации): вся база.\\nLOG: история; если что-то не сработало, причина здесь.\\nА также пустые для заполнения: AUTORES CLAVE (ключевые авторы), CONGRESOS (конференции) и FUENTES PRIMARIAS (первичные источники).\",\n      \"pista\": \"До настройки ничего трогать не нужно.\"\n    },\n    {\n      \"titulo\": \"Что нужно перед началом\",\n      \"texto\": \"Два бесплатных ключа, без карты:\\n• Gemini (ИИ): aistudio.google.com > «Get API key».\\n• OpenAlex (литература): создайте аккаунт на openalex.org и скопируйте ключ из профиля.\\n\\nИ аннотацию диссертации: не менее 4–5 предложений.\",\n      \"pista\": \"Получите их сейчас на другой вкладке браузера и вернитесь сюда.\"\n    },\n    {\n      \"titulo\": \"Разрешения Google\",\n      \"texto\": \"В первый раз Google запросит разрешения и покажет «непроверенное приложение». Для личных скриптов это нормально.\\n\\nНажмите «Дополнительные настройки», затем «Перейти на… (небезопасно)». Код ваш, и его можно прочитать в Расширения > Apps Script.\",\n      \"pista\": \"Система затрагивает только этот документ.\"\n    },\n    {\n      \"titulo\": \"Первый шаг: настройте диссертацию\",\n      \"texto\": \"Нажмите кнопку ниже или используйте верхнее меню:\\n\\nPIH Doctorado  >  🎓 Настроить мою диссертацию\\n\\nВставьте аннотацию, ключевые слова и оба ключа. Система создаст ваш профиль и подскажет, что делать дальше.\",\n      \"pista\": \"Если кнопка не реагирует, используйте меню. Если меню не появилось, обновите страницу.\",\n      \"accion\": {\n        \"etiqueta\": \"Открыть «Настроить мою диссертацию»\",\n        \"funcion\": \"menuConfigurarTesisPIH\"\n      }\n    }\n  ],\n  \"tut_listo\": [\n    {\n      \"titulo\": \"Ваш профиль готов\",\n      \"texto\": \"Система создала вкладку PERFIL с запросами, понятиями и блоками вашей диссертации. Жёлтые ячейки можно редактировать: один запрос в строке.\",\n      \"pista\": \"Проверьте, подходят ли запросы вашей теме.\"\n    },\n    {\n      \"titulo\": \"Для чего каждая вкладка\",\n      \"texto\": \"RADAR: ваш рабочий план. Самое релевантное вверху; вы меняете ESTADO (статус) и исправляете оценки.\\nPANEL: цифры и графики в целом.\\nPUBLICACIONES: вся база (редактировать не нужно).\\nMAPA HUECOS: в каких частях диссертации мало литературы.\\nAUTORES CLAVE: авторы, за которыми вы хотите следить.\\nCONGRESOS: сроки и статус ваших заявок.\\nFUENTES PRIMARIAS: документы по вашим случаям (отчёты, нормативы).\\nBUSQUEDA: результаты поиска. LOG: история.\",\n      \"pista\": \"Цвета в RADAR показывают релевантность, надёжность ИИ и статус.\"\n    },\n    {\n      \"titulo\": \"Шаг 1 · Искать новинки\",\n      \"texto\": \"Меню PIH Doctorado > 🔎 Искать новинки сейчас.\\n\\nЧерез минуту-две на вкладке PUBLICACIONES появятся новые публикации.\",\n      \"pista\": \"Если ничего не появилось, посмотрите вкладку LOG: там причина.\"\n    },\n    {\n      \"titulo\": \"Шаг 2 · Классификация с помощью ИИ\",\n      \"texto\": \"Меню PIH Doctorado > 🤖 Классифицировать ожидающие с помощью ИИ.\\n\\nИИ читает каждую аннотацию и ставит релевантность от 0 до 5 с пояснением. Это может занять несколько минут.\",\n      \"pista\": \"Если Google сообщает о «высоком спросе» (ошибка 503), это временно: система сама повторит попытку.\"\n    },\n    {\n      \"titulo\": \"Шаг 3 · Ваш рабочий план\",\n      \"texto\": \"На вкладке RADAR вверху вы увидите самое релевантное. Цвета показывают релевантность (тёмно-зелёный = 5) и статус.\\n\\nМеняйте ESTADO в выпадающем списке: Pendiente (ожидает), Para leer (к прочтению), Leído (прочитано) или Descartado (отклонено). Если вы не согласны с оценкой, исправьте её.\",\n      \"pista\": \"Ваши исправления сохраняются сами.\"\n    },\n    {\n      \"titulo\": \"Шаг 4 · Ищите и исследуйте\",\n      \"texto\": \"🔍 Искать по всей базе: находит слова в заголовках, аннотациях и абстрактах.\\n\\n🗺 Карта пробелов: показывает, в каких частях диссертации мало литературы.\\n\\nКлючевые авторы, Конференции и Первичные источники: вкладки, которые вы заполняете своими материалами.\",\n      \"pista\": \"Начните с поиска: в первый день он полезнее всего.\"\n    },\n    {\n      \"titulo\": \"Шаг 5 · Ваш менеджер библиографии\",\n      \"texto\": \"То, что вы отметите «Para leer» (к прочтению) или «Leído» (прочитано), может само попасть в вашу библиотеку.\\n\\nZotero: PIH Doctorado > Настройки > Zotero: подключить (нужен бесплатный ключ).\\nEndNote или другие: 📤 Экспортировать файл RIS.\",\n      \"pista\": \"Mendeley — вариант для опытных.\"\n    },\n    {\n      \"titulo\": \"Шаг 6 · Автоматизация\",\n      \"texto\": \"Когда вас всё устроит:\\n\\nPIH Doctorado > ⚙ Настройки > ▶ Включить ВСЮ автоматизацию.\\n\\nС этого момента система ищет, классифицирует и присылает вам еженедельную сводку по почте. Исторический радар (предыдущая литература) включается отдельно, в Настройках.\",\n      \"pista\": \"Если что-то не сработает, вкладка LOG объяснит причину. Меню «Пошаговое руководство» снова откроет это руководство.\"\n    }\n  ],\n  \"w_titulo\": \"Настроить мою диссертацию\",\n  \"w_idioma\": \"Язык интерфейса\",\n  \"w_intro\": \"Заполните то, что знаете. Чем конкретнее аннотация, тем лучше всё будет работать. Всё сохраняется только в вашем документе.\",\n  \"w_tema\": \"Название или тема\",\n  \"w_disciplina\": \"Дисциплина\",\n  \"w_disciplina_ej\": \"(например, социология, морская биология…)\",\n  \"w_resumen\": \"Аннотация диссертации\",\n  \"w_resumen_ej\": \"(вставьте её из вашего проекта)\",\n  \"w_claves\": \"Ключевые слова\",\n  \"w_claves_ej\": \"(через запятую)\",\n  \"w_casos\": \"Конкретные случаи, которые вы изучаете\",\n  \"w_opcional\": \"(необязательно)\",\n  \"w_casos_ph\": \"Например: вид, учреждение, регион, программа, компания…\",\n  \"w_casos_ayuda\": \"Если ваша диссертация сравнивает или анализирует конкретные объекты, укажите их здесь (через запятую). Если она чисто теоретическая, оставьте пустым.\",\n  \"w_idioma_local\": \"Местный язык поиска\",\n  \"w_idioma_local_ej\": \"(помимо английского)\",\n  \"w_idioma_local_valor\": \"русский\",\n  \"w_gestor\": \"Менеджер библиографии\",\n  \"w_gestor_ninguno\": \"Никакой\",\n  \"w_gemini\": \"Ключ Gemini\",\n  \"w_gemini_ej\": \"(бесплатно, на aistudio.google.com)\",\n  \"w_openalex\": \"Ключ OpenAlex\",\n  \"w_openalex_ej\": \"(бесплатно, на openalex.org)\",\n  \"w_guardar\": \"Сохранить и создать мой профиль\",\n  \"w_generando\": \"Создаю ваш профиль с помощью ИИ… это может занять минуту.\",\n  \"w_siguientes\": \"Посмотреть следующие шаги\",\n  \"w_error_corto\": \"Напишите аннотацию не менее чем из 3–4 предложений или несколько ключевых слов.\",\n  \"w_error_gemini\": \"Не хватает ключа Gemini. Он бесплатный: aistudio.google.com.\",\n  \"w_listo\": \"Готово. Просмотрите вкладку PERFIL (можно исправить всё, что хотите), затем нажмите «Включить ВСЮ автоматизацию».\",\n  \"w_error_ia\": \"ИИ не вернул «{0}». Нажмите «Сохранить» ещё раз (иногда с первого раза не получается).\",\n  \"w_error_contexto\": \"ИИ не вернул контекст. Попробуйте ещё раз.\",\n  \"pf_cabecera\": [\n    \"КЛЮЧ\",\n    \"ОПИСАНИЕ\",\n    \"ЗНАЧЕНИЕ\"\n  ],\n  \"pf_nota\": \"Жёлтые ячейки можно редактировать. В списках пишите по одному элементу в строке (Ctrl+Enter для новой строки).\",\n  \"pf_titulo\": \"Название или тема диссертации\",\n  \"pf_disciplina\": \"Дисциплина\",\n  \"pf_resumen\": \"Аннотация диссертации\",\n  \"pf_palabras_clave\": \"Ключевые слова\",\n  \"pf_casos\": \"Конкретные случаи, которые вы изучаете (необязательно)\",\n  \"pf_idioma_local\": \"Местный язык поиска\",\n  \"pf_gestor_referencias\": \"Менеджер библиографии\",\n  \"pf_contexto_tesis\": \"Контекст, передаваемый ИИ при классификации\",\n  \"pf_rasgos_casos\": \"Признаки каждого случая или учреждения (по одному в строке)\",\n  \"pf_consultas_radar\": \"Запросы ежедневного радара (по одному в строке)\",\n  \"pf_consultas_historico\": \"Запросы исторического радара (по одному в строке)\",\n  \"pf_terminos_filtro\": \"Термины для фильтрации открытых источников (по одному в строке)\",\n  \"pf_bloques_mapa\": \"Блоки карты пробелов (название | ключевые слова | поиск)\",\n  \"st_pendiente\": \"Pendiente (ожидает)\",\n  \"st_paraleer\": \"Para leer (к прочтению)\",\n  \"st_leido\": \"Leído (прочитано)\",\n  \"st_descartado\": \"Descartado (отклонено)\",\n  \"bq_panel\": \"Искать по всей базе\",\n  \"bq_intro\": \"Ищет по <b>всей</b> базе, а не только в RADAR.\",\n  \"bq_palabras\": \"Слова\",\n  \"bq_ph\": \"управление \\\"принятие решений\\\" -туризм\",\n  \"bq_ayuda\": \"Точная фраза в кавычках. С - в начале слово исключается.\",\n  \"bq_debe\": \"Должно содержать\",\n  \"bq_todas\": \"Все слова\",\n  \"bq_alguna\": \"Хотя бы одно из слов\",\n  \"bq_buscar_en\": \"Искать в\",\n  \"bq_todo\": \"Всё (включая исходный абстракт)\",\n  \"bq_rapido\": \"Заголовок, аннотация, тема и авторы\",\n  \"bq_minima\": \"Минимальная релевантность\",\n  \"bq_cualquiera\": \"Любая\",\n  \"bq_n_o_mas\": \"{0} или больше\",\n  \"bq_solo5\": \"Только 5\",\n  \"bq_estado\": \"Статус\",\n  \"bq_boton\": \"Искать\",\n  \"bq_buscando\": \"Ищу…\",\n  \"bq_err_vacio\": \"Введите хотя бы одно слово (минимум 2 буквы).\",\n  \"bq_err_sin_pub\": \"Пока нет публикаций, по которым можно искать.\",\n  \"bq_sin_resultados\": \"Нет результатов. Попробуйте меньше слов или «Хотя бы одно из слов».\",\n  \"bq_resultados\": \"Результатов: {0}\",\n  \"bq_mostrados\": \" (показаны {0} лучших)\",\n  \"bq_mira\": \". Смотрите вкладку BUSQUEDA.\",\n  \"bq_h_busqueda\": \"Поиск: {0}\",\n  \"bq_h_resultados\": \"Результатов: {0}. Нажмите на заголовок, чтобы открыть публикацию.\",\n  \"bq_cab\": [\n    \"ПУБЛИКАЦИЯ\",\n    \"СОВПАДЕНИЕ В\",\n    \"РЕЛЕВАНТНОСТЬ\",\n    \"СТАТУС\",\n    \"ГОД\",\n    \"АВТОРЫ\",\n    \"АННОТАЦИЯ\"\n  ],\n  \"bq_
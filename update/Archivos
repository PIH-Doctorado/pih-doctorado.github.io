q_h_busqueda\": \"Søgning: {0}\",\n  \"bq_h_resultados\": \"{0} resultat(er). Klik på titlen for at åbne publikationen.\",\n  \"bq_cab\": [\n    \"PUBLIKATION\",\n    \"MATCH I\",\n    \"RELEVANS\",\n    \"STATUS\",\n    \"ÅR\",\n    \"FORFATTERE\",\n    \"RESUMÉ\"\n  ],\n  \"bq_f_TITULO\": \"titel\",\n  \"bq_f_TEMATICA_PRINCIPAL\": \"tema\",\n  \"bq_f_TEMATICAS_SECUNDARIAS\": \"temaer\",\n  \"bq_f_RESUMEN_IA\": \"AI-resumé\",\n  \"bq_f_JUSTIFICACION_RELEVANCIA\": \"begrundelse\",\n  \"bq_f_AUTORES\": \"forfattere\",\n  \"bq_f_REVISTA_EDITORIAL\": \"tidsskrift\",\n  \"bq_f_ABSTRACT_ORIGINAL\": \"abstract\",\n  \"zo_dialogo\": \"Forbind til Zotero\",\n  \"zo_intro\": \"Opret din nøgle på <b>zotero.org/settings/keys</b> (knappen «Create new private key»). Sæt flueben ved <b>Allow library access</b> og <b>Allow write access</b>, gem og kopiér nøglen hertil:\",\n  \"zo_conectar\": \"Forbind\",\n  \"zo_comprobando\": \"Kontrollerer…\",\n  \"zo_err_pegar\": \"Indsæt Zotero-nøglen.\",\n  \"zo_err_clave\": \"Zotero genkender ikke denne nøgle (HTTP {0}). Kopiér den igen.\",\n  \"zo_err_acceso\": \"Nøglen har ikke adgang til dit bibliotek. Opret en ny med flueben ved «Allow library access».\",\n  \"zo_err_escritura\": \"Nøglen tillader ikke skrivning. Opret en ny med flueben ved «Allow write access».\",\n  \"zo_conectado\": \"Forbundet til Zotero. Nu kan du bruge «Send nu til min referencehåndtering».\",\n  \"zo_desconectado\": \"Zotero afbrudt. Du kan slette nøglen på zotero.org.\",\n  \"zo_funciona\": \"Forbindelsen virker.\",\n  \"zo_no_conectado\": \"Zotero er ikke forbundet. Brug Indstillinger > Zotero: forbind.\",\n  \"zo_err_coleccion\": \"Zotero returnerede ikke den oprettede samling.\",\n  \"zo_ocupado\": \"En anden proces kører. Prøv igen om nogle minutter.\",\n  \"zo_no_hoja\": \"Fanen PUBLICACIONES findes ikke.\",\n  \"zo_nada\": \"Der er ingen publikationer at sende. Skift ESTADO i RADAR til Para leer (til læsning) eller Leído (læst).\",\n  \"zo_enviadas\": \"Sen
\": \"脚本属性中缺少 MENDELEY_CLIENT_ID 或 MENDELEY_CLIENT_SECRET。\",\n  \"me_falta_oauth\": \"项目中缺少 OAuth2 库（OAuth2 标识）。\",\n  \"me_ya\": \"Mendeley 已连接。\",\n  \"me_html\": \"<p>1. 点击链接，Mendeley 将在另一个标签页中打开。</p><p>2. 登录并批准权限。</p><p>3. 看到“Mendeley 已连接”后，关闭该标签页，并使用 <i>设置 &gt; Mendeley：测试连接</i>。</p>\",\n  \"me_enlace\": \"👉 连接 Mendeley\",\n  \"me_dialogo\": \"连接 Mendeley\",\n  \"me_desconectado\": \"已断开 Mendeley。\",\n  \"me_alert_no\": \"你尚未连接。请使用 设置 > Mendeley（高级）：连接。\",\n  \"me_ok\": \"✅ 与你的 Mendeley 文献库的连接正常。\",\n  \"me_api_codigo\": \"API 返回代码 {0}。\\n\\n{1}\",\n  \"me_no_conectado\": \"未连接 Mendeley。\",\n  \"me_no_conectado_aviso\": \"未连接 Mendeley。请使用 设置 > Mendeley（高级）：连接。\",\n  \"me_enviadas\": \"已发送到 Mendeley：{0}。待处理：{1}。\",\n  \"me_reconectar\": \" 需要通过菜单重新连接 Mendeley。\",\n  \"me_auto_on\": \"已启用自动发送到 Mendeley（每 6 小时）。\",\n  \"me_auto_off\": \"已停用自动发送到 Mendeley（{0}）。\"\n};\n}\n"}, {"name": "Idiomas", "type": "SERVER_JS", "source": "/**\n * PERSONAL INTELLIGENCE HUB · PLANTILLA PARA DOCTORANDOS\n * Idiomas.gs · Idioma de la interfaz (menús, asistente, tutorial, avisos)\n *\n * Qué hace:\n *   - Guarda el idioma elegido en las propiedades del DOCUMENTO.\n *   - Si nadie ha elegido, usa el idioma de tu cuenta de Google (si está\n *     disponible) y, si no, inglés.\n *   - Ofrece tPIH_(\"clave\") para obtener cualquier texto en tu idioma.\n *\n * Los nombres internos NO se traducen (pestañas RADAR, PERFIL, LOG…, columnas\n * y estados «Pendiente», «Para leer», «Leído», «Descartado»): el código los\n * usa para encontrar los datos. En los textos en otros idiomas aparecen tal\n * cual, con su traducción entre paréntesis.\n *\n * Para añadir un idioma: pega su archivo Idioma_xx.gs (función textosPIH_xx)\n * y aparecerá solo en la lista. Lo que falte se muestra en inglés.\n *\n * Coste: 0 €.\n */\n\nconst PIH_IDIOMA_PROPIEDAD = \"PIH_IDIOMA\";\n\n// [código, nombre en su propio idioma, nombre en inglés (para pedírselo a Gemini)]\n// Solo aparecen en las listas los idiomas cuyo texto está pegado en el proyecto\n// (Idiomas.gs trae es, en, ca, eu, gl, fr, it, pt, de; el resto va en archivos Idioma_xx.gs).\nconst PIH_IDIOMAS_TODOS = [\n  [\"es\", \"Español\", \"Spanish\"],\n  [\"en\", \"English\", \"English\"],\n  [\"ca\", \"Català\", \"Catalan\"],\n  [\"eu\", \"Euskara\", \"Basque\"],\n  [\"gl\", \"Galego\", \"Galician\"],\n  [\"fr\", \"Français\", \"French\"],\n  [\"it\", \"Italiano\", \"Italian\"],\n  [\"pt\", \"Português\", \"Portuguese\"],\n  [\"de\", \"Deutsch\", \"German\"],\n  [\"sv\", \"Svenska\", \"Swedish\"],\n  [\"da\", \"Dansk\", \"Danish\"],\n  [\"no\", \"Norsk\", \"Norwegian\"],\n  [\"fi\", \"Suomi\", \"Finnish\"],\n  [\"is\", \"Íslenska\", \"Icelandic\"],\n  [\"lt\", \"Lietuvių\", \"Lithuanian\"],\n  [\"lv\", \"Latviešu\", \"Latvian\"],\n  [\"et\", \"Eesti\", \"Estonian\"],\n  [\"cs\", \"Čeština\", \"Czech\"],\n  [\"pl\", \"Polski\", \"Polish\"],\n  [\"ru\", \"Русский\", \"Russian\"],\n  [\"uk\", \"Українська\", \"Ukrainian\"],\n  [\"sr\", \"Српски / Srpski\", \"Serbian\"],\n  [\"bs\", \"Bosanski\", \"Bosnian\"],\n  [\"hr\", \"Hrvatski\", \"Croatian\"],\n  [\"bg\", \"Български\", \"Bulgarian\"],\n  [\"sl\", \"Slovenščina\", \"Slovenian\"],\n  [\"sq\", \"Shqip\", \"Albanian\"],\n  [\"el\", \"Ελληνικά\", \"Greek\"],\n  [\"tr\", \"Türkçe\", \"Turkish\"],\n  [\"hu\", \"Magyar\", \"Hungarian\"],\n  [\"nl\", \"Nederlands\", \"Dutch\"],\n  [\"nlbe\", \"Vlaams (België)\", \"Flemish (Belgian Dutch)\"],\n  [\"zh\", \"中文\", \"Chinese (Simplified)\"],\n  [\"ja\", \"日本語\", \"Japanese\"],\n  [\"ko\", \"한국어\", \"Korean\"],\n  [\"th\", \"ไทย\", \"Thai\"],\n  [\"vi\", \"Tiếng Việt\", \"Vietnamese\"],\n  [\"id\", \"Bahasa Indonesia\", \"Indonesian\"],\n  [\"hi\", \"हिन्दी\", \"Hindi\"],\n  [\"mn\", \"Монгол\", \"Mongolian\"],\n  [\"ar\", \"العربية\", \"Arabic\"],\n  [\"fa\", \"فارسی\", \"Persian\"],\n  [\"ur\", \"اردو\", \"Urdu\"],\n  [\"ga\", \"Gaeilge\", \"Irish\"],\n  [\"sw\", \"Kiswahili\", \"Swahili\"],\n  [\"ha\", \"Hausa\", \"Hausa\"]\n];\n\nlet PIH_IDIOMA_CACHE = null;\n\n\n// =====================================================\n// IDIOMA ACTIVO\n// =====================================================\n\nfunction idiomaPIH_() {\n\n  if (PIH_IDIOMA_CACHE) return PIH_IDIOMA_CACHE;\n\n  const validos = idiomasDisponiblesPIH_().map(p => p[0]);\n\n  let codigo = \"\";\n\n  try {\n    codigo = PropertiesService.getDocumentProperties()\n      .getProperty(PIH_IDIOMA_PROPIEDAD) || \"\";\n  } catch (e) {\n    codigo = \"\";\n  }\n\n  if (validos.indexOf(codigo) < 0) {\n    codigo = \"\";\n    try {\n      const loc = String(Session.getActiveUserLocale() || \"\").toLowerCase();\n      codigo = loc.slice(0, 2);\n      if (loc.indexOf(\"nl-be\") === 0 || loc.indexOf(\"nl_be\") === 0) codigo = \"nlbe\";\n      if (codigo === \"nb\" || codigo === \"nn\") codigo = \"no\";\n    } catch (e) {\n      codigo = \"\";\n    }\n    if (validos.indexOf(codigo) < 0) codigo = \"en\";\n  }\n\n  PIH_IDIOMA_CACHE = codigo;\n  return codigo;\n}\n\n\n/**\n * Cambia el idioma (la llaman el menú y las ventanas). Devuelve el código.\n */\nfunction cambiarIdiomaPIH(codigo) {\n\n  const validos = idiomasDisponiblesPIH_().map(p => p[0]);\n\n  if (validos.indexOf(codigo) < 0) {\n    throw new Error(\"Idioma no disponible / Language not available.\");\n  }\n\n  PropertiesService.getDocumentProperties()\n    .setProperty(PIH_IDIOMA_PROPIEDAD, codigo);\n\n  PIH_IDIOMA_CACHE = codigo;\n\n  try {\n    construirMenuPIH_();\n  } catch (e) {\n    console.log(\"Menú: \" + e.message);\n  }\n\n  try {\n    crearGuiaHojasPIH(true);\n  } catch (e) {\n    console.log(\"Guía de pestañas: \" + e.message);\n  }\n\n  return codigo;\n}\n\n\n// Nombre del idioma de la interfaz tal y como se le pide a Gemini que escriba\n// (resúmenes, justificaciones y contexto de la tesis).\nfunction nombreIdiomaIAPIH_() {\n  const c = idiomaPIH_();\n  const f = PIH_IDIOMAS_TODOS.filter(p => p[0] === c)[0];\n  return f ? f[2] : \"English\";\n}\n\n// Texto de un idioma: está en PIH_TEXTOS o en un archivo Idioma_xx.gs\n// (función textosPIH_xx).\nfunction textosIdiomaPIH_(c) {\n  if (PIH_TEXTOS[c]) return PIH_TEXTOS[c];\n  try {\n    const f = globalThis[\"textosPIH_\" + c];\n    if (typeof f === \"function\") {\n      PIH_TEXTOS[c] = f();\n      return PIH_TEXTOS[c];\n    }\n  } catch (e) {}\n  return null;\n}\n\n// Idiomas realmente disponibles en este proyecto.\nfunction idiomasDisponiblesPIH_() {\n  return PIH_IDIOMAS_TODOS.filter(p => textosIdiomaPIH_(p[0]) !== null);\n}\n\n\n// Idiomas que se escriben de derecha a izquierda.\nconst PIH_IDIOMAS_RTL = [\"ar\", \"fa\", \"ur\"];\n\n// Envuelve el HTML de una ventana con la dirección de escritura del idioma.\nfunction envolverPIH_(html) {\n  const c = idiomaPIH_();\n  const dir = PIH_IDIOMAS_RTL.indexOf(c) > -1 ? \"rtl\" : \"ltr\";\n  return '<div dir=\"' + dir + '\" lang=\"' + c + '\">' + html + \"</div>\";\n}\n\n// Entrada única del menú «Idioma»: abre una ventana con lista desplegable.\nfunction menuElegirIdiomaPIH() {\n  const actual = idiomaPIH_();\n  const opciones = idiomasDisponiblesPIH_().map(p =>\n    '<option value=\"' + p[0] + '\"' + (p[0] === actual ? \" selected\" : \"\") + \">\" + p[1] + \"</option>\"\n  ).join(\"\");\n  const html =\n    '<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #202124; padding: 6px;\">' +\n    '<p><b>Idioma / Language</b></p>' +\n    '<select id=\"sel\" style=\"font-size:14px; padding:6px; width:100%;\">' + opciones + '</select>' +\n    '<p style=\"margin-top:16px;\"><button onclick=\"ir()\" style=\"font-size:14px; padding:6px 16px;\">OK</button></p>' +\n    '<script>function ir(){var c=document.getElementById(\"sel\").value;' +\n    'google.script.run.withSuccessHandler(function(){google.script.host.close();}).cambiarIdiomaPIH(c);}</script>' +\n    '</div>';\n  SpreadsheetApp.getUi().showModalDialog(\n    HtmlService.createHtmlOutput(html).setWidth(340).setHeight(190),\n    \"🌐 Idioma / Language\"\n  );\n}\n\n\n// =====================================================\n// TEXTOS\n// =====================================================\n\n/**\n * Devuelve el texto «clave» en el idioma activo. Los marcadores {0}, {1}…\n * se sustituyen por los argumentos siguientes. Si falta la clave, usa inglés,\n * después español y, por último, la propia clave.\n */\nfunction tPIH_(clave) {\n\n  const args = Array.prototype.slice.call(arguments, 1);\n  const idioma = idiomaPIH_();\n\n  let valor;\n\n  const tabla = textosIdiomaPIH_(idioma);\n\n  if (tabla && tabla[clave] !== undefined) {\n    valor = tabla[clave];\n  } else if (PIH_TEXTOS.en[clave] !== undefined) {\n    valor = PIH_TEXTOS.en[clave];\n  } else if (PIH_TEXTOS.es[clave] !== undefined) {\n    valor = PIH_TEXTOS.es[clave];\n  } else {\n    return clave;\n  }\n\n  if (typeof valor !== \"string\") return valor;\n\n  return valor.replace(/\\{(\\d+)\\}/g, (m, i) =>\n    args[Number(i)] !== undefined ? String(args[Number(i)]) : \"\"\n  );\n}\n\n\nconst PIH_TEXTOS = {\n\n  // ===================================================\n  // ESPAÑOL\n  // ===================================================\n  es: {\n\n    // ---- Menú ----\n    m_configurar: \"🎓 Configurar mi tesis (empieza aquí)\",\n    m_actualizar: \"📊 Actualizar panel y RADAR\",\n    m_buscar_base: \"🔍 Buscar en toda la base\",\n    m_novedades: \"🔎 Buscar novedades ahora\",\n    m_clasificar: \"🤖 Clasificar pendientes con IA\",\n    m_gestor: \"📚 Enviar a mi gestor de referencias ahora\",\n    m_ris: \"📤 Exportar archivo RIS (EndNote y otros)\",\n    m_ris_enviar: \"Enviarme el archivo por correo\",\n    m_ris_marcar: \"Marcar como importado\",\n    m_mapa: \"🗺 Mapa de huecos de la tesis\",\n    m_revisar: \"🔄 Revisar ahora\",\n    m_autores: \"Autores clave\",\n    m_fuentes: \"Fuentes primarias\",\n    m_abiertas: \"Fuentes abiertas (opcional)\",\n    m_congresos: \"Plazos de congresos\",\n    m_resumen: \"Resumen semanal por correo\",\n    m_hist_continuar: \"Radar histórico: continuar\",\n    m_hist_estado: \"Radar histórico: ver estado\",\n    m_ajustes: \"⚙ Ajustes\",\n    m_activar_todo: \"▶ Activar TODA la automatización\",\n    m_desactivar_todo: \"⏹ Desactivar TODA la automatización\",\n    m_hist_activar: \"Radar histórico automático: activar\",\n    m_hist_desactivar: \"Radar histórico automático: desactivar\",\n    m_ab_activar: \"Fuentes abiertas (opcional): activar\",\n    m_ab_desactivar: \"Fuentes abiertas: desactivar\",\n    m_ab_probar: \"Fuentes abiertas: probar conexión\",\n    m_zo_conectar: \"Zotero: conectar (solo la primera vez)\",\n    m_zo_probar: \"Zotero: probar la conexión\",\n    m_zo_desconectar: \"Zotero: desconectar\",\n    m_me_conectar: \"Mendeley (avanzado): conectar\",\n    m_me_probar: \"Mendeley: probar la conexión\",\n    m_me_desconectar: \"Mendeley: desconectar\",\n    m_repuntuar: \"Repuntuar pendientes con el criterio nuevo\",\n    m_diagnostico: \"Diagnóstico del sistema\",\n    m_idioma: \"🌐 Idioma / Language\",\n    m_guia: \"📖 Guía paso a paso\",\n    m_guia_inicio: \"Primeros pasos\",\n    m_guia_listo: \"Después de configurar la tesis\",\n    m_guia_rapida: \"❓ Guía rápida\",\n\n    // ---- Avisos del menú ----\n    a_buscando: \"Buscando novedades en OpenAlex…\",\n    a_nuevos: \"{0} publicación(es) nueva(s).\",\n    a_nuevos_clasificar: \" Usa «Clasificar pendientes con IA» para analizarlas.\",\n    a_limite_openalex: \" Se ha alcanzado el límite gratuito de OpenAlex: inténtalo más tarde.\",\n    a_clasificando: \"Clasificando con IA (puede tardar unos minutos)…\",\n    a_fuentes: \"Revisando las páginas de fuentes…\",\n    a_autores: \"Vigilando autores clave…\",\n    a_mapa: \"Calculando el mapa de huecos…\",\n    a_error_titulo: \"No se ha podido completar la acción\",\n    a_error_pie: \"\\n\\nSi el problema continúa, revisa la pestaña LOG.\",\n\n    // ---- Activar / desactivar ----\n    act_titulo: \"Activar toda la automatización\",\n    act_texto:\n      \"Se activarán:\\n\" +\n      \"• Radar diario + clasificación con IA (cada día y cada hora)\\n\" +\n      \"• Envío a tu gestor de referencias, el que elegiste (cada 6 horas)\\n\" +\n      \"• Resumen semanal por correo (lunes)\\n\" +\n      \"• Aviso de plazos de congresos (lunes)\\n\" +\n      \"• Vigilancia de fuentes primarias (domingo)\\n\" +\n      \"• Vigilancia de autores clave (domingo)\\n\" +\n      \"\\nEl radar histórico y las fuentes abiertas (repositorios de tesis) se activan aparte (Ajustes).\\n\\n¿Continuar?\",\n    act_ok: \"Automatización activada\",\n    des_titulo: \"Desactivar toda la automatización\",\n    des_texto:\n      \"Se detendrán todas las tareas automáticas (incluido el radar \" +\n      \"histórico). La edición de RADAR seguirá sincronizándose.\\n\\n¿Continuar?\",\n    des_ok: \"Automatización desactivada\",\n    p_radar: \"Radar diario y clasificación\",\n    p_gestor: \"Envío a tu gestor de referencias\",\n    p_resumen: \"Resumen semanal\",\n    p_congresos: \"Plazos de congresos\",\n    p_fuentes: \"Fuentes primarias\",\n    p_autores: \"Autores clave\",\n    p_abiertas: \"Fuentes abiertas\",\n    p_historico: \"Radar histórico\",\n\n    // ---- Guía rápida ----\n    guia_titulo: \"Guía rápida · PIH Doctorado\",\n    guia_html:\n      '<h3 style=\"margin: 0 0 8px; color: #24445C;\">Cómo funciona tu PIH Doctorado</h3>' +\n      '<p><b>0. Empieza</b> en «Configurar mi tesis»: pega el resumen de tu tesis y tus claves gratuitas, y el sistema se configura solo.</p>' +\n      '<p><b>1. PANEL</b> es el resumen: números y gráficos. Solo se mira.</p>' +\n      '<p><b>2. RADAR</b> es tu mesa de trabajo, ordenada por relevancia (lo más importante, arriba). Los colores indican relevancia, confianza de la IA y estado.</p>' +\n      '<ul style=\"margin-top: 0;\">' +\n      '<li>Cambia el <b>ESTADO</b> con el desplegable: <b>Pendiente</b> (sin revisar), <b>Para leer</b> (te interesa), <b>Leído</b> o <b>Descartado</b>.</li>' +\n      '<li>Puedes corregir la <b>RELEVANCIA</b> (0 a 5) y la <b>TEMÁTICA</b>. Se guardan solas.</li></ul>' +\n      '<p><b>3. Zotero o Mendeley:</b> las publicaciones en «Para leer» o «Leído» se envían solas a tu biblioteca (colección «PIH Doctorado»). Primera vez: Ajustes &gt; Zotero: conectar (Mendeley es más técnico).</p>' +\n      '<p><b>4. Automático:</b> en <i>Ajustes &gt; Activar TODA la automatización</i> se activa todo de una vez. Si se alcanza un límite gratuito, se detiene y sigue sola más tarde. Todo es gratuito.</p>' +\n      '<p><b>5. Otras pestañas:</b> MAPA HUECOS (qué partes de la tesis tienen poca bibliografía), AUTORES CLAVE, FUENTES PRIMARIAS y CONGRESOS se rellenan y avisan por correo. PUBLICACIONES es la base de datos y LOG el historial (si algo falla, aquí está el motivo).</p>',\n\n    // ---- Tutorial ----\n    tut_label_inicio: \"GUÍA · PRIMEROS PASOS\",\n    tut_label_listo: \"GUÍA · SIGUIENTES PASOS\",\n    tut_prev: \"Anterior\",\n    tut_next: \"Siguiente\",\n    tut_start: \"Empezar\",\n    tut_of: \"de\",\n    tut_menu_error: \"Usa el menú superior: PIH Doctorado > Configurar mi tesis.\",\n    tut_toast: \"Abre PIH Doctorado > Guía paso a paso para ver los primeros pasos.\",\n    tut_toast_titulo: \"Bienvenida\",\n    tut_idioma: \"Idioma\",\n    tut_dialogo: \"PIH Doctorado\",\n\n    tut_inicio: [\n      {\n        titulo: \"Bienvenida a tu PIH Doctorado\",\n        texto: \"Es un sistema que busca cada día publicaciones nuevas sobre tu tesis, \" +\n          \"las puntúa de 0 a 5 con IA y las deja ordenadas en esta hoja. Funciona con \" +\n          \"cuentas gratuitas y tus datos se quedan en tu cuenta de Google.\",\n        pista: \"Esta guía dura unos 3 minutos. Puedes volver a abrirla desde el menú.\"\n      },\n      {\n        titulo: \"Cómo funciona\",\n        texto: \"1. Tú describes tu tesis.\\n2. El sistema busca bibliografía en OpenAlex, \" +\n          \"una base abierta de obras científicas.\\n3. La IA lee cada resumen y le pone una \" +\n          \"nota según tu tesis.\\n4. Tú decides qué leer y lo envías a tu gestor de referencias.\",\n        pista: \"Tú siempre tienes la última palabra: puedes corregir cualquier nota.\"\n      },\n      {\n        titulo: \"Qué se creará en tu hoja\",\n        texto: \"Al configurar tu tesis aparecerán estas pestañas:\\n\\n\" +\n          \"PERFIL: tu tesis y las búsquedas generadas.\\n\" +\n          \"RADAR: la lista de publicaciones, ordenada por relevancia. Aquí trabajas.\\n\" +\n          \"PANEL: resumen con números y gráficos.\\n\" +\n          \"PUBLICACIONES: la base de datos completa.\\n\" +\n          \"LOG: el historial; si algo falla, el motivo está aquí.\\n\" +\n          \"Y vacías, para que las rellenes: AUTORES CLAVE, CONGRESOS y FUENTES PRIMARIAS.\",\n        pista: \"No hace falta tocar nada antes de configurar.\"\n      },\n      {\n        titulo: \"Lo que necesitas antes de empezar\",\n        texto: \"Dos claves gratuitas, sin tarjeta:\\n\" +\n          \"• Gemini (la IA): aistudio.google.com > «Get API key».\\n\" +\n          \"• OpenAlex (la bibliografía): crea una cuenta en openalex.org y copia la clave de tu perfil.\\n\\n\" +\n          \"Y el resumen de tu tesis: unas 4 o 5 frases como mínimo.\",\n        pista: \"Consíguelas ahora en otra pestaña del navegador y vuelve.\"\n      },\n      {\n        titulo: \"Los permisos de Google\",\n        texto: \"La primera vez, Google te pedirá permisos y mostrará «aplicación no verificada». \" +\n          \"Es normal en scripts personales.\\n\\nPulsa «Configuración avanzada» y luego \" +\n          \"«Ir a… (no seguro)». El código es tuyo y lo puedes leer en Extensiones > Apps Script.\",\n        pista: \"El sistema solo toca este documento.\"\n      },\n      {\n        titulo: \"Primer paso: configurar tu tesis\",\n        texto: \"Pulsa el botón de abajo, o bien el menú superior:\\n\\n\" +\n          \"PIH Doctorado  >  🎓 Configurar mi tesis\\n\\n\" +\n          \"Pega tu resumen, tus palabras clave y las dos claves. El sistema generará tu perfil \" +\n          \"y te indicará qué hacer a continuación.\",\n        pista: \"Si el botón no responde, usa el menú. Si el menú no aparece, recarga la página.\",\n        accion: { etiqueta: \"Abrir «Configurar mi tesis»\", funcion: \"menuConfigurarTesisPIH\" }\n      }\n    ],\n\n    tut_listo: [\n      {\n        titulo: \"Tu perfil está listo\",\n        texto: \"El sistema ha creado la pestaña PERFIL con las búsquedas, los términos y los \" +\n          \"bloques de tu tesis. Las celdas amarillas se pueden editar: una consulta por línea.\",\n        pista: \"Revisa que las consultas tengan sentido para tu tema.\"\n      },\n      {\n        titulo: \"Qué es cada pestaña\",\n        texto: \"RADAR: tu mesa de trabajo. Lo más relevante arriba; cambias el ESTADO y corriges notas.\\n\" +\n          \"PANEL: números y gráficos del conjunto.\\n\" +\n          \"PUBLICACIONES: la base completa (no hace falta editarla).\\n\" +\n          \"MAPA HUECOS: qué partes de tu tesis tienen poca bibliografía.\\n\" +\n          \"AUTORES CLAVE: autores que quieres vigilar.\\n\" +\n          \"CONGRESOS: plazos y estado de tus propuestas.\\n\" +\n          \"FUENTES PRIMARIAS: documentos de tus casos (memorias, normativa).\\n\" +\n          \"BUSQUEDA: resultados del buscador. LOG: el historial.\",\n        pista: \"Los colores de RADAR indican relevancia, confianza de la IA y estado.\"\n      },\n      {\n        titulo: \"Paso 1 · Buscar novedades\",\n        texto: \"Menú PIH Doctorado > 🔎 Buscar novedades ahora.\\n\\nEn uno o dos minutos \" +\n          \"aparecerán publicaciones nuevas en la pestaña PUBLICACIONES.\",\n        pista: \"Si no sale nada, mira la pestaña LOG: ahí está el motivo.\"\n      },\n      {\n        titulo: \"Paso 2 · Clasificación con IA\",\n        texto: \"Menú PIH Doctorado > 🤖 Clasificar pendientes con IA.\\n\\nLa IA lee cada resumen \" +\n          \"y le asigna una relevancia de 0 a 5 con una explicación. Puede tardar unos minutos.\",\n        pista: \"Si Google dice «alta demanda» (error 503), es temporal: se reintenta solo.\"\n      },\n      {\n        titulo: \"Paso 3 · Tu mesa de trabajo\",\n        texto: \"En la pestaña RADAR verás lo más relevante arriba. Los colores indican la relevancia \" +\n          \"(verde oscuro = 5) y el estado.\\n\\nCambia el ESTADO con el desplegable: Pendiente, \" +\n          \"Para leer, Leído o Descartado. Si no estás de acuerdo con una nota, corrígela.\",\n        pista: \"Tus correcciones se guardan solas.\"\n      },\n      {\n        titulo: \"Paso 4 · Buscar y explorar\",\n        texto: \"🔍 Buscar en toda la base: encuentra palabras en títulos, resúmenes y abstracts.\\n\\n\" +\n          \"🗺 Mapa de huecos: te dice qué partes de tu tesis tienen poca bibliografía.\\n\\n\" +\n          \"Autores clave, Congresos y Fuentes primarias: pestañas para rellenar con lo tuyo.\",\n        pista: \"Empieza por el buscador: es lo más útil el primer día.\"\n      },\n      {\n        titulo: \"Paso 5 · Tu gestor de referencias\",\n        texto: \"Lo que marques como «Para leer» o «Leído» puede viajar solo a tu biblioteca.\\n\\n\" +\n          \"Zotero: PIH Doctorado > Ajustes > Zotero: conectar (necesitas una clave gratuita).\\n\" +\n          \"EndNote u otros: 📤 Exportar archivo RIS.\",\n        pista: \"Mendeley es una opción avanzada.\"\n      },\n      {\n        titulo: \"Paso 6 · Automatización\",\n        texto: \"Cuando todo te convenza:\\n\\nPIH Doctorado > ⚙ Ajustes > ▶ Activar TODA la automatización.\\n\\n\" +\n          \"Desde ahí el sistema busca, clasifica y te manda un resumen semanal por correo. \" +\n          \"El radar histórico (bibliografía anterior) se activa aparte, en Ajustes.\",\n        pista: \"Si algo falla, la pestaña LOG lo explica. El menú «Guía paso a paso» vuelve a abrir esto.\"\n      }\n    ],\n\n    // ---- Asistente «Configurar mi tesis» ----\n    w_titulo: \"Configurar mi tesis\",\n    w_idioma: \"Idioma de la interfaz\",\n    w_intro: \"Rellena lo que sepas. Cuanto más concreto sea el resumen, mejor funcionará. Todo se guarda solo en tu documento.\",\n    w_tema: \"Título o tema\",\n    w_disciplina: \"Disciplina\",\n    w_disciplina_ej: \"(ej. sociología, biología marina…)\",\n    w_resumen: \"Resumen de la tesis\",\n    w_resumen_ej: \"(pega el de tu propuesta)\",\n    w_claves: \"Palabras clave\",\n    w_claves_ej: \"(separadas por comas)\",\n    w_casos: \"Casos concretos que estudias\",\n    w_opcional: \"(opcional)\",\n    w_casos_ph: \"Ej.: una especie, una institución, una región, un programa, una empresa…\",\n    w_casos_ayuda: \"Si tu tesis compara o analiza cosas concretas, nómbralas aquí (separadas por comas). Si es puramente teórica, déjalo en blanco.\",\n    w_idioma_local: \"Idioma local de búsqueda\",\n    w_idioma_local_ej: \"(además del inglés)\",\n    w_idioma_local_valor: \"español\",\n    w_gestor: \"Gestor de referencias\",\n    w_gestor_ninguno: \"Ninguno\",\n    w_gemini: \"Clave de Gemini\",\n    w_gemini_ej: \"(gratis, en aistudio.google.com)\",\n    w_openalex: \"Clave de OpenAlex\",\n    w_openalex_ej: \"(gratis, en openalex.org)\",\n    w_guardar: \"Guardar y generar mi perfil\",\n    w_generando: \"Generando tu perfil con la IA… puede tardar un minuto.\",\n    w_siguientes: \"Ver los siguientes pasos\",\n    w_error_corto: \"Escribe un resumen de al menos unas 3-4 frases, o varias palabras clave.\",\n    w_error_gemini: \"Falta la clave de Gemini. Es gratuita: aistudio.google.com.\",\n    w_listo: \"Listo. Revisa la pestaña PERFIL (puedes corregir lo que quieras) y después pulsa «Activar TODA la automatización».\",\n    w_error_ia: \"La IA no ha devuelto «{0}». Vuelve a pulsar «Guardar» (a veces falla a la primera).\",\n    w_error_contexto: \"La IA no ha devuelto el contexto. Vuelve a intentarlo.\",\n\n    // ---- Pestaña PERFIL ----\n    pf_cabecera: [\"CLAVE\", \"DESCRIPCIÓN\", \"VALOR\"],\n    pf_nota: \"Las celdas amarillas se pueden editar. Para listas, escribe un elemento por línea (Ctrl+Intro para saltar de línea).\",\n    pf_titulo: \"Título o tema de la tesis\",\n    pf_disciplina: \"Disciplina\",\n    pf_resumen: \"Resumen de la tesis\",\n    pf_palabras_clave: \"Palabras clave\",\n    pf_casos: \"Casos concretos que estudias (opcional)\",\n    pf_idioma_local: \"Idioma local de búsqueda\",\n    pf_gestor_referencias: \"Gestor de referencias\",\n    pf_contexto_tesis: \"Contexto que se da a la IA al clasificar\",\n    pf_rasgos_casos: \"Rasgos de cada caso o institución (uno por línea)\",\n    pf_consultas_radar: \"Consultas del radar diario (una por línea)\",\n    pf_consultas_historico: \"Consultas del radar histórico (una por línea)\",\n    pf_terminos_filtro: \"Términos para filtrar fuentes abiertas (uno por línea)\",\n    pf_bloques_mapa: \"Bloques del mapa de huecos (nombre | claves | búsqueda)\",\n\n    // ---- Estados (etiquetas visibles; el valor interno no cambia) ----\n    st_pendiente: \"Pendiente\",\n    st_paraleer: \"Para leer\",\n    st_leido: \"Leído\",\n    st_descartado: \"Descartado\",\n\n    // ---- Buscador ----\n    bq_panel: \"Buscar en toda la base\",\n    bq_intro: \"Busca en <b>toda</b> la base, no solo en RADAR.\",\n    bq_palabras: \"Palabras\",\n    bq_ph: 'gobernanza \"toma de decisiones\" -turismo',\n    bq_ayuda: \"Frase exacta entre comillas. Con - delante, excluye.\",\n    bq_debe: \"Debe contener\",\n    bq_todas: \"Todas las palabras\",\n    bq_alguna: \"Alguna de las palabras\",\n    bq_buscar_en: \"Buscar en\",\n    bq_todo: \"Todo (incluye el abstract original)\",\n    bq_rapido: \"Título, resumen, temática y autores\",\n    bq_minima: \"Relevancia mínima\",\n    bq_cualquiera: \"Cualquiera\",\n    bq_n_o_mas: \"{0} o más\",\n    bq_solo5: \"Solo 5\",\n    bq_estado: \"Estado\",\n    bq_boton: \"Buscar\",\n    bq_buscando: \"Buscando…\",\n    bq_err_vacio: \"Escribe al menos una palabra (mínimo 2 letras).\",\n    bq_err_sin_pub: \"Todavía no hay publicaciones que buscar.\",\n    bq_sin_resultados: \"Sin resultados. Prueba con menos palabras o con «Alguna de las palabras».\",\n    bq_resultados: \"{0} resultado(s)\",\n    bq_mostrados: \" (se muestran los {0} mejores)\",\n    bq_mira: \". Mira la pestaña BUSQUEDA.\",\n    bq_h_busqueda: \"Búsqueda: {0}\",\n    bq_h_resultados: \"{0} resultado(s). Haz clic en el título para abrir la publicación.\",\n    bq_cab: [\"PUBLICACIÓN\", \"COINCIDE EN\", \"RELEVANCIA\", \"ESTADO\", \"AÑO\", \"AUTORES\", \"RESUMEN\"],\n    bq_f_TITULO: \"título\",\n    bq_f_TEMATICA_PRINCIPAL: \"temática\",\n    bq_f_TEMATICAS_SECUNDARIAS: \"temáticas\",\n    bq_f_RESUMEN_IA: \"resumen IA\",\n    bq_f_JUSTIFICACION_RELEVANCIA: \"justificación\",\n    bq_f_AUTORES: \"autores\",\n    bq_f_REVISTA_EDITORIAL: \"revista\",\n    bq_f_ABSTRACT_ORIGINAL: \"abstract\",\n\n    // ---- Zotero ----\n    zo_dialogo: \"Conectar con Zotero\",\n    zo_intro: 'Crea tu clave en <b>zotero.org/settings/keys</b> (botón «Create new private key»). Marca <b>Allow library access</b> y <b>Allow write access</b>, guarda y copia la clave aquí:',\n    zo_conectar: \"Conectar\",\n    zo_comprobando: \"Comprobando…\",\n    zo_err_pegar: \"Pega la clave de Zotero.\",\n    zo_err_clave: \"Zotero no reconoce esa clave (HTTP {0}). Cópiala de nuevo.\",\n    zo_err_acceso: \"La clave no tiene acceso a tu biblioteca. Crea otra marcando «Allow library access».\",\n    zo_err_escritura: \"La clave no permite escribir. Crea otra marcando «Allow write access».\",\n    zo_conectado: \"Conectado con Zotero. Ya puedes usar «Enviar a mi gestor ahora».\",\n    zo_desconectado: \"Zotero desconectado. Puedes borrar la clave en zotero.org.\",\n    zo_funciona: \"La conexión funciona.\",\n    zo_no_conectado: \"Zotero no está conectado. Usa Ajustes > Zotero: conectar.\",\n    zo_err_coleccion: \"Zotero no ha devuelto la colección creada.\",\n    zo_ocupado: \"Hay otro proceso en marcha. Inténtalo en unos minutos.\",\n    zo_no_hoja: \"No existe la pestaña PUBLICACIONES.\",\n    zo_nada: \"No hay publicaciones por enviar. Cambia el ESTADO en RADAR a Para leer o Leído.\",\n    zo_enviadas: \"Enviadas a Zotero: {0}. Pendientes: {1}.\",\n    zo_reconectar: \" Vuelve a conectar Zotero desde Ajustes.\",\n    zo_limite: \" Límite de uso alcanzado: se retomará más tarde.\",\n    zo_temporal: \" Error temporal: se reintentará.\",\n    zo_errores: \" Hubo errores: revisa la pestaña LOG.\",\n    zo_auto_on: \"Envío automático a Zotero activado (cada 6 horas).\",\n    zo_auto_off: \"Envío automático a Zotero desactivado ({0}).\",\n    zo_sin_gestor: \"Has elegido no usar gestor. Puedes cambiarlo en la pestaña PERFIL (fila gestor_referencias).\",\n    // ---- Comunes ----\n    c_ocupado: \"Hay otro proceso en marcha. Inténtalo en unos minutos.\",\n    c_no_hoja_pub: \"No existe la pestaña PUBLICACIONES.\",\n    c_falta_openalex: \"Falta la clave de OpenAlex. Usa «Configurar mi tesis» para añadirla.\",\n    c_falta_tesis: \"Falta configurar la tesis. Usa PIH Doctorado > «Configurar mi tesis».\",\n    c_activadores: \"{0} activador(es)\",\n\n    // ---- Clasificador ----\n    ig_vacio: \"No hay publicaciones pendientes de clasificar.\",\n    ig_resultado: \"Clasificadas: {0}. Pendientes: {1}.\",\n    ig_actualizar: \" Usa «Actualizar panel y RADAR» para ver los cambios.\",\n    ig_cuota: \" Límite gratuito alcanzado: se retomará más tarde.\",\n    ig_transitorio: \" Error temporal de Gemini: se reintentará.\",\n    ig_config: \" Error de configuración: revisa la pestaña LOG.\",\n    ig_errores: \" Hubo errores: revisa la pestaña LOG.\",\n    ig_sin_gemini: \"Falta la clave de Gemini. Usa «Configurar mi tesis» para añadirla.\",\n    ig_recal_titulo: \"Recalibrar puntuaciones\",\n    ig_recal_texto: \"Se volverán a puntuar con IA las publicaciones en estado «Pendiente» (o sin estado). No se tocan las que estén Para leer, Leído o Descartado.\\n\\nSi habías corregido a mano alguna relevancia de una publicación aún Pendiente, se recalculará.\\n\\n¿Continuar?\",\n    ig_recal_nada: \"No hay publicaciones que recalibrar.\",\n    ig_recal_sin_pend: \"No hay publicaciones pendientes con puntuación.\",\n    ig_recal_listas: \"{0} publicaciones listas para repuntuar. Ahora usa «Clasificar pendientes con IA» (o espera a la automatización).\",\n\n    // ---- Radar diario ----\n    ra_auto_on: \"Automatización activada: radar diario y clasificación periódica.\",\n    ra_auto_off: \"Automatización desactivada ({0}).\",\n\n    // ---- Panel y RADAR ----\n    ui_no_hoja: \"No se encuentra la hoja PUBLICACIONES.\",\n    ui_actualizado: \"RADAR y PANEL actualizados ({0} publicaciones en RADAR).\",\n    ui_valor_invalido: \"Valor no válido en {0} celda(s): se ha restaurado el anterior.\",\n    ui_sin_identificar: \"No se ha podido identificar la publicación en {0} fila(s). Ejecuta crearInterfazDoctorado().\",\n    ui_sync_on: \"Sincronización automática activada.\",\n\n    // ---- Mapa de huecos ----\n    mh_sin_pub: \"No hay publicaciones en PUBLICACIONES.\",\n    mh_actualizado: \"Mapa de huecos actualizado ({0} publicaciones puntuadas, {1} aún sin puntuar).\",\n\n    // ---- Exportar RIS ----\n    ris_sin_pub: \"No hay publicaciones.\",\n    ris_sin_confirmar: \"No hay publicaciones exportadas pendientes de confirmar.\",\n    ris_marcadas: \"{0} publicación(es) marcadas como incorporadas a tu gestor.\",\n    ris_nada_exportar: \"No hay publicaciones para exportar.\",\n    ris_nada_estado: \"No hay publicaciones para exportar. En RADAR, cambia el ESTADO a Para leer o Leído en las que quieras llevar a tu gestor.\",\n    ris_cuota: \"Has agotado el límite diario de correos. Inténtalo mañana.\",\n    ris_enviado: \"Exportación enviada a tu correo ({0} referencias). Importa el archivo en tu gestor.\",\n\n    // ---- Autores clave ----\n    au_candidatos: \"{0} candidato(s) encontrado(s). Revisa la pestaña {1} y escribe «Sí» en CONFIRMADO solo donde sea la persona correcta.\",\n    au_limite: \" Límite gratuito de OpenAlex alcanzado: repite más tarde.\",\n    au_primero: \"Primero usa «Preparar autores y buscar candidatos».\",\n    au_resumen: \"{0} publicación(es) nueva(s) de autores clave ({1} autor(es) revisados).\",\n    au_ninguno: \"No hay autores confirmados. Escribe «Sí» en CONFIRMADO en la pestaña {0}.\",\n    au_ia: \" La IA las puntuará en la siguiente clasificación.\",\n    au_on: \"Vigilancia de autores activada: cada domingo sobre las 21:00.\",\n    au_off: \"Vigilancia de autores desactivada ({0}).\",\n\n    // ---- Fuentes abiertas ----\n    fa_pausa: \"Fuentes abiertas en pausa: hay {0} publicaciones por clasificar. Sigue cuando la IA se ponga al día.\",\n    fa_al_dia: \"Fuentes abiertas al día. Próxima revisión en unos días.\",\n    fa_nuevas: \"{0} publicación(es) nueva(s) de fuentes abiertas.\",\n    fa_ia: \" La IA las puntuará en la siguiente clasificación.\",\n    fa_prueba_titulo: \"Fuentes abiertas · prueba de conexión\",\n    fa_prueba_leyenda: \"\\n\\n✔ funciona · ⚠ responde con problemas · ✖ no responde\",\n    fa_on: \"Fuentes abiertas activadas: se revisan solas cada 6 horas.\",\n    fa_off: \"Fuentes abiertas desactivadas ({0}).\",\n\n    // ---- Histórico, correos, congresos, fuentes primarias, Mendeley ----\n    hi_reiniciar_titulo: \"Radar histórico\",\n    hi_reiniciar: \"Ya hay un proceso histórico en marcha. ¿Quieres reiniciarlo desde cero? (No se borra nada de PUBLICACIONES; solo se vacía la cola de candidatas.)\",\n    hi_iniciado: \"Radar histórico iniciado. Empiezo a buscar candidatas…\",\n    hi_no_iniciado: \"El radar histórico no se ha iniciado. Usa «Revisar ahora > Radar histórico: continuar».\",\n    hi_pausa: \"El radar histórico está en pausa.\",\n    hi_saturado: \"El radar histórico ya alcanzó la saturación.\",\n    hi_error: \"Error en el radar histórico: {0}\",\n    hi_busq: \"Histórico: {0} candidatas nuevas en la cola (consulta {1} de {2}).\",\n    hi_limite: \" Límite gratuito de OpenAlex alcanzado: continuará más tarde.\",\n    hi_terminada: \" Búsqueda terminada; empiezan las olas de análisis.\",\n    hi_ola_clasif: \"Histórico: la ola {0} se está clasificando ({1} de {2}). Se continuará automáticamente.\",\n    hi_ola_enviada: \"Histórico: ola {0} enviada ({1} publicaciones). La IA las irá clasificando.\",\n    hi_terminado: \"Radar histórico terminado ({0}). Te he enviado un resumen.\",\n    hi_m_sat: \"saturación\",\n    hi_m_cola: \"cola agotada\",\n    hi_ola_resumen: \"Ola {0}: {1} de relevancia 4-5 (de {2})\",\n    hi_mail_asunto: \"PIH · Radar histórico terminado ({0})\",\n    hi_mail_cuerpo: \"El radar histórico se ha detenido por: {0}.\\n\\nOlas analizadas: {1}\\n{2}\\n\\nRevisa RADAR (ordenado por relevancia). Si quieres seguir buscando, amplía las consultas del radar histórico en la pestaña PERFIL y reinícialo desde el menú.\\n\",\n    hi_alert_no: \"Todavía no se ha iniciado.\",\n    hi_f_busqueda: \"Buscando candidatas\",\n    hi_f_olas: \"Analizando por olas\",\n    hi_f_saturado: \"Terminado (saturación)\",\n    hi_l_fase: \"Fase: {0}\",\n    hi_l_pausa: \"⏸ EN PAUSA\",\n    hi_l_activo: \"▶ Activo\",\n    hi_l_cola: \"Candidatas en cola: {0}\",\n    hi_l_olas: \"Olas enviadas: {0}\",\n    hi_l_flojas: \"Olas flojas seguidas: {0} (se para a las {1})\",\n    hi_l_consulta: \"Consulta {0} de {1}\",\n    hi_l_ola: \"Ola {0}: {1} de relevancia 4-5\",\n    hi_l_bola: \"Bola de nieve: no disponible\",\n    hi_no_ini_corto: \"El radar histórico no está iniciado.\",\n    hi_en_pausa: \"Radar histórico en pausa.\",\n    hi_reanudado: \"Radar histórico reanudado.\",\n    hi_auto_on: \"Radar histórico automático activado (cada 6 horas).\",\n    hi_auto_off: \"Radar histórico automático desactivado ({0}).\",\n    rs_sin_pub: \"No hay publicaciones para resumir.\",\n    rs_sin_novedades: \"No hay novedades de relevancia 4-5 esta semana: no se envía correo.\",\n    rs_enviado: \"Resumen semanal enviado a tu correo.\",\n    rs_on: \"Resumen semanal activado: cada lunes sobre las 8:00.\",\n    rs_off: \"Resumen semanal desactivado ({0}).\",\n    rs_asunto: \"PIH Doctorado · {0} publicación(es) de relevancia 4-5 esta semana\",\n    rs_historico: \"Radar histórico: fase «{0}»{1}, {2} olas enviadas.\",\n    rs_en_pausa: \" (en pausa)\",\n    rs_t_titulo: \"Resumen semanal del Personal Intelligence Hub\",\n    rs_t_sub: \"Publicaciones de relevancia 4-5 detectadas esta semana (Pendientes):\",\n    rs_tematica: \"Temática\",\n    rs_balance: \"Balance\",\n    rs_nuevas: \"Nuevas esta semana: {0}\",\n    rs_puntuadas: \"Puntuadas en total: {0}\",\n    rs_sinpunt: \"Aún sin puntuar: {0}\",\n    rs_pend: \"Relevancia 4-5 pendientes de revisar: {0}\",\n    rs_abre: \"Abre tu hoja: {0}\",\n    rs_h_titulo: \"Resumen semanal · PIH Doctorado\",\n    rs_h_sub: \"Publicaciones de relevancia 4-5 detectadas esta semana que siguen en estado <b>Pendiente</b>:\",\n    rs_h_abrir: \"Abrir mi hoja PIH_DOCTORADO\",\n    co_lista: \"Pestaña CONGRESOS lista. Añade fechas y plazos reales (FECHA_LIMITE) para recibir avisos.\",\n    co_ninguno: \"No hay congresos. Usa «Preparar hoja de congresos».\",\n    co_sin_plazos: \"No hay plazos de congresos en los próximos {0} días.\",\n    co_mail_cab: \"Plazos de congresos en los próximos {0} días:\",\n    co_en_dia: \"en {0} día\",\n    co_en_dias: \"en {0} días\",\n    co_asunto: \"PIH Doctorado · {0} plazo(s) de congresos en los próximos {1} días\",\n    co_enviado: \"Recordatorio de plazos enviado a tu correo.\",\n    co_on: \"Recordatorio de congresos activado: cada lunes sobre las 8:00.\",\n    co_off: \"Recordatorio de congresos desactivado ({0}).\",\n    fp_catalogo: \"{0} fuente(s) añadida(s). Revisa los enlaces marcados «Localizado en buscador» y completa los «Por localizar».\",\n    fp_primero: \"Primero usa «Preparar catálogo».\",\n    fp_mail_cab: \"Documentos nuevos en tus fuentes primarias:\",\n    fp_asunto: \"PIH Doctorado · {0} documento(s) nuevo(s) en fuentes primarias\",\n    fp_resultado: \"{0} documento(s) nuevo(s) ({1} página(s) revisadas).\",\n    fp_errores: \" Hubo errores: mira LOG.\",\n    fp_on: \"Vigilancia de fuentes activada: cada domingo sobre las 20:00.\",\n    fp_off: \"Vigilancia de fuentes desactivada ({0}).\",\n    me_falta_cred: \"Faltan MENDELEY_CLIENT_ID o MENDELEY_CLIENT_SECRET en las propiedades de la secuencia de comandos.\",\n    me_falta_oauth: \"Falta la biblioteca OAuth2 (identificador OAuth2) en el proyecto.\",\n    me_ya: \"Mendeley ya está conectado.\",\n    me_html: \"<p>1. Pulsa el enlace. Se abrirá Mendeley en otra pestaña.</p><p>2. Inicia sesión y acepta el permiso.</p><p>3. Cuando veas «Mendeley conectado», cierra esa pestaña y usa <i>Ajustes &gt; Mendeley: probar la conexión</i>.</p>\",\n    me_enlace: \"👉 Conectar con Mendeley\",\n    me_dialogo: \"Conectar con Mendeley\",\n    me_desconectado: \"Mendeley desconectado.\",\n    me_alert_no: \"Todavía no estás conectado. Usa Ajustes > Mendeley (avanzado): conectar.\",\n    me_ok: \"✅ Conexión correcta con tu biblioteca de Mendeley.\",\n    me_api_codigo: \"La API ha respondido con el código {0}.\\n\\n{1}\",\n    me_no_conectado: \"Mendeley no está conectado.\",\n    me_no_conectado_aviso: \"Mendeley no está conectado. Usa Ajustes > Mendeley (avanzado): conectar.\",\n    me_enviadas: \"Enviadas a Mendeley: {0}. Pendientes: {1}.\",\n    me_reconectar: \" Hay que volver a conectar Mendeley desde el menú.\",\n    me_auto_on: \"Envío automático a Mendeley activado (cada 6 horas).\",\n    me_auto_off: \"Envío automático a Mendeley desactivado ({0}).\"\n  },\n\n\n  // ===================================================\n  // ENGLISH\n  // ===================================================\n  en: {\n\n    // ---- Menu ----\n    m_configurar: \"🎓 Set up my thesis (start here)\",\n    m_actualizar: \"📊 Refresh dashboard and RADAR\",\n    m_buscar_base: \"🔍 Search the whole database\",\n    m_novedades: \"🔎 Look for new publications now\",\n    m_clasificar: \"🤖 Classify pending items with AI\",\n    m_gestor: \"📚 Send to my reference manager now\",\n    m_ris: \"📤 Export RIS file (EndNote and others)\",\n    m_ris_enviar: \"Email me the file\",\n    m_ris_marcar: \"Mark as imported\",\n    m_mapa: \"🗺 Thesis gap map\",\n    m_revisar: \"🔄 Check now\",\n    m_autores: \"Key authors\",\n    m_fuentes: \"Primary sources\",\n    m_abiertas: \"Open sources (optional)\",\n    m_congresos: \"Conference deadlines\",\n    m_resumen: \"Weekly summary by email\",\n    m_hist_continuar: \"Historical radar: continue\",\n    m_hist_estado: \"Historical radar: show status\",\n    m_ajustes: \"⚙ Settings\",\n    m_activar_todo: \"▶ Turn ON all automation\",\n    m_desactivar_todo: \"⏹ Turn OFF all automation\",\n    m_hist_activar: \"Automatic historical radar: on\",\n    m_hist_desactivar: \"Automatic historical radar: off\",\n    m_ab_activar: \"Open sources (optional): on\",\n    m_ab_desactivar: \"Open sources: off\",\n    m_ab_probar: \"Open sources: test connection\",\n    m_zo_conectar: \"Zotero: connect (first time only)\",\n    m_zo_probar: \"Zotero: test connection\",\n    m_zo_desconectar: \"Zotero: disconnect\",\n    m_me_conectar: \"Mendeley (advanced): connect\",\n    m_me_probar: \"Mendeley: test connection\",\n    m_me_desconectar: \"Mendeley: disconnect\",\n    m_repuntuar: \"Re-score pending items with the new criteria\",\n    m_diagnostico: \"System diagnostics\",\n    m_idioma: \"🌐 Idioma / Language\",\n    m_guia: \"📖 Step-by-step guide\",\n    m_guia_inicio: \"First steps\",\n    m_guia_listo: \"After setting up the thesis\",\n    m_guia_rapida: \"❓ Quick guide\",\n\n    // ---- Menu notices ----\n    a_buscando: \"Looking for new items in OpenAlex…\",\n    a_nuevos: \"{0} new publication(s).\",\n    a_nuevos_clasificar: \" Use “Classify pending items with AI” to analyse them.\",\n    a_limite_openalex: \" The free OpenAlex limit has been reached: try again later.\",\n    a_clasificando: \"Classifying with AI (it may take a few minutes)…\",\n    a_fuentes: \"Checking the source pages…\",\n    a_autores: \"Checking key authors…\",\n    a_mapa: \"Calculating the gap map…\",\n    a_error_titulo: \"The action could not be completed\",\n    a_error_pie: \"\\n\\nIf the problem continues, check the LOG tab.\",\n\n    // ---- Turn on / off ----\n    act_titulo: \"Turn on all automation\",\n    act_texto:\n      \"This will turn on:\\n\" +\n      \"• Daily radar + AI classification (every day and every hour)\\n\" +\n      \"• Sending to the reference manager you chose (every 6 hours)\\n\" +\n      \"• Weekly summary by email (Mondays)\\n\" +\n      \"• Conference deadline alerts (Mondays)\\n\" +\n      \"• Primary sources watch (Sundays)\\n\" +\n      \"• Key authors watch (Sundays)\\n\" +\n      \"\\nThe historical radar and the open sources (thesis repositories) are turned on separately (Settings).\\n\\nContinue?\",\n    act_ok: \"Automation turned on\",\n    des_titulo: \"Turn off all automation\",\n    des_texto:\n      \"All automatic tasks will stop (including the historical radar). \" +\n      \"Edits in RADAR will keep syncing.\\n\\nContinue?\",\n    des_ok: \"Automation turned off\",\n    p_radar: \"Daily radar and classification\",\n    p_gestor: \"Sending to your reference manager\",\n    p_resumen: \"Weekly summary\",\n    p_congresos: \"Conference deadlines\",\n    p_fuentes: \"Primary sources\",\n    p_autores: \"Key authors\",\n    p_abiertas: \"Open sources\",\n    p_historico: \"Historical radar\",\n\n    // ---- Quick guide ----\n    guia_titulo: \"Quick guide · PIH Doctorado\",\n    guia_html:\n      '<h3 style=\"margin: 0 0 8px; color: #24445C;\">How your PIH Doctorado works</h3>' +\n      '<p><b>0. Start</b> with “Set up my thesis”: paste your thesis abstract and your free keys, and the system configures itself.</p>' +\n      '<p><b>1. PANEL</b> is the summary: numbers and charts. Look only.</p>' +\n      '<p><b>2. RADAR</b> is your workbench, sorted by relevance (the most important on top). Colours show relevance, AI confidence and status.</p>' +\n      '<ul style=\"margin-top: 0;\">' +\n      '<li>Change the <b>ESTADO</b> (status) with the drop-down: <b>Pendiente</b> (pending, not reviewed), <b>Para leer</b> (to read, you are interested), <b>Leído</b> (read) or <b>Descartado</b> (discarded).</li>' +\n      '<li>You can correct the <b>RELEVANCIA</b> (relevance, 0 to 5) and the <b>TEMÁTICA</b> (topic). They save automatically.</li></ul>' +\n      '<p><b>3. Zotero or Mendeley:</b> publications marked “Para leer” or “Leído” are sent automatically to your library (collection “PIH Doctorado”). First time: Settings &gt; Zotero: connect (Mendeley is more technical).</p>' +\n      '<p><b>4. Automatic:</b> <i>Settings &gt; Turn ON all automation</i> switches everything on at once. If a free limit is reached, it stops and carries on later by itself. Everything is free.</p>' +\n      '<p><b>5. Other tabs:</b> MAPA HUECOS (gap map: which parts of the thesis have little literature), AUTORES CLAVE (key authors), FUENTES PRIMARIAS (primary sources) and CONGRESOS (conferences) fill in and alert you by email. PUBLICACIONES is the database and LOG the history (if something fails, the reason is there).</p>',\n\n    // ---- Tutorial ----\n    tut_label_inicio: \"GUIDE · FIRST STEPS\",\n    tut_label_listo: \"GUIDE · NEXT STEPS\",\n    tut_prev: \"Previous\",\n    tut_next: \"Next\",\n    tut_start: \"Start\",\n    tut_of: \"of\",\n    tut_menu_error: \"Use the top menu: PIH Doctorado > Set up my thesis.\",\n    tut_toast: \"Open PIH Doctorado > Step-by-step guide to see the first steps.\",\n    tut_toast_titulo: \"Welcome\",\n    tut_idioma: \"Language\",\n    tut_dialogo: \"PIH Doctorado\",\n\n    tut_inicio: [\n      {\n        titulo: \"Welcome to your PIH Doctorado\",\n        texto: \"It is a system that looks every day for new publications on your thesis, \" +\n          \"scores them from 0 to 5 with AI and leaves them sorted in this sheet. It works with \" +\n          \"free accounts and your data stays in your Google account.\",\n        pista: \"This guide takes about 3 minutes. You can reopen it from the menu.\"\n      },\n      {\n        titulo: \"How it works\",\n        texto: \"1. You describe your thesis.\\n2. The system searches for literature in OpenAlex, \" +\n          \"an open database of scholarly works.\\n3. The AI reads each abstract and gives it a \" +\n          \"score according to your thesis.\\n4. You decide what to read and send it to your reference manager.\",\n        pista: \"You always have the last word: you can correct any score.\"\n      },\n      {\n        titulo: \"What will be created in your sheet\",\n        texto: \"When you set up your thesis, these tabs will appear:\\n\\n\" +\n          \"PERFIL (profile): your thesis and the generated searches.\\n\" +\n          \"RADAR: the list of publications, sorted by relevance. This is where you work.\\n\" +\n          \"PANEL (dashboard): summary with numbers and charts.\\n\" +\n          \"PUBLICACIONES (publications): the full database.\\n\" +\n          \"LOG: the history; if something fails, the reason is here.\\n\" +\n          \"And empty, for you to fill in: AUTORES CLAVE (key authors), CONGRESOS (conferences) and FUENTES PRIMARIAS (primary sources).\",\n        pista: \"You do not need to touch anything before setting up.\"\n      },\n      {\n        titulo: \"What you need before starting\",\n        texto: \"Two free keys, no card needed:\\n\" +\n          \"• Gemini (the AI): aistudio.google.com > “Get API key”.\\n\" +\n          \"• OpenAlex (the literature): create an account at openalex.org and copy the key from your profile.\\n\\n\" +\n          \"And your thesis abstract: at least 4 or 5 sentences.\",\n        pista: \"Get them now in another browser tab and come back.\"\n      },\n      {\n        titulo: \"Google permissions\",\n        texto: \"The first time, Google will ask for permissions and show “unverified app”. \" +\n          \"This is normal for personal scripts.\\n\\nPress “Advanced” and then \" +\n          \"“Go to… (unsafe)”. The code is yours and you can read it under Extensions > Apps Script.\",\n        pista: \"The system only touches this document.\"\n      },\n      {\n        titulo: \"First step: set up your thesis\",\n        texto: \"Press the button below, or use the top menu:\\n\\n\" +\n          \"PIH Doctorado  >  🎓 Set up my thesis\\n\\n\" +\n          \"Paste your abstract, your keywords and the two keys. The system will generate your profile \" +\n          \"and tell you what to do next.\",\n        pista: \"If the button does not respond, use the menu. If the menu does not appear, reload the page.\",\n        accion: { etiqueta: \"Open “Set up my thesis”\", funcion: \"menuConfigurarTesisPIH\" }\n      }\n    ],\n\n    tut_listo: [\n      {\n        titulo: \"Your profile is ready\",\n        texto: \"The system has created the PERFIL tab with the searches, terms and \" +\n          \"blocks of your thesis. The yellow cells can be edited: one query per line.\",\n        pista: \"Check that the queries make sense for your topic.\"\n      },\n      {\n        titulo: \"What each tab is\",\n        texto: \"RADAR: your workbench. Most relevant on top; you change the ESTADO (status) and correct scores.\\n\" +\n          \"PANEL: numbers and charts for the whole.\\n\" +\n          \"PUBLICACIONES: the full database (no need to edit it).\\n\" +\n          \"MAPA HUECOS: which parts of your thesis have little literature.\\n\" +\n          \"AUTORES CLAVE: authors you want to follow.\\n\" +\n          \"CONGRESOS: deadlines and status of your proposals.\\n\" +\n          \"FUENTES PRIMARIAS: documents about your cases (reports, regulations).\\n\" +\n          \"BUSQUEDA: search results. LOG: the history.\",\n        pista: \"The colours in RADAR show relevance, AI confidence and status.\"\n      },\n      {\n        titulo: \"Step 1 · Look for new publications\",\n        texto: \"Menu PIH Doctorado > 🔎 Look for new publications now.\\n\\nWithin a minute or two \" +\n          \"new publications will appear in the PUBLICACIONES tab.\",\n        pista: \"If nothing appears, look at the LOG tab: the reason is there.\"\n      },\n      {\n        titulo: \"Step 2 · AI classification\",\n        texto: \"Menu PIH Doctorado > 🤖 Classify pending items with AI.\\n\\nThe AI reads each abstract \" +\n          \"and gives it a relevance from 0 to 5 with an explanation. It can take a few minutes.\",\n        pista: \"If Google says “high demand” (error 503), it is temporary: it retries by itself.\"\n      },\n      {\n        titulo: \"Step 3 · Your workbench\",\n        texto: \"In the RADAR tab you will see the most relevant on top. Colours show relevance \" +\n          \"(dark green = 5) and status.\\n\\nChange the ESTADO with the drop-down: Pendiente (pending), \" +\n          \"Para leer (to read), Leído (read) or Descartado (discarded). If you disagree with a score, correct it.\",\n        pista: \"Your corrections are saved automatically.\"\n      },\n      {\n        titulo: \"Step 4 · Search and explore\",\n        texto: \"🔍 Search the whole database: finds words in titles, summaries and abstracts.\\n\\n\" +\n          \"🗺 Gap map: tells you which parts of your thesis have little literature.\\n\\n\" +\n          \"Key authors, Conferences and Primary sources: tabs to fill in with your own material.\",\n        pista: \"Start with the search: it is the most useful on day one.\"\n      },\n      {\n        titulo: \"Step 5 · Your reference manager\",\n        texto: \"What you mark as “Para leer” (to read) or “Leído” (read) can travel to your library by itself.\\n\\n\" +\n          \"Zotero: PIH Doctorado > Settings > Zotero: connect (you need a free key).\\n\" +\n          \"EndNote or others: 📤 Export RIS file.\",\n        pista: \"Mendeley is an advanced option.\"\n      },\n      {\n        titulo: \"Step 6 · Automation\",\n        texto: \"When you are happy with everything:\\n\\nPIH Doctorado > ⚙ Settings > ▶ Turn ON all automation.\\n\\n\" +\n          \"From then on the system searches, classifies and emails you a weekly summary. \" +\n          \"The historical radar (earlier literature) is turned on separately, in Settings.\",\n        pista: \"If something fails, the LOG tab explains it. The “Step-by-step guide” menu reopens this.\"\n      }\n    ],\n\n    // ---- “Set up my thesis” wizard ----\n    w_titulo: \"Set up my thesis\",\n    w_idioma: \"Interface language\",\n    w_intro: \"Fill in what you know. The more specific the abstract, the better it will work. Everything is saved only in your document.\",\n    w_tema: \"Title or topic\",\n    w_disciplina: \"Discipline\",\n    w_disciplina_ej: \"(e.g. sociology, marine biology…)\",\n    w_resumen: \"Thesis abstract\",\n    w_resumen_ej: \"(paste the one from your proposal)\",\n    w_claves: \"Keywords\",\n    w_claves_ej: \"(separated by commas)\",\n    w_casos: \"Specific cases you study\",\n    w_opcional: \"(optional)\",\n    w_casos_ph: \"E.g.: a species, an institution, a region, a programme, a company…\",\n    w_casos_ayuda: \"If your thesis compares or analyses specific things, name them here (separated by commas). If it is purely theoretical, leave it blank.\",\n    w_idioma_local: \"Local search language\",\n    w_idioma_local_ej: \"(besides English)\",\n    w_idioma_local_valor: \"\",\n    w_gestor: \"Reference manager\",\n    w_gestor_ninguno: \"None\",\n    w_gemini: \"Gemini key\",\n    w_gemini_ej: \"(free, at aistudio.google.com)\",\n    w_openalex: \"OpenAlex key\",\n    w_openalex_ej: \"(free, at openalex.org)\",\n    w_guardar: \"Save and generate my profile\",\n    w_generando: \"Generating your profile with AI… it may take a minute.\",\n    w_siguientes: \"See the next steps\",\n    w_error_corto: \"Write an abstract of at least 3-4 sentences, or several keywords.\",
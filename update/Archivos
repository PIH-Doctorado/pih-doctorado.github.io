rad ({0}).\",\n  \"fp_catalogo\": \"{0} källa/källor tillagda. Granska länkarna markerade «Localizado en buscador» (hittad via sökning) och komplettera de som är «Por localizar» (ska hittas).\",\n  \"fp_primero\": \"Använd först «Preparar catálogo» (förbereder katalogen).\",\n  \"fp_mail_cab\": \"Nya dokument i dina primärkällor:\",\n  \"fp_asunto\": \"PIH Doctorado · {0} nytt/nya dokument i primärkällorna\",\n  \"fp_resultado\": \"{0} nytt/nya dokument ({1} sida/sidor kontrollerade).\",\n  \"fp_errores\": \" Det uppstod fel: se LOG.\",\n  \"fp_on\": \"Källkontroll aktiverad: varje söndag omkring kl. 20:00.\",\n  \"fp_off\": \"Källkontroll inaktiverad ({0}).\",\n  \"me_falta_cred\": \"MENDELEY_CLIENT_ID eller MENDELEY_CLIENT_SECRET saknas i skriptets egenskaper.\",\n  \"me_falta_oauth\": \"OAuth2-biblioteket (OAuth2-identifierare) saknas i projektet.\",\n  \"me_ya\": \"Mendeley är redan anslutet.\",\n  \"me_html\": \"<p>1. Klicka på länken. Mendeley öppnas i en annan flik.</p><p>2. Logga in och godkänn behörigheten.</p><p>3. När du ser «Mendeley anslutet», stäng den fliken och använd <i>Inställningar &gt; Mendeley: testa anslutningen</i>.</p>\",\n  \"me_enlace\": \"👉 Anslut till Mendeley\",\n  \"me_dialogo\": \"Anslut till Mendeley\",\n  \"me_desconectado\": \"Mendeley frånkopplat.\",\n  \"me_alert_no\": \"Du är inte ansluten ännu. Använd Inställningar > Mendeley (avancerat): anslut.\",\n  \"me_ok\": \"✅ Anslutningen till ditt Mendeley-bibliotek fungerar.\",\n  \"me_api_codigo\": \"API:et svarade med kod {0}.\\n\\n{1}\",\n  \"me_no_conectado\": \"Mendeley är inte anslutet.\",\n  \"me_no_conectado_aviso\": \"Mendeley är inte anslutet. Använd Inställningar > Mendeley (avancerat): anslut.\",\n  \"me_enviadas\": \"Skickade till Mendeley: {0}. Väntande: {1}.\",\n  \"me_reconectar\": \" Mendeley måste anslutas igen från menyn.\",\n  \"me_auto_on\": \"Automatisk sändning till Mendeley aktiverad (var 6:e timme).\",\n  \"me_auto_off\": \"Automatisk sändning till Mendeley inaktiverad ({0}).\"\n};\n}\n"}, {"name": "Idioma_sw", "type": "SERVER_JS", "source": "// PIH Doctorado · textos del idioma \"sw\". Pega este archivo como Idioma_sw.gs.\nfunction textosPIH_sw() {\n  return {\n  \"m_configurar\": \"🎓 Sanidi tasnifu yangu (anzia hapa)\",\n  \"m_actualizar\": \"📊 Sasisha paneli na RADAR\",\n  \"m_buscar_base\": \"🔍 Tafuta katika hifadhidata nzima\",\n  \"m_novedades\": \"🔎 Tafuta machapisho mapya sasa\",\n  \"m_clasificar\": \"🤖 Panga machapisho yanayosubiri kwa AI\",\n  \"m_gestor\": \"📚 Tuma kwa kidhibiti changu cha marejeo sasa\",\n  \"m_ris\": \"📤 Hamisha faili ya RIS (EndNote n.k.)\",\n  \"m_ris_enviar\": \"Tuma faili kwa barua pepe yangu\",\n  \"m_ris_marcar\": \"Weka alama kuwa imeingizwa\",\n  \"m_mapa\": \"🗺 Ramani ya mapengo ya tasnifu\",\n  \"m_revisar\": \"🔄 Kagua sasa\",\n  \"m_autores\": \"Waandishi muhimu\",\n  \"m_fuentes\": \"Vyanzo vya msingi\",\n  \"m_abiertas\": \"Vyanzo huria (hiari)\",\n  \"m_congresos\": \"Tarehe za mwisho za makongamano\",\n  \"m_resumen\": \"Muhtasari wa kila wiki kwa barua pepe\",\n  \"m_hist_continuar\": \"Rada ya kihistoria: endelea\",\n  \"m_hist_estado\": \"Rada ya kihistoria: onyesha hali\",\n  \"m_ajustes\": \"⚙ Mipangilio\",\n  \"m_activar_todo\": \"▶ Washa otomatiki zote\",\n  \"m_desactivar_todo\": \"⏹ Zima otomatiki zote\",\n  \"m_hist_activar\": \"Rada ya kihistoria otomatiki: washa\",\n  \"m_hist_desactivar\": \"Rada ya kihistoria otomatiki: zima\",\n  \"m_ab_activar\": \"Vyanzo huria (hiari): washa\",\n  \"m_ab_desactivar\": \"Vyanzo huria: zima\",\n  \"m_ab_probar\": \"Vyanzo huria: jaribu muunganisho\",\n  \"m_zo_conectar\": \"Zotero: unganisha (mara ya kwanza tu)\",\n  \"m_zo_probar\": \"Zotero: jaribu muunganisho\",\n  \"m_zo_desconectar\": \"Zotero: tenganisha\",\n  \"m_me_conectar\": \"Mendeley (ya hali ya juu): unganisha\",\n  \"m_me_probar\": \"Mendeley: jaribu muunganisho\",\n  \"m_me_desconectar\": \"Mendeley: tenganisha\",\n  \"m_repuntuar\": \"Weka alama upya machapisho yanayosubiri kwa kigezo kipya\",\n  \"m_diagnostico\": \"Uchunguzi wa mfumo\",\n  \"m_idioma\": \"🌐 Idioma / Language\",\n  \"m_guia\": \"📖 Mwongozo hatua kwa hatua\",\n  \"m_guia_inicio\": \"Hatua za kwanza\",\n  \"m_guia_listo\": \"Baada ya kusanidi tasnifu\",\n  \"m_guia_rapida\": \"❓ Mwongozo wa haraka\",\n  \"a_buscando\": \"Inatafuta machapisho mapya katika OpenAlex…\",\n  \"a_nuevos\": \"Machapisho mapya: {0}.\",\n  \"a_nuevos_clasificar\": \" Tumia «Panga machapisho yanayosubiri kwa AI» ili kuyachambua.\",\n  \"a_limite_openalex\": \" Kikomo cha bure cha OpenAlex kimefikiwa: jaribu tena baadaye.\",\n  \"a_clasificando\": \"Inapanga kwa AI (inaweza kuchukua dakika chache)…\",\n  \"a_fuentes\": \"Inakagua kurasa za vyanzo…\",\n  \"a_autores\": \"Inakagua waandishi muhimu…\",\n  \"a_mapa\": \"Inakokotoa ramani ya mapengo…\",\n  \"a_error_titulo\": \"Kitendo hakikukamilika\",\n  \"a_error_pie\": \"\\n\\nTatizo likiendelea, angalia kichupo cha LOG.\",\n  \"act_titulo\": \"Washa otomatiki zote\",\n  \"act_texto\": \"Vitu hivi vitawashwa:\\n• Rada ya kila siku + upangaji kwa AI (kila siku na kila saa)\\n• Kutuma kwa kidhibiti cha marejeo ulichochagua (kila saa 6)\\n• Muhtasari wa kila wiki kwa barua pepe (Jumatatu)\\n• Ukumbusho wa tarehe za mwisho za makongamano (Jumatatu)\\n• Kukagua vyanzo vya msingi (Jumapili)\\n• Kukagua waandishi muhimu (Jumapili)\\n\\nRada ya kihistoria na vyanzo huria (hazina za tasnifu) huwashwa kando kutoka «Mipangilio».\\n\\nUendelee?\",\n  \"act_ok\": \"Otomatiki zimewashwa\",\n  \"des_titulo\": \"Zima otomatiki zote\",\n  \"des_texto\": \"Kazi zote za otomatiki zitasimama (pamoja na rada ya kihistoria). Mabadiliko yako katika RADAR yataendelea kusawazishwa.\\n\\nUendelee?\",\n  \"des_ok\": \"Otomatiki zimezimwa\",\n  \"p_radar\": \"Rada ya kila siku na upangaji\",\n  \"p_gestor\": \"Kutuma kwa kidhibiti cha marejeo\",\n  \"p_resumen\": \"Muhtasari wa kila wiki\",\n  \"p_congresos\": \"Tarehe za mwisho za makongamano\",\n  \"p_fuentes\": \"Vyanzo vya msingi\",\n  \"p_autores\": \"Waandishi muhimu\",\n  \"p_abiertas\": \"Vyanzo huria\",\n  \"p_historico\": \"Rada ya kihistoria\",\n  \"guia_titulo\": \"Mwongozo wa haraka · PIH Doctorado\",\n  \"guia_html\": \"<h3 style='margin: 0 0 8px; color: #24445C;'>Jinsi PIH Doctorado yako inavyofanya kazi</h3><p><b>0. Kuanza:</b> kwa «Configurar mi tesis» (Sanidi tasnifu yangu): bandika muhtasari wa tasnifu yako na funguo zako za bure ili mfumo ujisanidi wenyewe.</p><p><b>1. PANEL (paneli)</b> ni muhtasari wa jumla: nambari na grafu. Unatazama tu.</p><p><b>2. RADAR</b> ni mpango wako wa kazi, umepangwa kwa umuhimu (muhimu zaidi juu). Rangi zinaonyesha umuhimu, uhakika wa AI na hali.</p><ul style='margin-top: 0;'><li>Badilisha <b>ESTADO</b> (hali) kwa orodha kunjuzi: <b>Pendiente</b> (inasubiri, haijakaguliwa), <b>Para leer</b> (ya kusoma, inavutia), <b>Leído</b> (imesomwa) au <b>Descartado</b> (imeachwa).</li><li>Unaweza kusahihisha <b>RELEVANCIA</b> (umuhimu, 0 hadi 5) na <b>TEMÁTICA</b> (mada). Huhifadhiwa kiotomatiki.</li></ul><p><b>3. Zotero au Mendeley:</b> machapisho unayoyaweka alama «Para leer» au «Leído» huenda kiotomatiki kwenye maktaba yako (mkusanyiko «PIH Doctorado»). Mara ya kwanza: Mipangilio &gt; Zotero: unganisha (Mendeley ni ya kiufundi zaidi).</p><p><b>4. Otomatiki:</b> kwa <i>Mipangilio &gt; Washa otomatiki zote</i> kila kitu kinawashwa kwa pamoja. Kikomo cha bure kikifikiwa, mfumo husimama na kuendelea wenyewe baadaye. Kila kitu ni bure.</p><p><b>5. Vichupo vingine:</b> MAPA HUECOS (ramani ya mapengo: sehemu za tasnifu zenye vyanzo vichache), AUTORES CLAVE (waandishi muhimu), FUENTES PRIMARIAS (vyanzo vya msingi) na CONGRESOS (makongamano) unavijaza wewe mwenyewe na vinakuonya kwa barua pepe. PUBLICACIONES ni hifadhidata na LOG ni historia (kitu kikishindwa, sababu iko huko).</p>\",\n  \"tut_label_inicio\": \"Mwongozo · Hatua za kwanza\",\n  \"tut_label_listo\": \"Mwongozo · Hatua zinazofuata\",\n  \"tut_prev\": \"Iliyotangulia\",\n  \"tut_next\": \"Inayofuata\",\n  \"tut_start\": \"Anza\",\n  \"tut_of\": \"ya\",\n  \"tut_menu_error\": \"Tumia menyu iliyo juu: PIH Doctorado > Sanidi tasnifu yangu.\",\n  \"tut_toast\": \"Ili kuona hatua za kwanza, fungua PIH Doctorado > Mwongozo hatua kwa hatua.\",\n  \"tut_toast_titulo\": \"Karibu\",\n  \"tut_idioma\": \"Lugha\",\n  \"tut_dialogo\": \"PIH Doctorado\",\n  \"tut_inicio\": [\n    {\n      \"titulo\": \"Karibu kwenye PIH Doctorado yako\",\n      \"texto\": \"Huu ni mfumo unaotafuta kila siku machapisho mapya yanayohusu tasnifu yako, kuyapa alama kutoka 0 hadi 5 kwa AI na kuyapanga katika lahajedwali hii. Unafanya kazi na akaunti za bure na data yako inabaki katika akaunti yako ya Google.\",\n      \"pista\": \"Mwongozo huu unachukua takriban dakika 3. Unaweza kuufungua tena kutoka kwenye menyu.\"\n    },\n    {\n      \"titulo\": \"Inafanyaje kazi\",\n      \"texto\": \"1. Unaelezea tasnifu yako.\\n2. Mfumo unatafuta vyanzo katika OpenAlex, hifadhidata huria ya kazi za kisayansi.\\n3. AI husoma kila muhtasari na kuulinganisha na tasnifu yako.\\n4. Wewe unaamua cha kusoma na cha kutuma kwa kidhibiti chako cha marejeo.\",\n      \"pista\": \"Neno la mwisho ni lako daima: kila alama inaweza kusahihishwa.\"\n    },\n    {\n      \"titulo\": \"Kinachoundwa katika lahajedwali yako\",\n      \"texto\": \"Ukisanidi tasnifu, vichupo hivi vinaonekana:\\n\\nPERFIL (wasifu): tasnifu yako na utafutaji uliotengenezwa.\\nRADAR: orodha ya machapisho kwa umuhimu. Hapa ndipo unapofanya kazi.\\nPANEL (paneli): muhtasari wa jumla wenye nambari na grafu.\\nPUBLICACIONES (machapisho): hifadhidata nzima.\\nLOG: historia; kitu kikishindwa, sababu iko hapa.\\nNa vichupo tupu vya kujaza: AUTORES CLAVE (waandishi muhimu), CONGRESOS (makongamano) na FUENTES PRIMARIAS (vyanzo vya msingi).\",\n      \"pista\": \"Huhitaji kugusa chochote kabla ya kusanidi tasnifu.\"\n    },\n    {\n      \"titulo\": \"Unachohitaji ili kuanza\",\n      \"texto\": \"Funguo mbili za bure, bila kadi:\\n• Gemini (AI): aistudio.google.com > «Get API key».\\n• OpenAlex (vyanzo): fungua akaunti kwenye openalex.org na unakili ufunguo kutoka wasifu wako.\\n\\nNa muhtasari wa tasnifu: sentensi 4 au 5 angalau.\",\n      \"pista\": \"Zipate kwenye kichupo kingine cha kivinjari kisha urudi.\"\n    },\n    {\n      \"titulo\": \"Ruhusa za Google\",\n      \"texto\": \"Mara ya kwanza Google itaomba ruhusa na kuonyesha «programu isiyothibitishwa». Hii ni kawaida kwa hati za kibinafsi.\\n\\nBofya «Ya hali ya juu» kisha «Nenda kwenye… (si salama)». Msimbo ni wako na unaweza kuusoma katika Viendelezi > Apps Script.\",\n      \"pista\": \"Mfumo unagusa hati hii tu.\"\n    },\n    {\n      \"titulo\": \"Hatua ya kwanza: sanidi tasnifu\",\n      \"texto\": \"Bonyeza kitufe kilicho chini au nenda kutoka menyu ya juu:\\n\\nPIH Doctorado  >  🎓 Sanidi tasnifu yangu\\n\\nBandika muhtasari, maneno muhimu na funguo mbili. Mfumo unaunda wasifu wako na kukuambia la kufanya baadaye.\",\n      \"pista\": \"Kitufe kisipojibu, tumia menyu. Menyu isipoonekana, pakia upya ukurasa.\",\n      \"accion\": {\n        \"etiqueta\": \"Fungua «Sanidi tasnifu yangu»\",\n        \"funcion\": \"menuConfigurarTesisPIH\"\n      }\n    }\n  ],\n  \"tut_listo\": [\n    {\n      \"titulo\": \"Wasifu wako uko tayari\",\n      \"texto\": \"Mfumo uliunda kichupo cha PERFIL chenye utafutaji wako, dhana na vizuizi vya tasnifu. Visanduku vya manjano vinaweza kuhaririwa: utafutaji mmoja kwa kila mstari.\",\n      \"pista\": \"Hakikisha utafutaji unaendana na mada yako.\"\n    },\n    {\n      \"titulo\": \"Kila kichupo kinatumika kwa nini\",\n      \"texto\": \"RADAR: mpango wako wa kazi. Zinazohusika zaidi juu; unabadilisha ESTADO (hali) na kusahihisha alama.\\nPANEL: nambari na grafu za jumla.\\nPUBLICACIONES: hifadhidata nzima (huhitaji kuihariri).\\nMAPA HUECOS: sehemu za tasnifu zenye vyanzo vichache.\\nAUTORES CLAVE: waandishi unaotaka kuwafuatilia.\\nCONGRESOS: tarehe za mwisho na hali ya ushiriki wako.\\nFUENTES PRIMARIAS: hati zinazohusu kesi zako (ripoti, kanuni).\\nBUSQUEDA: matokeo ya utafutaji. LOG: historia.\",\n      \"pista\": \"Rangi za RADAR zinaonyesha umuhimu, uhakika wa AI na hali.\"\n    },\n    {\n      \"titulo\": \"Hatua ya 1 · Tafuta machapisho mapya\",\n      \"texto\": \"Menyu PIH Doctorado > 🔎 Tafuta machapisho mapya sasa.\\n\\nNdani ya dakika moja au mbili machapisho mapya yataonekana katika kichupo cha PUBLICACIONES.\",\n      \"pista\": \"Kama hakuna kinachoonekana, angalia sababu katika kichupo cha LOG.\"\n    },\n    {\n      \"titulo\": \"Hatua ya 2 · Upangaji kwa AI\",\n      \"texto\": \"Menyu PIH Doctorado > 🤖 Panga machapisho yanayosubiri kwa AI.\\n\\nAI husoma kila muhtasari na kutoa umuhimu kutoka 0 hadi 5 pamoja na maelezo. Inaweza kuchukua dakika chache.\",\n      \"pista\": \"Google ikisema «mahitaji makubwa» (hitilafu 503), ni ya muda: mfumo hujaribu tena wenyewe.\"\n    },\n    {\n      \"titulo\": \"Hatua ya 3 · Mpango wako wa kazi\",\n      \"texto\": \"Katika kichupo cha RADAR zinazohusika zaidi ziko juu. Rangi zinaonyesha umuhimu (kijani kilichokolea = 5) na hali.\\n\\nBadilisha ESTADO kwa orodha kunjuzi: Pendiente (inasubiri), Para leer (ya kusoma), Leído (imesomwa) au Descartado (imeachwa). Sahihisha alama usipokubaliana nayo.\",\n      \"pista\": \"Masahihisho yako huhifadhiwa kiotomatiki.\"\n    },\n    {\n      \"titulo\": \"Hatua ya 4 · Tafuta na chunguza\",\n      \"texto\": \"🔍 Tafuta katika hifadhidata nzima: hupata maneno katika vichwa, muhtasari na abstract.\\n\\n🗺 Ramani ya mapengo: inaonyesha sehemu za tasnifu zenye vyanzo vichache.\\n\\nWaandishi muhimu, makongamano na vyanzo vya msingi: vichupo unavyovijaza kwa nyenzo zako.\",\n      \"pista\": \"Anza na utafutaji mmoja: siku ya kwanza ndiyo yenye manufaa zaidi.\"\n    },\n    {\n      \"titulo\": \"Hatua ya 5 · Kidhibiti chako cha marejeo\",\n      \"texto\": \"Unachoweka alama «Para leer» (ya kusoma) au «Leído» (imesomwa) kinaweza kwenda kiotomatiki kwenye maktaba yako.\\n\\nZotero: PIH Doctorado > Mipangilio > Zotero: unganisha (ufunguo wa bure unahitajika).\\nEndNote au programu nyingine: 📤 Hamisha faili ya RIS.\",\n      \"pista\": \"Mendeley ni chaguo la hali ya juu.\"\n    },\n    {\n      \"titulo\": \"Hatua ya 6 · Otomatiki\",\n      \"texto\": \"Kila kitu kikienda vizuri:\\n\\nPIH Doctorado > ⚙ Mipangilio > ▶ Washa otomatiki zote.\\n\\nKuanzia hapo mfumo hutafuta, hupanga na kukutumia muhtasari wa kila wiki kwa barua pepe wenyewe. Rada ya kihistoria (vyanzo vya zamani) huwashwa kando kutoka Mipangilio.\",\n      \"pista\": \"Kitu kikishindwa, kichupo cha LOG kinaeleza. Menyu «Mwongozo hatua kwa hatua» hufungua mwongozo huu tena.\"\n    }\n  ],\n  \"w_titulo\": \"Sanidi tasnifu yangu\",\n  \"w_idioma\": \"Lugha ya kiolesura\",\n  \"w_intro\": \"Jaza unachokijua. Kadiri muhtasari ulivyo wazi, ndivyo mfumo unavyofanya kazi vizuri. Kila kitu huhifadhiwa katika hati yako pekee.\",\n  \"w_tema\": \"Kichwa au mada\",\n  \"w_disciplina\": \"Taaluma\",\n  \"w_disciplina_ej\": \"(mf. sosholojia, biolojia ya baharini…)\",\n  \"w_resumen\": \"Muhtasari wa tasnifu\",\n  \"w_resumen_ej\": \"(bandika kutoka pendekezo lako)\",\n  \"w_claves\": \"Maneno muhimu\",\n  \"w_claves_ej\": \"(tenganisha kwa koma)\",\n  \"w_casos\": \"Kesi mahususi unazozisoma\",\n  \"w_opcional\": \"(hiari)\",\n  \"w_casos_ph\": \"mf.: spishi, taasisi, eneo, programu, kampuni…\",\n  \"w_casos_ayuda\": \"Kama tasnifu yako inalinganisha au kuchambua kesi mahususi, ziandike hapa (tenganisha kwa koma). Acha tupu kama ni ya kinadharia kabisa.\",\n  \"w_idioma_local\": \"Lugha ya utafutaji wa ndani\",\n  \"w_idioma_local_ej\": \"(mbali na Kiingereza)\",\n  \"w_idioma_local_valor\": \"Kiswahili\",\n  \"w_gestor\": \"Kidhibiti cha marejeo\",\n  \"w_gestor_ninguno\": \"Hakuna\",\n  \"w_gemini\": \"Ufunguo wa Gemini\",\n  \"w_gemini_ej\": \"(bure, kwenye aistudio.google.com)\",\n  \"w_openalex\": \"Ufunguo wa OpenAlex\",\n  \"w_openalex_ej\": \"(bure, kwenye openalex.or
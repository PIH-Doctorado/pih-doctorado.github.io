0}\",\n  \"rs_puntuadas\": \"Scóráilte san iomlán: {0}\",\n  \"rs_sinpunt\": \"Gan scór fós: {0}\",\n  \"rs_pend\": \"Ábharthacht 4–5 le hathbhreithniú: {0}\",\n  \"rs_abre\": \"Oscail do scarbhileog: {0}\",\n  \"rs_h_titulo\": \"Achoimre sheachtainiúil · PIH Doctorado\",\n  \"rs_h_sub\": \"Foilseacháin le hábharthacht 4–5 a aimsíodh an tseachtain seo agus atá fós <b>Pendiente</b> (ar feitheamh):\",\n  \"rs_h_abrir\": \"Oscail mo scarbhileog PIH_DOCTORADO\",\n  \"co_lista\": \"Tá an táb CONGRESOS réidh. Cuir isteach dátaí agus spriocdhátaí fíora (FECHA_LIMITE) chun meabhrúcháin a fháil.\",\n  \"co_ninguno\": \"Gan comhdháil. Úsáid «Preparar hoja de congresos» (ullmhaigh bileog na gcomhdhálacha).\",\n  \"co_sin_plazos\": \"Níl spriocdháta comhdhála sna {0} lá atá romhainn.\",\n  \"co_mail_cab\": \"Spriocdhátaí comhdhálacha sna {0} lá atá romhainn:\",\n  \"co_en_dia\": \"i gceann {0} lá\",\n  \"co_en_dias\": \"i gceann {0} lá\",\n  \"co_asunto\": \"PIH Doctorado · Spriocdhátaí comhdhálacha sna {1} lá atá romhainn: {0}\",\n  \"co_enviado\": \"Seoladh an meabhrúchán spriocdhátaí chuig do ríomhphost.\",\n  \"co_on\": \"Gníomhachtaíodh meabhrúchán na gcomhdhálacha: gach Luan thart ar 8:00.\",\n  \"co_off\": \"Díghníomhachtaíodh meabhrúchán na gcomhdhálacha ({0}).\",\n  \"fp_catalogo\": \"Foinsí curtha leis: {0}. Seiceáil na naisc «Localizado en buscador» (aimsithe le cuardaitheoir) agus comhlánaigh na cinn «Por localizar» (le haimsiú).\",\n  \"fp_primero\": \"Úsáid «Preparar catálogo» (ullmhaigh an catalóg) ar dtús.\",\n  \"fp_mail_cab\": \"Doiciméid nua i do phríomhfhoinsí:\",\n  \"fp_asunto\": \"PIH Doctorado · Doiciméid nua sna príomhfhoinsí: {0}\",\n  \"fp_resultado\": \"Doiciméid nua: {0} (leathanaigh seiceáilte: {1}).\",\n  \"fp_errores\": \" Tharla earráidí: féach ar LOG.\",\n  \"fp_on\": \"Gníomhachtaíodh seiceáil na bhfoinsí: gach Domhnach thart ar 20:00.\",\n  \"fp_off\": \"Díghníomhachtaíodh seiceáil na bhfoinsí ({0}).\",\n  \"me_falta_cred\": \"Níl MENDELEY_CLIENT_ID ná MENDELEY_CLIENT_SECRET i maoin an scripte.\",\n  \"me_falta_oauth\": \"Níl leabharlann OAuth2 (ID OAuth2) sa tionscadal.\",\n  \"me_ya\": \"Tá Mendeley ceangailte cheana féin.\",\n  \"me_html\": \"<p>1. Cliceáil ar an nasc. Osclóidh Mendeley i dtáb nua.</p><p>2. Logáil isteach agus glac leis na ceadanna.</p><p>3. Nuair a fheiceann tú «Mendeley ceangailte», dún an táb sin agus úsáid <i>Socruithe &gt; Mendeley: tástáil an ceangal</i>.</p>\",\n  \"me_enlace\": \"👉 Ceangail le Mendeley\",\n  \"me_dialogo\": \"Ceangail le Mendeley\",\n  \"me_desconectado\": \"Dícheangailte ó Mendeley.\",\n  \"me_alert_no\": \"Níl tú ceangailte fós. Úsáid Socruithe > Mendeley (ard): ceangail.\",\n  \"me_ok\": \"✅ Tá an ceangal le do leabharlann Mendeley ceart.\",\n  \"me_api_codigo\": \"D’fhreagair an API le cód {0}.\\n\\n{1}\",\n  \"me_no_conectado\": \"Níl Mendeley ceangailte.\",\n  \"me_no_conectado_aviso\": \"Níl Mendeley ceangailte. Úsáid Socruithe > Mendeley (ard): ceangail.\",\n  \"me_enviadas\": \"Seolta chuig Mendeley: {0}. Ar feitheamh: {1}.\",\n  \"me_reconectar\": \" Caithfear Mendeley a cheangal arís ón roghchlár.\",\n  \"me_auto_on\": \"Gníomhachtaíodh an seoladh uathoibríoch chuig Mendeley (gach 6 uair).\",\n  \"me_auto_off\": \"Díghníomhachtaíodh an seoladh uathoibríoch chuig Mendeley ({0}).\"\n};\n}\n"}, {"name": "Idioma_ha", "type": "SERVER_JS", "source": "// PIH Doctorado · textos del idioma \"ha\". Pega este archivo como Idioma_ha.gs.\nfunction textosPIH_ha() {\n  return {\n  \"m_configurar\": \"🎓 Saita kundin karatuna (fara daga nan)\",\n  \"m_actualizar\": \"📊 Sabunta allo da RADAR\",\n  \"m_buscar_base\": \"🔍 Nemo a cikin dukan rumbun bayanai\",\n  \"m_novedades\": \"🔎 Nemo sababbin wallafe-wallafe yanzu\",\n  \"m_clasificar\": \"🤖 Rarraba wallafe-wallafen da ke jiran aiki da AI\",\n  \"m_gestor\": \"📚 Aika wa manajan nassoshina yanzu\",\n  \"m_ris\": \"📤 Fitar da fayil na RIS (EndNote da sauransu)\",\n  \"m_ris_enviar\": \"Aika fayil zuwa imel dina\",\n  \"m_ris_marcar\": \"Yi alama a matsayin an shigar\",\n  \"m_mapa\": \"🗺 Taswirar gibin kundin bincike\",\n  \"m_revisar\": \"🔄 Bincika yanzu\",\n  \"m_autores\": \"Muhimman marubuta\",\n  \"m_fuentes\": \"Tushen farko\",\n  \"m_abiertas\": \"Buɗaɗɗun tushe (na zaɓi)\",\n  \"m_congresos\": \"Ranakun ƙarshe na tarurruka\",\n  \"m_resumen\": \"Taƙaitaccen mako-mako ta imel\",\n  \"m_hist_continuar\": \"Radar na tarihi: ci gaba\",\n  \"m_hist_estado\": \"Radar na tarihi: nuna matsayi\",\n  \"m_ajustes\": \"⚙ Saituna\",\n  \"m_activar_todo\": \"▶ Kunna dukkan sarrafa kai\",\n  \"m_desactivar_todo\": \"⏹ Kashe dukkan sarrafa kai\",\n  \"m_hist_activar\": \"Radar na tarihi na kai-tsaye: kunna\",\n  \"m_hist_desactivar\": \"Radar na tarihi na kai-tsaye: kashe\",\n  \"m_ab_activar\": \"Buɗaɗɗun tushe (na zaɓi): kunna\",\n  \"m_ab_desactivar\": \"Buɗaɗɗun tushe: kashe\",\n  \"m_ab_probar\": \"Buɗaɗɗun tushe: gwada haɗi\",\n  \"m_zo_conectar\": \"Zotero: haɗa (karo na farko kawai)\",\n  \"m_zo_probar\": \"Zotero: gwada haɗi\",\n  \"m_zo_desconectar\": \"Zotero: cire haɗi\",\n  \"m_me_conectar\": \"Mendeley (na ƙwararru): haɗa\",\n  \"m_me_probar\": \"Mendeley: gwada haɗi\",\n  \"m_me_desconectar\": \"Mendeley: cire haɗi\",\n  \"m_repuntuar\": \"Sake ba da maki ga wallafe-wallafen da ke jira da sabon ma’auni\",\n  \"m_diagnostico\": \"Binciken tsarin\",\n  \"m_idioma\": \"🌐 Idioma / Language\",\n  \"m_guia\": \"📖 Jagora mataki-mataki\",\n  \"m_guia_inicio\": \"Matakan farko\",\n  \"m_guia_listo\": \"Bayan saita kundin bincike\",\n  \"m_guia_rapida\": \"❓ Jagora cikin gaggawa\",\n  \"a_buscando\": \"Ana neman sababbin wallafe-wallafe a OpenAlex…\",\n  \"a_nuevos\": \"Sababbin wallafe-wallafe: {0}.\",\n  \"a_nuevos_clasificar\": \" Yi amfani da «Rarraba wallafe-wallafen da ke jiran aiki da AI» don nazarin su.\",\n  \"a_limite_openalex\": \" An kai iyakar kyauta ta OpenAlex: sake gwadawa daga baya.\",\n  \"a_clasificando\": \"Ana rarrabawa da AI (zai iya ɗaukar ƴan mintuna)…\",\n  \"a_fuentes\": \"Ana duba shafukan tushe…\",\n  \"a_autores\": \"Ana duba muhimman marubuta…\",\n  \"a_mapa\": \"Ana ƙididdige taswirar gibi…\",\n  \"a_error_titulo\": \"Ba a kammala aikin ba\",\n  \"a_error_pie\": \"\\n\\nIdan matsalar ta ci gaba, duba shafin LOG.\",\n  \"act_titulo\": \"Kunna dukkan sarrafa kai\",\n  \"act_texto\": \"Za a kunna waɗannan:\\n• Radar na yau da kullum + rarrabawa da AI (kowace rana da kowace awa)\\n• Aikawa ga manajan nassoshin da ka zaɓa (kowace awa 6)\\n• Taƙaitaccen mako-mako ta imel (Litinin)\\n• Tunatarwar ranakun ƙarshe na tarurruka (Litinin)\\n• Duba tushen farko (Lahadi)\\n• Duba muhimman marubuta (Lahadi)\\n\\nRadar na tarihi da buɗaɗɗun tushe (rumbunan kundin bincike) ana kunna su daban daga «Saituna».\\n\\nKa ci gaba?\",\n  \"act_ok\": \"An kunna sarrafa kai\",\n  \"des_titulo\": \"Kashe dukkan sarrafa kai\",\n  \"des_texto\": \"Dukkan ayyukan sarrafa kai za su tsaya (har da radar na tarihi). Canje-canjenka a RADAR za su ci gaba da daidaitawa.\\n\\nKa ci gaba?\",\n  \"des_ok\": \"An kashe sarrafa kai\",\n  \"p_radar\": \"Radar na yau da kullum da rarrabawa\",\n  \"p_gestor\": \"Aikawa ga manajan nassoshi\",\n  \"p_resumen\": \"Taƙaitaccen mako-mako\",\n  \"p_congresos\": \"Ranakun ƙarshe na tarurruka\",\n  \"p_fuentes\": \"Tushen farko\",\n  \"p_autores\": \"Muhimman marubuta\",\n  \"p_abiertas\": \"Buɗaɗɗun tushe\",\n  \"p_historico\": \"Radar na tarihi\",\n  \"guia_titulo\": \"Jagora cikin gaggawa · PIH Doctorado\",\n  \"guia_html\": \"<h3 style='margin: 0 0 8px; color: #24445C;'>Yadda PIH Doctorado naka yake aiki</h3><p><b>0. Farawa:</b> da «Configurar mi tesis» (Saita kundin karatuna): manna taƙaitaccen kundin bincikenka da maɓallanka na kyauta don tsarin ya saita kansa.</p><p><b>1. PANEL (allo)</b> shi ne cikakken kallo: lambobi da zane-zane. Kallo kawai za ka yi.</p><p><b>2. RADAR</b> shi ne tsarin aikinka, an jera shi bisa dacewa (mafi muhimmanci a sama). Launuka suna nuna dacewa, amincewar AI da matsayi.</p><ul style='margin-top: 0;'><li>Canja <b>ESTADO</b> (matsayi) da jerin zaɓi: <b>Pendiente</b> (yana jira, ba a duba ba), <b>Para leer</b> (don karantawa, mai ban sha’awa), <b>Leído</b> (an karanta) ko <b>Descartado</b> (an ƙi).</li><li>Za ka iya gyara <b>RELEVANCIA</b> (dacewa, 0 zuwa 5) da <b>TEMÁTICA</b> (jigo). Ana adana su kai-tsaye.</li></ul><p><b>3. Zotero ko Mendeley:</b> wallafe-wallafen da ka yi wa alama «Para leer» ko «Leído» suna shiga ɗakin karatunka kai-tsaye (tarin «PIH Doctorado»). Karo na farko: Saituna &gt; Zotero: haɗa (Mendeley ya fi buƙatar ilimin fasaha).</p><p><b>4. Kai-tsaye:</b> da <i>Saituna &gt; Kunna dukkan sarrafa kai</i> ana kunna komai a lokaci guda. Idan an kai iyakar kyauta, tsarin yana tsayawa kuma yana ci gaba da kansa daga baya. Komai kyauta ne.</p><p><b>5. Sauran shafuka:</b> MAPA HUECOS (taswirar gibi: sassan kundin bincike masu ƙarancin tushe), AUTORES CLAVE (muhimman marubuta), FUENTES PRIMARIAS (tushen farko) da CONGRESOS (tarurruka) kai ne ke cika su kuma suna faɗakar da kai ta imel. PUBLICACIONES shi ne rumbun bayanai, LOG kuma tarihi ne (idan wani abu ya gaza, dalilin yana can).</p>\",\n  \"tut_label_inicio\": \"Jagora · Matakan farko\",\n  \"tut_label_listo\": \"Jagora · Matakai na gaba\",\n  \"tut_prev\": \"Na baya\",\n  \"tut_next\": \"Na gaba\",\n  \"tut_start\": \"Fara\",\n  \"tut_of\": \"cikin\",\n  \"tut_menu_error\": \"Yi amfani da menu na sama: PIH Doctorado > Saita kundin karatuna.\",\n  \"tut_toast\": \"Don ganin matakan farko, buɗe PIH Doctorado > Jagora mataki-mataki.\",\n  \"tut_toast_titulo\": \"Barka da zuwa\",\n  \"tut_idioma\": \"Harshe\",\n  \"tut_dialogo\": \"PIH Doctorado\",\n  \"tut_inicio\": [\n    {\n      \"titulo\": \"Barka da zuwa PIH Doctorado naka\",\n      \"texto\": \"Wannan tsari ne da ke nemo sababbin wallafe-wallafen da suka shafi kundin bincikenka kowace rana, yana ba su maki daga 0 zuwa 5 da AI, kuma yana jera su a cikin wannan takardar lissafi. Yana aiki da asusun kyauta kuma bayananka suna zama a asusunka na Google.\",\n      \"pista\": \"Wannan jagora yana ɗaukar kusan mintuna 3. Za ka iya sake buɗe shi daga menu.\"\n    },\n    {\n      \"titulo\": \"Yadda yake aiki\",\n      \"texto\": \"1. Ka bayyana kundin bincikenka.\\n2. Tsarin yana neman tushe a OpenAlex, buɗaɗɗen rumbun ayyukan kimiyya.\\n3. AI yana karanta kowane taƙaitaccen bayani ya kwatanta shi da kundin bincikenka.\\n4. Kai ne ke yanke shawarar abin da za ka karanta da abin da za ka aika wa manajan nassoshinka.\",\n      \"pista\": \"Kalmar ƙarshe taka ce koyaushe: za a iya gyara kowane maki.\"\n    },\n    {\n      \"titulo\": \"Abin da ake ƙirƙira a takardar lissafinka\",\n      \"texto\": \"Idan ka saita kundin bincike, waɗannan shafuka suna bayyana:\\n\\nPERFIL (bayanin martaba): kundin bincikenka da bincike-binciken da aka ƙirƙira.\\nRADAR: jerin wallafe-wallafe bisa dacewa. A nan kake aiki.\\nPANEL (allo): cikakken kallo da lambobi da zane-zane.\\nPUBLICACIONES (wallafe-wallafe): dukan rumbun bayanai.\\nLOG: tarihi; idan wani abu ya gaza, dalilin yana nan.\\nDa shafuka marasa komai don cikawa: AUTORES CLAVE (muhimman marubuta), CONGRESOS (tarurruka) da FUENTES PRIMARIAS (tushen farko).\",\n      \"pista\": \"Ba sai ka taɓa komai ba kafin ka saita kundin bincike.\"\n    },\n    {\n      \"titulo\": \"Abin da kake buƙata don farawa\",\n      \"texto\": \"Maɓallai biyu na kyauta, ba tare da kati ba:\\n• Gemini (AI): aistudio.google.com > «Get API key».\\n• OpenAlex (tushe): buɗe asusu a openalex.org ka kwafi maɓallin daga bayanin martabarka.\\n\\nDa taƙaitaccen kundin bincikenka: jimloli 4 ko 5 aƙalla.\",\n      \"pista\": \"Samo su a wani shafin burauza ka dawo.\"\n    },\n    {\n      \"titulo\": \"Izinin Google\",\n      \"texto\": \"Karo na farko Google zai nemi izini ya nuna «manhajar da ba a tabbatar ba». Wannan al’ada ce ga rubutattun shirye-shirye na kai.\\n\\nDanna «Na ƙwararru» sannan «Je zuwa… (ba lafiya)». Lambar taka ce kuma za ka iya karanta ta a Kari > Apps Script.\",\n      \"pista\": \"Tsarin yana taɓa wannan takarda kawai.\"\n    },\n    {\n      \"titulo\": \"Mataki na farko: saita kundin bincike\",\n      \"texto\": \"Danna maɓallin da ke ƙasa ko ka tafi daga menu na sama:\\n\\nPIH Doctorado  >  🎓 Saita kundin karatuna\\n\\nManna taƙaitaccen bayani, kalmomin mabuɗi da maɓallai biyun. Tsarin zai ƙirƙiri bayanin martabarka ya gaya maka abin da za ka yi na gaba.\",\n      \"pista\": \"Idan maɓallin bai amsa ba, yi amfani da menu. Idan menu bai fito ba, sake loda shafin.\",\n      \"accion\": {\n        \"etiqueta\": \"Buɗe «Saita kundin karatuna»\",\n        \"funcion\": \"menuConfigurarTesisPIH\"\n      }\n    }\n  ],\n  \"tut_listo\": [\n    {\n      \"titulo\": \"Bayanin martabarka ya shirya\",\n      \"texto\": \"Tsarin ya ƙirƙiri shafin PERFIL da bincike-binciken, ra’ayoyi da sassan kundin bincikenka. Za a iya gyara akwatunan rawaya: bincike ɗaya a kowane layi.\",\n      \"pista\": \"Tabbatar bincike-binciken sun dace da jigonka.\"\n    },\n    {\n      \"titulo\": \"Menene amfanin kowane shafi\",\n      \"texto\": \"RADAR: tsarin aikinka. Mafi dacewa a sama; kana canja ESTADO (matsayi) kana gyara maki.\\nPANEL: lambobi da zane-zane gaba ɗaya.\\nPUBLICACIONES: dukan rumbun bayanai (ba sai ka gyara ba).\\nMAPA HUECOS: sassan kundin bincike masu ƙarancin tushe.\\nAUTORES CLAVE: marubutan da kake so ka bi.\\nCONGRESOS: ranakun ƙarshe da matsayin shigarka.\\nFUENTES PRIMARIAS: takardun da suka shafi shari’o’inka (rahotanni, ƙa’idoji).\\nBUSQUEDA: sakamakon bincike. LOG: tarihi.\",\n      \"pista\": \"Launukan RADAR suna nuna dacewa, amincewar AI da matsayi.\"\n    },\n    {\n      \"titulo\": \"Mataki na 1 · Nemo sababbin wallafe-wallafe\",\n      \"texto\": \"Menu PIH Doctorado > 🔎 Nemo sababbin wallafe-wallafe yanzu.\\n\\nA cikin minti ɗaya ko biyu sababbin wallafe-wallafe za su bayyana a shafin PUBLICACIONES.\",\n      \"pista\": \"Idan babu abin da ya zo, duba dalili a shafin LOG.\"\n    },\n    {\n      \"titulo\": \"Mataki na 2 · Rarrabawa da AI\",\n      \"texto\": \"Menu PIH Doctorado > 🤖 Rarraba wallafe-wallafen da ke jiran aiki da AI.\\n\\nAI yana karanta kowane taƙaitaccen bayani yana ba da dacewa daga 0 zuwa 5 tare da bayani. Zai iya ɗaukar ƴan mintuna.\",\n      \"pista\": \"Idan Google ya ce «buƙata mai yawa» (kuskure 503), na ɗan lokaci ne: tsarin yana sake gwadawa da kansa.\"\n    },\n    {\n      \"titulo\": \"Mataki na 3 · Tsarin aikinka\",\n      \"texto\": \"A shafin RADAR mafi dacewa suna sama. Launuka suna nuna dacewa (kore mai duhu = 5) da matsayi.\\n\\nCanja ESTADO da jerin zaɓi: Pendiente (yana jira), Para leer (don karantawa), Leído (an karanta) ko Descartado (an ƙi). Gyara maki idan ba ka yarda da shi ba.\",\n      \"pista\": \"Ana adana gyare-gyarenka kai-tsaye.\"\n    },\n    {\n      \"titulo\": \"Mataki na 4 · Bincika ka gano\",\n      \"texto\": \"🔍 Nemo a dukan rumbun bayanai: yana samun kalmomi a cikin taken, taƙaitattun bayanai da abstract.\\n\\n🗺 Taswirar gibi: tana nuna sassan kundin bincike masu ƙarancin tushe.\\n\\nMuhimman marubuta, tarurruka da tushen farko: shafuka ne da kake cikawa da kayanka.\",\n      \"pista\": \"Fara da bincike ɗaya: ranar farko ce mafi amfani.\"\n    },\n    {\n      \"titulo\": \"Mataki na 5 · Manajan nassoshinka\",\n      \"texto\": \"Abin da ka yi wa alama «Para leer» (don karantawa) ko «Leído» (an karanta) zai iya shiga ɗakin karatunka kai-tsaye.\\n\\nZotero: PIH Doctorado > Saituna > Zotero: haɗa (ana buƙatar maɓalli na kyauta).\\nEndNote ko wasu shirye-shirye: 📤 Fitar da fayil na RIS.\",\n      \"pista\": \"Mendeley zaɓi ne na ƙwararru.\"\n    },\n    {\n      \"titulo\": \"Mataki na 6 · Sarrafa kai\",\n      \"texto\": \"Idan komai ya tafi daidai:\\n\\nPIH Doctorado > ⚙ Saituna > ▶ Kunna dukkan sarrafa kai.\\n\\nDaga nan tsarin yana nema, yana rarrabawa kuma yana aiko maka taƙaitaccen mako-mako ta imel da kansa. Ana kunna radar na tarihi (tsofaffin tushe) daban daga Saituna.\",\n      \"pista\": \"Idan wani abu ya gaza, shafin LOG yana bayani. Menu «Jagora mataki-mataki» yana sake buɗe wannan jagora.\"\n    }\n  ],\n  \"w_titulo\": \"Saita kundin karatuna\",\n  \"w_idioma\": \"Harshen mahaɗa\",\n  \"w_intro\": \"Cika abin da ka sani. Idan taƙaitaccen bayani ya fi bayyana, tsarin zai fi aiki da kyau. Ana adana komai a takardarka kaɗai.\",\n  \"w_tema\": \"Take ko jigo\",\n  \"w_disciplina\": \"Fanni\",\n  \"w_disciplina_ej\": \"(misali ilimin zamantakewa, ilimin halittun teku…)\",\n  \"w_resumen\": \"Taƙaitaccen kundin bincike\",\n  \"w_resumen_ej\": \"(manna daga shawararka)\",\n  \"w_claves\": \"Kalmomin mabuɗi\",\n  \"w_claves_ej\": \"(raba da waƙafi)\",\n  \"w_casos\": \"Takamaiman shari’o’in da kake nazari\",\n  \"w_opcional\": \"(na zaɓi)\",\n  \"w_casos_ph\": \"misali: wani nau’i, cibiya, yanki, shiri, kamfani…\",\n  \"w_casos_ayuda\": \"Idan kundin bincikenka yana kwatantawa ko nazarin takamaiman shari’o’i, rubuta su a nan (raba da waƙafi). Bar shi babu komai idan na ra’ayi ne kawai.\",\n  \"w_idioma_local\": \"Harshen neman na gida\",\n  \"w_idioma_local_ej\": \"(ban da Ingilishi)\",\n  \"w_idioma_local_valor\": \"Hausa\",\n  \"w_gestor\": \"Manajan nassoshi\",\n  \"w_gestor_ninguno\": \"Babu\",\n  \"w_gemini\": \"Maɓallin Gemini\",\n  \"w_gemini_ej\": \"(kyauta, a aistudio.google.com)\",\n  \"w_openalex\": \"Maɓallin OpenAlex\",\n  \"w_openalex_ej\": \"(kyauta, a openalex.org)\",\n  \"w_guardar\": \"Ajiye kuma ƙirƙiri bayanin martabata\",\n  \"w_generando\": \"AI yana ƙirƙirar bayanin martabarka… zai iya ɗaukar minti ɗaya.\",\n  \"w_siguientes\": \"Duba matakai na gaba\",\n  \"w_error_corto\": \"Rubuta taƙaitaccen bayani na jimloli 3–4 aƙalla ko wasu kalmomin mabuɗi.\",\n  \"w_error_gemini\": \"Babu maɓallin Gemini. Kyauta ne: aistudio.google.com.\",\n  \"w_listo\": \"An gama. Duba shafin PERFIL (gyara abin da kake so) sannan ka danna «Kunna dukkan sarrafa kai».\",\n  \"w_error_ia\": \"AI bai dawo da «{0}» ba. Sake danna «Ajiye» (wani lokaci yana gazawa karo na farko).\",\
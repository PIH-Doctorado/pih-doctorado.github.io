me": "Idioma_zh", "type": "SERVER_JS", "source": "// PIH Doctorado · textos del idioma \"zh\". Pega este archivo como Idioma_zh.gs.\nfunction textosPIH_zh() {\n  return {\n  \"m_configurar\": \"🎓 设置我的论文（从这里开始）\",\n  \"m_actualizar\": \"📊 刷新面板和 RADAR\",\n  \"m_buscar_base\": \"🔍 在整个数据库中搜索\",\n  \"m_novedades\": \"🔎 立即搜索新文献\",\n  \"m_clasificar\": \"🤖 用 AI 对待处理文献分类\",\n  \"m_gestor\": \"📚 立即发送到我的文献管理器\",\n  \"m_ris\": \"📤 导出 RIS 文件（EndNote 等）\",\n  \"m_ris_enviar\": \"把文件发送到我的邮箱\",\n  \"m_ris_marcar\": \"标记为已导入\",\n  \"m_mapa\": \"🗺 论文空白图\",\n  \"m_revisar\": \"🔄 立即检查\",\n  \"m_autores\": \"关键作者\",\n  \"m_fuentes\": \"一手资料来源\",\n  \"m_abiertas\": \"开放来源（可选）\",\n  \"m_congresos\": \"会议截止日期\",\n  \"m_resumen\": \"每周邮件摘要\",\n  \"m_hist_continuar\": \"历史雷达：继续\",\n  \"m_hist_estado\": \"历史雷达：显示状态\",\n  \"m_ajustes\": \"⚙ 设置\",\n  \"m_activar_todo\": \"▶ 启用全部自动化\",\n  \"m_desactivar_todo\": \"⏹ 停用全部自动化\",\n  \"m_hist_activar\": \"自动历史雷达：启用\",\n  \"m_hist_desactivar\": \"自动历史雷达：停用\",\n  \"m_ab_activar\": \"开放来源（可选）：启用\",\n  \"m_ab_desactivar\": \"开放来源：停用\",\n  \"m_ab_probar\": \"开放来源：测试连接\",\n  \"m_zo_conectar\": \"Zotero：连接（仅首次）\",\n  \"m_zo_probar\": \"Zotero：测试连接\",\n  \"m_zo_desconectar\": \"Zotero：断开连接\",\n  \"m_me_conectar\": \"Mendeley（高级）：连接\",\n  \"m_me_probar\": \"Mendeley：测试连接\",\n  \"m_me_desconectar\": \"Mendeley：断开连接\",\n  \"m_repuntuar\": \"按新标准重新评分待处理文献\",\n  \"m_diagnostico\": \"系统诊断\",\n  \"m_idioma\": \"🌐 Idioma / Language\",\n  \"m_guia\": \"📖 分步指南\",\n  \"m_guia_inicio\": \"最初的步骤\",\n  \"m_guia_listo\": \"设置论文之后\",\n  \"m_guia_rapida\": \"❓ 快速指南\",\n  \"a_buscando\": \"正在 OpenAlex 中搜索新文献…\",\n  \"a_nuevos\": \"新文献：{0}。\",\n  \"a_nuevos_clasificar\": \" 使用“用 AI 对待处理文献分类”来分析它们。\",\n  \"a_limite_openalex\": \" 已达到 OpenAlex 的免费额度：请稍后再试。\",\n  \"a_clasificando\": \"正在用 AI 分类（可能需要几分钟）…\",\n  \"a_fuentes\": \"正在检查来源页面…\",\n  \"a_autores\": \"正在检查关键作者…\",\n  \"a_mapa\": \"正在计算空白图…\",\n  \"a_error_titulo\": \"无法完成该操作\",\n  \"a_error_pie\": \"\\n\\n如果问题持续，请查看 LOG 标签页。\",\n  \"act_titulo\": \"启用全部自动化\",\n  \"act_texto\": \"将启用以下功能：\\n• 每日雷达 + AI 分类（每天和每小时）\\n• 发送到所选文献管理器（每 6 小时）\\n• 每周邮件摘要（周一）\\n• 会议截止日期提醒（周一）\\n• 检查一手资料来源（周日）\\n• 检查关键作者（周日）\\n\\n历史雷达和开放来源（论文库）需在“设置”中单独启用。\\n\\n是否继续？\",\n  \"act_ok\": \"自动化已启用\",\n  \"des_titulo\": \"停用全部自动化\",\n  \"des_texto\": \"所有自动任务都将停止（包括历史雷达）。你在 RADAR 中的修改仍会继续同步。\\n\\n是否继续？\",\n  \"des_ok\": \"自动化已停用\",\n  \"p_radar\": \"每日雷达和分类\",\n  \"p_gestor\": \"发送到文献管理器\",\n  \"p_resumen\": \"每周摘要\",\n  \"p_congresos\": \"会议截止日期\",\n  \"p_fuentes\": \"一手资料来源\",\n  \"p_autores\": \"关键作者\",\n  \"p_abiertas\": \"开放来源\",\n  \"p_historico\": \"历史雷达\",\n  \"guia_titulo\": \"快速指南 · PIH Doctorado\",\n  \"guia_html\": \"<h3 style='margin: 0 0 8px; color: #24445C;'>你的 PIH Doctorado 如何运作</h3><p><b>0. 开始</b>：使用“Configurar mi tesis”（设置我的论文）：粘贴论文摘要和你的免费密钥，系统会自动完成配置。</p><p><b>1. PANEL（面板）</b>是总览：数字和图表，只需查看。</p><p><b>2. RADAR</b>是你的工作计划，按相关度排序（最重要的在最上面）。颜色显示相关度、AI 的把握程度和状态。</p><ul style='margin-top: 0;'><li>用下拉列表修改 <b>ESTADO</b>（状态）：<b>Pendiente</b>（待处理，未看）、<b>Para leer</b>（待阅读，感兴趣）、<b>Leído</b>（已读）或 <b>Descartado</b>（已舍弃）。</li><li>可以修正 <b>RELEVANCIA</b>（相关度，0 到 5）和 <b>TEMÁTICA</b>（主题），修改会自动保存。</li></ul><p><b>3. Zotero 或 Mendeley：</b>你标记为“Para leer”或“Leído”的文献会自动进入你的文献库（集合“PIH Doctorado”）。首次使用：设置 &gt; Zotero：连接（Mendeley 技术要求更高）。</p><p><b>4. 自动化：</b>使用 <i>设置 &gt; 启用全部自动化</i> 一次打开所有功能。达到免费额度时系统会暂停，之后自动继续。一切免费。</p><p><b>5. 其他标签页：</b>MAPA HUECOS（空白图：论文中哪些部分文献较少）、AUTORES CLAVE（关键作者）、FUENTES PRIMARIAS（一手资料来源）和 CONGRESOS（会议）需要你填写，并会通过邮件提醒你。PUBLICACIONES 是数据库，LOG 是历史记录（出错时原因在这里）。</p>\",\n  \"tut_label_inicio\": \"指南 · 最初的步骤\",\n  \"tut_label_listo\": \"指南 · 接下来的步骤\",\n  \"tut_prev\": \"上一步\",\n  \"tut_next\": \"下一步\",\n  \"tut_start\": \"开始\",\n  \"tut_of\": \"/\",\n  \"tut_menu_error\": \"请使用顶部菜单：PIH Doctorado > 设置我的论文。\",\n  \"tut_toast\": \"打开 PIH Doctorado > 分步指南，查看最初的步骤。\",\n  \"tut_toast_titulo\": \"欢迎\",\n  \"tut_idioma\": \"语言\",\n  \"tut_dialogo\": \"PIH Doctorado\",\n  \"tut_inicio\": [\n    {\n      \"titulo\": \"欢迎使用你的 PIH Doctorado\",\n      \"texto\": \"这是一个每天为你的论文搜索新文献、用 AI 按 0 到 5 评分，并按顺序放入本表格的系统。它使用免费账户，你的数据保存在你自己的 Google 账户中。\",\n      \"pista\": \"本指南约需 3 分钟，之后可从菜单重新打开。\"\n    },\n    {\n      \"titulo\": \"它如何运作\",\n      \"texto\": \"1. 你描述自己的论文。\\n2. 系统在 OpenAlex（开放的学术成果数据库）中搜索文献。\\n3. AI 阅读每篇摘要，并对照你的论文打分。\\n4. 由你决定读什么，并发送到文献管理器。\",\n      \"pista\": \"最终决定权始终在你：每个评分你都可以修正。\"\n    },\n    {\n      \"titulo\": \"你的表格里会创建什么\",\n      \"texto\": \"设置论文后，会出现这些标签页：\\n\\nPERFIL（档案）：你的论文和生成的搜索式。\\nRADAR：按相关度排序的文献列表，你在这里工作。\\nPANEL（面板）：数字和图表总览。\\nPUBLICACIONES（文献）：完整数据库。\\nLOG：历史记录；出错时原因在这里。\\n另有待你填写的空白标签页：AUTORES CLAVE（关键作者）、CONGRESOS（会议）和 FUENTES PRIMARIAS（一手资料来源）。\",\n      \"pista\": \"设置之前无需改动任何内容。\"\n    },\n    {\n      \"titulo\": \"开始前你需要什么\",\n      \"texto\": \"两个免费密钥，无需银行卡：\\n• Gemini（AI）：aistudio.google.com > “Get API key”。\\n• OpenAlex（文献）：在 openalex.org 创建账户，并从你的个人资料中复制密钥。\\n\\n还有论文摘要：至少 4 到 5 句话。\",\n      \"pista\": \"现在在另一个浏览器标签页中获取，然后回到这里。\"\n    },\n    {\n      \"titulo\": \"Google 权限\",\n      \"texto\": \"首次使用时，Google 会请求权限并显示“未经验证的应用”。对个人脚本来说这是正常的。\\n\\n点击“高级”，然后点击“前往…（不安全）”。代码属于你，可在 扩展程序 > Apps Script 中查看。\",\n      \"pista\": \"系统只会访问这份文档。\"\n    },\n    {\n      \"titulo\": \"第一步：设置论文\",\n      \"texto\": \"点击下方按钮或使用顶部菜单：\\n\\nPIH Doctorado  >  🎓 设置我的论文\\n\\n粘贴摘要、关键词和两个密钥。系统会创建你的档案，并告诉你接下来做什么。\",\n      \"pista\": \"如果按钮没有反应，请使用菜单。如果菜单没有出现，请刷新页面。\",\n      \"accion\": {\n        \"etiqueta\": \"打开“设置我的论文”\",\n        \"funcion\": \"menuConfigurarTesisPIH\"\n      }\n    }\n  ],\n  \"tut_listo\": [\n    {\n      \"titulo\": \"你的档案已就绪\",\n      \"texto\": \"系统已创建 PERFIL 标签页，其中包含你的论文的搜索式、概念和板块。黄色单元格可编辑：每行一个搜索式。\",\n      \"pista\": \"请检查这些搜索式是否适合你的主题。\"\n    },\n    {\n      \"titulo\": \"每个标签页的作用\",\n      \"texto\": \"RADAR：你的工作计划。最相关的在最上面；你修改 ESTADO（状态）并修正评分。\\nPANEL：整体的数字和图表。\\nPUBLICACIONES：完整数据库（无需编辑）。\\nMAPA HUECOS：论文中哪些部分文献较少。\\nAUTORES CLAVE：你想关注的作者。\\nCONGRESOS：会议截止日期和投稿状态。\\nFUENTES PRIMARIAS：与案例相关的文件（报告、法规）。\\nBUSQUEDA：搜索结果。LOG：历史记录。\",\n      \"pista\": \"RADAR 中的颜色显示相关度、AI 的把握程度和状态。\"\n    },\n    {\n      \"titulo\": \"第 1 步 · 搜索新文献\",\n      \"texto\": \"菜单 PIH Doctorado > 🔎 立即搜索新文献。\\n\\n一两分钟内，新文献就会出现在 PUBLICACIONES 标签页。\",\n      \"pista\": \"如果没有出现，请在 LOG 标签页查看原因。\"\n    },\n    {\n      \"titulo\": \"第 2 步 · 用 AI 分类\",\n      \"texto\": \"菜单 PIH Doctorado > 🤖 用 AI 对待处理文献分类。\\n\\nAI 阅读每篇摘要，给出 0 到 5 的相关度并附说明。可能需要几分钟。\",\n      \"pista\": \"如果 Google 提示“需求量大”（错误 503），这是暂时的：系统会自动重试。\"\n    },\n    {\n      \"titulo\": \"第 3 步 · 你的工作计划\",\n      \"texto\": \"在 RADAR 标签页中，最相关的文献在最上面。颜色显示相关度（深绿 = 5）和状态。\\n\\n用下拉列表修改 ESTADO：Pendiente（待处理）、Para leer（待阅读）、Leído（已读）或 Descartado（已舍弃）。如果不同意某个评分，请修正它。\",\n      \"pista\": \"你的修改会自动保存。\"\n    },\n    {\n      \"titulo\": \"第 4 步 · 搜索与探索\",\n      \"texto\": \"🔍 在整个数据库中搜索：在标题、摘要和 abstract 中查找词语。\\n\\n🗺 空白图：显示论文中哪些部分文献较少。\\n\\n关键作者、会议和一手资料来源：你用自己的材料填写的标签页。\",\n      \"pista\": \"先试试搜索：第一天这最有用。\"\n    },\n    {\n      \"titulo\": \"第 5 步 · 你的文献管理器\",\n      \"texto\": \"你标记为“Para leer”（待阅读）或“Leído”（已读）的文献可以自动进入你的文献库。\\n\\nZotero：PIH Doctorado > 设置 > Zotero：连接（需要一个免费密钥）。\\nEndNote 或其他：📤 导出 RIS 文件。\",\n      \"pista\": \"Mendeley 是高级选项。\"\n    },\n    {\n      \"titulo\": \"第 6 步 · 自动化\",\n      \"texto\": \"如果一切满意：\\n\\nPIH Doctorado > ⚙ 设置 > ▶ 启用全部自动化。\\n\\n此后系统会自动搜索、分类，并每周给你发送邮件摘要。历史雷达（早期文献）在“设置”中单独启用。\",\n      \"pista\": \"如果出错，LOG 标签页会说明原因。菜单“分步指南”可重新打开本指南。\"\n    }\n  ],\n  \"w_titulo\": \"设置我的论文\",\n  \"w_idioma\": \"界面语言\",\n  \"w_intro\": \"填写你所知道的信息。摘要越具体，效果越好。所有内容只保存在你自己的文档中。\",\n  \"w_tema\": \"题目或主题\",\n  \"w_disciplina\": \"学科\",\n  \"w_disciplina_ej\": \"（例如：社会学、海洋生物学…）\",\n  \"w_resumen\": \"论文摘要\",\n  \"w_resumen_ej\": \"（从你的项目中粘贴）\",\n  \"w_claves\": \"关键词\",\n  \"w_claves_ej\": \"（用逗号分隔）\",\n  \"w_casos\": \"你研究的具体案例\",\n  \"w_opcional\": \"（可选）\",\n  \"w_casos_ph\": \"例如：某个物种、机构、地区、项目、公司…\",\n  \"w_casos_ayuda\": \"如果你的论文比较或分析具体案例，请在此列出（用逗号分隔）。如果是纯理论研究，请留空。\",\n  \"w_idioma_local\": \"本地搜索语言\",\n  \"w_idioma_local_ej\": \"（除英语外）\",\n
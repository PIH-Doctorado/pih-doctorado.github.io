arch in\",\n    bq_todo: \"Everything (includes the original abstract)\",\n    bq_rapido: \"Title, summary, topic and authors\",\n    bq_minima: \"Minimum relevance\",\n    bq_cualquiera: \"Any\",\n    bq_n_o_mas: \"{0} or more\",\n    bq_solo5: \"Only 5\",\n    bq_estado: \"Status\",\n    bq_boton: \"Search\",\n    bq_buscando: \"Searching…\",\n    bq_err_vacio: \"Type at least one word (minimum 2 letters).\",\n    bq_err_sin_pub: \"There are no publications to search yet.\",\n    bq_sin_resultados: \"No results. Try fewer words or “Any of the words”.\",\n    bq_resultados: \"{0} result(s)\",\n    bq_mostrados: \" (showing the best {0})\",\n    bq_mira: \". See the BUSQUEDA tab.\",\n    bq_h_busqueda: \"Search: {0}\",\n    bq_h_resultados: \"{0} result(s). Click the title to open the publication.\",\n    bq_cab: [\"PUBLICATION\", \"MATCHES IN\", \"RELEVANCE\", \"STATUS\", \"YEAR\", \"AUTHORS\", \"SUMMARY\"],\n    bq_f_TITULO: \"title\",\n    bq_f_TEMATICA_PRINCIPAL: \"topic\",\n    bq_f_TEMATICAS_SECUNDARIAS: \"topics\",\n    bq_f_RESUMEN_IA: \"AI summary\",\n    bq_f_JUSTIFICACION_RELEVANCIA: \"justification\",\n    bq_f_AUTORES: \"authors\",\n    bq_f_REVISTA_EDITORIAL: \"journal\",\n    bq_f_ABSTRACT_ORIGINAL: \"abstract\",\n\n    // ---- Zotero ----\n    zo_dialogo: \"Connect to Zotero\",\n    zo_intro: 'Create your key at <b>zotero.org/settings/keys</b> (button “Create new private key”). Tick <b>Allow library access</b> and <b>Allow write access</b>, save, and copy the key here:',\n    zo_conectar: \"Connect\",\n    zo_comprobando: \"Checking…\",\n    zo_err_pegar: \"Paste the Zotero key.\",\n    zo_err_clave: \"Zotero does not recognise that key (HTTP {0}). Copy it again.\",\n    zo_err_acceso: \"The key has no access to your library. Create another one ticking “Allow library access”.\",\n    zo_err_escritura: \"The key does not allow writing. Create another one ticking “Allow write access”.\",\n    zo_conectado: \"Connected to Zotero. You can now use “Send to my reference manager now”.\",\n    zo_desconectado: \"Zotero disconnected. You can delete the key at zotero.org.\",\n    zo_funciona: \"The connection works.\",\n    zo_no_conectado: \"Zotero is not connected. Use Settings > Zotero: connect.\",\n    zo_err_coleccion: \"Zotero did not return the collection it created.\",\n    zo_ocupado: \"Another process is running. Try again in a few minutes.\",\n    zo_no_hoja: \"The PUBLICACIONES tab does not exist.\",\n    zo_nada: \"There are no publications to send. Change the ESTADO in RADAR to Para leer or Leído.\",\n    zo_enviadas: \"Sent to Zotero: {0}. Pending: {1}.\",\n    zo_reconectar: \" Reconnect Zotero from Settings.\",\n    zo_limite: \" Usage limit reached: it will resume later.\",\n    zo_temporal: \" Temporary error: it will retry.\",\n    zo_errores: \" There were errors: check the LOG tab.\",\n    zo_auto_on: \"Automatic sending to Zotero turned on (every 6 hours).\",\n    zo_auto_off: \"Automatic sending to Zotero turned off ({0}).\",\n    zo_sin_gestor: \"You chose not to use a reference manager. You can change it in the PERFIL tab (row gestor_referencias).\",\n\n    // ---- Common ----\n    c_ocupado: \"Another process is running. Try again in a few minutes.\",\n    c_no_hoja_pub: \"The PUBLICACIONES tab does not exist.\",\n    c_falta_openalex: \"The OpenAlex key is missing. Use “Set up my thesis” to add it.\",\n    c_falta_tesis: \"The thesis is not set up. Use PIH Doctorado > “Set up my thesis”.\",\n    c_activadores: \"{0} trigger(s)\",\n\n    // ---- Classifier ----\n    ig_vacio: \"There are no publications waiting to be classified.\",\n    ig_resultado: \"Classified: {0}. Pending: {1}.\",\n    ig_actualizar: \" Use “Refresh dashboard and RADAR” to see the changes.\",\n    ig_cuota: \" Free limit reached: it will resume later.\",\n    ig_transitorio: \" Temporary Gemini error: it will retry.\",\n    ig_config: \" Configuration error: check the LOG tab.\",\n    ig_errores: \" There were errors: check the LOG tab.\",\n    ig_sin_gemini: \"The Gemini key is missing. Use “Set up my thesis” to add it.\",\n    ig_recal_titulo: \"Re-score\",\n    ig_recal_texto: \"Publications with status “Pendiente” (pending) or no status will be scored again with AI. Those marked Para leer (to read), Leído (read) or Descartado (discarded) are not touched.\\n\\nIf you had manually corrected the relevance of a publication that is still Pendiente, it will be recalculated.\\n\\nContinue?\",\n    ig_recal_nada: \"There are no publications to re-score.\",\n    ig_recal_sin_pend: \"There are no pending publications with a score.\",\n    ig_recal_listas: \"{0} publications ready to be re-scored. Now use “Classify pending items with AI” (or wait for the automation).\",\n\n    // ---- Daily radar ----\n    ra_auto_on: \"Automation turned on: daily radar and periodic classification.\",\n    ra_auto_off: \"Automation turned off ({0}).\",\n\n    // ---- Dashboard and RADAR ----\n    ui_no_hoja: \"The PUBLICACIONES sheet cannot be found.\",\n    ui_actualizado: \"RADAR and PANEL updated ({0} publications in RADAR).\",\n    ui_valor_invalido: \"Invalid value in {0} cell(s): the previous one has been restored.\",\n    ui_sin_identificar: \"The publication could not be identified in {0} row(s). Run crearInterfazDoctorado().\",\n    ui_sync_on: \"Automatic sync turned on.\",\n\n    // ---- Gap map ----\n    mh_sin_pub: \"There are no publications in PUBLICACIONES.\",\n    mh_actualizado: \"Gap map updated ({0} publications scored, {1} not scored yet).\",\n\n    // ---- RIS export ----\n    ris_sin_pub: \"There are no publications.\",\n    ris_sin_confirmar: \"There are no exported publications waiting to be confirmed.\",\n    ris_marcadas: \"{0} publication(s) marked as added to your manager.\",\n    ris_nada_exportar: \"There are no publications to export.\",\n    ris_nada_estado: \"There are no publications to export. In RADAR, change the ESTADO to Para leer (to read) or Leído (read) on the ones 
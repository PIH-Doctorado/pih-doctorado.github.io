\", \"TITULO\", \"AUTORES\", \"AÑO\", \"FECHA_PUBLICACION\",\n  \"REVISTA_EDITORIAL\", \"TIPO_DOCUMENTO\", \"IDIOMA\", \"FUENTE\", \"URL\",\n  \"ABSTRACT_ORIGINAL\", \"RESUMEN_IA\", \"TEMATICA_PRINCIPAL\",\n  \"TEMATICAS_SECUNDARIAS\", \"RELEVANCIA_0_5\", \"JUSTIFICACION_RELEVANCIA\",\n  \"VINCULO_TESIS\", \"ESTADO_LECTURA\", \"FECHA_DETECCION\", \"FECHA_REVISION\",\n  \"INCORPORADO_MENDELEY\", \"NIVEL_ANALISIS_IA\", \"CONFIANZA_ANALISIS\",\n  \"ORIGEN\", \"EXPORTADO_MENDELEY\", \"MENDELEY_ID_DOCUMENTO\",\n  \"FECHA\", \"PROCESO\", \"RESULTADO\", \"REGISTROS_NUEVOS\", \"ERRORES\", \"DETALLES\",\n  \"AUTOR\", \"CANDIDATO_OPENALEX\", \"ID_OPENALEX\", \"CONFIRMADO\",\n  \"OBRAS_AÑADIDAS\", \"ULTIMA_REVISION\", \"OTROS_CANDIDATOS\", \"NOTAS\",\n  \"NOMBRE\", \"ORGANIZADOR\", \"FECHA_INICIO\", \"FECHA_FIN\", \"LUGAR_MODALIDAD\",\n  \"TEMATICA\", \"FECHA_LIMITE\", \"ESTADO\", \"ENLACE\", \"PRIORIDAD\",\n  \"INSTITUCION\", \"TIPO\", \"DOCUMENTO\", \"COMPROBACION\", \"EJE_TESIS\", \"VIGILAR\",\n  \"ENLACES_PDF_CONOCIDOS\", \"ULTIMO_CAMBIO\",\n  \"EJE DE LA TESIS\", \"REFERENCIAS RELEVANTES (3-5)\", \"DE RELEVANCIA 4-5\",\n  \"PARA LEER O LEÍDAS\", \"MEJORES REFERENCIAS\", \"BÚSQUEDA SUGERIDA\",\n  \"DÓNDE ENCAJA\"\n];\n\n// Pestañas cuyas cabeceras reciben nota explicativa.\nconst PIH_GUIA_HOJAS_NOTAS = [\n  \"PUBLICACIONES\", \"LOG\", \"AUTORES CLAVE\", \"CONGRESOS\",\n  \"FUENTES PRIMARIAS\", \"MAPA HUECOS\"\n];\n\n// Texto del glosario en el idioma activo (si falta: inglés, después español).\nfunction gPIH_(clave) {\n  const c = idiomaPIH_();\n  const t = PIH_GLOSARIOS[c];\n  if (t && t[clave] !== undefined) return t[clave];\n  if (PIH_GLOSARIOS.en && PIH_GLOSARIOS.en[clave] !== undefined) {\n    return PIH_GLOSARIOS.en[clave];\n  }\n  if (PIH_GLOSARIOS.es && PIH_GLOSARIOS.es[clave] !== undefined) {\n    return PIH_GLOSARIOS.es[clave];\n  }\n  return clave;\n}\n\n// Crea o actualiza la pestaña «❓ HELP» y las notas de RADAR.\n// Si silencioso es true, no muestra aviso.\nfunction crearGuiaHojasPIH(silencioso) {\n\n  const ss = SpreadsheetApp.getActiveSpreadsheet();\n\n  let hoja = ss.getSheetByName(PIH_AYUDA_HOJA);\n  if (!hoja) hoja = ss.insertSheet(PIH_AYUDA_HOJA);\n\n  hoja.clear();\n\n  const rtl = PIH_IDIOMAS_RTL.indexOf(idiomaPIH_()) > -1;\n  hoja.setRightToLeft(rtl);\n\n  const filas = [];\n  const tipos = [];   // 1 = título, 2 = cabecera, 0 = texto\n\n  filas.push([gPIH_(\"gl_titulo\"), \"\"]); tipos.push(1);\n  filas.push([gPIH_(\"gl_intro\"), \"\"]); tipos.push(0);\n  filas.push([\"\", \"\"]); tipos.push(0);\n  filas.push([gPIH_(\"gl_h_hoja\"), gPIH_(\"gl_h_sig\")]); tipos.push(2);\n\n  PIH_GUIA_PESTANAS.forEach(nombre => {\n    filas.push([nombre, gPIH_(\"gl_t_\" + nombre)]);\n    tipos.push(0);\n  });\n\n  filas.push([\"\", \"\"]); tipos.push(0);\n  filas.push([gPIH_(\"gl_h_radar\"), \"\"]); tipos.push(2);\n\n  PIH_RADAR_CONFIG.columnas.forEach((nombre, i) => {\n    if (i >= PIH_RADAR_CONFIG.numeroColumnasVisibles) return;\n    filas.push([nombre, gPIH_(\"gl_c_\" + (i + 1))]);\n    tipos.push(0);\n  });\n\n  filas.push([\"\", \"\"]); tipos.push(0);\n  filas.push([gPIH_(\"gl_h_estados\"), \"\"]); tipos.push(2);\n\n  [\n    [\"Pendiente\", \"st_pendiente\"],\n    [\"Para leer\", \"st_paraleer\"],\n    [\"Leído\", \"st_leido\"],\n    [\"Descartado\", \"st_descartado\"]\n  ].forEach(par => {\n    filas.push([par[0], tPIH_(par[1])]);\n    tipos.push(0);\n  });\n\n  hoja.getRange(1, 1, filas.length, 2).setValues(filas);\n\n  hoja.setColumnWidth(1, 200);\n  hoja.setColumnWidth(2, 640);\n\n  hoja.getRange(1, 1, filas.length, 2)\n    .setWrap(true)\n    .setVerticalAlignment(\"top\")\n    .setFontFamily(\"Arial\");\n\n  tipos.forEach((tipo, i) => {\n    const fila = hoja.getRange(i + 1, 1, 1, 2);\n    if (tipo === 1) {\n      fila.setFontSize(14).setFontWeight(\"bold\");\n    } else if (tipo === 2) {\n      fila.setFontWeight(\"bold\")\n        .setBackground(\"#24445C\")\n        .setFontColor(\"#FFFFFF\");\n    } else if (filas[i][0]) {\n      hoja.getRange(i + 1, 1).setFontWeight(\"bold\");\n    }\n  });\n\n  // La introducción ocupa las dos columnas.\n  hoja.getRange(2, 1, 1, 2).merge();\n  hoja.getRange(1, 1, 1, 2).merge();\n\n  hoja.setFrozenRows(0);\n\n  // Notas en las cabeceras de RADAR.\n  const radar = ss.getSheetByName(PIH_RADAR_CONFIG.hojaRadar);\n\n  if (radar) {\n    PIH_RADAR_CONFIG.columnas.forEach((nombre, i) => {\n      if (i >= PIH_RADAR_CONFIG.numeroColumnasVisibles) return;\n      radar.getRange(1, i + 1).setNote(gPIH_(\"gl_c_\" + (i + 1)));\n    });\n  }\n\n  PIH_GUIA_HOJAS_NOTAS.forEach(nombre => {\n    ponerNotasCabecerasPIH_(ss.getSheetByName(nombre));\n  });\n\n  aplicarPanelIdiomaPIH_(ss.getSheetByName(PIH_RADAR_CONFIG.hojaPanel));\n\n  if (!silencioso) {\n    ss.toast(gPIH_(\"gl_hecho\"), \"PIH Doctorado\", 6);\n  }\n}\n\n\n// Nota de la cabecera PRECIO_INSCRIPCION (CONGRESOS) en cada idioma.\nconst PIH_GLOSA_PRECIO = {\n  \"es\": \"Precio de inscripción (de asistir o presentar), si se conoce.\",\n  \"en\": \"Registration fee (to attend or present), if known.\",\n  \"ca\": \"Preu d'inscripció (per assistir o presentar), si es coneix.\",\n  \"eu\": \"Izen-emateko prezioa (parte hartzeko edo aurkezteko), ezagutzen bada.\",\n  \"gl\": \"Prezo de inscrición (para asistir ou presentar), se se coñece.\",\n  \"fr\": \"Frais d'inscription (pour assister ou présenter), s'ils sont connus.\",\n  \"it\": \"Quota di iscrizione (per partecipare o presentare), se nota.\",\n  \"pt\": \"Preço de inscrição (para assistir ou apresentar), se conhecido.\",\n  \"de\": \"Teilnahmegebühr (zum Besuch oder Vortrag), falls bekannt.\",\n  \"nl\": \"Inschrijfgeld (om bij te wonen of te presenteren), indien bekend.\",\n  \"nlbe\": \"Inschrijfgeld (om bij te wonen of te presenteren), indien bekend.\",\n  \"sv\": \"Anmälningsavgift (för att delta eller presentera), om den är känd.\",\n  \"da\": \"Tilmeldingsgebyr (for at deltage eller præsentere), hvis kendt.\",\n  \"no\": \"Påmeldingsavgift (for å delta eller presentere), hvis kjent.\",\n  \"fi\": \"Ilmoittautumismaksu (osallistumiseen tai esitelmöintiin), jos tiedossa.\",\n  \"is\": \"Skráningargjald (til að mæta eða flytja erindi), ef það er þekkt.\",\n  \"lt\": \"Registracijos mokestis (dalyvauti ar pristatyti), jei žinomas.\",\n  \"lv\": \"Reģistrācijas maksa (lai apmeklētu vai prezentētu), ja zināma.\",\n  \"et\": \"Registreerimistasu (osalemiseks või ettekandeks), kui teada.\",\n  \"cs\": \"Registrační poplatek (za účast nebo prezentaci), je-li znám.\",\n  \"pl\": \"Opłata rejestracyjna (za udział lub wystąpienie), jeśli jest znana.\",\n  \"ru\": \"Регистрационный взнос (для участия или доклада), если известен.\",\n  \"uk\": \"Реєстраційний внесок (для участі або доповіді), якщо відомий.\",\n  \"sr\": \"Котизација (за присуство или излагање), ако је позната.\",\n  \"bs\": \"Kotizacija (za prisustvo ili izlaganje), ako je poznata.\",\n  \"hr\": \"Kotizacija (za sudjelovanje ili izlaganje), ako je poznata.\",\n  \"bg\": \"Такса за участие (за присъствие или представяне), ако е известна.\",\n  \"sl\": \"Kotizacija (za udeležbo ali predstavitev), če je znana.\",\n  \"sq\": \"Tarifa e regjistrimit (për të ndjekur ose paraqitur), nëse dihet.\",\n  \"el\": \"Δικαίωμα συμμετοχής (για παρακολούθηση ή παρουσίαση), αν είναι γνωστό.\",\n  \"tr\": \"Kayıt ücreti (katılmak veya sunum yapmak için), biliniyorsa.\",\n  \"hu\": \"Regisztrációs díj (részvételhez vagy előadáshoz), ha ismert.\",\n  \"zh\": \"报名费（参加或发表所需），如已知。\",\n  \"ja\": \"参加費（参加または発表のための登録料）。わかる場合のみ。\",\n  \"ko\": \"등록비(참석 또는 발표용), 알고 있는 경우.\",\n  \"th\": \"ค่าลงทะเบียน (สำหรับเข้าร่วมหรือนำเสนอ) หากทราบ\",\n  \"vi\": \"Phí đăng ký (để tham dự hoặc trình bày), nếu biết.\",\n  \"id\": \"Biaya pendaftaran (untuk hadir atau mempresentasikan), jika diketahui.\",\n  \"hi\": \"पंजीकरण शुल्क (उपस्थित होने या प्रस्तुत करने के लिए), यदि ज्ञात हो।\",\n  \"mn\": \"Бүртгэлийн хураамж (оролцох эсвэл илтгэх), мэдэгдэж байвал.\",\n  \"ar\": \"رسوم التسجيل (للحضور أو التقديم)، إن كانت معروفة.\",\n  \"fa\": \"هزینهٔ ثبت‌نام (برای حضور یا ارائه)، در صورت اطلاع.\",\n  \"ur\": \"رجسٹریشن فیس (شرکت یا پیشکش کے لیے)، اگر معلوم ہو۔\",\n  \"ga\": \"Táille chlárúcháin (le freastal nó le cur i láthair), má tá sí ar eolas.\",\n  \"sw\": \"Ada ya usajili (kuhudhuria au kuwasilisha), ikiwa inajulikana.\",\n  \"ha\": \"Kuɗin rajista (don halarta ko gabatarwa), idan an sani.\",\n};\n\n// Pone una nota (en el idioma activo) en cada cabecera conocida de la hoja.\nfunction ponerNotasCabecerasPIH_(hoja) {\n\n  if (!hoja) return;\n\n  const glosas = gPIH_(\"gl_hdr\");\n  if (!Array.isArray(glosas)) return;\n\n  const ultimaColumna = Math.min(hoja.getLastColumn(), 40);\n  if (ultimaColumna < 1) return;\n\n  const filas = Math.min(hoja.getLastRow(), 6);\n  if (filas < 1) return;\n\n  const valores = hoja.getRange(1, 1, filas, ultimaColumna).getValues();\n\n  for (let f = 0; f < valores.length; f++) {\n    for (let c = 0; c < ultimaColumna; c++) {\n      const texto = String(valores[f][c]).trim();\n      if (!texto) continue;\n      if (texto === \"PRECIO_INSCRIPCION\") {\n        const idioma = idiomaPIH_();\n        hoja.getRange(f + 1, c + 1).setNote(\n          PIH_GLOSA_PRECIO[idioma] || PIH_GLOSA_PRECIO.en\n        );\n        continue;\n      }\n      const pos = PIH_GUIA_CABECERAS.indexOf(texto);\n      if (pos > -1 && glosas[pos]) {\n        hoja.getRange(f + 1, c + 1).setNote(glosas[pos]);\n      }\n    }\n  }\n}\n\n\n// Escribe en PANEL los rótulos en el idioma activo (el programa usa las\n// celdas por posición, no por texto, así que se pueden traducir).\nfunction aplicarPanelIdiomaPIH_(panel) {\n\n  if (!panel) return;\n\n  const p = gPIH_(\"gl_panel\");\n  if (!Array.isArray(p) || p.length < 13) return;\n\n  panel.getRange(\"A2\").setValue(p[0]);\n  panel.getRange(\"A4:B4\").setValues([[p[1], p[2]]]);\n  panel.getRange(\"A5:A9\").setValues([[p[3]], [p[4]], [p[5]], [p[6]], [p[7]]]);\n  panel.getRange(\"A11\").setValue(p[8]);\n  panel.getRange(\"A12:A15\").setValues([[p[9]], [p[10]], [p[11]], [p[12]]]);\n}\n"}, {"name": "Idioma_ar", "type": "SERVER_JS", "source": "// PIH Doctorado · textos del idioma \"ar\". Pega este archivo como Idioma_ar.gs.\nfunction textosPIH_ar() {\n  return {\n  \"m_configurar\": \"🎓 إعداد أطروحتي (ابدأ من هنا)\",\n  \"m_actualizar\": \"📊 تحديث اللوحة وRADAR\",\n  \"m_buscar_base\": \"🔍 البحث في قاعدة البيانات كاملة\",\n  \"m_novedades\": \"🔎 البحث عن منشورات جديدة الآن\",\n  \"m_clasificar\": \"🤖 تصنيف المنشورات المعلّقة بالذكاء الاصطناعي\",\n  \"m_gestor\": \"📚 الإرسال الآن إلى مدير المراجع لديّ\",\n  \"m_ris\": \"📤 تصدير ملف RIS (EndNote وغيره)\",\n  \"m_ris_enviar\": \"إرسال الملف إلى بريدي الإلكتروني\",\n  \"m_ris_marcar\": \"تعليم كمستورد\",\n  \"m_mapa\": \"🗺 خريطة فجوات الأطروحة\",\n  \"m_revisar\": \"🔄 التحقق الآن\",\n  \"m_autores\": \"المؤلفون الرئيسيون\",\n  \"m_fuentes\": \"المصادر الأولية\",\n  \"m_abiertas\": \"المصادر المفتوحة (اختياري)\",\n  \"m_congresos\": \"مواعيد المؤتمرات النهائية\",\n  \"m_resumen\": \"ملخص أسبوعي بالبريد الإلكتروني\",\n  \"m_hist_continuar\": \"الرادار التاريخي: متابعة\",\n  \"m_hist_estado\": \"الرادار التاريخي: عرض الحالة\",\n  \"m_ajustes\": \"⚙ الإعدادات\",\n  \"m_activar_todo\": \"▶ تفعيل كل الأتمتة\",\n  \"m_desactivar_todo\": \"⏹ إيقاف كل الأتمتة\",\n  \"m_hist_activar\": \"الرادار التاريخي التلقائي: تفعيل\",\n  \"m_hist_desactivar\": \"الرادار التاريخي التلقائي: إيقاف\",\n  \"m_ab_activar\": \"المصادر المفتوحة (اختياري): تفعيل\",\n  \"m_ab_desactivar\": \"المصادر المفتوحة: إيقاف\",\n  \"m_ab_probar\": \"المصادر المفتوحة: اختبار الاتصال\",\n  \"m_zo_conectar\": \"Zotero: ربط (في المرة الأولى فقط)\",\n  \"m_zo_probar\": \"Zotero: اختبار الاتصال\",\n  \"m_zo_desconectar\": \"Zotero: فصل الاتصال\",\n  \"m_me_conectar\": \"Mendeley (متقدم): ربط\",\n  \"m_me_probar\": \"Mendeley: اختبار الاتصال\",\n  \"m_me_desconectar\": \"Mendeley: فصل الاتصال\",\n  \"m_repuntuar\": \"إعادة تقييم المنشورات المعلّقة بالمعيار الجديد\",\n  \"m_diag
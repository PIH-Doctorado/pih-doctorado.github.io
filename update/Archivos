esultado\": \"Нових докумената: {0} (проверених страница: {1}).\",\n  \"fp_errores\": \" Било је грешака: погледајте LOG.\",\n  \"fp_on\": \"Провера извора је укључена: сваке недеље око 20:00.\",\n  \"fp_off\": \"Провера извора је искључена ({0}).\",\n  \"me_falta_cred\": \"У својствима скрипте недостаје MENDELEY_CLIENT_ID или MENDELEY_CLIENT_SECRET.\",\n  \"me_falta_oauth\": \"У пројекту недостаје библиотека OAuth2 (идентификатор OAuth2).\",\n  \"me_ya\": \"Mendeley је већ повезан.\",\n  \"me_html\": \"<p>1. Кликните на везу. Mendeley ће се отворити на другој картици.</p><p>2. Пријавите се и одобрите дозволе.</p><p>3. Када видите «Mendeley је повезан», затворите ту картицу и користите <i>Подешавања &gt; Mendeley: тестирај везу</i>.</p>\",\n  \"me_enlace\": \"👉 Повежи са Mendeley\",\n  \"me_dialogo\": \"Повежи са Mendeley\",\n  \"me_desconectado\": \"Mendeley је искључен.\",\n  \"me_alert_no\": \"Још нисте повезани. Користите Подешавања > Mendeley (напредно): повежи.\",\n  \"me_ok\": \"✅ Веза са вашом Mendeley библиотеком је у реду.\",\n  \"me_api_codigo\": \"API је одговорио кодом {0}.\\n\\n{1}\",\n  \"me_no_conectado\": \"Mendeley није повезан.\",\n  \"me_no_conectado_aviso\": \"Mendeley није повезан. Користите Подешавања > Mendeley (напредно): повежи.\",\n  \"me_enviadas\": \"Послато у Mendeley: {0}. На чекању: {1}.\",\n  \"me_reconectar\": \" Треба поново повезати Mendeley из менија.\",\n  \"me_auto_on\": \"Аутоматско слање у Mendeley је укључено (на сваких 6 сати).\",\n  \"me_auto_off\": \"Аутоматско слање у Mendeley је искључено ({0}).\"\n};\n}\n"}, {"name": "Idioma_sv", "type": "SERVER_JS", "source": "// PIH Doctorado · textos del idioma \"sv\". Pega este archivo como Idioma_sv.gs.\nfunction textosPIH_sv() {\n  return {\n  \"m_configurar\": \"🎓 Ställ in min avhandling (börja här)\",\n  \"m_actualizar\": \"📊 Uppdatera panel och RADAR\",\n  \"m_buscar_base\": \"🔍 Sök i hela databasen\",\n  \"m_novedades\": \"🔎 Sök efter nyheter nu\",\n  \"m_clasificar\": \"🤖 Klassificera väntande med AI\",\n  \"m_gestor\": \"📚 Skicka nu till min referenshanterare\",\n  \"m_ris\": \"📤 Exportera RIS-fil (EndNote m.fl.)\",\n  \"m_ris_enviar\": \"Skicka filen till mig via e-post\",\n  \"m_ris_marcar\": \"Markera som importerad\",\n  \"m_mapa\": \"🗺 Luckkarta för avhandlingen\",\n  \"m_revisar\": \"🔄 Kontrollera nu\",\n  \"m_autores\": \"Nyckelförfattare\",\n  \"m_fuentes\": \"Primärkällor\",\n  \"m_abiertas\": \"Öppna källor (valfritt)\",\n  \"m_congresos\": \"Konferensdeadlines\",\n  \"m_resumen\": \"Veckosammanfattning via e-post\",\n  \"m_hist_continuar\": \"Historisk radar: fortsätt\",\n  \"m_hist_estado\": \"Historisk radar: visa status\",\n  \"m_ajustes\": \"⚙ Inställningar\",\n  \"m_activar_todo\": \"▶ Aktivera ALL automatisering\",\n  \"m_desactivar_todo\": \"⏹ Inaktivera ALL automatisering\",\n  \"m_hist_activar\": \"Automatisk historisk radar: aktivera\",\n  \"m_hist_desactivar\": \"Automatisk historisk radar: inaktivera\",\n  \"m_ab_activar\": \"Öppna källor (valfritt): aktivera\",\n  \"m_ab_desactivar\": \"Öppna källor: inaktivera\",\n  \"m_ab_probar\": \"Öppna källor: testa anslutningen\",\n  \"m_zo_conectar\": \"Zotero: anslut (bara första gången)\",\n  \"m_zo_probar\": \"Zotero: testa anslutningen\",\n  \"m_zo_desconectar\": \"Zotero: koppla från\",\n  \"m_me_conectar\": \"Mendeley (avancerat): anslut\",\n  \"m_me_probar\": \"Mendeley: testa anslutningen\",\n  \"m_me_desconectar\": \"Mendeley: koppla från\",\n  \"m_repuntuar\": \"Omvärdera väntande med det nya kriteriet\",\n  \"m_diagnostico\": \"Systemdiagnostik\",\n  \"m_idioma\": \"🌐 Idioma / Language\",\n  \"m_guia\": \"📖 Steg-för-steg-guide\",\n  \"m_guia_inicio\": \"Första stegen\",\n  \"m_guia_listo\": \"Efter att avhandlingen ställts in\",\n  \"m_guia_rapida\": \"❓ Snabbguide\",\n  \"a_buscando\": \"Söker efter nyheter i OpenAlex…\",\n  \"a_nuevos\": \"{0} ny(a) publikation(er).\",\n  \"a_nuevos_clasificar\": \" Använd «Klassificera väntande med AI» för att analysera dem.\",\n  \"a_limite_openalex\": \" OpenAlex gratisgräns är nådd: försök igen senare.\",\n  \"a_clasificando\": \"Klassificerar med AI (kan ta några minuter)…\",\n  \"a_fuentes\": \"Kontrollerar källsidorna…\",\n  \"a_autores\": \"Kontrollerar nyckelförfattarna…\",\n  \"a_mapa\": \"Beräknar luckkartan…\",\n  \"a_error_titulo\": \"Åtgärden kunde inte slutföras\",\n  \"a_error_pie\": \"\\n\\nOm problemet kvarstår, titta i fliken LOG.\",\n  \"act_titulo\": \"Aktivera all automatisering\",\n  \"act_texto\": \"Följande aktiveras:\\n• Daglig radar + AI-klassificering (varje dag och varje timme)\\n• Sändning till vald referenshanterare (var 6:e timme)\\n• Veckosammanfattning via e-post (måndag)\\n• Påminnelse om konferensdeadlines (måndag)\\n• Kontroll av primärkällor (söndag)\\n• Kontroll av nyckelförfattare (söndag)\\n\\nHistorisk radar och öppna källor (avhandlingsarkiv) aktiveras separat (Inställningar).\\n\\nFortsätta?\",\n  \"act_ok\": \"Automatisering aktiverad\",\n  \"des_titulo\": \"Inaktivera all automatisering\",\n  \"des_texto\": \"Alla automatiska uppgifter stoppas (inklusive den historiska radarn). Ändringar i RADAR fortsätter att synkroniseras.\\n\\nFortsätta?\",\n  \"des_ok\": \"Automatisering inaktiverad\",\n  \"p_radar\": \"Daglig radar och klassificering\",\n  \"p_gestor\": \"Sändning till din referenshanterare\",\n  \"p_resumen\": \"Veckosammanfattning\",\n  \"p_congresos\": \"Konferensdeadlines\",\n  \"p_fuentes\": \"Primärkällor\",\n  \"p_autores\": \"Nyckelförfattare\",\n  \"p_abiertas\": \"Öppna källor\",\n  \"p_historico\": \"Historisk radar\",\n  \"guia_titulo\": \"Snabbguide · PIH Doctorado\",\n  \"guia_html\": \"<h3 style='margin: 0 0 8px; color: #24445C;'>Så fungerar din PIH Doctorado</h3><p><b>0. Börja</b> med «Configurar mi tesis» (Ställ in min avhandling): klistra in avhandlingens sammanfattning och dina gratisnycklar, så ställer systemet in sig självt.</p><p><b>1. PANEL</b> är översikten: siffror och diagram. Den är bara till för att titta på.</p><p><b>2. RADAR</b> är din arbetsplan, sorterad efter relevans (det viktigaste överst). Färgerna visar relevans, AI:ns tillförlitlighet och status.</p><ul style='margin-top: 0;'><li>Ändra <b>ESTADO</b> (status) med rullgardinsmenyn: <b>Pendiente</b> (väntande, ej granskad), <b>Para leer</b> (att läsa, intresserar dig), <b>Leído</b> (läst) eller <b>Descartado</b> (kasserad).</li><li>Du kan rätta <b>RELEVANCIA</b> (relevans, 0 till 5) och <b>TEMÁTICA</b> (tema). De sparas automatiskt.</li></ul><p><b>3. Zotero eller Mendeley:</b> publikationer markerade «Para leer» eller «Leído» skickas automatiskt till ditt bibliotek (samlingen «PIH Doctorado»). Första gången: Inställningar &gt; Zotero: anslut (Mendeley är mer tekniskt).</p><p><b>4. Automatiskt:</b> under <i>Inställningar &gt; Aktivera ALL automatisering</i> aktiveras allt på en gång. Om en gratisgräns nås stannar det och fortsätter av sig självt senare. Allt är gratis.</p><p><b>5. Övriga flikar:</b> MAPA HUECOS (luckkarta: vilka delar av avhandlingen som har lite litteratur), AUTORES CLAVE (nyckelförfattare), FUENTES PRIMARIAS (primärkällor) och CONGRESOS (konferenser) fylls i och meddelar dig via e-post. PUBLICACIONES är databasen och LOG historiken (om något går fel står orsaken där).</p>\",\n  \"tut_label_inicio\": \"GUIDE · FÖRSTA STEGEN\",\n  \"tut_label_listo\": \"GUIDE · NÄSTA STEG\",\n  \"tut_prev\": \"Föregående\",\n  \"tut_next\": \"Nästa\",\n  \"tut_start\": \"Börja\",\n  \"tut_of\": \"av\",\n  \"tut_menu_error\": \"Använd menyn överst: PIH Doctorado > Ställ in min avhandling.\",\n  \"tut_toast\": \"Öppna PIH Doctorado > Steg-för-steg-guide för att se de första stegen.\",\n  \"tut_toast_titulo\": \"Välkommen\",\n  \"tut_idioma\": \"Språk\",\n  \"tut_dialogo\": \"PIH Doctorado\",\n  \"tut_inicio\": [\n    {\n      \"titulo\": \"Välkommen till din PIH Doctorado\",\n      \"texto\": \"Det är ett system som varje dag söker nya publikationer om din avhandling, betygsätter dem från 0 till 5 med AI och lägger dem sorterade i det här bladet. Det fungerar med gratiskonton och dina data stannar i ditt Google-konto.\",\n      \"pista\": \"Den här guiden tar cirka 3 minuter. Du kan öppna den igen från menyn.\"\n    },\n    {\n      \"titulo\": \"Så fungerar det\",\n      \"texto\": \"1. Du beskriver din avhandling.\\n2. Systemet söker litteratur i OpenAlex, en öppen databas över vetenskapliga arbeten.\\n3. AI:n läser varje sammanfattning och ger ett betyg utifrån din avhandling.\\n4. Du bestämmer vad du ska läsa och skickar det till din referenshanterare.\",\n      \"pista\": \"Sista ordet har alltid du: du kan rätta vilket betyg som helst.\"\n    },\n    {\n      \"titulo\": \"Vad som skapas i ditt blad\",\n      \"texto\": \"När du ställer in avhandlingen dyker de här flikarna upp:\\n\\nPERFIL (profil): din avhandling och de genererade sökningarna.\\nRADAR: publikationslistan, sorterad efter relevans. Här arbetar du.\\nPANEL (panel): översikt med siffror och diagram.\\nPUBLICACIONES (publikationer): hela databasen.\\nLOG: historiken; om något går fel står orsaken här.\\nOch tomma, för dig att fylla i: AUTORES CLAVE (nyckelförfattare), CONGRESOS (konferenser) och FUENTES PRIMARIAS (primärkällor).\",\n      \"pista\": \"Du behöver inte röra något innan du ställer in.\"\n    },\n    {\n      \"titulo\": \"Vad du behöver innan du börjar\",\n      \"texto\": \"Två gratisnycklar, utan kort:\\n• Gemini (AI:n): aistudio.google.com > «Get API key».\\n• OpenAlex (litteraturen): skapa ett konto på openalex.org och kopiera nyckeln från din profil.\\n\\nOch sammanfattningen av din avhandling: minst 4 eller 5 meningar.\",\n      \"pista\": \"Skaffa dem nu i en annan webbläsarflik och kom tillbaka hit.\"\n    },\n    {\n      \"titulo\": \"Googles behörigheter\",\n      \"texto\": \"Första gången ber Google om behörigheter och visar «overifierad app». Det är normalt för personliga skript.\\n\\nKlicka på «Avancerat» och sedan «Gå till … (osäkert)». Koden är din och du kan läsa den under 